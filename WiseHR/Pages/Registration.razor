@page "/registration"
@using Components.sidebar
@layout HomeLayout
@using WiseHR.Pages.Form
@using WiseHRServer.Models
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large">
    <MudCard Elevation="25" Class="p-4">
        <!-- Header -->
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-4">Employee Registration</MudText>
            <MudProgressLinear Value="@ProgressPercentage" Color="Color.Primary" Rounded="true" Height="10px" />

            @if (IsLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="my-6" />
            }
            else
            {
                @switch (CurrentStep)
                {
                    case 1:
                        <EmployeeDetailsForm @ref="employeeForm" OnSubmit="HandleEmployeeDetailsSubmit" />
                        break;
                    case 2:
                        <BankingInfoForm @ref="bankingForm" OnSubmit="HandleBankingInfoSubmit" OnBack="HandleBack" />
                        break;
                    case 3:
                        <WorkExperienceForm @ref="workForm" OnSubmit="HandleWorkExperienceSubmit" OnBack="HandleBack" />
                        break;
                }
            }

            <!-- Success Message -->
            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mt-4">@SuccessMessage</MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private int CurrentStep = 1;
    private string SuccessMessage;
    private bool IsLoading = false;

    private EmployeeDetailsForm employeeForm;
    private BankingInfoForm bankingForm;
    private WorkExperienceForm workForm;

    private EmployeeDetails employeeDetails = new();
    private BankingInformation bankingInfo = new();
    private Experience experience = new();

    private int ProgressPercentage => CurrentStep switch
    {
        1 => 33,
        2 => 66,
        3 => 100,
        _ => 0
    };

    private async Task HandleEmployeeDetailsSubmit(EmployeeDetails details)
    {
        employeeDetails = details;
        await GoToNextStep();
    }

    private async Task HandleBankingInfoSubmit(BankingInformation info)
    {
        bankingInfo = info;
        await GoToNextStep();
    }

    private async Task HandleWorkExperienceSubmit(Experience exp)
    {
        experience = exp;
        IsLoading = true;
        await Task.Delay(500); // Simulate save delay
        SaveAllData();

        SuccessMessage = "🎉 Registration completed successfully!";
        await ResetFormFlow();
        IsLoading = false;
    }

    private void HandleBack()
    {
        if (CurrentStep > 1)
            CurrentStep--;
    }

    private async Task GoToNextStep()
    {
        await Task.Yield();
        if (CurrentStep < 3)
            CurrentStep++;
    }

    private async Task ResetFormFlow()
    {
        CurrentStep = 1;
        employeeForm?.Reset(); // Ensure Reset() is public
        bankingForm?.Reset();
        workForm?.Reset();

        employeeDetails = new();
        bankingInfo = new();
        experience = new();

        await Task.Yield();
    }

    private void SaveAllData()
    {
        Console.WriteLine("Saving employee details:");
        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(employeeDetails));
        Console.WriteLine("Saving banking info:");
        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(bankingInfo));
        Console.WriteLine("Saving experience:");
        Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(experience));
    }
}