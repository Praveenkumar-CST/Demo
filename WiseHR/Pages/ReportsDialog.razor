@page "/reports"
@inject IDialogService DialogService
@using WiseHR.Pages.Form
@inject ISnackbar Snackbar
@inject ReportService ReportService
@using Components.sidebar
@layout HomeLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <!-- Button to open dialog -->
    <div class="d-flex justify-end mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenReportDialog">
            Add Report
        </MudButton>
    </div>

    <h3 class="mb-2">Reports</h3>

    <!-- Displaying reports in a table -->
    <MudTable Items="reports" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Mentee Email</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.MenteeEmail</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               OnClick="@(() => EditReport(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteReport(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<ReportModel> reports = new();

    [Parameter]
    public ReportModel? EditableReport { get; set; }

    protected override async Task OnInitializedAsync()
    {
        reports = await ReportService.GetReportsAsync();
    }

    private async Task DeleteReport(string id)
    {
        var response = await ReportService.DeleteReportAsync(id);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("Deleted successfully", Severity.Info);
            reports = await ReportService.GetReportsAsync();
        }
        else
        {
            Snackbar.Add("Delete failed", Severity.Error);
        }
    }

    private async Task EditReport(ReportModel reportToEdit)
    {
        var parameters = new DialogParameters { ["EditableReport"] = reportToEdit };

        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = false
            };

        var dialog = await DialogService.ShowAsync<FortnightReportForm>("Edit Report", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Report updated successfully!", Severity.Success);
            reports = await ReportService.GetReportsAsync();
        }
    }

    private async Task OpenReportDialog()
    {
        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = false
            };

        await DialogService.ShowAsync<FortnightReportForm>("Submit Fortnight Report", options);
    }
}
