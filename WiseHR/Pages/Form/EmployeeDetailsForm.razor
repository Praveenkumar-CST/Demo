                            <ValidationMessage For="@(() => employeeDetails.PassportPlaceOfIssue)" />
                        </MudTextField>
                    </MudItem>
                   </MudGrid>
                       @* break *@

                <!-- Current Address -->
                <MudText Typo="Typo.h6" Class="mb-4 mt-6">Current Address</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField Label="Address" Variant="Variant.Outlined" @bind-Value="employeeDetails.CurrentAddress" Required="true" Lines="3">
                            <ValidationMessage For="@(() => employeeDetails.CurrentAddress)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
