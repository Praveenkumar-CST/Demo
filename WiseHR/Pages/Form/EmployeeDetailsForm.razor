                    </MudGrid>
                    @* break *@
                    <MudGrid>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Emergency Contact 2 Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact2Name" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.EmergencyContact2Name)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Relationship" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact2Relationship" Required="true">
