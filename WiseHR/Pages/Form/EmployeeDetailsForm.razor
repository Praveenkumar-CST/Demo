                            <ValidationMessage For="@(() => employeeDetails.CurrentCity)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="State" Variant="Variant.Outlined" @bind-Value="employeeDetails.CurrentState" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.CurrentState)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Zip/Pin Code" Variant="Variant.Outlined" @bind-Value="employeeDetails.CurrentZip" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.CurrentZip)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Mobile No" Variant="Variant.Outlined" @bind-Value="employeeDetails.CurrentMobile" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.CurrentMobile)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Email" Variant="Variant.Outlined" @bind-Value="employeeDetails.CurrentEmail" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.CurrentEmail)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudCheckBox T="bool" @bind-Checked="IsSameAsCurrentAddress" Label="Same as Current Address" Color="Color.Primary" ValueChanged="CopyAddress" />
                    </MudItem>
                </MudGrid>

                <!-- Permanent Address -->
                <MudText Typo="Typo.h6" Class="mb-4 mt-6">Permanent Address</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField Label="Address" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentAddress" Required="true" Lines="3">
                            <ValidationMessage For="@(() => employeeDetails.PermanentAddress)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="City" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentCity" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.PermanentCity)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="State" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentState" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.PermanentState)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Zip/Pin Code" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentZip" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.PermanentZip)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Mobile No" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentMobile" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.PermanentMobile)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Email" Variant="Variant.Outlined" @bind-Value="employeeDetails.PermanentEmail" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.PermanentEmail)" />
                        </MudTextField>
                    </MudItem>
                </MudGrid>

                <!-- Emergency Contact Information -->
                <MudText Typo="Typo.h6" Class="mb-4 mt-6">Emergency Contact Information</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Emergency Contact 1 Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact1Name" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.EmergencyContact1Name)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Relationship" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact1Relationship" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.EmergencyContact1Relationship)" />
                        </MudTextField>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Address" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact1Address" Required="true">
