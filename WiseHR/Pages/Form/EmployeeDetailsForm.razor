                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField Label="Mobile No" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmergencyContact1Mobile" Required="true">
                            <ValidationMessage For="@(() => employeeDetails.EmergencyContact1Mobile)" />
