                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudDatePicker Label="Date of Relieving" Variant="Variant.Outlined" @bind-Date="employeeDetails.DateOfRelieving" Required="true" MinDate="@employeeDetails.DateOfJoining" For="@(() => employeeDetails.DateOfRelieving)" />
