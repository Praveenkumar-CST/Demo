@page "/employee-form"
@using WiseHRServer.Models
@inject EmployeeService employeeService
@using Components.sidebar
@layout HomeLayout
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using System.Text.Json;
@inject CountryService CountryService

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">
    <MudPaper Elevation="10" Class="rounded-lg overflow-hidden">
        <!-- Header with gradient background -->
        <MudCardHeader Class="bg-gradient-primary py-6">
            <MudText Typo="Typo.h4" Color="Color.Inherit" Class="text-white font-weight-bold">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                EMPLOYEE REGISTRATION FORM
            </MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Inherit" Class="text-white-50">
                Complete all sections to register new employee
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="p-0">
            <!-- Stepper for form progress -->
            <MudStepper Linear="true" Class="px-4 pt-4">
                <MudStep Text="Personal Details" Color="Color.Primary" CompletedIcon="@Icons.Material.Filled.Check" />
                <MudStep Text="Banking Info" Disabled="true" />
                <MudStep Text="Documents" Disabled="true" />
                <MudStep Text="Review" Disabled="true" />
            </MudStepper>

            <EditForm Model="@employeeDetails" OnValidSubmit="@GoToNextPage" Class="px-4">
                <DataAnnotationsValidator />

                <!-- Personal Information Section -->
                <MudExpansionPanel Text="Personal Information" Icon="@Icons.Material.Filled.PersonOutline" Class="mt-4" Expanded="true">
                    <MudGrid Spacing="2">
                        <!-- Employee ID -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Employee ID" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.EmployeeID"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Badge"
                                         Required="true" 
                                         Margin="Margin.Dense" 
                                         Disabled="true" />
                        </MudItem>

                        <!-- Name Fields -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="First Name *" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.FirstName" 
                                         Required="true" 
                                         Margin="Margin.Dense" />
                            <ValidationMessage For="@(() => employeeDetails.FirstName)" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Middle Name" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.MiddleName" 
                                         Margin="Margin.Dense" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Last Name *" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.LastName" 
                                         Required="true" 
                                         Margin="Margin.Dense" />
                            <ValidationMessage For="@(() => employeeDetails.LastName)" />
                        </MudItem>

                        <!-- Parents Info -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Father's Name *" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.FatherName" 
                                         Required="true" 
                                         Margin="Margin.Dense" />
                            <ValidationMessage For="@(() => employeeDetails.FatherName)" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Mother's Name *" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.MotherName" 
                                         Required="true" 
                                         Margin="Margin.Dense" />
                            <ValidationMessage For="@(() => employeeDetails.MotherName)" />
                        </MudItem>

                        <!-- Date of Birth -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker Label="Date of Birth *" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          @bind-Date="employeeDetails.DateOfBirth" 
                                          Required="true" 
                                          MaxDate="DateTime.Now" 
                                          For="@(() => employeeDetails.DateOfBirth)"
                                          AdornmentIcon="@Icons.Material.Filled.Cake" />
                        </MudItem>

                        <!-- Gender -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Gender *" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.Gender" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Transgender">
                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                                <MudSelectItem Value="@("Prefer not to mention")">Prefer not to mention</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Health Information -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Physically Challenged *" 
                                      Margin="Margin.Dense" 
                                      Variant="Variant.Outlined" 
                                      @bind-Value="employeeDetails.PhysicallyChallenged" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Accessibility">
                                <MudSelectItem Value="@("Yes")">Yes</MudSelectItem>
                                <MudSelectItem Value="@("No")">No</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Allergies" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.Allergies"
                                         AdornmentIcon="@Icons.Material.Filled.HealthAndSafety" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Medications" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.Medications"
                                         AdornmentIcon="@Icons.Material.Filled.MedicalServices" />
                        </MudItem>

                        <!-- Marital Status -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Marital Status *" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.MaritalStatus" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Favorite">
                                <MudSelectItem Value="@("Single")">Single</MudSelectItem>
                                <MudSelectItem Value="@("Married")">Married</MudSelectItem>
                                <MudSelectItem Value="@("Divorced")">Divorced</MudSelectItem>
                                <MudSelectItem Value="@("Widowed")">Widowed</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Children Info (conditional) -->
                        @if (employeeDetails.MaritalStatus != "Single")
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField T="string" Label="No of Sons" 
                                                Variant="Variant.Outlined" 
                                                Margin="Margin.Dense" 
                                                @bind-Value="employeeDetails.Sons"
                                                Min="@("0")"
                                                AdornmentIcon="@Icons.Material.Filled.Boy" />
                            </MudItem>
                            
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField T="string" Label="No of Daughters" 
                                                Variant="Variant.Outlined" 
                                                Margin="Margin.Dense" 
                                                @bind-Value="employeeDetails.Daughters"
                                                Min="@("0")"
                                                AdornmentIcon="@Icons.Material.Filled.Girl" />
                            </MudItem>
                        }

                        <!-- Blood Group -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Blood Group *" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.BloodGroup" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Bloodtype">
                                <MudSelectItem Value="@("A+")">A+</MudSelectItem>
                                <MudSelectItem Value="@("A-")">A-</MudSelectItem>
                                <MudSelectItem Value="@("B+")">B+</MudSelectItem>
                                <MudSelectItem Value="@("B-")">B-</MudSelectItem>
                                <MudSelectItem Value="@("O+")">O+</MudSelectItem>
                                <MudSelectItem Value="@("O-")">O-</MudSelectItem>
                                <MudSelectItem Value="@("AB+")">AB+</MudSelectItem>
                                <MudSelectItem Value="@("AB-")">AB-</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <!-- Nationality -->
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Nationality *" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.Nationality" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Public">
                                @if (countries != null)
                                {
                                    @foreach (var country in countries)
                                    {
                                        <MudSelectItem Value="@country.Name">@country.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- Photo Upload -->
                        <MudItem xs="12" sm="12" md="12">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg" Style="border: 1px dashed var(--mud-palette-primary);">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Class="mr-2" />
                                    Upload Employee Photo
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                    JPG, PNG or PDF (Max 20MB)
                                </MudText>
                                
                                <MudFileUpload T="IReadOnlyList<IBrowserFile>" 
                                              FilesChanged="@HandlePhotoFileChange"
                                              Accept=".jpg,.jpeg,.png,.pdf"
                                              Multiple="false">
                                    <Template>
                                        <MudButton Variant="Variant.Outlined" 
                                                  Color="Color.Primary" 
                                                  StartIcon="@Icons.Material.Filled.Upload"
                                                  Class="ma-2">
                                            Browse Files
                                        </MudButton>
                                    </Template>
                                </MudFileUpload>
                                
                                @if (!string.IsNullOrEmpty(employeeDetails.PhotoFileName))
                                {
                                    <MudChip T="string" Class="mt-2" Color="Color.Success" Variant="Variant.Filled" OnClose="() => ClearPhotoUpload()">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="mr-1" />
                                        @employeeDetails.PhotoFileName
                                    </MudChip>
                                }
                                
                                @if (!string.IsNullOrEmpty(PhotoUploadError))
                                {
                                    <MudAlert Severity="Severity.Error" Class="mt-2">@PhotoUploadError</MudAlert>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Work Information Section -->
                <MudExpansionPanel Text="Work Information" Icon="@Icons.Material.Filled.WorkOutline" Class="mt-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Type of Employment" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.TypeOfEmployment"
                                      AdornmentIcon="@Icons.Material.Filled.BusinessCenter">
                                <MudSelectItem Value="@("Full-Time")">Full-Time</MudSelectItem>
                                <MudSelectItem Value="@("Part-Time")">Part-Time</MudSelectItem>
                                <MudSelectItem Value="@("Contract")">Contract</MudSelectItem>
                                <MudSelectItem Value="@("Internship")">Internship</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField T="string"
                                        Label="Level"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        @bind-Value="employeeDetails.Level"
                                        AdornmentIcon="@Icons.Material.Filled.Leaderboard" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Designation" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.Designation"
                                         AdornmentIcon="@Icons.Material.Filled.Work" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Joining Location *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.JoiningLocation" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker Label="Date of Joining *" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          @bind-Date="employeeDetails.DateOfJoining" 
                                          Required="true" 
                                          MaxDate="DateTime.Now" 
                                          For="@(() => employeeDetails.DateOfJoining)"
                                          AdornmentIcon="@Icons.Material.Filled.DateRange" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Passport Information Section -->
                <MudExpansionPanel Text="Passport Information" Icon="@Icons.Material.Filled.PermIdentity" Class="mt-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Passport Full Name *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PassportFullName" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Person" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Passport No *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PassportNo" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.CreditCard" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudSelect T="string" 
                                      Label="Passport Nationality *" 
                                      Variant="Variant.Outlined" 
                                      Margin="Margin.Dense" 
                                      @bind-Value="employeeDetails.PassportNationality" 
                                      Required="true"
                                      AdornmentIcon="@Icons.Material.Filled.Public">
                                @if (countries != null)
                                {
                                    @foreach (var country in countries)
                                    {
                                        <MudSelectItem Value="@country.Name">@country.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker Label="Date of Issue *" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          @bind-Date="employeeDetails.PassportIssueDate" 
                                          Required="true" 
                                          MaxDate="DateTime.Now" 
                                          For="@(() => employeeDetails.PassportIssueDate)"
                                          AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudDatePicker Label="Date of Expiry *" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          @bind-Date="employeeDetails.PassportExpiryDate" 
                                          Required="true" 
                                          MinDate="@employeeDetails.PassportIssueDate" 
                                          For="@(() => employeeDetails.PassportExpiryDate)"
                                          AdornmentIcon="@Icons.Material.Filled.EventBusy" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Passport Place of Issue *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PassportPlaceOfIssue" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Place" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Current Address Section -->
                <MudExpansionPanel Text="Current Address" Icon="@Icons.Material.Filled.Home" Class="mt-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField Label="Address *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.CurrentAddress" 
                                         Required="true" 
                                         Lines="3"
                                         AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="City *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.CurrentCity" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="State *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.CurrentState" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Map" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Zip/Pin Code *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.CurrentZip" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Pin" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Mobile No *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.CurrentMobile" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Email *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense"
                                         @bind-Value="employeeDetails.CurrentEmail" 
                                         Required="true" 
                                         Disabled="true"
                                         AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <MudCheckBox T="bool" 
                                        @bind-Checked="IsSameAsCurrentAddress" 
                                        Margin="Margin.Dense" 
                                        Label="Same as Current Address" 
                                        Color="Color.Primary" 
                                        ValueChanged="CopyAddress"
                                        Class="ml-0" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Permanent Address Section -->
                <MudExpansionPanel Text="Permanent Address" Icon="@Icons.Material.Filled.House" Class="mt-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField Label="Address *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PermanentAddress" 
                                         Required="true" 
                                         Lines="3"
                                         AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="City *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PermanentCity" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="State *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PermanentState" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Map" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Zip/Pin Code *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PermanentZip" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Pin" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Mobile No *" 
                                         Variant="Variant.Outlined" 
                                         Margin="Margin.Dense" 
                                         @bind-Value="employeeDetails.PermanentMobile" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Phone" />
                        </MudItem>
                        
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Label="Email *" 
                                         Variant="Variant.Outlined" 
                                         @bind-Value="employeeDetails.PermanentEmail" 
                                         Required="true"
                                         AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>

                <!-- Emergency Contact Section -->
                <MudExpansionPanel Text="Emergency Contacts" Icon="@Icons.Material.Filled.Emergency" Class="mt-4">
                    <MudTabs Elevation="0" Color="Color.Primary" Centered="true">
                        <MudTab Text="Primary Contact">
                            <MudGrid Spacing="2" Class="pt-4">
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Contact Name *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1Name" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.Person" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Relationship *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1Relationship" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.People" />
                                </MudItem>
                                
                                <MudItem xs="12">
                                    <MudTextField Label="Address *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1Address" 
                                                 Required="true"
                                                 Lines="3"
                                                 AdornmentIcon="@Icons.Material.Filled.Home" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="City *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1City" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="State *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1State" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.Map" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Zip/Pin Code *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1ZipCode" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.Pin" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Mobile No *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact1Mobile" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.Phone" />
                                </MudItem>
                            </MudGrid>
                        </MudTab>
                        
                        <MudTab Text="Secondary Contact">
                            <MudGrid Spacing="2" Class="pt-4">
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Contact Name *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact2Name" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.Person" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="Relationship *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact2Relationship" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.People" />
                                </MudItem>
                                
                                <MudItem xs="12">
                                    <MudTextField Label="Address *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact2Address" 
                                                 Required="true"
                                                 Lines="3"
                                                 AdornmentIcon="@Icons.Material.Filled.Home" />
                                </MudItem>
                                
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField Label="City *" 
                                                 Variant="Variant.Outlined" 
                                                 Margin="Margin.Dense" 
                                                 @bind-Value="employeeDetails.EmergencyContact2City" 
                                                 Required="true"
                                                 AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                                </MudItem>
                                
