@inherits LayoutComponentBase
@using WiseHR.Components.sidebar
@using WiseHR.Models
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudLayout>

    <!-- Top Navigation Bar -->
    <MudAppBar Elevation="1" Style="background-color: var(--primary);">
        <MudItem xs="2" Class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@(() => sidebar?.ToggleDrawer())"
                           Class="mr-2" />

            <MudImage Src="images/logo1.png"
                      Alt="Company Logo"
                      Height="60"
                      Style="margin-left: 60px; color:white;" />
        </MudItem>

        <MudItem xs="8" Class="d-flex flex-column justify-center align-center">
            <div class="d-flex align-center" style="width: 50%;">
                <MudAutocomplete T="EmployeeSearchResult"
                                 SearchFunc="@SearchEmployeesAutocomplete"
                                 Placeholder="Search employees..."
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 Style="width: 100%; background-color: var(--secondary); border-radius: var(--border-radius-input); --mud-palette-text-primary: var(--text-primary); --mud-icon-adornment-color: var(--primary);"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="false"
                                 ShowProgressIndicator="true"
                                 ValueChanged="OnEmployeeSelected"
                                 @bind-Text="_searchText"
                                 ItemTemplate="@ResultTemplate" />

                <MudIconButton Icon="@Icons.Material.Filled.FilterList" Color="Color.Inherit" OnClick="ToggleFilters" Class="ml-2"/>
            </div>

            @* Filter Popover - anchored to the filter icon *@
            <MudPopover Open="@_showFilters" Fixed="true" Class="px-4 pt-4" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                 <MudPaper Elevation="3" Class="pa-4" Style="background-color: var(--secondary); min-width: 400px;">
                    <MudText Typo="Typo.h6" GutterBottom="true" Style="color: var(--text-primary);">Filter Options</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudSelect T="string" Label="Gender" Variant="Variant.Outlined" Value="@selectedGender" ValueChanged="@(value => OnFilterChanged("gender", value))" Dense="true" Margin="Margin.Dense" Style="--mud-palette-text-primary: var(--text-primary);">
                                <MudSelectItem Value="@("")">Any Gender</MudSelectItem>
                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="string" Label="Blood Group" Variant="Variant.Outlined" Value="@selectedBloodGroup" ValueChanged="@(value => OnFilterChanged("bloodGroup", value))" Dense="true" Margin="Margin.Dense" Style="--mud-palette-text-primary: var(--text-primary);">
                                <MudSelectItem Value="@("")">Any Blood</MudSelectItem>
                                <MudSelectItem Value="@("A+")">A+</MudSelectItem>
                                <MudSelectItem Value="@("A-")">A-</MudSelectItem>
                                <MudSelectItem Value="@("B+")">B+</MudSelectItem>
                                <MudSelectItem Value="@("B-")">B-</MudSelectItem>
                                <MudSelectItem Value="@("AB+")">AB+</MudSelectItem>
                                <MudSelectItem Value="@("AB-")">AB-</MudSelectItem>
                                <MudSelectItem Value="@("O+")">O+</MudSelectItem>
                                <MudSelectItem Value="@("O-")">O-</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="string" Label="Designation" Variant="Variant.Outlined" Value="@selectedDesignation" ValueChanged="@(value => OnFilterChanged("designation", value))" Dense="true" Margin="Margin.Dense" Style="--mud-palette-text-primary: var(--text-primary);">
                                <MudSelectItem Value="@("")">Any Designation</MudSelectItem>
                                @foreach (var designation in designations)
                                {
                                    <MudSelectItem Value="@designation">@designation</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                 </MudPaper>
            </MudPopover>

            @* Display error message if search fails *@
            @if (!string.IsNullOrEmpty(_searchError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_searchError</MudText>
            }
        </MudItem>

        <MudItem xs="2" Style="padding: 8px;">
            <MudMenu>
                <ActivatorContent>
                    @if (!string.IsNullOrEmpty(userProfilePicture))
                    {
                        <img src="@userProfilePicture"
                             class="rounded-circle" alt="Employee Photo"
                             style="width: 50px; height: 50px; margin-left:180px; object-fit: cover;" />
                    }
                    else
                    {
                        <MudAvatar Size="Size.Medium"
                                   Class="cursor-pointer"
                                   Style="background-color: var(--secondary); color: var(--text-primary); margin-left: 180px;">
                            @userInitials
                        </MudAvatar>
                    }
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Style="color: var(--text-primary);">Profile</MudMenuItem>
                    <MudMenuItem Style="color: var(--text-primary);">Setting</MudMenuItem>
                    <MudMenuItem Style="color: var(--error);">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudItem>
    </MudAppBar>

    <!-- Sidebar -->
    <HomeSidebar @ref="sidebar" @bind-DrawerOpen="drawerOpen" />

    <!-- Main Content -->
    <MudMainContent Style="flex-grow: 1;">
        <MudContainer Class="mt-6 mx-auto" MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

    <!-- Popover Support -->
    <MudPopoverProvider />

</MudLayout>

@code {
    private bool drawerOpen = true;
    private HomeSidebar? sidebar;
    private string? userProfilePicture;
    private string? userName;
    private string? userInitials;
    private string? _searchError = null;
    private string _lastSearchQuery = string.Empty;
    private string? _searchText = null;
    private string? selectedGender = null;
    private string? selectedBloodGroup = null;
    private string? selectedDesignation = null;
    private List<string> designations = new();
    private bool _showFilters = false; // State for filter panel visibility

    private RenderFragment<EmployeeSearchResult> ResultTemplate => (context) => __builder =>
    {
        __builder.OpenComponent<MudGrid>(0);
        __builder.AddAttribute(1, "Spacing", 2);
        __builder.AddAttribute(2, "Justify", Justify.FlexStart);
        __builder.AddAttribute(3, "Class", "py-2 px-1");
        __builder.AddAttribute(4, "ChildContent", (RenderFragment)((__builder2) =>
        {
            __builder2.OpenComponent<MudItem>(5);
            __builder2.AddAttribute(6, "xs", 2);
            __builder2.AddAttribute(7, "Class", "d-flex align-center justify-center");
            __builder2.AddAttribute(8, "ChildContent", (RenderFragment)((__builder3) =>
            {
                if (!string.IsNullOrEmpty(context.ProfilePicture))
                {
                    __builder3.OpenComponent<MudAvatar>(9);
                    __builder3.AddAttribute(10, "Image", $"data:image/png;base64,{context.ProfilePicture}");
                    __builder3.AddAttribute(11, "Size", Size.Medium);
                    __builder3.CloseComponent();
                }
                else
                {
                    __builder3.OpenComponent<MudAvatar>(12);
                    __builder3.AddAttribute(13, "Color", Color.Primary);
                    __builder3.AddAttribute(14, "Size", Size.Medium);
                    __builder3.AddAttribute(15, "ChildContent", (RenderFragment)((__builder4) =>
                    {
                        __builder4.AddContent(16, GetInitials(context.Name));
                    }));
                    __builder3.CloseComponent();
                }
            }));
            __builder2.CloseComponent();
            __builder2.OpenComponent<MudItem>(17);
            __builder2.AddAttribute(18, "xs", 10);
            __builder2.AddAttribute(19, "ChildContent", (RenderFragment)((__builder3) =>
            {
                __builder3.OpenComponent<MudText>(20);
                __builder3.AddAttribute(21, "Typo", Typo.body1);
                __builder3.AddAttribute(22, "ChildContent", (RenderFragment)((__builder4) =>
                {
                    __builder4.AddContent(23, (MarkupString)GetHighlightedHtml(context.Name, _lastSearchQuery));
                }));
                __builder3.CloseComponent();
                __builder3.OpenComponent<MudText>(24);
                __builder3.AddAttribute(25, "Typo", Typo.body2);
                __builder3.AddAttribute(26, "Color", Color.Dark);
                __builder3.AddAttribute(27, "ChildContent", (RenderFragment)((__builder4) =>
                {
                    __builder4.AddContent(28, (MarkupString)GetHighlightedHtml(context.Designation, _lastSearchQuery));
                }));
                __builder3.CloseComponent();
                __builder3.OpenComponent<MudText>(29);
                __builder3.AddAttribute(30, "Typo", Typo.caption);
                __builder3.AddAttribute(31, "Color", Color.Dark);
                __builder3.AddAttribute(32, "ChildContent", (RenderFragment)((__builder4) =>
                {
                    __builder4.AddContent(33, (MarkupString)GetHighlightedHtml(context.Email, _lastSearchQuery));
                }));
                __builder3.CloseComponent();
            }));
             __builder2.CloseComponent();
        }));
        __builder.CloseComponent();
    };

    [Parameter]
    public EventCallback<string> OnSearchQueryChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDetails();
        await LoadDesignations();
    }

    private async Task LoadDesignations()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<string>>("/api/designations");
            designations = response ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading designations: {ex.Message}");
            designations = new List<string> { "Developer", "Project Manager", "Analyst" }; // Fallback
        }
    }

    private async Task<IEnumerable<EmployeeSearchResult>> SearchEmployeesAutocomplete(string query, CancellationToken token)
    {
        string currentQuery = _searchText ?? string.Empty;
        _lastSearchQuery = currentQuery;
        Console.WriteLine($"Autocomplete SearchFunc triggered. Bound text: '{currentQuery}', Param query: '{query}'");
        _searchError = null;

        if (string.IsNullOrWhiteSpace(currentQuery) &&
            string.IsNullOrWhiteSpace(selectedGender) &&
            string.IsNullOrWhiteSpace(selectedBloodGroup) &&
            string.IsNullOrWhiteSpace(selectedDesignation))
        {
            Console.WriteLine("No query or filters provided, returning empty results.");
            return Enumerable.Empty<EmployeeSearchResult>();
        }

        try
        {
            var queryParams = new List<string>();
            if (!string.IsNullOrWhiteSpace(currentQuery))
                queryParams.Add($"query={System.Net.WebUtility.UrlEncode(currentQuery)}");
            if (!string.IsNullOrWhiteSpace(selectedGender))
                queryParams.Add($"gender={System.Net.WebUtility.UrlEncode(selectedGender)}");
            if (!string.IsNullOrWhiteSpace(selectedBloodGroup))
                queryParams.Add($"bloodGroup={System.Net.WebUtility.UrlEncode(selectedBloodGroup)}");
            if (!string.IsNullOrWhiteSpace(selectedDesignation))
                queryParams.Add($"designation={System.Net.WebUtility.UrlEncode(selectedDesignation)}");

            var apiUrl = $"/api/search/spotlight?{string.Join("&", queryParams)}";
            Console.WriteLine($"Attempting API call to: {apiUrl}");
            var response = await Http.GetAsync(apiUrl, token);
            Console.WriteLine($"API call completed with status code: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var results = await response.Content.ReadFromJsonAsync<List<EmployeeSearchResult>>(token) ?? new List<EmployeeSearchResult>();
                Console.WriteLine($"Search successful: Found {results.Count} results");
                foreach (var r in results.Take(5)) { Console.WriteLine($" - Result: {r.Name}, Email: {r.Email}"); }
                if (results.Count > 5) { Console.WriteLine("..."); }

                _searchError = null;

                // Check if exactly 10 results were returned (backend limit)
                if (results.Count == 10)
                {
                    Console.WriteLine("Max results hit. Adding Analytics link.");
                    // Add a special item to link to the analytics page
                    results.Add(new EmployeeSearchResult 
                    {
                        Name = $"See analytics for '{currentQuery}'...", // Use currentQuery in the text
                        ProfileUrl = "/analytics", // Special URL to identify this item
                        // Other fields can be null/empty
                    });
                }

                return results;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _searchError = await response.Content.ReadAsStringAsync(token);
                Console.WriteLine($"Search BadRequest: {_searchError}");
            }
            else
            {
                _searchError = $"Error fetching search results: {response.ReasonPhrase} ({(int)response.StatusCode})";
                Console.WriteLine($"Search HTTP Error: {_searchError}");
            }
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine($"Search cancelled.");
            _searchError = null;
            return Enumerable.Empty<EmployeeSearchResult>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during search API call: {ex.Message}");
            _searchError = "An error occurred while searching.";
        }
        finally
        {
            Console.WriteLine("Autocomplete SearchFunc finished.");
        }

        return Enumerable.Empty<EmployeeSearchResult>();
    }

    private async Task OnEmployeeSelected(EmployeeSearchResult selectedEmployee)
    {
        if (selectedEmployee != null)
        {
            Console.WriteLine($"OnEmployeeSelected triggered for: {selectedEmployee.Name} ({selectedEmployee.ProfileUrl})");

            await NavigateToEmployeeInNewTab(selectedEmployee.ProfileUrl);

            _searchText = null;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("OnEmployeeSelected triggered with null employee.");
        }
    }

    private async Task NavigateToEmployeeInNewTab(string profileUrl)
    {
        if (!string.IsNullOrEmpty(profileUrl))
        {
            Console.WriteLine($"Attempting to navigate to {profileUrl} in new tab.");
            try
            {
                await JSRuntime.InvokeVoidAsync("open", profileUrl, "_blank");
                Console.WriteLine("JavaScript window.open called successfully.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error calling JavaScript open: {ex.Message}");
                _searchError = "Could not open employee profile.";
                StateHasChanged();
            }
        }
        else
        {
            Console.WriteLine("NavigateToEmployeeInNewTab called with empty or null URL.");
        }

        await SearchEmployeesAutocomplete(_searchText ?? string.Empty, CancellationToken.None);
        StateHasChanged();
    }

    private async Task OnFilterChanged(string filterType, string value)
    {
        if (filterType == "gender")
            selectedGender = value;
        else if (filterType == "bloodGroup")
            selectedBloodGroup = value;
        else if (filterType == "designation")
            selectedDesignation = value;

        Console.WriteLine($"Filter changed: {filterType} = {value}");
        StateHasChanged();

        await SearchEmployeesAutocomplete(_searchText ?? string.Empty, CancellationToken.None);
    }

    private void ToggleFilters()
    {
        _showFilters = !_showFilters;
    }

    private async Task LoadUserDetails()
    {
        try
        {
            var email = await JSRuntime.InvokeAsync<string>("sessionStorageHelper.getItem", "email");
            userProfilePicture = null;
            userName = null;
            userInitials = null;

            if (!string.IsNullOrWhiteSpace(email))
            {
                var employee = await EmployeeService.GetEmployeeDetailsByEmail(email);

                if (employee != null)
                {
                    if (!string.IsNullOrEmpty(employee.PhotoBase64Content) && !string.IsNullOrEmpty(employee.PhotoContentType))
                    {
                        userProfilePicture = $"data:{employee.PhotoContentType};base64,{employee.PhotoBase64Content}";
                    }
                    else
                    {
                        userName = employee.FirstName ?? "User";
                        userInitials = GetInitials(userName);
                        userProfilePicture = null;
                    }
                    return;
                }
            }

            if (!string.IsNullOrWhiteSpace(email))
            {
                userName = "User";
                userInitials = GetInitialFromEmail(email);
                userProfilePicture = null;
            }
            else
            {
                SetDefaultUser();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details: {ex.Message}");
            SetDefaultUser();
        }
    }

    private void SetDefaultUser()
    {
        userName = "Guest";
        userInitials = "?";
        userProfilePicture = null;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0].Length > 0 ? parts[0][0].ToString().ToUpper() : "?";

        return $"{parts[0][0]}{parts.Last()[0]}".ToUpper();
    }

    private string GetInitialFromEmail(string? email)
    {
        if (!string.IsNullOrWhiteSpace(email) && email.Length > 0)
            return char.ToUpper(email[0]).ToString();

        return "?";
    }

    private class UserResponse
    {
        public string Id { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public UserMetadata UserMetadata { get; set; } = new();
    }

    private class UserMetadata
    {
        public string ProfilePictureUrl { get; set; } = string.Empty;
    }

    public class EmployeeSearchResult
    {
        public string Name { get; set; } = string.Empty;
        public string Designation { get; set; } = string.Empty;
        public string ProfileUrl { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Mobile { get; set; }
        public string? ProfilePicture { get; set; }
        public string? EmployeeID { get; set; }
    }

    private string GetHighlightedHtml(string? text, string? highlightTerm)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(highlightTerm))
        {
            return text ?? string.Empty;
        }

        try
        {
            var regex = new Regex(Regex.Escape(highlightTerm), RegexOptions.IgnoreCase | RegexOptions.Compiled);
            return regex.Replace(text, match => $"<strong>{match.Value}</strong>");
        }
        catch (ArgumentException ex)
        {
            Console.WriteLine($"Regex error during highlighting: {ex.Message}");
            return text;
        }
    }
}