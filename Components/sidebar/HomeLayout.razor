@inherits LayoutComponentBase
@using WiseHR.Components.sidebar
@using WiseHR.Models
@using System.Net.Http.Json
@using System.Text.Json
@using WiseHR.Services
@using System.Net.Http.Headers
@using WiseHR.Dtos
@using WiseHRServer.Models
@using WiseHR.Components.Chat
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using System.Text.RegularExpressions
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager
@inject SearchService SearchService
@inject IDialogService DialogService
@inject AnalyticsCacheService AnalyticsCache
@inject ILogger<HomeLayout> Logger

<MudThemeProvider />
<MudSnackbarProvider />

<!-- Top Navigation Bar -->
<MudAppBar Elevation="5" Style="background: linear-gradient(90deg, #f8f9fa 0%, #e2e6ea 100%); height: 67px; color: var(--primary); padding-top:2px;padding-left:4px">
    <MudItem xs="2" Class="d-flex align-center">
        <MudImage Class="logo-hover" Src="images/logo1.png"
                  Alt="Company Logo"
                  Height="50"
                  @onclick=@(() => NavigationManager.NavigateTo("/home")) />
    </MudItem>
    <MudItem xs="8" Class="d-flex flex-column justify-center align-center">
        <div class="d-flex flex-column align-center position-relative" style="width: 75%; max-width: 800px;">
            <div class="d-flex align-center position-relative" style="width: 100%;">
                <MudAutocomplete T="EmployeeSearchResult"
                                 SearchFunc="@SearchEmployeesAutocomplete"
                                 Placeholder="Search employees..."
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary"
                                 Class="search-elevated analytics-link "
                                 Style="width: 100%;  font-size: 1.1rem; outline: none; border: none; box-shadow: none;"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="true"
                                 ShowProgressIndicator="true"
                                 ValueChanged="OnSearchItemSelected"
                                 @bind-Text="_searchText"
                                 ItemTemplate="@ResultTemplate"
                                 MaxItems="15"
                                 ToStringFunc="@(e => null)" />
                @if (IsAdmin)
                {
                    <MudTooltip Text="Go to Advanced Search">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Class="ml-2 filter-button"
                                       OnClick="@(() => NavigationManager.NavigateTo("/analytics"))"
                                       Style="border-radius: 50%;" />
                    </MudTooltip>
                }
            </div>

            @* Display error message if search fails *@
            @if (!string.IsNullOrEmpty(_searchError))
            {
                <MudText Typo="Typo.body1" Color="Color.Error" Class="mt-2 position-absolute" Style="top: 100%; left: 50%; transform: translateX(-50%); z-index: 1000; font-size: 1.1rem; font-weight: 500;">@_searchError</MudText>
            }
        </div>
    </MudItem>

    <MudItem xs="2" Style="padding: 8px;display: flex;justify-content: flex-end;">
        <MudMenu AnchorOrigin="Origin.BottomLeft">
            <ActivatorContent>
                <div class="d-flex align-center justify-end ">
                    @if (!string.IsNullOrEmpty(userProfilePicture))
                    {
                        <img src="@userProfilePicture"
                             class="border-hover-color-shift profile-bounce neon-glow " alt="Employee Photo"
                             style="width: 55px; height: 55px; object-fit: cover;" />
                    }
                    else
                    {
                        <MudAvatar Size="Size.Large"
                                   Class="cursor-pointer"
                                   Style="background-color: var(--secondary); color: var(--text-primary); border: 2px solid var(--primary);">
                            @userInitials
                        </MudAvatar>
                    }
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="px-2 py-3">
                    <MudText Typo="Typo.subtitle1" Class="px-4 mb-2">@(userName ?? "Guest")</MudText>
                    <MudDivider Class="mb-2" />
                    <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary" OnClick="NavigateToProfile">My Profile</MudMenuItem>
                    <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">Settings</MudMenuItem>
                    <MudDivider Class="my-2" />
                    <MudMenuItem Style="color: var(--error);" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="Logout">Logout</MudMenuItem>
                </div>
            </ChildContent>
        </MudMenu>
    </MudItem>
</MudAppBar>

<!-- Sidebar -->
<div class="sidebar-container">
    <HomeSidebar @ref="sidebar" @bind-DrawerOpen="drawerOpen" />
</div>

<!-- Main Content -->
<MudMainContent Style="@($"flex-grow: 1; margin-left: {(drawerOpen ? "260px" : "70px")}; transition: margin 0.3s ease; z-index = 1610")">
    <MudContainer Class="mt-6 mx-auto" MaxWidth="MaxWidth.ExtraLarge">
        @Body
    </MudContainer>
</MudMainContent>
<MudPopoverProvider />

<!-- Chat Widget -->
<div class="chat-widget-container">
    <WiseChatWidget />
</div>

