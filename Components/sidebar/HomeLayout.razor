@inherits LayoutComponentBase
@using WiseHR.Components.sidebar
@using WiseHR.Models
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager
@using WiseHR.Components.sidebar

<MudThemeProvider />
<MudLayout>

    <!-- Top Navigation Bar -->
    <MudAppBar Elevation="1" Style="background-color: var(--primary);">
        <MudItem xs="2" Class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@(() => sidebar?.ToggleDrawer())"
                           Class="mr-2" />

            <MudImage Src="images/logo1.png"
                      Alt="Company Logo"
                      Height="60"
                      Style="margin-left: 60px; color:white;" />
        </MudItem>

        <MudItem xs="8" Class="d-flex flex-column justify-center align-center">
            <div class="d-flex align-center position-relative" style="width: 60%;">
                <MudAutocomplete T="EmployeeSearchResult"
                                 SearchFunc="@SearchEmployeesAutocomplete"
                                 Placeholder="Search employees..."
                                 Variant="Variant.Filled"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary"
                                 Class="search-autocomplete"
                                 Style="width: 100%; border-radius: 28px; background-color: var(--secondary);"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="true"
                                 ShowProgressIndicator="true"
                                 ValueChanged="OnEmployeeSelected"
                                 @bind-Text="_searchText"
                                 @onkeyup="HandleSearchInputKeyUp"
                                 ItemTemplate="@ResultTemplate"
                                 ToStringFunc="@(e => null)" />

                <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                               Color="Color.Primary"
                               Class="ml-2 filter-button"
                               OnClick="@ToggleFilterDrawer"
                               Style="background-color: var(--secondary); border-radius: 50%;" />
            </div>

            <!-- Filter Drawer -->
            @if (filterDrawerOpen)
            {
                <MudPaper Elevation="2"
                          Class="filter-drawer pa-3"
                          Style="width: 360px; max-width: 100%; margin: 0 auto; border-radius: 8px; position: absolute; top: 65px; z-index: 1200;">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.h6">Filter Options</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@CloseFilterDrawer" />
                    </div>
                    <MudDivider Class="mb-3" />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudSelect T="string" Label="Gender" Variant="Variant.Outlined" Value="@selectedGender"
                                       ValueChanged="@(value => OnFilterChanged("gender", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-3" DisableUnderLine="false">
                                <MudSelectItem Value="@("All")">All Genders</MudSelectItem>
                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Blood Group" Variant="Variant.Outlined" Value="@selectedBloodGroup"
                                       ValueChanged="@(value => OnFilterChanged("bloodGroup", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-3">
                                <MudSelectItem Value="@("All")">All Blood Groups</MudSelectItem>
                                <MudSelectItem Value="@("A+")">A+</MudSelectItem>
                                <MudSelectItem Value="@("A-")">A-</MudSelectItem>
                                <MudSelectItem Value="@("B+")">B+</MudSelectItem>
                                <MudSelectItem Value="@("B-")">B-</MudSelectItem>
                                <MudSelectItem Value="@("AB+")">AB+</MudSelectItem>
                                <MudSelectItem Value="@("AB-")">AB-</MudSelectItem>
                                <MudSelectItem Value="@("O+")">O+</MudSelectItem>
                                <MudSelectItem Value="@("O-")">O-</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Designation" Variant="Variant.Outlined" Value="@selectedDesignation"
                                       ValueChanged="@(value => OnFilterChanged("designation", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-3">
                                <MudSelectItem Value="@("All")">All Designations</MudSelectItem>
                                @foreach (var designation in designations)
                                {
                                    <MudSelectItem Value="@designation">@designation</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-space-between">
                            <MudButton Variant="Variant.Filled" Color="Color.Error"
                                       OnClick="@ClearFilters"
                                       StartIcon="@Icons.Material.Filled.FilterAltOff">
                                Clear Filters
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @* Display error message if search fails *@
            @if (!string.IsNullOrEmpty(_searchError))
            {
                @* <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_searchError</MudText> *@
            }


        </MudItem>

        <MudItem xs="2" Style="padding: 8px;">
            <MudMenu>
                <ActivatorContent>
                    @if (!string.IsNullOrEmpty(userProfilePicture))
                    {
                        <img src="@userProfilePicture"
                             class="rounded-circle" alt="Employee Photo"
                             style="width: 50px; height: 50px; margin-left:180px; object-fit: cover; border: 2px solid var(--secondary);" />
                    }
                    else
                    {
                        <MudAvatar Size="Size.Medium"
                                   Class="cursor-pointer"
                                   Style="background-color: var(--secondary); color: var(--text-primary); margin-left: 180px; border: 2px solid var(--dark);">
                            @userInitials
                        </MudAvatar>
                    }
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Person" OnClick="NavigateToProfile">Profile</MudMenuItem>
                    <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Settings">Settings</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Style="color: var(--error);" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudItem>
    </MudAppBar>

    <!-- Sidebar -->
    <HomeSidebar @ref="sidebar" @bind-DrawerOpen="drawerOpen" />

    <!-- Main Content -->
    <MudMainContent Style="flex-grow: 1;">
        @* Display active filters *@
        @if (HasActiveFilters())
        {
            <div class="d-flex flex-wrap active-filters">
                @if (!string.IsNullOrEmpty(selectedGender))
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("gender"))"
                             Class="mr-1 mb-1">
                        Gender: @selectedGender
                    </MudChip>
                }
                @if (!string.IsNullOrEmpty(selectedBloodGroup))
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("bloodGroup"))"
                             Class="mr-1 mb-1">
                        Blood Group: @selectedBloodGroup
                    </MudChip>
                }
                @if (!string.IsNullOrEmpty(selectedDesignation))
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("designation"))"
                             Class="mr-1 mb-1">
                        Designation: @selectedDesignation
                    </MudChip>
                }
            </div>
        }
        <MudContainer Class="mt-6 mx-auto" MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

    <!-- Popover Support -->
    <MudPopoverProvider />

    @if (filterDrawerOpen)
    {
        <div class="filter-backdrop" @onclick="CloseFilterDrawer"></div>
    }

</MudLayout>

@code {
