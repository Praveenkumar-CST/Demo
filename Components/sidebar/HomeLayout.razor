@inherits LayoutComponentBase
@using WiseHR.Components.sidebar
@using WiseHR.Models
@using System.Net.Http.Json
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using System.Text.RegularExpressions
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager
@using WiseHR.Components.sidebar

<MudThemeProvider />
<MudSnackbarProvider />


    <!-- Top Navigation Bar -->
    <MudAppBar Elevation="3" Style="background: linear-gradient(90deg, #f8f9fa 0%, #e2e6ea 100%); height: 78px; color: var(--primary); padding-top:5px">
        <MudItem xs="2" Class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Primary"
                           Edge="Edge.Start"
                           OnClick="@(() => ToggleSidebar())"
                           Size="Size.Large"
                           Class="mr-2" />

            <MudImage Src="images/logo1.png"
                      Alt="Company Logo"
                      Height="64"
                      Style="margin-left: 16px;"/>
        </MudItem>

        <MudItem xs="8" Class="d-flex flex-column justify-center align-center">
            <div class="d-flex align-center position-relative" style="width: 75%; max-width: 850px;">
                <MudAutocomplete T="EmployeeSearchResult"
                                 SearchFunc="@SearchEmployeesAutocomplete"
                                 Placeholder="Search employees..."
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary"
                                 Class="search-autocomplete"
                                 Style="width: 100%; border-radius: 28px; font-size: 1.1rem;"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="true"
                                 ShowProgressIndicator="true"
                                 ValueChanged="OnEmployeeSelected"
                                 @bind-Text="_searchText"
                                 @onkeyup="HandleSearchInputKeyUp"
                                 ItemTemplate="@ResultTemplate"
                                 ToStringFunc="@(e => null)" />
                @if (IsAdmin)
                {
                    <MudTooltip Text="Go to Advanced Search">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Class="ml-2 filter-button"
                                       OnClick="@(() => NavigationManager.NavigateTo("/analytics"))"
                                       Style="border-radius: 50%;" />
                    </MudTooltip>
                }
            </div>

            @* Display error message if search fails *@
            @if (!string.IsNullOrEmpty(_searchError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_searchError</MudText>
            }
        </MudItem>

    <MudItem xs="2" Style="padding: 8px;display: flex;justify-content: flex-end;">
            <MudMenu AnchorOrigin="Origin.BottomLeft">
                <ActivatorContent>
                    <div class="d-flex align-center justify-end ">
                        @if (!string.IsNullOrEmpty(userProfilePicture))
                        {
                            <img src="@userProfilePicture"
                                 class="rounded-circle" alt="Employee Photo"
                                 style="width: 56px; height: 56px; object-fit: cover; border: 2px solid var(--primary);" />
                        }
                        else
                        {
                            <MudAvatar Size="Size.Large"
                                       Class="cursor-pointer"
                                       Style="background-color: var(--secondary); color: var(--text-primary); border: 2px solid var(--primary);">
                                @userInitials
                            </MudAvatar>
                        }
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-2 py-3">
                        <MudText Typo="Typo.subtitle1" Class="px-4 mb-2">@(userName ?? "Guest")</MudText>
                        <MudDivider Class="mb-2" />
                        <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary" OnClick="NavigateToProfile">My Profile</MudMenuItem>
                        <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">Settings</MudMenuItem>
                        <MudDivider Class="my-2" />
                        <MudMenuItem Style="color: var(--error);" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="Logout">Logout</MudMenuItem>
                    </div>
                </ChildContent>
            </MudMenu>
        </MudItem>
    </MudAppBar>

    <!-- Sidebar -->
     <div class="sidebar-container" @onmouseleave="HandleMouseLeave">
        <HomeSidebar @ref="sidebar" @bind-DrawerOpen="drawerOpen" />
    </div>
    <!-- Main Content -->
  
    <MudMainContent Style="@($"flex-grow: 1; margin-left: {(drawerOpen ? "260px" : "70px")}; transition: margin 0.3s ease;")">
        <MudContainer Class="mt-6 mx-auto" MaxWidth="MaxWidth.ExtraLarge"> 
            @Body
        </MudContainer>
    </MudMainContent>
  
    <!-- Popover Support -->
    <MudPopoverProvider />



<style>
    .mud-divider {
        margin: 0;
        flex-shrink: 0;
        border-color: rgb(22 21 21);
        border-width: 2px;
        border-style: solid none none none;
    }
    .search-autocomplete ::deep .mud-input {
        border-radius: 28px;
        transition: all 0.3s ease;
    }

        .search-autocomplete ::deep .mud-input:focus-within {
            box-shadow: 0 0 0 2px var(--primary-light);
        }

    .search-autocomplete ::deep .mud-input-adornment {
        color: var(--primary);
    }

    .active-filters {
        position: sticky;
        top: 72px;
        left: 0;
        z-index: 99;
        background-color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    /* Improved user menu styling */
    ::deep .mud-menu-list {
        border-radius: 12px;
        overflow: hidden;
        min-width: 200px;
    }

    ::deep .mud-list-item-icon {
        min-width: 40px;
    }

    @@media (max-width: 960px) {
        .active-filters {
            padding: 8px 12px;
        }
    }

    /* Sidebar container styles */
    .sidebar-container {
        position: fixed;
        top: 78px; /* Match the AppBar height */
        left: 0;
        height: calc(100vh - 78px);
        z-index: 1000;
        transition: all 0.3s ease;
    }

    /* Removed hover styles to prevent automatic opening on hover */
    
    ::deep .mud-drawer {
        transition: width 0.3s ease;
        width: 60px; /* Default collapsed width */
        overflow: hidden;
    }

        ::deep .mud-drawer.open {
            width: 250px !important; /* Expanded width */
        }

    ::deep .mud-nav-menu {
        opacity: 1;
        transition: opacity 0.3s ease;
    }

    ::deep .mud-nav-link span {
        display: none; /* Hide text when collapsed */
    }

    ::deep .mud-drawer.open .mud-nav-link span {
        display: inline; /* Show text when expanded */
    }
</style>

@code {
    private bool drawerOpen = false; // Start closed
    private HomeSidebar? sidebar;
    private string? userProfilePicture;
    private string? userName;
    private string? userInitials;
    private string? _searchError = null;
    private string _lastSearchQuery = string.Empty;
    private string? _searchText = null;
    private List<string> designations = new();
    private string? activeSearchQuery = "";
    private string? employeeId;
    private bool IsAdmin = false;

    private async Task ToggleSidebar()
    {
        drawerOpen = !drawerOpen;
        if (sidebar != null)
        {
            await sidebar.ToggleDrawer(); // Sync with sidebar component
        }
        StateHasChanged();
    }
    
    // Close sidebar when mouse leaves
    private async Task HandleMouseLeave()
    {
        if (drawerOpen)
        {
            drawerOpen = false;
            if (sidebar != null)
            {
                await sidebar.ToggleDrawer();
            }
            StateHasChanged();
        }
    }

    private async Task ClearSearchQuery()
    {
        activeSearchQuery = "";
        _searchText = "";
        await RefreshMainEmployeeListAsync();
        StateHasChanged();
    }

    private async Task HandleSearchInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Console.WriteLine($"Enter key pressed. Finalizing search for: '{_searchText}'");
            activeSearchQuery = _searchText ?? "";
            await RefreshMainEmployeeListAsync();
        }
    }

    private async Task Logout()
    {
        try
        {
            // Clear localStorage
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "email");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "empId");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "userRole");
            Console.WriteLine("Logged out successfully. LocalStorage cleared.");

            // Navigate to login page
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during logout: {ex.Message}");
            _searchError = "Error logging out. Please try again.";
            StateHasChanged();
        }
    }

