    };

    [Parameter]
    public EventCallback<string> OnSearchQueryChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDetails();
        await LoadDesignations();
    }

    private async Task LoadDesignations()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<string>>("/api/designations");
            designations = response ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading designations: {ex.Message}");
            designations = new List<string> { "Developer", "Project Manager", "Analyst" }; // Fallback
        }
    }

    private async Task<IEnumerable<EmployeeSearchResult>> SearchEmployeesAutocomplete(string query, CancellationToken token)
    {
        _lastSearchQuery = query;
        Console.WriteLine($"Autocomplete SearchFunc triggered with query: '{query}'");
        _searchError = null;

        if (string.IsNullOrWhiteSpace(query) &&
            string.IsNullOrWhiteSpace(selectedGender) &&
            string.IsNullOrWhiteSpace(selectedBloodGroup) &&
            string.IsNullOrWhiteSpace(selectedDesignation))
        {
            Console.WriteLine("No query or filters provided for autocomplete, returning empty results.");
            return Enumerable.Empty<EmployeeSearchResult>();
        }

        try
        {
            var queryParams = new List<string>();
            if (!string.IsNullOrWhiteSpace(query))
                queryParams.Add($"query={System.Net.WebUtility.UrlEncode(query)}");
            if (!string.IsNullOrWhiteSpace(selectedGender))
                queryParams.Add($"gender={System.Net.WebUtility.UrlEncode(selectedGender)}");
            if (!string.IsNullOrWhiteSpace(selectedBloodGroup))
                queryParams.Add($"bloodGroup={System.Net.WebUtility.UrlEncode(selectedBloodGroup)}");
            if (!string.IsNullOrWhiteSpace(selectedDesignation))
                queryParams.Add($"designation={System.Net.WebUtility.UrlEncode(selectedDesignation)}");

            var apiUrl = $"/api/search/spotlight?{string.Join("&", queryParams)}";
            Console.WriteLine($"Attempting Autocomplete API call to: {apiUrl}");
            var response = await Http.GetAsync(apiUrl, token);
            Console.WriteLine($"Autocomplete API call completed with status code: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
            {
                var results = await response.Content.ReadFromJsonAsync<List<EmployeeSearchResult>>(token) ?? new List<EmployeeSearchResult>();
                Console.WriteLine($"Autocomplete Search successful: Found {results.Count} results");
                _searchError = null;
                return results;
            }
            else
            {
                _searchError = $"Error fetching autocomplete results: {response.ReasonPhrase}";
                Console.WriteLine($"Autocomplete Search HTTP Error: {_searchError}");
            }
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine($"Autocomplete Search cancelled.");
            _searchError = null; // Clear error on cancellation
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during autocomplete search API call: {ex.Message}");
            _searchError = "An error occurred during autocomplete.";
        }
        finally
        {
            Console.WriteLine("Autocomplete SearchFunc finished.");
        }

        return Enumerable.Empty<EmployeeSearchResult>();
    }

    private async Task OnEmployeeSelected(EmployeeSearchResult selectedEmployee)
    {
        if (selectedEmployee != null)
        {
            Console.WriteLine($"OnEmployeeSelected triggered for: {selectedEmployee.Name} ({selectedEmployee.ProfileUrl})");
            await NavigateToEmployeeInNewTab(selectedEmployee.ProfileUrl);
        }
        else
        {
            Console.WriteLine("OnEmployeeSelected triggered with null employee.");
        }
    }

    private async Task NavigateToEmployeeInNewTab(string profileUrl)
    {
        if (!string.IsNullOrEmpty(profileUrl))
        {
            Console.WriteLine($"Attempting to navigate to {profileUrl} in new tab.");
            try
            {
                await JSRuntime.InvokeVoidAsync("open", profileUrl, "_blank");
                Console.WriteLine("JavaScript window.open called successfully.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error calling JavaScript open: {ex.Message}");
                _searchError = "Could not open employee profile.";
                StateHasChanged();
            }
        }
        else
        {
            Console.WriteLine("NavigateToEmployeeInNewTab called with empty or null URL.");
        }
    }

    private async void ToggleFilterDrawer()
    {
        filterDrawerOpen = !filterDrawerOpen;

        // Reset temporary drawer selections when opening
        if (filterDrawerOpen)
        {
            selectedGender = activeGenderFilter; // Sync drawer with active state
            selectedBloodGroup = activeBloodGroupFilter;
            selectedDesignation = activeDesignationFilter;
        }
        StateHasChanged(); // Update drawer UI
    }

    private void CloseFilterDrawer()
    {
        filterDrawerOpen = false;
        StateHasChanged();
    }

    private async Task ClearFilters()
    {
        // Clear both selected (drawer) and active (main list) filters
        selectedGender = null;
        selectedBloodGroup = null;
        selectedDesignation = null;
        activeGenderFilter = null;
        activeBloodGroupFilter = null;
        activeDesignationFilter = null;
        activeSearchQuery = "";
        _searchText = "";

        await RefreshMainEmployeeListAsync(); // Trigger main list update
        filterDrawerOpen = false; // Close drawer
        StateHasChanged(); // Update UI (chips, drawer controls)
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(activeGenderFilter) ||
               !string.IsNullOrEmpty(activeBloodGroupFilter) ||
               !string.IsNullOrEmpty(activeDesignationFilter) ||
               !string.IsNullOrEmpty(activeSearchQuery);
    }

    private async Task OnFilterChanged(string filterType, string value)
    {
        string? processedValue = (value == "All" || string.IsNullOrWhiteSpace(value)) ? null : value;

        // Update the temporary selection state for the drawer control
        if (filterType == "gender")
            selectedGender = processedValue;
        else if (filterType == "bloodGroup")
            selectedBloodGroup = processedValue;
        else if (filterType == "designation")
            selectedDesignation = processedValue;

        // Update the ACTIVE filter state
        if (filterType == "gender")
            activeGenderFilter = processedValue;
        else if (filterType == "bloodGroup")
            activeBloodGroupFilter = processedValue;
        else if (filterType == "designation")
            activeDesignationFilter = processedValue;

        Console.WriteLine($"Filter changed & applied: {filterType} = {processedValue ?? "null"}");
        await RefreshMainEmployeeListAsync(); // Trigger main list update immediately
        StateHasChanged(); // Update filter drawer controls UI
    }

    private async Task RemoveFilter(string filterType)
    {
        // Set both selected (drawer) and active (main list) to null
        if (filterType == "gender")
        {
            selectedGender = null;
            activeGenderFilter = null;
        }
        else if (filterType == "bloodGroup")
        {
            selectedBloodGroup = null;
            activeBloodGroupFilter = null;
        }
        else if (filterType == "designation")
        {
            selectedDesignation = null;
            activeDesignationFilter = null;
        }

        await RefreshMainEmployeeListAsync(); // Trigger main list update
        StateHasChanged(); // Update UI (chips)
    }

    private async Task RefreshMainEmployeeListAsync()
    {
        Console.WriteLine($"Refreshing main content with Query: '{activeSearchQuery}', Gender: '{activeGenderFilter ?? "N/A"}', Blood: '{activeBloodGroupFilter ?? "N/A"}', Designation: '{activeDesignationFilter ?? "N/A"}'");
        await Task.CompletedTask; // Placeholder
        StateHasChanged(); // Ensure UI reflects changes (like active filter chips)
    }

    private async Task<string?> CurrentUserEmail()
    {
        try
        {
            return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "email");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error retrieving email from localStorage: {ex.Message}");
            return null;
        }
    }

    private async Task NavigateToProfile()
    {
        Console.WriteLine($"Navigate to current user profile, employeeId: {employeeId}");
        if (!string.IsNullOrEmpty(employeeId))
        {
            NavigationManager.NavigateTo($"/employee/{employeeId}");
        }
        else
        {
            Console.WriteLine("Cannot navigate to profile: employeeId is null or empty.");
            _searchError = "Unable to load profile. Please try logging in again.";
            StateHasChanged();
        }
    }

    private async Task LoadUserDetails()
    {
        try
        {
            // Retrieve email from localStorage
            var email = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "email");
            Console.WriteLine($"Retrieved email from localStorage: {email}");

            // Initialize defaults
            userProfilePicture = null;
            userName = null;
            userInitials = null;
            employeeId = null;

            // Try to retrieve employeeId from localStorage
            employeeId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "empId");
            Console.WriteLine($"Retrieved employeeId from localStorage: {employeeId}");

            if (!string.IsNullOrWhiteSpace(email))
            {
                var employee = await EmployeeService.GetEmployeeDetailsByEmail(email);
                if (employee != null)
                {
                    // Set employeeId from API if not already set from localStorage
                    employeeId ??= employee.EmployeeID;
                    Console.WriteLine($"EmployeeID from API: {employee.EmployeeID}");
					Console.WriteLine($"Employee ID {employeeId}");

					// Set profile picture if available
                    if (!string.IsNullOrEmpty(employee.PhotoBase64Content) && !string.IsNullOrEmpty(employee.PhotoContentType))
                    {
                        userProfilePicture = $"data:{employee.PhotoContentType};base64,{employee.PhotoBase64Content}";
                    }
                    else
                    {
                        userProfilePicture = null;
                    }

                    // Set user name and initials
                    userName = employee.FirstName ?? "User";
                    userInitials = GetInitials(userName);
                    return;
                }
            }

            // Fallback if employee not found but email exists
            if (!string.IsNullOrWhiteSpace(email))
            {
                userName = "User";
                userInitials = GetInitialFromEmail(email);
                userProfilePicture = null;
            }
            else
            {
                SetDefaultUser();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details: {ex.Message}");
            SetDefaultUser();
        }
    }

    private void SetDefaultUser()
    {
        userName = "Guest";
        userInitials = "?";
        userProfilePicture = null;
        employeeId = null;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0].Length > 0 ? parts[0][0].ToString().ToUpper() : "?";

        return $"{parts[0][0]}{parts.Last()[0]}".ToUpper();
    }

    private string GetInitialFromEmail(string? email)
    {
        if (!string.IsNullOrWhiteSpace(email) && email.Length > 0)
            return char.ToUpper(email[0]).ToString();

        return "?";
    }

    private string GetHighlightedHtml(string? text, string? highlightTerm)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(highlightTerm))
        {
            return text ?? string.Empty;
        }

        try
        {
            var regex = new Regex(Regex.Escape(highlightTerm), RegexOptions.IgnoreCase | RegexOptions.Compiled);
            return regex.Replace(text, match => $"<strong>{match.Value}</strong>");
        }
        catch (ArgumentException ex)
        {
            Console.WriteLine($"Regex error during highlighting: {ex.Message}");
            return text;
        }
    }

