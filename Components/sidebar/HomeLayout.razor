@inherits LayoutComponentBase
@using WiseHR.Components.sidebar
@using WiseHR.Models
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager
@using WiseHR.Components.sidebar

<MudThemeProvider />
<MudLayout>
    <!-- Top Navigation Bar -->
    <MudAppBar Elevation="3" Style="background-color: var(--primary); height: 72px;">
        <MudItem xs="2" Class="d-flex align-center">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="@(() => sidebar?.ToggleDrawer())"
                           Class="mr-2" />

            <MudImage Src="images/logo1.png"
                      Alt="Company Logo"
                      Height="48"
                      Style="margin-left: 16px; color:white;" />
        </MudItem>

        <MudItem xs="8" Class="d-flex flex-column justify-center align-center">
            <div class="d-flex align-center position-relative" style="width: 70%; max-width: 800px;">
                <MudAutocomplete T="EmployeeSearchResult"
                                 SearchFunc="@SearchEmployeesAutocomplete"
                                 Placeholder="Search employees..."
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 AdornmentColor="Color.Primary"
                                 Class="search-autocomplete"
                                 Style="width: 100%; border-radius: 28px; background-color: var(--secondary);"
                                 DebounceInterval="300"
                                 ResetValueOnEmptyText="true"
                                 ShowProgressIndicator="true"
                                 ValueChanged="OnEmployeeSelected"
                                 @bind-Text="_searchText"
                                 @onkeyup="HandleSearchInputKeyUp"
                                 ItemTemplate="@ResultTemplate"
                                 ToStringFunc="@(e => null)" />

                <MudTooltip Text="Filter Options">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                   Color="Color.Primary"
                                   Class="ml-2 filter-button"
                                   OnClick="@ToggleFilterDrawer"
                                   Style="background-color: var(--secondary); border-radius: 50%;" />
                </MudTooltip>
            </div>

            <!-- Filter Drawer -->
            @if (filterDrawerOpen)
            {
                <MudPaper Elevation="4"
                          Class="filter-drawer pa-4"
                          Style="width: 360px; max-width: 100%; margin: 0 auto; border-radius: 12px; position: absolute; top: 65px; z-index: 1200;">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.h6" Style="font-weight: 500;">Filter Options</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@CloseFilterDrawer" />
                    </div>
                    <MudDivider Class="mb-4" />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudSelect T="string" Label="Gender" Variant="Variant.Outlined" Value="@selectedGender"
                                       ValueChanged="@(value => OnFilterChanged("gender", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-4" DisableUnderLine="false"
                                       Style="border-radius: 8px;">
                                <MudSelectItem Value="@("All")">All Genders</MudSelectItem>
                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Blood Group" Variant="Variant.Outlined" Value="@selectedBloodGroup"
                                       ValueChanged="@(value => OnFilterChanged("bloodGroup", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-4"
                                       Style="border-radius: 8px;">
                                <MudSelectItem Value="@("All")">All Blood Groups</MudSelectItem>
                                <MudSelectItem Value="@("A+")">A+</MudSelectItem>
                                <MudSelectItem Value="@("A-")">A-</MudSelectItem>
                                <MudSelectItem Value="@("B+")">B+</MudSelectItem>
                                <MudSelectItem Value="@("B-")">B-</MudSelectItem>
                                <MudSelectItem Value="@("AB+")">AB+</MudSelectItem>
                                <MudSelectItem Value="@("AB-")">AB-</MudSelectItem>
                                <MudSelectItem Value="@("O+")">O+</MudSelectItem>
                                <MudSelectItem Value="@("O-")">O-</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Designation" Variant="Variant.Outlined" Value="@selectedDesignation"
                                       ValueChanged="@(value => OnFilterChanged("designation", value))"
                                       FullWidth="true" Margin="Margin.Dense" Class="mb-4"
                                       Style="border-radius: 8px;">
                                <MudSelectItem Value="@("All")">All Designations</MudSelectItem>
                                @foreach (var designation in designations)
                                {
                                    <MudSelectItem Value="@designation">@designation</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-space-between">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="@ClearFilters"
                                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                                       Class="px-4">
                                Clear Filters
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@CloseFilterDrawer"
                                       StartIcon="@Icons.Material.Filled.Check"
                                       Class="px-4">
                                Apply
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @* Display error message if search fails *@
            @if (!string.IsNullOrEmpty(_searchError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_searchError</MudText>
            }
        </MudItem>

        <MudItem xs="2" Style="padding: 8px;">
            <MudMenu AnchorOrigin="Origin.BottomRight">
                <ActivatorContent>
                    <div class="d-flex align-center justify-end pr-4">
                        @if (!string.IsNullOrEmpty(userProfilePicture))
                        {
                            <img src="@userProfilePicture"
                                 class="rounded-circle" alt="Employee Photo"
                                 style="width: 48px; height: 48px; object-fit: cover; border: 2px solid var(--secondary);" />
                        }
                        else
                        {
                            <MudAvatar Size="Size.Medium"
                                       Class="cursor-pointer"
                                       Style="background-color: var(--secondary); color: var(--text-primary); border: 2px solid var(--dark);">
                                @userInitials
                            </MudAvatar>
                        }
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-2 py-3">
                        <MudText Typo="Typo.subtitle1" Class="px-4 mb-2">@(userName ?? "Guest")</MudText>
                        <MudDivider Class="mb-2" />
                        <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Person" IconColor="Color.Primary" OnClick="NavigateToProfile">My Profile</MudMenuItem>
                        <MudMenuItem Style="color: var(--text-primary);" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Primary">Settings</MudMenuItem>
                        <MudDivider Class="my-2" />
                        <MudMenuItem Style="color: var(--error);" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">Logout</MudMenuItem>
                    </div>
                </ChildContent>
            </MudMenu>
        </MudItem>
    </MudAppBar>

    <!-- Sidebar -->
    <HomeSidebar @ref="sidebar" @bind-DrawerOpen="drawerOpen" />

    <!-- Main Content -->
    <MudMainContent Style="flex-grow: 1;">
        @* Display active filters *@
        @if (HasActiveFilters())
        {
            <div class="d-flex flex-wrap active-filters pa-3">
                <MudText Typo="Typo.body2" Class="mr-3 d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" Class="mr-1" />
                    Active Filters:
                </MudText>

                @if (!string.IsNullOrEmpty(activeGenderFilter))
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("gender"))"
                             Class="mr-2 mb-1">
                        Gender: @activeGenderFilter
                    </MudChip>
                }
                @if (!string.IsNullOrEmpty(activeBloodGroupFilter))
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("bloodGroup"))"
                             Class="mr-2 mb-1">
                        Blood Group: @activeBloodGroupFilter
                    </MudChip>
                }
                @if (!string.IsNullOrEmpty(activeDesignationFilter))
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             OnClose="@(() => RemoveFilter("designation"))"
                             Class="mr-2 mb-1">
                        Designation: @activeDesignationFilter
                    </MudChip>
                }

                @if (!string.IsNullOrEmpty(activeSearchQuery))
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             OnClose="@(() => ClearSearchQuery())"
                             Class="mr-2 mb-1">
                        Search: @activeSearchQuery
                    </MudChip>
                }

                <MudTooltip Text="Clear All Filters">
                    <MudIconButton Size="Size.Small"
                                   OnClick="ClearFilters"
                                   Icon="@Icons.Material.Filled.ClearAll"
                                   Color="Color.Error"
                                   Class="ml-auto" />
                </MudTooltip>
            </div>
        }

        <MudContainer Class="mt-6 mx-auto" MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

    <!-- Popover Support -->
    <MudPopoverProvider />

    @if (filterDrawerOpen)
    {
        <div class="filter-backdrop" @onclick="CloseFilterDrawer"></div>
    }

</MudLayout>

<style>
    .search-autocomplete ::deep .mud-input {
        border-radius: 28px;
        transition: all 0.3s ease;
    }

        .search-autocomplete ::deep .mud-input:focus-within {
            box-shadow: 0 0 0 2px var(--primary-light);
        }

    .search-autocomplete ::deep .mud-input-adornment {
        color: var(--primary);
    }

    .active-filters {
        position: sticky;
        top: 72px;
        left: 0;
        z-index: 99;
        background-color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-drawer {
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        z-index: 1300;
    }

    .filter-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0,0,0,0.2);
        z-index: 1100;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* Improved select styles */
    ::deep .mud-select {
        transition: all 0.2s ease;
    }

        ::deep .mud-select:focus-within {
            border-color: var(--primary);
        }

    /* Improved user menu styling */
    ::deep .mud-menu-list {
        border-radius: 12px;
        overflow: hidden;
        min-width: 200px;
    }

    ::deep .mud-list-item-icon {
        min-width: 40px;
    }

    @@media (max-width: 960px) {
        .active-filters {
            padding: 8px 12px;
        }
    }
</style>

@code {
    private bool drawerOpen = true;
    private bool filterDrawerOpen = false;
    private HomeSidebar? sidebar;
    private string? userProfilePicture;
    private string? userName;
    private string? userInitials;
    private string? _searchError = null;
    private string _lastSearchQuery = string.Empty;
    private string? _searchText = null;
    private string? selectedGender = null;
    private string? selectedBloodGroup = null;
    private string? selectedDesignation = null;
    private List<string> designations = new();

    // Active State Variables
    private string activeSearchQuery = "";
    private string? activeGenderFilter = null;
    private string? activeBloodGroupFilter = null;
    private string? activeDesignationFilter = null;
    private string? employeeId; // Moved to field for accessibility

    // Clear search query method
    private async Task ClearSearchQuery()
    {
        activeSearchQuery = "";
        _searchText = "";
        await RefreshMainEmployeeListAsync();
        StateHasChanged();
    }

    private async Task HandleSearchInputKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Console.WriteLine($"Enter key pressed. Finalizing search for: '{_searchText}'");
            activeSearchQuery = _searchText ?? ""; // Update active query
            await RefreshMainEmployeeListAsync();    // Trigger main list refresh
        }
    }

