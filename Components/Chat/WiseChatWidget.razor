@code {
    // Connection and State
    private bool isOpen = false;
    private bool isConnected = false;
    private bool isTyping = false;
    private bool isSending = false;
    private int unreadCount = 0;
    private string statusMessage = string.Empty;
    private string currentSessionId = Guid.NewGuid().ToString();

    // Messages
    private List<ChatMessage> messages = new();
    private string currentMessage = string.Empty;

    // UI References
    private ElementReference messagesContainer;
    private ElementReference inputRef;

    // Data Models
    private string? EmployeeId { get; set; }
    private string? DisplayName { get; set; }

    public class ChatSession
    {
        public string SessionId { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public DateTime LastActivityAt { get; set; }
        public List<ChatMessage> Messages { get; set; } = new();
    }

    public class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsFromUser { get; set; }
        public DateTime Timestamp { get; set; }
        public MessageStatus Status { get; set; } = MessageStatus.Sent;
        public string SessionId { get; set; } = string.Empty;
        public bool IsTable { get; set; } = false;
    }

    public enum MessageStatus
    {
        Sending,
        Sent,
        Read,
        Failed
    }

    // Add state for chat history
    private List<ChatSession> chatSessions = new();
    private bool showHistory = false;

    protected override async Task OnInitializedAsync()
    {
        // Load user details internally, similar to HomeDashboard
        await LoadUserDetails();

        // Load existing session if available
        var savedSession = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "currentChatSession");
        if (!string.IsNullOrEmpty(savedSession))
        {
            currentSessionId = savedSession;
        }

        // Load chat history
        var savedHistory = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "chatHistory");
        if (!string.IsNullOrEmpty(savedHistory))
        {
            try
            {
                chatSessions = System.Text.Json.JsonSerializer.Deserialize<List<ChatSession>>(savedHistory) ?? new List<ChatSession>();
                // After loading history, try to set the current session to the one loaded from localStorage
                var initialSession = chatSessions.FirstOrDefault(s => s.SessionId == currentSessionId);
                if (initialSession != null)
                {
                    messages = initialSession.Messages;
                }
            }
            catch
            {
                chatSessions = new List<ChatSession>();
            }
        }

        ChatService.OnChunkReceived += HandleChunkReceived;
        ChatService.OnStatusReceived += HandleStatusReceived;
        ChatService.OnConnectionStateChanged += HandleConnectionStateChanged;
        
        await ChatService.InitializeAsync();
    }

    private async void HandleChunkReceived(string chunk)
    {
        if (messages.Count > 0 && !messages.Last().IsFromUser)
        {
            messages.Last().Content += chunk;
            // Check if the cumulative content now contains table data
            messages.Last().IsTable = IsContentTable(messages.Last().Content);
        }
        else
        {
            messages.Add(new ChatMessage
            {
                Content = chunk,
                IsFromUser = false,
                Timestamp = DateTime.Now,
                Status = MessageStatus.Read,
                SessionId = currentSessionId,
                IsTable = IsContentTable(chunk) // Check for table content on initial chunk
            });
        }
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    private async void HandleStatusReceived(string status)
    {
        statusMessage = status;
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }

    private async void HandleConnectionStateChanged()
    {
        isConnected = ChatService.IsConnected;
        statusMessage = isConnected ? string.Empty : "Connecting...";
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleChat()
    {
        isOpen = !isOpen;
        
        if (isOpen)
        {
            unreadCount = 0;
            await Task.Delay(100);
            await ScrollToBottom();
        }
    }

    private void MinimizeChat()
    {
        isOpen = false;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || !ChatService.IsConnected || isSending)
            return;

        isSending = true;
        var messageContent = currentMessage.Trim();
        currentMessage = string.Empty;

        var chatMessage = new ChatMessage
        {
            Content = messageContent,
            IsFromUser = true,
            Timestamp = DateTime.Now,
            Status = MessageStatus.Sending,
            SessionId = currentSessionId
        };
        
        messages.Add(chatMessage);
        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        try
        {
            // Use the DisplayName parameter here
            await ChatService.SendQueryAsync(DisplayName ?? "User", messageContent, EmployeeId, currentSessionId);
            chatMessage.Status = MessageStatus.Sent;
        }
        catch (Exception ex)
        {
            chatMessage.Status = MessageStatus.Failed;
            statusMessage = "Failed to send message. Please try again.";
            Console.WriteLine($"Failed to send message: {ex.Message}");
        }
        finally
        {
            isSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (e.ShiftKey)
            {
                // Insert a new line
                var currentPosition = await JSRuntime.InvokeAsync<int>("getCursorPosition", inputRef);
                currentMessage = currentMessage.Insert(currentPosition, "\n");
                StateHasChanged();
            }
            else
            {
                // Send message
                await SendMessage();
            }
        }
    }

    private async Task OnInputFocus()
    {
        await Task.Delay(100);
        await ScrollToBottom();
    }

    private async Task OnInputBlur()
    {
        // No typing indicator needed for now
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await InvokeAsync(async () => 
            {
                await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
            });
        }
        catch
        {
            // Ignore JS interop errors
        }
    }

    private string FormatGeneralMessageContent(string content)
    {
        if (string.IsNullOrEmpty(content))
            return content;

        // First, normalize line endings and trim
        content = content.Replace("\r\n", "\n").Trim();

        // Handle bold text (text between **) - this should be done first to protect these asterisks
        var boldPattern = @"\*\*(.*?)\*\*";
        var formattedContent = Regex.Replace(content, boldPattern, "<strong>$1</strong>");

        // Now split into lines and process each line
        var lines = formattedContent.Split('\n');
        var formattedLines = new List<string>();
        var inBulletList = false;

        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line))
            {
                if (inBulletList)
                {
                    formattedLines.Add("</div>"); // Close previous bullet list
                    inBulletList = false;
                }
                formattedLines.Add("<div class='wisechat-spacing'></div>");
                continue;
            }

            var trimmedLine = line.TrimStart(); // Trim leading spaces for bullet detection
            bool isBulletLine = trimmedLine.StartsWith("-") || trimmedLine.StartsWith("*");

            if (isBulletLine)
            {
                // Remove the leading bullet marker (e.g., "* " or "- ") from the first part of the line.
                // Then, split by " * " to handle multiple logical bullet points on the same physical line.
                string initialCleanedLine = trimmedLine.Substring(1).TrimStart();
                var subBulletParts = Regex.Split(initialCleanedLine, @" \* ").Where(s => !string.IsNullOrWhiteSpace(s)).ToList();

                foreach (var part in subBulletParts)
                {
                    if (!inBulletList)
                    {
                        formattedLines.Add("<div class='wisechat-bullet-list'>");
                        inBulletList = true;
                    }

                    // Remove any trailing single asterisk (e.g., from "item. *")
                    string cleanedPart = part.TrimEnd(' ', '*'); // Use TrimEnd for robustness

                    var isNested = line.StartsWith("    "); // Check original line for indentation
                    var bulletClass = isNested ? "wisechat-nested-bullet" : "wisechat-bullet";
                    formattedLines.Add($"<div class='{bulletClass}'><span class='bullet'>•</span><span class='bullet-content'>{cleanedPart}</span></div>");
                }
            }
            // Handle numbered lists
            else if (Regex.IsMatch(trimmedLine, @"^\d+\."))
            {
                if (inBulletList)
                {
                    formattedLines.Add("</div>");
                    inBulletList = false;
                }
                string numberedContent = trimmedLine; // Keep original numbered list format
                // Remove any trailing single asterisk from numbered lists too (e.g., "1. item. *")
                numberedContent = numberedContent.TrimEnd(' ', '*'); // Use TrimEnd for robustness
                formattedLines.Add($"<div class='wisechat-numbered-point'>{numberedContent}</div>");
            }
            // Regular text - remove any remaining standalone asterisks not part of bold or bulleting
            else
            {
                if (inBulletList)
                {
                    formattedLines.Add("</div>");
                    inBulletList = false;
                }
                // Remove any trailing single asterisk from regular text lines (e.g., "guidelines: *")
                string cleanLine = line.TrimEnd(' ', '*'); // Use TrimEnd for robustness
                formattedLines.Add($"<div class='wisechat-text-line'>{cleanLine}</div>");
            }
        }

        // Close any open bullet list
        if (inBulletList)
        {
            formattedLines.Add("</div>");
        }

        return string.Join("", formattedLines);
    }

    // New method for formatting table content
    private string FormatTableContent(string content)
    {
        var lines = content.Split('\n');
        var assets = new List<Dictionary<string, string>>();
        var currentAsset = new Dictionary<string, string>();
        var instances = new List<string>();

        foreach (var line in lines)
        {
            var trimmedLine = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmedLine)) continue;

            if (trimmedLine.StartsWith("Successfully executed"))
            {
                continue;
            }
            else if (trimmedLine.Contains("Asset Tag Prefix:"))
            {
                if (currentAsset.Count > 0)
                {
                    currentAsset["Instances"] = string.Join("<br>", instances);
                    assets.Add(currentAsset);
                    instances.Clear();
                }
                currentAsset = new Dictionary<string, string>();
                var parts = trimmedLine.Split(':');
                currentAsset["Asset Type"] = parts[0].Trim();
                currentAsset["Tag Prefix"] = parts[1].Trim();
            }
            else if (trimmedLine.Contains("Total Instances:"))
            {
                var parts = trimmedLine.Split(':');
                currentAsset["Total Instances"] = parts[1].Trim();
            }
            else if (trimmedLine.StartsWith("•"))
            {
                instances.Add(trimmedLine.Substring(1).Trim());
            }
        }

        // Add the last asset
        if (currentAsset.Count > 0)
        {
            currentAsset["Instances"] = string.Join("<br>", instances);
            assets.Add(currentAsset);
        }

        var tableHtml = new StringBuilder();
        tableHtml.Append("<div class='wisechat-asset-table-container'>");
        tableHtml.Append("<table class='wisechat-table'>");
        tableHtml.Append("<thead><tr>");
        tableHtml.Append("<th>Asset Type</th>");
        tableHtml.Append("<th>Tag Prefix</th>");
        tableHtml.Append("<th>Total Instances</th>");
        tableHtml.Append("<th>Instances</th>");
        tableHtml.Append("</tr></thead><tbody>");

        foreach (var asset in assets)
        {
            tableHtml.Append("<tr>");
            tableHtml.Append($"<td>{asset["Asset Type"]}</td>");
            tableHtml.Append($"<td>{asset["Tag Prefix"]}</td>");
            tableHtml.Append($"<td>{asset["Total Instances"]}</td>");
            tableHtml.Append($"<td>{asset["Instances"]}</td>");
            tableHtml.Append("</tr>");
        }

        tableHtml.Append("</tbody></table></div>");
        return tableHtml.ToString();
    }

    private bool IsContentTable(string content)
    {
        // Using previous detection logic
        return content.Contains("Successfully executed get_assets") || 
               (content.Contains("Asset Tag Prefix:") && content.Contains("Total Instances:"));
    }

    private async Task LoadUserDetails()
    {
        try
        {
            // Use AuthService to verify token and get any available context
            var (role, authError) = await AuthService.VerifyToken();
            
            var email = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "email");

            if (!string.IsNullOrWhiteSpace(email))
            {
                var employee = await EmployeeService.GetEmployeeDetailsByEmail(email);

                if (employee != null)
                {
                    if (!string.IsNullOrWhiteSpace(employee.FirstName))
                    {
                        DisplayName = employee.FirstName; // Use FirstName as DisplayName
                    }
                    else
                    {
                        DisplayName = GetInitialFromEmail(email); // Fallback to email initial
                    }
                    EmployeeId = employee.EmployeeID; // Set the EmployeeId here
                }
                else
                {
                    DisplayName = GetInitialFromEmail(email); // Fallback to email initial
                    EmployeeId = null; // Ensure it's null if employee not found
                }
            }
            else
            {
                DisplayName = "Guest";
                EmployeeId = null; // Ensure it's null if email is not found
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details for chat widget: {ex.Message}");
            DisplayName = "Guest";
            EmployeeId = null; // Ensure it's null on error
        }
    }

    private string GetInitialFromEmail(string email)
    {
        return !string.IsNullOrWhiteSpace(email) ? email.Substring(0, 1).ToUpper() : "G";
