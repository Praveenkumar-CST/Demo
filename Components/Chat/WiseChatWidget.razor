    private async Task SwitchToSession(string sessionId)
    {
        var session = chatSessions.FirstOrDefault(s => s.SessionId == sessionId);
        if (session != null)
        {
            currentSessionId = sessionId;
            messages = session.Messages;
            showHistory = false;
            await ScrollToBottom();
            StateHasChanged();
        }
    }

    private async Task StartNewChat()
    {
        // Save current session if it has messages
        if (messages.Any())
        {
            var currentSession = chatSessions.FirstOrDefault(s => s.SessionId == currentSessionId);
            if (currentSession == null)
            {
                currentSession = new ChatSession
                {
                    SessionId = currentSessionId,
                    Title = messages.FirstOrDefault()?.Content ?? "New Chat",
                    CreatedAt = DateTime.Now,
                    LastActivityAt = DateTime.Now,
                    Messages = new List<ChatMessage>(messages)
                };
                chatSessions.Add(currentSession);
            }
            else
            {
                currentSession.Messages = new List<ChatMessage>(messages);
                currentSession.LastActivityAt = DateTime.Now;
            }
            await SaveChatHistory();
        }

        // Generate a new session ID
        currentSessionId = Guid.NewGuid().ToString();
        // Save new session ID
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "currentChatSession", currentSessionId);
        
        messages.Clear();
        currentMessage = string.Empty;
        statusMessage = string.Empty;
        isTyping = false;
        StateHasChanged();
    }

    private async Task SaveChatHistory()
    {
        var historyJson = System.Text.Json.JsonSerializer.Serialize(chatSessions);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chatHistory", historyJson);
    }

    public async ValueTask DisposeAsync()
    {
        ChatService.OnChunkReceived -= HandleChunkReceived;
        ChatService.OnStatusReceived -= HandleStatusReceived;
        ChatService.OnConnectionStateChanged -= HandleConnectionStateChanged;
        await ChatService.DisposeAsync();
    }
}