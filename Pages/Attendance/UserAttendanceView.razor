@page "/UserAttendanceView"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject WiseHR.Services.AuthService AuthService
@inject IJSRuntime JSRuntime
@layout HomeLayout
@using FingerFrontend.Models

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

<!-- Error Message -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message">
        <p>Error: @errorMessage</p>
        <button @onclick="ClearError" class="action-button secondary-button">Clear</button>
    </div>
}

<!-- Success Message -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="success-message">
        <p>@successMessage</p>
        <button @onclick="ClearSuccess" class="action-button secondary-button">Clear</button>
    </div>
}

<!-- Success Pop-up -->
@if (showSuccessPopup)
{
    <div class="success-popup">
        <i class="fas fa-check-circle"></i>
        <p>@successPopupMessage</p>
    </div>
}

<!-- Modal for absence reason -->
@if (showModal && absencePeriod != null)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                Reason for Absence (@absencePeriod.StartTime.ToString("dd MMM yyyy hh:mm:ss tt") - @absencePeriod.EndTime.ToString("hh:mm:ss tt"))
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(absencePeriod.Reason))
                {
                    <div class="reason-display">
                        Reason: @absencePeriod.Reason
                    </div>
                }
                <textarea @bind="reasonInput" placeholder="Enter reason for absence" disabled="@(!string.IsNullOrEmpty(absencePeriod.Reason))"></textarea>
            </div>
            <div class="modal-footer">
                <button @onclick="CloseModal" class="action-button secondary-button">Cancel</button>
                <button @onclick="SubmitReason" class="action-button primary-button" disabled="@(!string.IsNullOrEmpty(absencePeriod.Reason))">Submit</button>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
    </div>
}
else if (!attendanceMonths.Any())
{
    <p style="text-align: center; color: #1e293b; font-size: 16px;">No records found.</p>
}
else
{
    <!-- Header with month navigation -->
    <div class="header-actions">
        <div class="date-nav">
            <button @onclick="PreviousMonth" class="nav-button">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <span style="font-size: 18px; font-weight: 500; color: #1e293b;">
                @currentMonth.ToString("MMMM yyyy")
            </span>
            <button @onclick="NextMonth" class="nav-button">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
        <div>
            <a href="/UserAbsenceReasons" class="request"> Reasons </a>
        </div>
    </div>

    <!-- Attendance table -->
    @foreach (var month in attendanceMonths.Where(m => m.Month.Year == currentMonth.Year && m.Month.Month == currentMonth.Month))
    {
        <div class="attendance-container">
            <!-- Table Header -->
            <div class="table-header">
                <div>Date</div>
                <div>Clock In</div>
                <div style="text-align: center;">Timeline</div>
                <div style="text-align: right;">Clock Out</div>
                <div style="text-align: right;">Total Hours</div>
            </div>
            @foreach (var day in month.Days.Where(d => d.Date.Date <= DateTime.Now.Date))
            {
                <div class="day-row @(day.IsWeeklyOff ? "week-off" : "")">
                    <!-- Date column -->
                    <div>
                        <div class="date-display">@day.Date.Day.ToString("00")</div>
                        <div class="weekday-display">@day.Date.ToString("ddd")</div>
                    </div>

                    <!-- Check-in time -->
                    <div style="font-size: 14px; color: #1e293b;">
                        @(day.Sessions.Any() ? day.Sessions.First().ClockIn.ToString("hh:mm:ss tt") : (day.IsWeeklyOff ? "Weekly Off" : "—"))
                    </div>

                    <!-- Timeline -->
                    <div style="position: relative; height: 24px;">
                        <!-- Background line -->
                        <div style="position: absolute; top: 50%; left: 0; right: 0; height: 2px; background-color: #e2e8f0; transform: translateY(-50%);"></div>

                        @if (day.IsWeeklyOff)
                        {
                            <!-- Weekly off display -->
                            <div style="position: absolute; top: 50%; left: 10%; width: 8px; height: 8px; background-color: #f59e0b; border-radius: 50%; transform: translate(-50%, -50%);"></div>
                            <div style="position: absolute; top: 50%; left: 10%; right: 10%; height: 2px; background-color: #f59e0b; transform: translateY(-50%);"></div>
                            <div style="position: absolute; top: 50%; right: 10%; width: 8px; height: 8px; background-color: #f59e0b; border-radius: 50%; transform: translate(50%, -50%);"></div>
                        }
                        else if (!day.Sessions.Any())
                        {
                            <!-- Absent display (non-clickable) -->
                            <div style="position: absolute; top: 50%; left: 10%; width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; transform: translate(-50%, -50%);"></div>
                            <div style="position: absolute; top: 50%; left: 10%; right: 10%; height: 2px; background-color: #ef4444; transform: translateY(-50%);"></div>
                            <div style="position: absolute; top: 50%; right: 10%; width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; transform: translate(50%, -50%);"></div>
                        }
                        else
                        {
                            <!-- Calculate positions for all dots to avoid overlap -->
                            const int startHour = 8;
                            const int totalHours = 12;
                            const double minGap = 2.0;
                            var dotPositions = new List<(double Position, string Type, DateTime Time, string Tooltip)>();

                            <!-- Collect all dot positions -->
                            @foreach (var session in day.Sessions)
                            {
                                var clockInHour = session.ClockIn.Hour + (session.ClockIn.Minute / 60.0) + (session.ClockIn.Second / 3600.0);
                                var clockInPosition = ((clockInHour - startHour) / totalHours) * 100;
                                clockInPosition = Math.Max(10, Math.Min(90, clockInPosition));
                                dotPositions.Add((clockInPosition, "clock-in", session.ClockIn, $"Clock In: {session.ClockIn:hh:mm:ss tt}"));

                                if (session.ClockOut.HasValue)
                                {
                                    var clockOutHour = session.ClockOut.Value.Hour + (session.ClockOut.Value.Minute / 60.0) + (session.ClockOut.Value.Second / 3600.0);
                                    var clockOutPosition = ((clockOutHour - startHour) / totalHours) * 100;
                                    clockOutPosition = Math.Max(10, Math.Min(90, clockOutPosition));
                                    dotPositions.Add((clockOutPosition, "clock-out", session.ClockOut.Value, $"Clock Out: {session.ClockOut.Value:hh:mm:ss tt}"));
                                }
                            }

                            <!-- Sort dots by position and adjust to prevent overlap -->
                            dotPositions = dotPositions.OrderBy(p => p.Position).ToList();
                            for (int i = 1; i < dotPositions.Count; i++)
                            {
                                if (dotPositions[i].Position - dotPositions[i - 1].Position < minGap)
                                {
                                    dotPositions[i] = (dotPositions[i - 1].Position + minGap, dotPositions[i].Type, dotPositions[i].Time, dotPositions[i].Tooltip);
                                }
                            }

                            <!-- Render green lines first (behind dots) -->
                            @foreach (var session in day.Sessions)
                            {
                                if (session.ClockOut.HasValue)
                                {
                                    var clockInPos = dotPositions.First(p => p.Time == session.ClockIn).Position;
                                    var clockOutPos = dotPositions.First(p => p.Time == session.ClockOut.Value).Position;
                                    <div style="position: absolute; top: 50%; left: @(clockInPos)%; right: calc(100% - @(clockOutPos)%); height: 2px; background-color: #22c55e; transform: translateY(-50%); z-index: 0;"></div>
                                }
                            }

                            <!-- Render dots -->
                            @foreach (var (position, type, time, tooltip) in dotPositions)
                            {
                                <div class="timeline-dot @(type)"
                                     data-tooltip="@tooltip"
                                     style="left: @(position)%; z-index: 1;">
                                </div>
                            }

                            <!-- Red lines for absence periods between sessions -->
                            @foreach (var absence in day.AbsencePeriods)
                            {
                                var absStartHour = absence.StartTime.Hour + (absence.StartTime.Minute / 60.0) + (absence.StartTime.Second / 3600.0);
                                var absEndHour = absence.EndTime.Hour + (absence.EndTime.Minute / 60.0) + (absence.EndTime.Second / 3600.0);
                                var startPosition = ((absStartHour - startHour) / totalHours) * 100;
                                var endPosition = ((absEndHour - startHour) / totalHours) * 100;
                                startPosition = Math.Max(10, Math.Min(90, startPosition));
                                endPosition = Math.Max(10, Math.Min(90, endPosition));

                                <!-- Ensure short periods are visible -->
                                @if (endPosition <= startPosition)
                                {
                                    endPosition = startPosition + 0.5;
                                }

                                <div class="absence-line"
                                     data-tooltip=@($"Absent: {absence.StartTime:hh:mm:ss tt} - {absence.EndTime:hh:mm:ss tt}{(string.IsNullOrEmpty(absence.Reason) ? "" : $"\nReason: {absence.Reason}")}")
                                     @onclick="() => OpenModal(day, absence)"
                                     style="position: absolute; top: 50%; left: @(startPosition)%; right: calc(100% - @(endPosition)%); height: 2px; background-color: #ef4444; transform: translateY(-50%); z-index: 0;">
                                </div>
                            }
                        }
                    </div>

                    <!-- Check-out time -->
                    <div style="text-align: right; font-size: 14px; color: #1e293b;">
                        @(day.Sessions.Any() && day.Sessions.Last().ClockOut.HasValue ?
                            day.Sessions.Last().ClockOut!.Value.ToString("hh:mm:ss tt") :
                            (day.IsWeeklyOff ? "Weekly Off" : "—"))
                    </div>

                    <!-- Total hours -->
                    <div style="text-align: right;">
                        <span style="font-size: 14px; color: @(day.TotalHours > 0 ? "#22c55e" : "#ef4444"); font-weight: 500;">
                            @(day.TotalHours > 0 ? $"{day.TotalHours:F2} Hrs" : (day.IsWeeklyOff ? "Weekly Off" : "0 Hrs"))
                        </span>
                    </div>
                </div>
            }
        </div>
    }
}

