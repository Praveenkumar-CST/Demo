</style>

@code {
    private string userId = "";
    private readonly List<AttendanceDto> logs = new();
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private bool showSuccessPopup;
    private string successPopupMessage = "";
    private readonly List<AttendanceMonth> attendanceMonths = new();
    private bool showModal;
    private AttendanceDay? selectedDay;
    private AbsencePeriod? absencePeriod;
    private string reasonInput = "";
    private DateTime currentMonth = DateTime.Now;
    private const string SupabaseUrl = "https://fhhnmffpdcyktnjahnwq.supabase.co";
    private const string SupabaseKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZoaG5tZmZwZGN5a3RuamFobndxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzczNzA4MDAsImV4cCI6MjA1Mjk0NjgwMH0.1b7s7qJ-yyZXo9wgzq5ZlOnaSxsKRcHDZyYb9J7LU60";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Verify user is authenticated
            var (role, error) = await AuthService.VerifyToken();
            if (!string.IsNullOrEmpty(error))
            {
                errorMessage = "Please log in to view attendance records.";
                Nav.NavigateTo("/login");
                return;
            }

            // Fetch the current user's email from Supabase
            var email = await GetCurrentUserEmailAsync();
            if (string.IsNullOrEmpty(email))
            {
                errorMessage = "Unable to retrieve user email. Please log in again.";
                Nav.NavigateTo("/login");
                return;
            }

            // Fetch user ID from the email
            var userIdResponse = await GetUserIdFromEmailAsync(email);
            if (string.IsNullOrEmpty(userIdResponse))
            {
                errorMessage = "Unable to retrieve user ID for the provided email.";
                return;
            }

            userId = userIdResponse;
            Console.WriteLine($"Assigned userId: {userId}");
            await FetchLogsById();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing component: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        if (currentMonth > DateTime.Now)
        {
            currentMonth = DateTime.Now;
        }
    }

    private async Task<string?> GetCurrentUserEmailAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token))
            {
                Console.WriteLine("No authentication token found in localStorage.");
                return null;
            }

            using var supabaseClient = new HttpClient { BaseAddress = new Uri(SupabaseUrl) };
            supabaseClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            supabaseClient.DefaultRequestHeaders.Add("apikey", SupabaseKey);
            supabaseClient.DefaultRequestHeaders.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue { NoCache = true };

            var userResponse = await supabaseClient.GetAsync("/auth/v1/user");
            if (!userResponse.IsSuccessStatusCode)
            {
                var errorContent = await userResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"Error fetching user from Supabase: Status {userResponse.StatusCode}, Content: {errorContent}");
                return null;
            }

            var userData = await userResponse.Content.ReadFromJsonAsync<UserResponse>();
            var email = userData?.Email;
            if (string.IsNullOrEmpty(email))
            {
                Console.WriteLine("Error: User email is null or empty after fetching user data.");
                return null;
            }
            Console.WriteLine($"User email from Supabase: {email}");
            return email;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"HTTP request error fetching user email: {ex.Message}");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unexpected error fetching user email: {ex.Message}");
            return null;
        }
    }

    private async Task<string?> GetUserIdFromEmailAsync(string email)
    {
        try
        {
            Console.WriteLine($"Fetching user ID for email: {email}");
            var requestUrl = $"/EmployeeDetails/GetEmployeeCodeByEmail/{Uri.EscapeDataString(email)}";
            Console.WriteLine($"Request URL: {requestUrl}");

            // Ensure no caching
            Http.DefaultRequestHeaders.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue { NoCache = true };

            var response = await Http.GetAsync(requestUrl);
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"API response: {responseContent}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<EmployeeCodeResponse>();
                Console.WriteLine($"Parsed employeeCode: {result?.EmployeeCode}");
                return result?.EmployeeCode;
            }

            Console.WriteLine($"Error fetching user ID: Status {response.StatusCode}, Content: {responseContent}");
            return null;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"HTTP error fetching user ID: {ex.Message}");
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception fetching user ID: {ex.Message}");
            return null;
        }
    }

    private async Task FetchLogsById()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        logs.Clear();
        attendanceMonths.Clear();

        try
        {
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not available.";
                return;
            }

            var logsEndpoint = $"/api/Zkteco/get-logs-by-id/{Uri.EscapeDataString(userId)}";
            var logsResponse = await Http.GetAsync(logsEndpoint).ConfigureAwait(false);

            if (!logsResponse.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to fetch logs: {logsResponse.StatusCode}";
                return;
            }

            var rawLogs = await logsResponse.Content.ReadFromJsonAsync<List<AttendanceDto>>() ?? new();
            logs.AddRange(DeduplicateLogs(rawLogs));

            var reasonsEndpoint = $"/api/AbsenceReason/{Uri.EscapeDataString(userId)}";
            var reasonsResponse = await Http.GetAsync(reasonsEndpoint).ConfigureAwait(false);
            var absenceReasons = reasonsResponse.IsSuccessStatusCode
                ? await reasonsResponse.Content.ReadFromJsonAsync<List<AbsenceReasonDto>>() ?? new()
                : new List<AbsenceReasonDto>();

            Console.WriteLine($"Fetched {absenceReasons.Count} absence reasons for UserId: {userId}");
            foreach (var reason in absenceReasons)
            {
                Console.WriteLine($"Reason: {reason.Reason}, Date: {reason.Date:yyyy-MM-dd}, Start: {reason.StartTime:yyyy-MM-dd HH:mm:ss.fff}, End: {reason.EndTime:yyyy-MM-dd HH:mm:ss.fff}");
            }

            GenerateAttendanceTable(absenceReasons);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<AttendanceDto> DeduplicateLogs(List<AttendanceDto> rawLogs)
    {
        return rawLogs
            .GroupBy(l => (l.UserId, l.Timestamp, l.Status))
            .Select(g => g.First())
            .OrderBy(l => l.Timestamp)
            .ToList();
    }

    private void GenerateAttendanceTable(List<AbsenceReasonDto> absenceReasons)
    {
        Console.WriteLine($"Processing {absenceReasons.Count} absence reasons");
        attendanceMonths.Clear();

        var groupedByMonth = logs
            .GroupBy(l => new DateTime(l.Timestamp.Year, l.Timestamp.Month, 1))
            .OrderBy(g => g.Key);

        foreach (var monthGroup in groupedByMonth)
        {
            var month = new AttendanceMonth
            {
                Month = monthGroup.Key,
                Days = new List<AttendanceDay>()
            };

            var daysInMonth = DateTime.DaysInMonth(monthGroup.Key.Year, monthGroup.Key.Month);
            for (int day = 1; day <= daysInMonth; day++)
            {
                var currentDate = new DateTime(monthGroup.Key.Year, monthGroup.Key.Month, day);
                if (currentDate.Date > DateTime.Now.Date)
                    continue;

                var dayLogs = monthGroup.Where(l => l.Timestamp.Date == currentDate).OrderBy(l => l.Timestamp).ToList();

                var attendanceDay = new AttendanceDay
                {
                    Date = currentDate,
                    IsWeeklyOff = currentDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                    Sessions = new List<AttendanceSession>(),
                    AbsencePeriods = new List<AbsencePeriod>()
                };

                if (!attendanceDay.IsWeeklyOff)
                {
                    AttendanceSession? currentSession = null;
                    foreach (var log in dayLogs)
                    {
                        if (log.Status == "Clock-In")
                        {
                            if (currentSession != null && !currentSession.ClockOut.HasValue)
                                continue;
                            currentSession = new AttendanceSession { ClockIn = log.Timestamp };
                            attendanceDay.Sessions.Add(currentSession);
                        }
                        else if (log.Status == "Clock-Out" && currentSession != null)
                        {
                            if (log.Timestamp >= currentSession.ClockIn)
                            {
                                currentSession.ClockOut = log.Timestamp;
                                currentSession = null;
                            }
                        }
                    }

                    attendanceDay.TotalHours = attendanceDay.Sessions
                        .Where(s => s.ClockOut.HasValue)
                        .Sum(s => (s.ClockOut.Value - s.ClockIn).TotalHours);

                    // Handle absence periods between sessions
                    for (int i = 0; i < attendanceDay.Sessions.Count - 1; i++)
                    {
                        var currentSessionItem = attendanceDay.Sessions[i];
                        var nextSession = attendanceDay.Sessions[i + 1];
                        if (currentSessionItem.ClockOut.HasValue && nextSession.ClockIn > currentSessionItem.ClockOut.Value)
                        {
                            var absencePeriod = new AbsencePeriod
                            {
                                StartTime = currentSessionItem.ClockOut.Value,
                                EndTime = nextSession.ClockIn
                            };

                            var matchingReason = absenceReasons.FirstOrDefault(r =>
                                r.UserId == userId &&
                                r.Date.Date == absencePeriod.StartTime.Date &&
                                Math.Abs((r.StartTime - absencePeriod.StartTime).TotalSeconds) <= 1 &&
                                Math.Abs((r.EndTime - absencePeriod.EndTime).TotalSeconds) <= 1);

                            if (matchingReason != null)
                            {
                                absencePeriod.Reason = matchingReason.Reason;
                                Console.WriteLine($"Matched absence reason for period on {currentDate:yyyy-MM-dd}: {absencePeriod.Reason}, Start: {matchingReason.StartTime:yyyy-MM-dd HH:mm:ss.fff}, End: { matchingReason.EndTime:yyyy-MM-dd HH:mm:ss.fff}");
                            }

                            attendanceDay.AbsencePeriods.Add(absencePeriod);
                        }
                    }

                    // Add any additional absence reasons that don't match existing periods
                    var dayReasons = absenceReasons.Where(r =>
                        r.UserId == userId &&
                        r.Date.Date == currentDate.Date).ToList();

                    foreach (var reason in dayReasons)
                    {
                        var existingAbsence = attendanceDay.AbsencePeriods.FirstOrDefault(p =>
                            Math.Abs((p.StartTime - reason.StartTime).TotalSeconds) <= 1 &&
                            Math.Abs((p.EndTime - reason.EndTime).TotalSeconds) <= 1);

                        if (existingAbsence == null)
                        {
                            var newAbsence = new AbsencePeriod
                            {
                                StartTime = reason.StartTime,
                                EndTime = reason.EndTime,
                                Reason = reason.Reason
                            };
                            attendanceDay.AbsencePeriods.Add(newAbsence);
                            Console.WriteLine($"Added new absence period for {currentDate:yyyy-MM-dd}: {reason.Reason}, Start: {reason.StartTime:yyyy-MM-dd HH:mm:ss.fff}, End: {reason.EndTime:yyyy-MM-dd HH:mm:ss.fff}");
                        }
                        else if (string.IsNullOrEmpty(existingAbsence.Reason))
                        {
                            existingAbsence.Reason = reason.Reason;
                            Console.WriteLine($"Updated absence reason for {currentDate:yyyy-MM-dd}: {reason.Reason}, Start: {reason.StartTime:yyyy-MM-dd HH:mm:ss.fff}, End: {reason.EndTime:yyyy-MM-dd HH:mm:ss.fff}");
                        }
                    }
                }

                month.Days.Add(attendanceDay);
            }

            attendanceMonths.Add(month);
        }

        // Only set currentMonth if no month is currently selected
        if (attendanceMonths.Any() && currentMonth == DateTime.MinValue)
        {
            currentMonth = attendanceMonths.Max(m => m.Month);
        }

        Console.WriteLine($"Generated {attendanceMonths.Count} months with {attendanceMonths.Sum(m => m.Days.Count)} days");
    }

    private void OpenModal(AttendanceDay day, AbsencePeriod absence)
    {
        selectedDay = day;
        absencePeriod = absence;
        reasonInput = absence.Reason ?? "";
        showModal = true;
        Console.WriteLine($"Opened modal for {absence.StartTime:yyyy-MM-dd HH:mm:ss.fff} - {absence.EndTime:yyyy-MM-dd HH:mm:ss.fff}, Reason: {reasonInput}");
    }

    private void CloseModal()
    {
        showModal = false;
        selectedDay = null;
        absencePeriod = null;
        reasonInput = "";
    }

    private async Task SubmitReason()
    {
        if (selectedDay == null || absencePeriod == null || string.IsNullOrWhiteSpace(reasonInput))
        {
            errorMessage = "Please enter a valid reason.";
            return;
        }

        // Store the current month before fetching new data
        var preservedMonth = currentMonth;

        try
        {
            var userLog = logs.FirstOrDefault();
            if (userLog == null)
            {
                errorMessage = "User information not available.";
                return;
            }

            var reasonDto = new AbsenceReasonDto
            {
                Id = 0,
                UserId = userId,
                Name = reasonInput,
                Date = absencePeriod.StartTime.Date,
                StartTime = absencePeriod.StartTime,
                EndTime = absencePeriod.EndTime,
                Reason = reasonInput,
                IsApproved = false
            };

            Console.WriteLine($"Submitting reason: {reasonInput} for {reasonDto.Date:yyyy-MM-dd}, Start: {reasonDto.StartTime:yyyy-MM-dd HH:mm:ss.fff}, End: {reasonDto.EndTime:yyyy-MM-dd HH:mm:ss.fff}");

            var response = await Http.PostAsJsonAsync("/api/AbsenceReason", reasonDto).ConfigureAwait(false);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                errorMessage = $"Failed to submit reason: {(int)response.StatusCode} ({errorContent})";
                return;
            }

            Console.WriteLine($"Reason submitted successfully: {reasonInput} for {absencePeriod.StartTime:yyyy-MM-dd HH:mm:ss.fff}");

            absencePeriod.Reason = reasonInput;

            // Fetch updated logs
            await FetchLogsById();

            // Restore the preserved month
            currentMonth = preservedMonth;

            Console.WriteLine($"Fetched {attendanceMonths.Count} months after submission, restored month to {currentMonth:MMMM yyyy}");

            successPopupMessage = "Reason submitted successfully.";
            showSuccessPopup = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                showSuccessPopup = false;
                successPopupMessage = "";
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error submitting reason: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error submitting reason: {ex.Message}";
        }
        finally
        {
            CloseModal();
            await InvokeAsync(StateHasChanged);
        }
    }

