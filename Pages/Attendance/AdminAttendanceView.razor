    private async Task FetchLogs()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        logs.Clear();
        attendanceMonths.Clear();

        try
        {
            if (string.IsNullOrEmpty(userIdInput) && string.IsNullOrEmpty(nameInput))
            {
                errorMessage = "Please enter a user ID or name.";
                return;
            }

            string logsEndpoint;
            if (!string.IsNullOrEmpty(userIdInput))
            {
                logsEndpoint = $"/api/Zkteco/get-logs-by-id/{Uri.EscapeDataString(userIdInput)}";
            }
            else
            {
                logsEndpoint = $"/api/Zkteco/get-logs/{Uri.EscapeDataString(nameInput)}";
            }

            var logsResponse = await Http.GetAsync(logsEndpoint).ConfigureAwait(false);

            if (!logsResponse.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to fetch logs: {logsResponse.StatusCode}";
                return;
            }

            var rawLogs = await logsResponse.Content.ReadFromJsonAsync<List<AttendanceDto>>() ?? new();
            logs.AddRange(DeduplicateLogs(rawLogs));

            if (logs.Any())
            {
                userIdInput = logs.First().UserId ?? userIdInput;
                nameInput = logs.First().Name ?? nameInput;
            }

            var reasonsEndpoint = $"/api/AbsenceReason/{Uri.EscapeDataString(userIdInput ?? logs.FirstOrDefault()?.UserId ?? "")}";
            var reasonsResponse = await Http.GetAsync(reasonsEndpoint).ConfigureAwait(false);
            var absenceReasons = reasonsResponse.IsSuccessStatusCode
                ? await reasonsResponse.Content.ReadFromJsonAsync<List<AbsenceReasonDto>>() ?? new()
                : new List<AbsenceReasonDto>();

            GenerateAttendanceTable(absenceReasons);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<AttendanceDto> DeduplicateLogs(List<AttendanceDto> rawLogs)
    {
        return rawLogs
            .GroupBy(l => (l.UserId, l.Timestamp, l.Status))
            .Select(g => g.First())
            .OrderBy(l => l.Timestamp)
            .ToList();
    }

    private async Task<List<AttendanceDto>> FetchAllLogs()
    {
        try
        {
            var allLogs = new List<AttendanceDto>();
            int page = 1;
            bool hasMoreData = true;

            while (hasMoreData)
            {
                var endpoint = $"/api/Zkteco/get-all-logs?page={page}&pageSize={PageSize}";
                var response = await Http.GetAsync(endpoint).ConfigureAwait(false);

                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = $"Failed to fetch logs: {response.StatusCode}";
                    return allLogs;
                }

                var pageLogs = await response.Content.ReadFromJsonAsync<List<AttendanceDto>>();
                if (pageLogs == null || pageLogs.Count == 0)
                {
                    hasMoreData = false;
                    break;
                }

                allLogs.AddRange(pageLogs);
                downloadProgress = Math.Min(100, (allLogs.Count * 100.0 / TotalRecordsExpected));
                await InvokeAsync(StateHasChanged);

                if (pageLogs.Count < PageSize || allLogs.Count >= TotalRecordsExpected)
                {
                    hasMoreData = false;
                }

                page++;
                await Task.Delay(50);
            }

            return allLogs;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to fetch all logs: {ex.Message}";
            return new List<AttendanceDto>();
        }
    }

    private void GenerateAttendanceTable(List<AbsenceReasonDto> absenceReasons)
    {
        attendanceMonths.Clear();

        var groupedByMonth = logs
            .GroupBy(l => new DateTime(l.Timestamp.Year, l.Timestamp.Month, 1))
            .OrderBy(g => g.Key);

        foreach (var monthGroup in groupedByMonth)
        {
            var month = new AttendanceMonth
            {
                Month = monthGroup.Key,
                Days = new List<AttendanceDay>()
            };

            var daysInMonth = DateTime.DaysInMonth(monthGroup.Key.Year, monthGroup.Key.Month);
            for (int day = 1; day <= daysInMonth; day++)
            {
                var currentDate = new DateTime(monthGroup.Key.Year, monthGroup.Key.Month, day);
                if (currentDate.Date > DateTime.Now.Date)
                    continue;

                var dayLogs = monthGroup.Where(l => l.Timestamp.Date == currentDate).OrderBy(l => l.Timestamp).ToList();

                var attendanceDay = new AttendanceDay
                {
                    Date = currentDate,
                    IsWeeklyOff = currentDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                    Name = logs.FirstOrDefault()?.Name ?? nameInput,
                    UserId = userIdInput ?? logs.FirstOrDefault()?.UserId ?? ""
                };

                if (!attendanceDay.IsWeeklyOff)
                {
                    AttendanceSession? currentSession = null;
                    foreach (var log in dayLogs)
                    {
                        if (log.Status == "Clock-In")
                        {
                            if (currentSession != null && !currentSession.ClockOut.HasValue)
                                continue;
                            currentSession = new AttendanceSession { ClockIn = log.Timestamp };
                            attendanceDay.Sessions.Add(currentSession);
                        }
                        else if (log.Status == "Clock-Out" && currentSession != null)
                        {
                            if (log.Timestamp >= currentSession.ClockIn)
                            {
                                currentSession.ClockOut = log.Timestamp;
                                currentSession = null;
                            }
                        }
                    }

                    if (!attendanceDay.Sessions.Any() && !attendanceDay.IsWeeklyOff)
                    {
                        var absence = new AbsencePeriod
                        {
                            StartTime = currentDate.AddHours(8),
                            EndTime = currentDate.AddHours(20)
                        };

                        var matchingReason = absenceReasons.FirstOrDefault(r =>
                            r.UserId == attendanceDay.UserId &&
                            r.Date.Date == currentDate.Date &&
                            Math.Abs((r.StartTime - absence.StartTime).TotalSeconds) < 1 &&
                            Math.Abs((r.EndTime - absence.EndTime).TotalSeconds) < 1);

                        if (matchingReason != null)
                        {
                            absence.Reason = matchingReason.Reason;
                        }

                        attendanceDay.AbsencePeriods.Add(absence);
                    }

                    for (int i = 0; i < attendanceDay.Sessions.Count - 1; i++)
                    {
                        var currentSessionItem = attendanceDay.Sessions[i];
                        var nextSession = attendanceDay.Sessions[i + 1];
                        if (currentSessionItem.ClockOut.HasValue && nextSession.ClockIn > currentSessionItem.ClockOut.Value)
                        {
                            var absencePeriod = new AbsencePeriod
                            {
                                StartTime = currentSessionItem.ClockOut.Value,
                                EndTime = nextSession.ClockIn
                            };

                            var matchingReason = absenceReasons.FirstOrDefault(r =>
                                r.UserId == attendanceDay.UserId &&
                                r.Date.Date == absencePeriod.StartTime.Date &&
                                Math.Abs((r.StartTime - absencePeriod.StartTime).TotalSeconds) < 1 &&
                                Math.Abs((r.EndTime - absencePeriod.EndTime).TotalSeconds) < 1);

                            if (matchingReason != null)
                            {
                                absencePeriod.Reason = matchingReason.Reason;
                            }

                            attendanceDay.AbsencePeriods.Add(absencePeriod);
                        }
                    }
                }

                var dayReasons = absenceReasons.Where(r =>
                    r.UserId == attendanceDay.UserId &&
                    r.Date.Date == currentDate.Date).ToList();

                foreach (var reason in dayReasons)
                {
                    var existingAbsence = attendanceDay.AbsencePeriods.FirstOrDefault(p =>
                        Math.Abs((p.StartTime - reason.StartTime).TotalSeconds) < 1 &&
                        Math.Abs((p.EndTime - reason.EndTime).TotalSeconds) < 1);

                    if (existingAbsence == null)
                    {
                        var newAbsence = new AbsencePeriod
                        {
                            StartTime = reason.StartTime,
                            EndTime = reason.EndTime,
                            Reason = reason.Reason
                        };
                        attendanceDay.AbsencePeriods.Add(newAbsence);
                    }
                    else if (string.IsNullOrEmpty(existingAbsence.Reason))
                    {
                        existingAbsence.Reason = reason.Reason;
                    }
                }

                month.Days.Add(attendanceDay);
            }

            attendanceMonths.Add(month);
        }

        if (attendanceMonths.Any())
        {
            currentMonth = attendanceMonths.Max(m => m.Month);
        }
    }

    private async Task DownloadExcel(bool downloadAll)
    {
        isDownloading = true;
        downloadProgress = 0;
        errorMessage = null;
        successMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            List<AttendanceDay> daysToExport = new();

            if (!downloadAll)
            {
                daysToExport = attendanceMonths
                    .SelectMany(m => m.Days)
                    .OrderBy(d => d.Date.Year)
                    .ThenBy(d => d.Date.Month)
                    .ThenBy(d => d.Date.Day)
                    .ToList();
            }
            else
            {
                var allLogs = await FetchAllLogs();
                if (!allLogs.Any())
                {
                    errorMessage = "No data available to download.";
                    isDownloading = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var groupedByUser = allLogs.GroupBy(l => l.UserId).OrderBy(g => g.Key).ToList();
                int processedUsers = 0;

                foreach (var userGroup in groupedByUser)
                {
                    var userId = userGroup.Key;
                    var userLogs = userGroup.ToList();
                    var userName = userLogs.FirstOrDefault()?.Name ?? userId;

                    var cleanedLogs = DeduplicateLogs(userLogs);
                    var groupedLogs = cleanedLogs
                        .GroupBy(l => l.Timestamp.ToLocalTime().Date)
                        .ToDictionary(g => g.Key, g => g.OrderBy(l => l.Timestamp).ToList());

                    var userDays = new List<AttendanceDay>();
                    var allDates = cleanedLogs.Select(l => l.Timestamp.ToLocalTime().Date)
                        .Distinct()
                        .OrderBy(d => d.Year)
                        .ThenBy(d => d.Month)
                        .ThenBy(d => d.Day)
                        .ToList();

                    foreach (var date in allDates)
                    {
                        var day = new AttendanceDay
                        {
                            Date = date,
                            IsWeeklyOff = date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
                            Name = userName,
                            UserId = userId
                        };

                        if (!day.IsWeeklyOff && groupedLogs.TryGetValue(date, out var dayLogs))
                        {
                            AttendanceSession? currentSession = null;
                            foreach (var log in dayLogs.OrderBy(l => l.Timestamp))
                            {
                                if (log.Status == "Clock-In")
                                {
                                    if (currentSession != null && !currentSession.ClockOut.HasValue)
                                        continue;
                                    currentSession = new AttendanceSession { ClockIn = log.Timestamp };
                                    day.Sessions.Add(currentSession);
                                }
                                else if (log.Status == "Clock-Out" && currentSession != null)
                                {
                                    if (log.Timestamp >= currentSession.ClockIn)
                                    {
                                        currentSession.ClockOut = log.Timestamp;
                                        currentSession = null;
                                    }
                                }
                            }
                        }

                        userDays.Add(day);
                    }

                    daysToExport.AddRange(userDays);
                    processedUsers++;
                    downloadProgress = Math.Min(100, (processedUsers * 100.0 / groupedByUser.Count));
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1);
                }

                daysToExport = daysToExport
                    .OrderBy(d => d.UserId)
                    .ThenBy(d => d.Date.Year)
                    .ThenBy(d => d.Date.Month)
                    .ThenBy(d => d.Date.Day)
                    .ToList();
            }

            if (!daysToExport.Any())
            {
                errorMessage = "No data available to download after processing.";
                isDownloading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            using (var workbook = new XLWorkbook())
            {
                var worksheet = workbook.Worksheets.Add("Attendance");

                // Add title
                worksheet.Cell(1, 1).Value = "Attendance Report";
                worksheet.Cell(1, 1).Style.Font.Bold = true;
                worksheet.Cell(1, 1).Style.Font.FontSize = 16;
                worksheet.Range(1, 1, 1, 6).Merge();
                worksheet.Cell(1, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

                // Add headers
                var headers = new[] { "Date", "Clock In Time", "Clock Out Time", "Total Hours", "User ID", "Name" };
                for (int i = 0; i < headers.Length; i++)
                {
                    var cell = worksheet.Cell(3, i + 1);
                    cell.Value = headers[i];
                    cell.Style.Font.Bold = true;
                    cell.Style.Fill.BackgroundColor = XLColor.LightBlue;
                    cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                    cell.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                }

                // Add data
                const int batchSize = 200;
                for (int i = 0; i < daysToExport.Count; i += batchSize)
                {
                    var batch = daysToExport.Skip(i).Take(batchSize).ToList();

                    for (int j = 0; j < batch.Count; j++)
                    {
                        var day = batch[j];
                        var row = i + j + 4;
                        worksheet.Cell(row, 1).Value = day.Date.ToString("ddd, dd MMM yyyy");
                        worksheet.Cell(row, 2).Value = day.Sessions.Any() ? day.Sessions.First().ClockIn.ToString("hh:mm:ss tt") : "-";
                        worksheet.Cell(row, 3).Value = day.Sessions.Any() && day.Sessions.Any(s => s.ClockOut.HasValue) ? 
                            day.Sessions.Where(s => s.ClockOut.HasValue).Max(s => s.ClockOut!.Value).ToString("hh:mm:ss tt") : "-";
                        worksheet.Cell(row, 4).Value = day.TotalHours > 0 ? $"{day.TotalHours:F2} hrs" : "0 hrs";
                        worksheet.Cell(row, 5).Value = day.UserId;
                        worksheet.Cell(row, 6).Value = day.Name;

                        for (int k = 1; k <= 6; k++)
                        {
                            var cell = worksheet.Cell(row, k);
                            cell.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
                            cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
                        }
                    }

                    downloadProgress = Math.Min(100, ((i + batch.Count) * 100.0 / daysToExport.Count));
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1);

                    GC.Collect();
                    GC.WaitForPendingFinalizers();
                }

                worksheet.Columns().AdjustToContents();

                using (var stream = new MemoryStream())
                {
                    workbook.SaveAs(stream);
                    var content = stream.ToArray();
                    var fileName = downloadAll ? "All_Users_Attendance.xlsx" : $"{(string.IsNullOrEmpty(userIdInput) ? nameInput : userIdInput)}_Attendance.xlsx";
                    var base64 = Convert.ToBase64String(content);
                    var dataUrl = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}";
                    Nav.NavigateTo(dataUrl, forceLoad: true);
                }
            }

            successPopupMessage = $"Excel file for {(downloadAll ? "all users" : (string.IsNullOrEmpty(userIdInput) ? nameInput : userIdInput))} downloaded successfully.";
            showSuccessPopup = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                showSuccessPopup = false;
                successPopupMessage = "";
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"Error during download: {ex.Message}";
        }
        finally
        {
            isDownloading = false;
            downloadProgress = 0;
            await InvokeAsync(StateHasChanged);
            GC.Collect();
        }
    }

