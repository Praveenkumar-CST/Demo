        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .clear-button {
        background-color: #6b7280;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .clear-button:hover {
        background-color: #4b5563;
        transform: translateY(-1px);
    }

    .request-row {
        padding: 16px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: grid;
        grid-template-columns: 100px 180px 140px 1fr 120px;
        align-items: center;
        gap: 24px;
        transition: all 0.3s ease;
    }

    .request-row:hover {
        background-color: #f9fafb;
        transform: translateY(-2px);
    }

    .action-button {
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .primary-button {
        background-color: #22c55e;
        color: #ffffff;
    }

    .primary-button:hover {
        background-color: #16a34a;
        transform: translateY(-1px);
    }

    .primary-button:disabled {
        background-color: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .secondary-button {
        background-color: #6b7280;
        color: #ffffff;
    }

    .secondary-button:hover {
        background-color: #4b5563;
        transform: translateY(-1px);
    }

    .error-message {
        color: #991b1b;
        background-color: #fef2f2;
        padding: 12px 16px;
        border-radius: 8px;
        margin: 16px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .success-message {
        color: #065f46;
        background-color: #ecfdf5;
        padding: 12px 16px;
        border-radius: 8px;
        margin: 16px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .success-popup {
        position: fixed;

            {
                var matchingRecord = zktecoData.FirstOrDefault(z => z.UserId == request.UserId);
                request.Name = matchingRecord != null ? matchingRecord.Name : "Unknown";
            }

            // Initialize filtered requests
            filteredRequests.AddRange(requests);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}. Displaying requests without names.";
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}. Displaying requests without names.";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnUserIdSearchInput(ChangeEventArgs e)
    {
        userIdSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void OnNameSearchInput(ChangeEventArgs e)
    {
        nameSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void FilterRequests()
    {
        filteredRequests = requests
            .Where(r => string.IsNullOrEmpty(userIdSearch) || r.UserId.Contains(userIdSearch, StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrEmpty(nameSearch) || r.Name.Contains(nameSearch, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.Date)
            .ToList();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        userIdSearch = "";
        nameSearch = "";
        filteredRequests = requests.OrderByDescending(r => r.Date).ToList();
        StateHasChanged();
    }

    private async Task ApproveRequest(int id)
    {
        try
        {
            var response = await Http.PutAsync($"/api/AbsenceReason/{id}/approve", null).ConfigureAwait(false);

    }
}