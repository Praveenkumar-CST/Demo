    private void OnUserIdSearchInput(ChangeEventArgs e)
    {
        userIdSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void OnNameSearchInput(ChangeEventArgs e)
    {
        nameSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void FilterRequests()
    {
        filteredRequests = requests
            .Where(r => string.IsNullOrEmpty(userIdSearch) || r.UserId.Contains(userIdSearch, StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrEmpty(nameSearch) || r.Name.Contains(nameSearch, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.Date)
            .ToList();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        userIdSearch = "";
        nameSearch = "";
        filteredRequests = requests.OrderByDescending(r => r.Date).ToList();
        StateHasChanged();
    }

    private async Task ApproveRequest(int id)
    {
        try
        {
            var response = await Http.PutAsync($"/api/AbsenceReason/{id}/approve", null).ConfigureAwait(false);

    }
