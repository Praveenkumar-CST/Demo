@page "/AdminAbsenceReasons"
@using System.Net.Http.Json
@using FingerFrontend.AdminAttendanceViewModel
@inject HttpClient Http
@inject NavigationManager Nav
@layout HomeLayout

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Error Message -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message">
        <p><i class="fas fa-exclamation-circle"></i> Error: @errorMessage</p>
        <button @onclick="ClearError" class="action-button secondary-button">Dismiss</button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="success-message">
        <p><i class="fas fa-check-circle"></i> @successMessage</p>
        <button @onclick="ClearSuccess" class="action-button secondary-button">Dismiss</button>
    </div>
}

<!-- Success Pop-up -->
@if (showSuccessPopup)
{
    <div class="success-popup">
        <i class="fas fa-check-circle"></i>
        <p>@successPopupMessage</p>
    </div>
}

<div class="admin-container">
    <div class="table-header">
        <h1>Absence Requests</h1>
    </div>

    <!-- Search Section -->
    <div class="search-container">
        <input type="text" class="search-input" placeholder="Search by User ID" @bind="userIdSearch" @oninput="OnUserIdSearchInput" />
        <input type="text" class="search-input" placeholder="Search by Name" @bind="nameSearch" @oninput="OnNameSearchInput" />
        <button class="clear-button" @onclick="ClearSearch">
            <i class="fas fa-times"></i> Clear
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loader"></div>
    }
    else if (!filteredRequests.Any())
    {
        <p class="no-data">No absence reason requests found.</p>
    }
    else
    {
        <div class="request-row" style="font-weight: 600; color: #1e293b; background-color: #f1f5f9;">
            <div>User ID</div>
            <div>Name</div>
            <div>Date & Time</div>
            <div>Reason</div>
            <div>Action</div>
        </div>
        @foreach (var request in filteredRequests)
        {
            <div class="request-row">
                <div>@request.UserId</div>
                <div>@request.Name</div>
                <div>@request.Date.ToString("dd MMM yyyy") (@request.StartTime.ToString("hh:mm tt") - @request.EndTime.ToString("hh:mm tt"))</div>
                <div class="reason-display">@request.Reason</div>
                <div>
                    @if (!request.IsApproved)
                    {
                        <button @onclick="() => ApproveRequest(request.Id)" class="action-button primary-button">
                            <i class="fas fa-check"></i> Approve
                        </button>
                    }
                    else
                    {
                        <span style="color: #2563eb; font-weight: 500;"><i class="fas fa-check-circle"></i> Approved</span>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .admin-container {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        max-width: 1280px;
        margin: 2rem auto;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 24px;
        overflow: hidden;
    }

    .table-header {
        background: linear-gradient(to right, #2563eb, #3b82f6);
        padding: 20px 24px;
        font-size: 20px;
        font-weight: 600;
        color: #ffffff;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .table-header h1 {
        margin: 0;
        font-size: 20px;
    }

    .search-container {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        padding: 16px 24px;
        background-color: #f9fafb;
        border-radius: 8px;
    }

    .search-input {
        flex: 1;
        padding: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
    }

    .search-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .clear-button {
        background-color: #6b7280;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .clear-button:hover {
        background-color: #4b5563;
        transform: translateY(-1px);
    }

    .request-row {
        padding: 16px 24px;
        border-bottom: 1px solid #e5e7eb;
        display: grid;
        grid-template-columns: 100px 180px 140px 1fr 120px;
        align-items: center;
        gap: 24px;
        transition: all 0.3s ease;
    }

    .request-row:hover {
        background-color: #f9fafb;
        transform: translateY(-2px);
    }

    .action-button {
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .primary-button {
        background-color: #22c55e;
        color: #ffffff;
    }

    .primary-button:hover {
        background-color: #16a34a;
        transform: translateY(-1px);
    }

    .primary-button:disabled {
        background-color: #9ca3af;
        cursor: not-allowed;
        transform: none;
    }

    .secondary-button {
        background-color: #6b7280;
        color: #ffffff;
    }

    .secondary-button:hover {
        background-color: #4b5563;
        transform: translateY(-1px);
    }

    .error-message {
        color: #991b1b;
        background-color: #fef2f2;
        padding: 12px 16px;
        border-radius: 8px;
        margin: 16px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .success-message {
        color: #065f46;
        background-color: #ecfdf5;
        padding: 12px 16px;
        border-radius: 8px;
        margin: 16px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

    .success-popup {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #ecfdf5;
        color: #065f46;
        padding: 14px 24px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        z-index: 2000;
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slideIn 0.3s ease-out, fadeOut 0.3s ease-out 2.7s;
    }

    .success-popup i {
        font-size: 20px;
    }

    .success-popup p {
        margin: 0;
        font-size: 15px;
        font-weight: 500;
    }

    .reason-display {
        font-size: 14px;
        color: #4b5563;
        padding: 10px;
        background-color: #f9fafb;
        border-radius: 6px;
        max-height: 100px;
        overflow-y: auto;
        line-height: 1.5;
    }

    .no-data {
        text-align: center;
        color: #4b5563;
        font-size: 16px;
        padding: 24px;
        background-color: #f9fafb;
        border-radius: 8px;
        margin-top: 16px;
    }

    .loader {
        display: inline-block;
        width: 40px;
        height: 40px;
        border: 4px solid #2563eb;
        border-top: 4px solid transparent;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 24px auto;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }
</style>

@code {
    private List<AbsenceReasonRequest> requests = new();
    private List<AbsenceReasonRequest> filteredRequests = new();
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private bool showSuccessPopup;
    private string successPopupMessage = "";
    private string userIdSearch = "";
    private string nameSearch = "";

    protected override async Task OnInitializedAsync()
    {
        await FetchAllReasons();
    }

    private async Task FetchAllReasons()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        requests.Clear();
        filteredRequests.Clear();

        try
        {
            // Fetch absence reason requests
            var absenceResponse = await Http.GetAsync("/api/AbsenceReason").ConfigureAwait(false);
            if (!absenceResponse.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to fetch absence requests: {absenceResponse.StatusCode}";
                isLoading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var fetchedRequests = await absenceResponse.Content.ReadFromJsonAsync<List<AbsenceReasonRequest>>() ?? new();
            requests.AddRange(fetchedRequests.OrderByDescending(r => r.Date));

            // Fetch names from Zkteco endpoint
            var zktecoResponse = await Http.GetAsync("/api/Zkteco/get-all-logs").ConfigureAwait(false);
            List<LowHoursReason> zktecoData = new();

            if (zktecoResponse.IsSuccessStatusCode)
            {
                zktecoData = await zktecoResponse.Content.ReadFromJsonAsync<List<LowHoursReason>>() ?? new();
            }
            else
            {
                errorMessage = $"Failed to fetch names: {zktecoResponse.StatusCode}. Displaying requests without names.";
            }

            // Map names to requests based on UserId
            foreach (var request in requests)
            {
                var matchingRecord = zktecoData.FirstOrDefault(z => z.UserId == request.UserId);
                request.Name = matchingRecord != null ? matchingRecord.Name : "Unknown";
            }

            // Initialize filtered requests
            filteredRequests.AddRange(requests);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}. Displaying requests without names.";
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}. Displaying requests without names.";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnUserIdSearchInput(ChangeEventArgs e)
    {
        userIdSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void OnNameSearchInput(ChangeEventArgs e)
    {
        nameSearch = e.Value?.ToString() ?? "";
        FilterRequests();
    }

    private void FilterRequests()
    {
        filteredRequests = requests
            .Where(r => string.IsNullOrEmpty(userIdSearch) || r.UserId.Contains(userIdSearch, StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrEmpty(nameSearch) || r.Name.Contains(nameSearch, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.Date)
            .ToList();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        userIdSearch = "";
        nameSearch = "";
        filteredRequests = requests.OrderByDescending(r => r.Date).ToList();
        StateHasChanged();
    }

    private async Task ApproveRequest(int id)
    {
        try
        {
            var response = await Http.PutAsync($"/api/AbsenceReason/{id}/approve", null).ConfigureAwait(false);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                errorMessage = $"Failed to approve request: {(int)response.StatusCode} ({errorContent})";
                return;
            }

            var request = requests.FirstOrDefault(r => r.Id == id);
            if (request != null)
            {
                request.IsApproved = true;
                FilterRequests(); // Update filtered list
            }

            successPopupMessage = "Request approved successfully.";
            showSuccessPopup = true;

            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                showSuccessPopup = false;
                successPopupMessage = "";
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error approving request: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving request: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClearError()
    {
        errorMessage = null;
    }

    private void ClearSuccess()
    {
        successMessage = null;
    }
}