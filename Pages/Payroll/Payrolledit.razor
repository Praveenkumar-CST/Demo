    protected override async Task OnInitializedAsync()
    {
        try
        {
            var query = new Uri(NavigationManager.Uri).Query;
            var queryParams = System.Web.HttpUtility.ParseQueryString(query);
            var encodedJson = queryParams["employee"];

            if (string.IsNullOrEmpty(encodedJson))
            {
                hasError = true;
                return;
            }

            var jsonBytes = Convert.FromBase64String(encodedJson);
            var json = System.Text.Encoding.UTF8.GetString(jsonBytes);
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            selectedEmployee = JsonSerializer.Deserialize<EmployeePayroll>(json, options);

            if (selectedEmployee == null)
            {
                hasError = true;
                return;
            }

            // Fetch joining location
            selectedEmployee.JoiningLocation = await GetJoiningLocation(selectedEmployee.EmployeeID);

            salaryDetails = new SalaryDetails
            {
                YearlySalary = selectedEmployee.CTC_Amount,
                Earnings = new List<Component>
                {
                    new Component { Name = "Basic Salary", MonthlyAmount = selectedEmployee.BasicSalary, YearlyAmount = selectedEmployee.BasicSalary * 12, IsEditable = true, Percentage = selectedEmployee.CTC_Amount > 0 ? (selectedEmployee.BasicSalary / selectedEmployee.CTC_Amount) * 100 : 0 },
                    new Component { Name = "HRA", MonthlyAmount = selectedEmployee.HRA_Amount, YearlyAmount = selectedEmployee.HRA_Amount * 12, IsEditable = true, Percentage = selectedEmployee.CTC_Amount > 0 ? (selectedEmployee.HRA_Amount / selectedEmployee.CTC_Amount) * 100 : 0 },
                    new Component { Name = "Special Allowance", MonthlyAmount = selectedEmployee.SpecialAllowance_Amount, YearlyAmount = selectedEmployee.SpecialAllowance_Amount * 12, IsEditable = true, Percentage = selectedEmployee.CTC_Amount > 0 ? (selectedEmployee.SpecialAllowance_Amount / selectedEmployee.CTC_Amount) * 100 : 0 },
                    new Component { Name = "Arrears", MonthlyAmount = selectedEmployee.Arrears_Amount, YearlyAmount = selectedEmployee.Arrears_Amount * 12, IsEditable = true, Percentage = selectedEmployee.CTC_Amount > 0 ? (selectedEmployee.Arrears_Amount / selectedEmployee.CTC_Amount) * 100 : 0 }
                }.Where(e => e.MonthlyAmount != 0).ToList(),
                Deductions = new List<Component>
                {
                    new Component { Name = "Employer PF", MonthlyAmount = selectedEmployee.EmployerPF_Amount, YearlyAmount = selectedEmployee.EmployerPF_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.EmployerPF_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Employee PF", MonthlyAmount = selectedEmployee.EmployeePF_Amount, YearlyAmount = selectedEmployee.EmployeePF_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.EmployeePF_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Employer ESIC", MonthlyAmount = selectedEmployee.EmployerESIC_Amount, YearlyAmount = selectedEmployee.EmployerESIC_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.EmployerESIC_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Employee ESIC", MonthlyAmount = selectedEmployee.EmployeeESIC_Amount, YearlyAmount = selectedEmployee.EmployeeESIC_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.EmployeeESIC_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Gratuity", MonthlyAmount = selectedEmployee.Gratuity_Amount, YearlyAmount = selectedEmployee.Gratuity_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.Gratuity_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Income Tax", MonthlyAmount = selectedEmployee.IncomeTax_Amount, YearlyAmount = selectedEmployee.IncomeTax_Amount * 12, IsEditable = true, Percentage = selectedEmployee.GrossSalary > 0 ? (selectedEmployee.IncomeTax_Amount / selectedEmployee.GrossSalary) * 100 : 0 },
                    new Component { Name = "Professional Tax", MonthlyAmount = selectedEmployee.ProfessionalTax_Amount, YearlyAmount = selectedEmployee.ProfessionalTax_Amount * 12, IsEditable = true, Percentage = 0 },
                    new Component { Name = "Loans", MonthlyAmount = selectedEmployee.Loans_Amount, YearlyAmount = selectedEmployee.Loans_Amount * 12, IsEditable = true, Percentage = 0 },
                    new Component { Name = "LOP", MonthlyAmount = selectedEmployee.LOP_Amount, YearlyAmount = selectedEmployee.LOP_Amount * 12, IsEditable = true, Percentage = 0 }
                }.Where(d => d.MonthlyAmount != 0).ToList()
            };

            foreach (var other in selectedEmployee.Others)
            {
                if (other.Value > 0)
                {
                    salaryDetails.Earnings.Add(new Component
                    {
                        Name = other.Key,
                        MonthlyAmount = other.Value / 12m,
                        YearlyAmount = other.Value,
                        IsEditable = true,
                        Percentage = selectedEmployee.CTC_Amount > 0 ? ((other.Value / 12m) / selectedEmployee.CTC_Amount) * 100 : 0
                    });
                }
                else if (other.Value < 0)
                {
                    salaryDetails.Deductions.Add(new Component
                    {
                        Name = other.Key,
                        MonthlyAmount = Math.Abs(other.Value / 12m),
                        YearlyAmount = Math.Abs(other.Value),
                        IsEditable = true,
                        Percentage = selectedEmployee.GrossSalary > 0 ? (Math.Abs(other.Value / 12m) / selectedEmployee.GrossSalary) * 100 : 0
                    });
                }
            }

            UpdateAvailableComponents();
            await GetLeaveHistory(); // Fetch leave history on initialization
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee data: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetJoiningLocation(string employeeId)
    {
        try
        {
            var response = await HttpClient.GetAsync($"https://localhost:7021/EmployeeDetails/GetJoiningLocationByEmployeeId/{employeeId}");
            if (response.IsSuccessStatusCode)
            {
                var location = await response.Content.ReadAsStringAsync();
                return location;
            }
            else
            {
                Console.WriteLine($"Failed to fetch joining location: {response.StatusCode}");
                return string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching joining location: {ex.Message}");
            return string.Empty;
        }
    }

    private async Task GetLeaveHistory()
    {
        if (selectedEmployee == null || string.IsNullOrWhiteSpace(selectedEmployee.EmployeeID))
        {
            Snackbar.Add("No Employee ID available", MudBlazor.Severity.Warning);
            return;
        }

        leaveHistory.Clear();
        totalUnpaidLeaveDays = 0;
        totalWorkingDays = 0;
        lopAmount = 0;

        try
        {
            // Construct date range for the selected month and year
            var startDate = new DateTime(selectedEmployee.Year, selectedEmployee.Month, 1);
            var endDate = startDate.AddMonths(1).AddDays(-1);
            var query = $"https://localhost:7021/api/LeaveManagement/history?employeeId={selectedEmployee.EmployeeID}&startDate={startDate:yyyy-MM-dd}&endDate={endDate:yyyy-MM-dd}&pageNumber=1&pageSize=10";

            var response = await HttpClient.GetAsync(query);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LeaveHistoryResponse>();
                if (result?.History != null)
                {
                    // Filter leave history by start date month and year and exclude rejected status
                    leaveHistory = result.History
                        .Where(record => record.StartDate.Month == selectedEmployee.Month && record.StartDate.Year == selectedEmployee.Year && !record.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    // Calculate total Unpaid leave days excluding weekends and days not in the selected month
                    totalUnpaidLeaveDays = leaveHistory
                        .Where(record => record.LeaveType.Equals("Unpaid", StringComparison.OrdinalIgnoreCase))
                        .Sum(record =>
                        {
                            int days = 0;
                            for (var date = record.StartDate; date <= record.EndDate; date = date.AddDays(1))
                            {
                                if (date.Month == selectedEmployee.Month && date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday)
                                {
                                    days++;
                                }
                            }
                            return days;
                        });

                    // Calculate total working days
                    totalWorkingDays = DateTime.DaysInMonth(selectedEmployee.Year, selectedEmployee.Month);

                    // Calculate LOP amount
                    var basicSalaryComponent = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Basic Salary");
                    if (basicSalaryComponent != null)
                    {
                        decimal dailySalary = basicSalaryComponent.MonthlyAmount / DateTime.DaysInMonth(selectedEmployee.Year, selectedEmployee.Month);
                        lopAmount = dailySalary * totalUnpaidLeaveDays;

                        var lopComponent = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "LOP");
                        if (lopComponent != null)
                        {
                            lopComponent.MonthlyAmount = lopAmount;
                            lopComponent.YearlyAmount = lopAmount * 12;
                        }
                        else
                        {
                            salaryDetails.Deductions.Add(new Component
                            {
                                Name = "LOP",
                                MonthlyAmount = lopAmount,
                                YearlyAmount = lopAmount * 12,
                                IsEditable = true,
                                Percentage = 0
                            });
                        }
                    }
                }
            }
            else
            {
                Snackbar.Add("Failed to fetch leave history", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching leave history: {ex.Message}");
            Snackbar.Add($"Error: {ex.Message}", MudBlazor.Severity.Error);
        }

        StateHasChanged();
    }

    private bool IsValidSalary()
    {
        return salaryDetails.Earnings.Any(e => e.Name == "Basic Salary" && e.MonthlyAmount >= 0);
    }

    private bool IsValidDeductionAmount(Component deduction)
    {
        return deduction.MonthlyAmount >= 0;
    }

