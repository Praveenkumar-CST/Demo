        earning.MonthlyAmount = value;
        earning.YearlyAmount = value * 12;
        if (earning.IsPartOfCTC && salaryDetails.YearlySalary > 0)
        {
            earning.Percentage = (earning.YearlyAmount / salaryDetails.YearlySalary) * 100;
        }
        CheckTotalSalary();
        StateHasChanged();
