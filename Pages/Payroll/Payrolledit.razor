        {
            Snackbar.Add("Yearly amount cannot be negative.", MudBlazor.Severity.Error);
            return;
        }
        earning.YearlyAmount = value;
        earning.MonthlyAmount = value / 12;
        if (earning.IsPartOfCTC && salaryDetails.YearlySalary > 0)
