        if (salaryDetails.YearlyGrossSalary > 0)
        {
            deduction.Percentage = (deduction.YearlyAmount / salaryDetails.YearlyGrossSalary) * 100;
        }
        if (!IsValidDeductionAmount(deduction))
        {
            Snackbar.Add("Deduction amount cannot be negative.", MudBlazor.Severity.Error);
            deduction.MonthlyAmount = 0;
            deduction.YearlyAmount = 0;
            deduction.Percentage = 0;
        }
        StateHasChanged();
    }

    private void CheckTotalSalary()
    {
        decimal totalYearlyEarnings = salaryDetails.Earnings.Where(e => e.IsPartOfCTC).Sum(e => e.YearlyAmount);
        showWarning = totalYearlyEarnings > salaryDetails.YearlySalary;
        StateHasChanged();
    }

    private void ToggleEarningDropdown()
    {
        showEarningDropdown = !showEarningDropdown;
        currentEarningComponent = null;
