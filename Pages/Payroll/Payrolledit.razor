    private class Component
    {
        public string Name { get; set; } = string.Empty;
        public decimal MonthlyAmount { get; set; }
        public decimal YearlyAmount { get; set; }
        public decimal? Percentage { get; set; }
        public bool IsEditable { get; set; } = true;
        public bool IsPartOfCTC { get; set; } = true;
    }

    private class SalaryDetails
    {
        public decimal YearlySalary { get; set; }
        public List<Component> Earnings { get; set; } = new();
        public List<Component> Deductions { get; set; } = new();
        public decimal MonthlyGrossSalary => Earnings.Sum(e => e.MonthlyAmount);
        public decimal YearlyGrossSalary => MonthlyGrossSalary * 12;
        public decimal MonthlyTotalDeductions => Deductions
            .Where(d => d.Name != "Employer PF" && d.Name != "Employer ESIC")
            .Sum(d => d.MonthlyAmount);
        public decimal YearlyTotalDeductions => MonthlyTotalDeductions * 12;
        public decimal MonthlyNetPay => MonthlyGrossSalary - MonthlyTotalDeductions;
        public decimal YearlyNetPay => MonthlyNetPay * 12;
    }

