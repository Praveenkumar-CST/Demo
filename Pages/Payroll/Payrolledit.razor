    private async Task SaveSalaryDetails()
    {
        if (selectedEmployee == null || !IsValidSalary())
        {
            Snackbar.Add("Invalid salary data: Basic Salary is required.", MudBlazor.Severity.Error);
            return;
        }

        decimal totalYearlyEarnings = salaryDetails.Earnings.Where(e => e.IsPartOfCTC).Sum(e => e.YearlyAmount);
        if (totalYearlyEarnings > salaryDetails.YearlySalary)
        {
            showWarning = true;
            Snackbar.Add("Total salary components exceed the yearly CTC.", MudBlazor.Severity.Warning);
            StateHasChanged();
            return;
        }

        try
        {
            var others = new Dictionary<string, int>();
            foreach (var earning in salaryDetails.Earnings)
            {
                if (!new List<string> { "Basic Salary", "HRA", "Special Allowance", "Arrears" }.Contains(earning.Name))
                {
                    others[earning.Name] = (int)Math.Round(earning.MonthlyAmount);
                }
            }
            foreach (var deduction in salaryDetails.Deductions)
            {
                if (!new List<string> { "Employer PF", "Employee PF", "Employer ESIC", "Employee ESIC", "Gratuity", "Income Tax", "Professional Tax", "Loans", "LOP" }.Contains(deduction.Name))
                {
                    others[deduction.Name] = -(int)Math.Round(deduction.MonthlyAmount);
                }
            }

            selectedEmployee.CTC_Amount = salaryDetails.YearlySalary;
            selectedEmployee.BasicSalary = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Basic Salary")?.MonthlyAmount ?? 0;
            selectedEmployee.HRA_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "HRA")?.MonthlyAmount ?? 0;
            selectedEmployee.SpecialAllowance_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Special Allowance")?.MonthlyAmount ?? 0;
            selectedEmployee.Arrears_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Arrears")?.MonthlyAmount ?? 0;
            selectedEmployee.EmployerPF_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employer PF")?.MonthlyAmount ?? 0;
            selectedEmployee.EmployeePF_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employee PF")?.MonthlyAmount ?? 0;
            selectedEmployee.EmployerESIC_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employer ESIC")?.MonthlyAmount ?? 0;
            selectedEmployee.EmployeeESIC_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employee ESIC")?.MonthlyAmount ?? 0;
            selectedEmployee.Gratuity_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Gratuity")?.MonthlyAmount ?? 0;
            selectedEmployee.IncomeTax_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Income Tax")?.MonthlyAmount ?? 0;
            selectedEmployee.ProfessionalTax_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Professional Tax")?.MonthlyAmount ?? 0;
            selectedEmployee.Loans_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Loans")?.MonthlyAmount ?? 0;
            selectedEmployee.LOP_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "LOP")?.MonthlyAmount ?? 0;
            selectedEmployee.GrossSalary = (int)Math.Round(salaryDetails.MonthlyGrossSalary);
            selectedEmployee.TotalDeductions = (int)Math.Round(salaryDetails.MonthlyTotalDeductions);
            selectedEmployee.NetPay = (int)Math.Round(salaryDetails.MonthlyNetPay);
            selectedEmployee.Others = others;

            var response = await HttpClient.PostAsJsonAsync("https://localhost:7021/api/PayrollMonthlyDetails", selectedEmployee);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Payroll details saved successfully!", MudBlazor.Severity.Success);
            }
            else
            {
                hasError = true;
                Snackbar.Add("Failed to save payroll details.", MudBlazor.Severity.Error);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving payroll details: {ex.Message}");
            hasError = true;
            Snackbar.Add("An error occurred while saving payroll details.", MudBlazor.Severity.Error);
            StateHasChanged();
        }
    }

    private void UpdateAvailableComponents()
    {
        availableEarnings = new List<string> { "Basic Salary", "HRA", "Special Allowance", "Arrears", "Others" }
            .Where(earning => earning == "Others" || !salaryDetails.Earnings.Any(component => component.Name == earning))
            .ToList();

        availableDeductions = new List<string> { "Employer PF", "Employee PF", "Employer ESIC", "Employee ESIC", "Gratuity", "Income Tax", "Professional Tax", "Loans", "LOP", "Others" }
            .Where(deduction => deduction == "Others" || !salaryDetails.Deductions.Any(component => component.Name == deduction))
            .ToList();
    }

