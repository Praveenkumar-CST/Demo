    private void UpdateEarningPercentage(Component earning, decimal value)
    {
        if (value < 0)
        {
            Snackbar.Add("Percentage cannot be negative.", MudBlazor.Severity.Error);
            return;
        }
        earning.Percentage = value;
        if (earning.IsPartOfCTC && salaryDetails.YearlySalary > 0)
        {
            earning.YearlyAmount = (value / 100) * salaryDetails.YearlySalary;
            earning.MonthlyAmount = earning.YearlyAmount / 12;
        }
        CheckTotalSalary();
        StateHasChanged();
    }

