    private async Task SaveSalaryDetails()
    {
        if (selectedEmployee == null || !IsValidSalary())
        {
            Snackbar.Add("Invalid salary details. Basic Salary is required.", MudBlazor.Severity.Error);
            return;
        }

        decimal totalYearlyEarnings = salaryDetails.Earnings.Where(e => e.IsPartOfCTC).Sum(e => e.YearlyAmount);
        if (totalYearlyEarnings > salaryDetails.YearlySalary)
        {
            showWarning = true;
            Snackbar.Add("Total salary components exceed the yearly CTC.", MudBlazor.Severity.Warning);
            StateHasChanged();
            return;
        }

        try
        {
            var others = new Dictionary<string, int>();
            foreach (var earning in salaryDetails.Earnings)
            {
                if (!new List<string> { "Basic Salary", "HRA", "Special Allowance", "Arrears" }.Contains(earning.Name))
                {
                    others[earning.Name] = (int)Math.Round(earning.YearlyAmount);
                }
            }
            foreach (var deduction in salaryDetails.Deductions)
            {
                if (!new List<string> { "Employer PF", "Employee PF", "Employer ESIC", "Employee ESIC", "Gratuity", "Income Tax", "Professional Tax", "Loans", "LOP" }.Contains(deduction.Name))
                {
                    others[deduction.Name] = -(int)Math.Round(deduction.YearlyAmount);
                }
            }

            var employeeData = new
            {
                EmployeeID = selectedEmployee.EmployeeID,
                FullName = selectedEmployee.FullName,
                CurrentEmail = selectedEmployee.CurrentEmail,
                Designation = selectedEmployee.Designation,
                Month = selectedMonth,
                Year = selectedYear,
                CTC_Amount = salaryDetails.YearlySalary,
                BasicSalary = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Basic Salary")?.MonthlyAmount ?? 0,
                HRA_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "HRA")?.MonthlyAmount ?? 0,
                SpecialAllowance_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Special Allowance")?.MonthlyAmount ?? 0,
                Arrears_Amount = salaryDetails.Earnings.FirstOrDefault(e => e.Name == "Arrears")?.MonthlyAmount ?? 0,
                EmployerPF_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employer PF")?.MonthlyAmount ?? 0,
                EmployeePF_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employee PF")?.MonthlyAmount ?? 0,
                EmployerESIC_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employer ESIC")?.MonthlyAmount ?? 0,
                EmployeeESIC_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Employee ESIC")?.MonthlyAmount ?? 0,
                Gratuity_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Gratuity")?.MonthlyAmount ?? 0,
                IncomeTax_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Income Tax")?.MonthlyAmount ?? 0,
                ProfessionalTax_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Professional Tax")?.MonthlyAmount ?? 0,
                Loans_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "Loans")?.MonthlyAmount ?? 0,
                LOP_Amount = salaryDetails.Deductions.FirstOrDefault(d => d.Name == "LOP")?.MonthlyAmount ?? 0,
                GrossSalary = (int)Math.Round(salaryDetails.MonthlyGrossSalary),
                TotalDeductions = (int)Math.Round(salaryDetails.MonthlyTotalDeductions),
                NetPay = (int)Math.Round(salaryDetails.MonthlyNetPay),
                Others = others
            };

            var response = await HttpClient.PostAsJsonAsync("https://localhost:7021/api/PayrollDetails", employeeData);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Payroll details saved successfully!", MudBlazor.Severity.Success);
                // Reload data to reflect the latest changes
                await OnInitializedAsync();
            }
            else
            {
                hasError = true;
                Snackbar.Add("Failed to save payroll details.", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving payroll details: {ex.Message}");
            hasError = true;
            Snackbar.Add("An error occurred while saving payroll details.", MudBlazor.Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void UpdateAvailableComponents()
    {
        availableEarnings = new List<string> { "Basic Salary", "HRA", "Special Allowance", "Arrears", "Others" }
            .Where(earning => earning == "Others" || !salaryDetails.Earnings.Any(component => component.Name == earning))
            .ToList();
        availableDeductions = new List<string> { "Employer PF", "Employee PF", "Employer ESIC", "Employee ESIC", "Gratuity", "Income Tax", "Professional Tax", "Loans", "LOP", "Others" }
            .Where(deduction => deduction == "Others" || !salaryDetails.Deductions.Any(component => component.Name == deduction))
            .ToList();
    }

    private void HandleEarningSelection(string value)
    {
        newEarning = value;
        showCustomEarningInput = value == "Others";
        if (!showCustomEarningInput)
        {
            AddEarning(value);
            showEarningDropdown = false;
        }
        customEarningName = string.Empty;
        StateHasChanged();
    }

    private void HandleDeductionSelection(string value)
    {
        newDeduction = value;
        showCustomDeductionInput = value == "Others";
        if (!showCustomDeductionInput)
        {
            AddDeduction(value);
            showDeductionDropdown = false;
        }
        customDeductionName = string.Empty;
        StateHasChanged();
    }

    private void AddEarning(string value)
    {
        if (!string.IsNullOrEmpty(value) && value != "Others")
        {
            salaryDetails.Earnings.Add(new Component { Name = value, MonthlyAmount = 0, YearlyAmount = 0, IsEditable = true, Percentage = 0, IsPartOfCTC = true });
            newEarning = string.Empty;
            UpdateAvailableComponents();
            StateHasChanged();
        }
    }

    private void AddDeduction(string value)
    {
        if (!string.IsNullOrEmpty(value) && value != "Others")
        {
            salaryDetails.Deductions.Add(new Component { Name = value, MonthlyAmount = 0, YearlyAmount = 0, IsEditable = true, Percentage = 0, IsPartOfCTC = value == "Employer PF" || value == "Employer ESIC" || value == "Gratuity" });
            newDeduction = string.Empty;
            UpdateAvailableComponents();
            StateHasChanged();
        }
    }

    private void AddCustomEarning()
    {
        if (!string.IsNullOrWhiteSpace(customEarningName) && !salaryDetails.Earnings.Any(e => e.Name == customEarningName))
        {
            salaryDetails.Earnings.Add(new Component { Name = customEarningName, MonthlyAmount = 0, YearlyAmount = 0, IsEditable = true, Percentage = 0, IsPartOfCTC = true });
            newEarning = string.Empty;
            showCustomEarningInput = false;
            customEarningName = string.Empty;
            showEarningDropdown = false;
            UpdateAvailableComponents();
            StateHasChanged();
        }
    }

    private void AddCustomDeduction()
    {
        if (!string.IsNullOrWhiteSpace(customDeductionName) && !salaryDetails.Deductions.Any(d => d.Name == customDeductionName))
        {
            salaryDetails.Deductions.Add(new Component { Name = customDeductionName, MonthlyAmount = 0, YearlyAmount = 0, IsEditable = true, Percentage = 0, IsPartOfCTC = false });
            newDeduction = string.Empty;
            showCustomDeductionInput = false;
            customDeductionName = string.Empty;
            showDeductionDropdown = false;
            UpdateAvailableComponents();
            StateHasChanged();
        }
    }

    private void RemoveEarning(Component earning)
    {
        if (earning.IsEditable)
        {
            salaryDetails.Earnings.Remove(earning);
            if (currentEarningComponent == earning)
            {
                showEarningDropdown = false;
                currentEarningComponent = null;
            }
            UpdateAvailableComponents();
            CheckTotalSalary();
            StateHasChanged();
        }
    }

    private void RemoveDeduction(Component deduction)
    {
        if (deduction.IsEditable)
        {
            salaryDetails.Deductions.Remove(deduction);
            if (currentDeductionComponent == deduction)
            {
                showDeductionDropdown = false;
                currentDeductionComponent = null;
            }
            UpdateAvailableComponents();
            CheckTotalSalary();
            StateHasChanged();
        }
    }

    private void UpdateYearlySalary(decimal value)
    {
        salaryDetails.YearlySalary = value;
        UpdateAllPercentages();
        CheckTotalSalary();
        StateHasChanged();
    }

    private void UpdateEarningMonthlyAmount(Component earning, decimal value)
    {
        earning.MonthlyAmount = value;
        earning.YearlyAmount = value * 12;
        if (salaryDetails.YearlySalary > 0)
        {
            earning.Percentage = (value * 12 / salaryDetails.YearlySalary) * 100;
        }
        else
        {
            earning.Percentage = 0;
        }
        CheckTotalSalary();
        StateHasChanged();
    }

    private void UpdateEarningYearlyAmount(Component earning, decimal value)
    {
        earning.YearlyAmount = value;
        earning.MonthlyAmount = value / 12;
        if (salaryDetails.YearlySalary > 0)
        {
            earning.Percentage = (value / salaryDetails.YearlySalary) * 100;
        }
        else
        {
            earning.Percentage = 0;
        }
        CheckTotalSalary();
        StateHasChanged();
    }

    private void UpdateDeductionMonthlyAmount(Component deduction, decimal value)
    {
        if (deduction.IsEditable)
        {
            deduction.MonthlyAmount = value;
            deduction.YearlyAmount = value * 12;
            if (salaryDetails.YearlyGrossSalary > 0)
            {
                deduction.Percentage = (value * 12 / salaryDetails.YearlyGrossSalary) * 100;
            }
            else
            {
                deduction.Percentage = 0;
            }
            CheckTotalSalary();
            StateHasChanged();
        }
    }

    private void UpdateDeductionYearlyAmount(Component deduction, decimal value)
    {
        if (deduction.IsEditable)
        {
            deduction.YearlyAmount = value;
            deduction.MonthlyAmount = value / 12;
            if (salaryDetails.YearlyGrossSalary > 0)
            {
                deduction.Percentage = (value / salaryDetails.YearlyGrossSalary) * 100;
            }
            else
            {
                deduction.Percentage = 0;
            }
            CheckTotalSalary();
            StateHasChanged();
        }
    }

    private void UpdateEarningPercentage(Component earning, decimal value)
    {
        earning.Percentage = value;
        if (value > 0 && salaryDetails.YearlySalary > 0)
        {
            earning.YearlyAmount = (value / 100) * salaryDetails.YearlySalary;
            earning.MonthlyAmount = earning.YearlyAmount / 12;
        }
        else
        {
            earning.MonthlyAmount = 0;
            earning.YearlyAmount = 0;
        }
        CheckTotalSalary();
        StateHasChanged();
    }

    private void UpdateDeductionPercentage(Component deduction, decimal value)
    {
        if (deduction.IsEditable)
        {
            deduction.Percentage = value;
            if (value > 0 && salaryDetails.YearlyGrossSalary > 0)
            {
                deduction.YearlyAmount = (value / 100) * salaryDetails.YearlyGrossSalary;
                deduction.MonthlyAmount = deduction.YearlyAmount / 12;
            }
            else
            {
                deduction.MonthlyAmount = 0;
                deduction.YearlyAmount = 0;
            }
            CheckTotalSalary();
            StateHasChanged();
        }
    }

    private void TogglePartOfCTC(Component component, bool isPartOfCTC)
    {
        component.IsPartOfCTC = isPartOfCTC;
        CheckTotalSalary();
        StateHasChanged();
    }

    private void UpdateAllPercentages()
    {
        foreach (var earning in salaryDetails.Earnings)
        {
            if (salaryDetails.YearlySalary > 0)
            {
                earning.Percentage = (earning.YearlyAmount / salaryDetails.YearlySalary) * 100;
            }
            else
            {
                earning.Percentage = 0;
            }
        }
        foreach (var deduction in salaryDetails.Deductions)
        {
            if (salaryDetails.YearlyGrossSalary > 0)
            {
                deduction.Percentage = (deduction.YearlyAmount / salaryDetails.YearlyGrossSalary) * 100;
            }
            else
            {
                deduction.Percentage = 0;
            }
        }
        CheckTotalSalary();
    }

    private void CheckTotalSalary()
    {
        decimal totalYearlyEarnings = salaryDetails.Earnings.Where(e => e.IsPartOfCTC).Sum(e => e.YearlyAmount);
        showWarning = totalYearlyEarnings > salaryDetails.YearlySalary;
        StateHasChanged();
    }
}