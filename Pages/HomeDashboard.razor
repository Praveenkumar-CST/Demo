@page "/home"
@using System
@using System.Collections.Generic
@using System.Net.Http
@using System.Text.Json
@using System.Threading.Tasks
@using Components.sidebar
@layout HomeLayout
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@inject EmployeeService EmployeeService
@inject LeaveManagementService LeaveService
@inject MentorAssignmentService MentorService
@inject NavigationManager Navigation
@inject HttpClient Http3

        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="header-content">
                <div class="user-profile">
                    <MudAvatar Sizerge" Class="user-avatar">
                        @(userName?.L.ToUpper() : "A")
                    </MudAvatar>
                    <div class="user-info">
                        <h1 class="welcome-title">
                            Welcome back, @(userName ?? "Admin")
                        </h1>
                        <p class="welcome-subtitle">
                            @DateTime.Now.Toe.Now.ToString("hh:mm tt")
                        </p>
                    </div>
                </div>
                <div class="header-actions">
                    <MudChip T="string" Class="role-chip" Size="Size.Medium" Variant="Variant.Filled">
                        <MudIcon Icon="@GetRoleIcon(userRole)" Class="chip-icon" />
                        @userRole
                    </MudChip>
                    @if (!string.IsNullOrEmpty(userDesignation))
                    {
                        <MudChip T="string" Class="designation-chip" Size="Size.Medium" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.Work" Class="chip-icon" />
                            @userDesignation
                        </MudChip>
                    }
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <p class="loading-text">Loading dashboard...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="error-alert" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Error" Class="alert-icon" />
                @errorMessage
            </MudAlert>
        }
        else
        {
            <!-- Key Metrics -->
            <div class="metrics-section">
                <h2 class="section-title">Dashboard Overview</h2>
                <div class="metrics-grid">
                    <MudPaper Class="metric-card clickable" Elevation="3" @onclick="@(() => NavigateToEmployeeList())">
                        <div class="metric-icon primary">
                            <MudIcon Icon="@Icons.Material.Filled.Group" />
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">@totalEmployees</div>
                            <div class="metric-label">Total Employees</div>
                            <div class="metric-trend positive">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                                Active members
                            </div>
                        </div>
                    </MudPaper>

                    <MudPaper Class="metric-card clickable" Elevation="3" @onclick="@(() => NavigateToLeaveManagement())">
                        <div class="metric-icon warning">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">@pendingLeaves</div>
                            <div class="metric-label">Pending Leave Requests</div>
                            <div class="metric-trend neutral">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                Awaiting approval
                            </div>
                        </div>
                    </MudPaper>

                    <MudPaper Class="metric-card clickable" Elevation="3" @onclick="@(() => NavigateToHolidays())">
                        <div class="metric-icon info">
                            <MudIcon Icon="@Icons.Material.Filled.Event" />
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">@upcomingHolidays</div>
                            <div class="metric-label">Upcoming Holidays</div>
                            <div class="metric-trend positive">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                Next 60 days
                            </div>
                        </div>
                    </MudPaper>

                    <MudPaper Class="metric-card clickable" Elevation="3" @onclick="@(() => NavigateToLeaveManagement())">
                        <div class="metric-icon success">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">@approvedLeaves</div>
                            <div class="metric-label">Approved Leaves</div>
                            <div class="metric-trend positive">
                                <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" />
                                This month
                            </div>
                        </div>
                    </MudPaper>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="dashboard-grid">
                <!-- Recent Leave Activity -->
                <MudPaper Class="dashboard-card" Elevation="3">
                    <div class="card-header">
                        <div class="card-title">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="title-icon" />
                            <h3>Recent Leave Requests</h3>
                        </div>
                        <MudButton Variant="Variant.Text"
                                  Size="Size.Small"
                                  Color="Color.Primary"
                                  @onclick="@(() => NavigateToLeaveManagement())">
                            View All
                        </MudButton>
                    </div>
                    <div class="card-content">
                        @if (recentLeaves?.Any() ?? false)
                        {
                            @foreach (var leave in recentLeaves.Take(5))
                            {
                                <div class="activity-item clickable" @onclick="@(() => NavigateToLeaveManagement())">
                                    <MudAvatar Size="Size.Small" Class="activity-avatar">
                                        @(leave.Name?.Length > 0 ? leave.Name[0].ToString().ToUpper() : "U")
                                    </MudAvatar>
                                    <div class="activity-details">
                                        <div class="activity-text">
                                            <strong>@leave.Name</strong> requested @leave.LeaveType leave
                                        </div>
                                        <div class="activity-meta">
                                            @leave.StartDate.ToString("MMM dd") - @leave.EndDate.ToString("MMM dd") • @GetDaysDifference(leave.StartDate, leave.EndDate) days
                                        </div>
                                    </div>
                                    <div class="activity-status">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetStatusColor(leave.Status)"
                                                 Variant="Variant.Filled">
                                            @leave.Status
                                        </MudChip>
                                        @if (leave.Status == "Pending" && userRole == "Admin")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="nav-icon" />
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="empty-icon" />
                                <p>No recent leave requests</p>
                            </div>
                        }
                    </div>
                </MudPaper>

                <!-- Upcoming Holidays -->
                <MudPaper Class="dashboard-card" Elevation="3">
                    <div class="card-header">
                        <div class="card-title">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Class="title-icon" />
                            <h3>Upcoming Holidays</h3>
                        </div>
                        <MudButton Variant="Variant.Text"
                                  Size="Size.Small"
                                  Color="Color.Primary"
                                  @onclick="@(() => NavigateToHolidays())">
                            View All
                        </MudButton>
                    </div>
                    <div class="card-content">
                        @if (holidays?.Any() ?? false)
                        {
                            @foreach (var holiday in holidays.Take(5))
                            {
                                var holidayDate = DateTime.TryParse(holiday.Date, out var date) ? date : DateTime.Now;
                                <div class="event-item clickable" @onclick="@(() => NavigateToHolidays())">
                                    <div class="event-date">
                                        <div class="event-month">@holidayDate.ToString("MMM")</div>
                                        <div class="event-day">@holidayDate.Day</div>
                                    </div>
                                    <div class="event-details">
                                        <div class="event-title">@holiday.Description</div>
                                        <div class="event-time">
                                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                            @holidayDate.ToString("dddd") • @GetDaysUntilHoliday(holidayDate)
                                        </div>
                                    </div>
                                    <div class="event-actions">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@GetHolidayTypeColor(holiday.HolidayType)"
                                                 Variant="Variant.Text">
                                            @holiday.HolidayType
                                        </MudChip>
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="nav-icon" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="empty-icon" />
                                <p>No upcoming holidays</p>
                            </div>
                        }
                    </div>
                </MudPaper>

                @if (userRole == "Admin")
                {
                    <!-- Team Management -->
                    <MudPaper Class="dashboard-card" Elevation="3">
                        <div class="card-header">
                            <div class="card-title">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Class="title-icon" />
                                <h3>Team Management</h3>
                            </div>
                            <MudButton Variant="Variant.Text"
                                      Size="Size.Small"
                                      Color="Color.Primary"
                                      @onclick="@(() => NavigateToEmployeeList())">
                                Manage Team
                            </MudButton>
                        </div>
                        <div class="card-content">
                            <div class="team-stats">
                                <div class="stat-item">
                                    <div class="stat-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-number">@totalEmployees</div>
                                        <div class="stat-label">Total Employees</div>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Secondary" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-number">@totalDesignations</div>
                                        <div class="stat-label">Designations</div>
                                    </div>
                                </div>
                                <div class="stat-item">
                                    <div class="stat-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Info" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-number">@totalLocations</div>
                                        <div class="stat-label">Locations</div>
                                    </div>
                                </div>
                            </div>
                            <div class="quick-actions">
                                <MudButton Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          StartIcon="@Icons.Material.Filled.PersonAdd"
                                          @onclick="@(() => NavigateToAddEmployee())"
                                          Class="action-btn">
                                    Add Employee
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          StartIcon="@Icons.Material.Filled.Assignment"
                                          @onclick="@(() => NavigateToLeaveManagement())"
                                          Class="action-btn">
                                    Manage Leaves
                                </MudButton>
                            </div>
                            <div class="clock-actions">
                                <MudButton Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          StartIcon="@Icons.Material.Filled.Login"
                                          @onclick="@ToggleClock"
                                          Class="clock-btn">
                                    @(isClockedIn ? "Clock Out" : "Clock In")
                                </MudButton>
                            </div>
                        </div>
                    </MudPaper>
                }
            </div>

@if (showSnackbar)
{
    <div class="snackbar show">
        @snackbarMessage
    </div>
}

<style>
    /* Header Section */
    .dashboard-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-avatar {
        width: 64px !important;
        height: 64px !important;
        background: linear-gradient(135deg, #3b82f6, #1e40af) !important;
        color: white !important;
        font-size: 1.5rem !important;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .user-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .welcome-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
        line-height: 1.2;
    }

    .welcome-subtitle {
        font-size: 0.95rem;
        color: #64748b;
        margin: 0;
        font-weight: 500;
    }

    .header-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .role-chip {
        background: linear-gradient(135deg, #3b82f6, #1e40af) !important;
        color: white !important;
        font-weight: 500 !important;
        border: none !important;
    }

    .designation-chip {
        background: linear-gradient(135deg, #059669, #047857) !important;
        color: white !important;
        font-weight: 500 !important;
        border: none !important;
    }

    .chip-icon {
        font-size: 1rem !important;
        margin-right: 0.25rem !important;
    }

    /* Loading */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        gap: 1.5rem;
    }

    .loading-text {
        color: #64748b;
        font-size: 1.1rem;
        font-weight: 500;
        margin: 0;
    }

    /* Error Alert */
    .error-alert {
        background: #ef4444 !important;
        color: white !important;
        border-radius: 12px !important;
        margin-bottom: 2rem;
    }

    .alert-icon {
        margin-right: 0.5rem !important;
    }

    /* Metrics Section */
    .metrics-section {
        margin-bottom: 2rem;
    }

    .section-title {
        color: #1e293b;
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 1.5rem 0;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .metric-card {
        background: white !important;
        border-radius: 16px !important;
        padding: 1.5rem !important;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
        border: 1px solid #e2e8f0 !important;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12) !important;
        border-color: #3b82f6;
    }

    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
    }

    .metric-icon.primary { background: linear-gradient(135deg, #3b82f6, #1e40af); }
    .metric-icon.warning { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .metric-icon.info { background: linear-gradient(135deg, #06b6d4, #0891b2); }
    .metric-icon.success { background: linear-gradient(135deg, #059669, #047857); }

    .metric-content {
        flex: 1;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .metric-label {
        font-size: 0.875rem;
        color: #64748b;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .metric-trend {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .metric-trend.positive { color: #059669; }
    .metric-trend.neutral { color: #d97706; }

    /* Dashboard Grid */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 2rem;
    }

    .dashboard-card {
        background: white !important;
        border-radius: 16px !important;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08) !important;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12) !important;
    }

    .card-header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fafbfc;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .card-title h3 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }

    .title-icon {
        color: #3b82f6 !important;
        font-size: 1.25rem !important;
    }

    .card-content {
        padding: 1.5rem 2rem 2rem;
    }

    /* Activity Items */
    .activity-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .activity-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .activity-item.clickable {
        cursor: pointer;
        border-radius: 8px;
        margin: 0 -0.5rem;
        padding: 1rem 0.5rem;
    }

    .activity-item.clickable:hover {
        background: #f8fafc;
        transform: translateX(4px);
    }

    .activity-avatar {
        background: linear-gradient(135deg, #06b6d4, #0891b2) !important;
        color: white !important;
        font-weight: 600;
    }

    .activity-details {
        flex: 1;
    }

    .activity-text {
        color: #1e293b;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .activity-meta {
        color: #64748b;
        font-size: 0.8rem;
    }

    .activity-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-icon {
        color: #94a3b8 !important;
        font-size: 1.2rem !important;
    }

    /* Event Items */
    .event-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .event-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .event-item.clickable {
        cursor: pointer;
        border-radius: 8px;
        margin: 0 -0.5rem;
        padding: 1rem 0.5rem;
    }

    .event-item.clickable:hover {
        background: #f8fafc;
        transform: translateX(4px);
    }

    .event-date {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        border-radius: 10px;
        padding: 0.5rem;
        text-align: center;
        color: white;
        min-width: 54px;
    }

    .event-month {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        line-height: 1;
    }

    .event-day {
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 2px;
    }

    .event-details {
        flex: 1;
    }

    .event-title {
        color: #1e293b;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .event-time {
        color: #64748b;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .event-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Team Management */
    .team-stats {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem;
        background: #f8fafc;
        border-radius: 8px;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-info {
        flex: 1;
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 0.25rem;
    }

    .quick-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .action-btn {
        flex: 1;
        min-width: 140px;
    }

    .clock-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .clock-btn {
        flex: 1;
        min-width: 140px;
    }

    /* Empty States */
    .empty-state {
        text-align: center;
        padding: 2rem 0;
        color: #94a3b8;
    }

    .empty-icon {
        font-size: 2.5rem !important;
        margin-bottom: 0.5rem;
        opacity: 0.6;
    }

    .empty-state p {
        margin: 0;
        font-size: 0.9rem;
    }

    /* Clickable elements */
    .clickable {
        cursor: pointer;
        user-select: none;
    }

    .clickable:active {
        transform: scale(0.98);
    }

    /* Snackbar */
    .snackbar {
        visibility: hidden;
        min-width: 250px;
        background-color: #333;
        color: #fff;
        text-align: center;
        border-radius: 4px;
        padding: 16px;
        position: fixed;
        z-index: 1;
        left: 50%;
        transform: translateX(-50%);
        bottom: 30px;
        font-size: 14px;
        opacity: 0;
        transition: opacity 0.5s, visibility 0.5s;
    }

    .snackbar.show {
        visibility: visible;
        opacity: 1;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .dashboard-content {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .welcome-title {
            font-size: 1.5rem;
        }

        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions {
            flex-direction: column;
        }

        .action-btn {
            min-width: auto;
        }
    }

    @@media (max-width: 480px) {
        .dashboard-header {
            padding: 1.5rem;
        }

        .card-header {
            padding: 1rem 1.5rem;
        }

        .card-content {
            padding: 1rem 1.5rem 1.5rem;
        }

        .metric-card {
            padding: 1.25rem !important;
        }
    }

    /* Performance optimizations */
    .dashboard-card, .metric-card {
        will-change: transform;
    }

    /* Accessibility */
    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }

    /* Focus styles for accessibility */
    .clickable:focus-visible {
        outline: 2px solid #3b82f6;
        outline-offset: 2px;
    }
