<script>
    function playSound() {
        var audio = new Audio('/audio/thankyou.mp3');
        audio.play().catch(e => console.error("Audio playback failed:", e));
    }

    async function getUserIP() {
        const response = await fetch('https://api.ipify.org?format=json');
        const data = await response.json();
        return data.ip;
    }
</script>

@code {
    private bool isClockedIn = false;
    private bool showSnackbar = false;
    private string snackbarMessage = string.Empty;
    private string userRole = "User";
    private string userName = "Admin";
    private string userEmail;
    private string userEmployeeId;
    private string userDesignation;
    private string userLocation = "Default Location";
    private bool isLoading = true;
    private string errorMessage;
    private int totalEmployees = 0;
    private int totalDesignations = 0;
    private int totalLocations = 0;
    private int pendingLeaves = 0;
    private int approvedLeaves = 0;
    private int upcomingHolidays = 0;
    private List<LeaveRequest> recentLeaves = new();
    private List<Events> holidays = new();
    private List<EmployeeDetails> employees = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadUserRoleAndDetails();
            var loadTasks = new List<Task>
            {
                LoadEmployeeData(),
                LoadLeaveData(),
                LoadHolidayData()
            };

            await Task.WhenAll(loadTasks);
            Console.WriteLine($"Dashboard loaded - Employees: {totalEmployees}, Pending Leaves: {pendingLeaves}, Upcoming Holidays: {upcomingHolidays}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard data: {ex.Message}";
            Console.WriteLine($"Dashboard initialization error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadUserRoleAndDetails()
    {
        try
        {
            userRole = await GetUserRoleFromSupabase();
            await LoadUserDetails();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details: {ex.Message}");
        }
    }

    private async Task LoadEmployeeData()
    {
        try
        {
            employees = await EmployeeService.GetAllEmployees() ?? new();
            totalEmployees = employees.Count;
            totalDesignations = employees
                .Where(e => !string.IsNullOrWhiteSpace(e.Designation))
                .Select(e => e.Designation.Trim())
                .Distinct()
                .Count();
            totalLocations = employees
                .Where(e => !string.IsNullOrWhiteSpace(e.JoiningLocation))
                .Select(e => e.JoiningLocation.Trim())
                .Distinct()
                .Count();
            Console.WriteLine($"Loaded {totalEmployees} employees, {totalDesignations} designations, {totalLocations} locations");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee data: {ex.Message}");
        }
    }

    private async Task LoadLeaveData()
    {
        try
        {
            var allLeaves = await LeaveService.GetPendingRequestsAsync() ?? new();
            recentLeaves = allLeaves
                .OrderByDescending(l => l.StartDate)
                .ToList();

            pendingLeaves = allLeaves.Count(l => l.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true);
            try
            {
                var userHistory = await LeaveService.GetMyLeaveHistoryAsync();
                if (userHistory?.History != null)
                {
                    var currentMonth = DateTime.Now.Month;
                    var currentYear = DateTime.Now.Year;
                    approvedLeaves = userHistory.History
                        .Count(l => l.Status?.Equals("Approved", StringComparison.OrdinalIgnoreCase) == true &&
                                     l.StartDate.Month == currentMonth &&
                                     l.StartDate.Year == currentYear);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading user leave history: {ex.Message}");
                approvedLeaves = 0;
            }
            Console.WriteLine($"Loaded {recentLeaves.Count} recent leaves, {pendingLeaves} pending, {approvedLeaves} approved this month");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading leave data: {ex.Message}");
        }
    }

    private async Task LoadHolidayData()
    {
        try
        {
            if (!string.IsNullOrEmpty(userEmployeeId))
            {
                var employee = await EmployeeService.GetEmployeeDetails(userEmployeeId);
                if (employee?.JoiningLocation != null)
                {
                    userLocation = employee.JoiningLocation;
                }
            }

            var currentYear = DateTime.Now.Year;
            string apiUrl = $"/api/Events?location={Uri.EscapeDataString(userLocation)}&year={currentYear}";

            var httpResponse = await Http.GetAsync(apiUrl);
            if (httpResponse.IsSuccessStatusCode)
            {
                var allHolidays = await httpResponse.Content.ReadFromJsonAsync<Events[]>() ?? Array.Empty<Events>();
                var today = DateTime.Today;
                var next60Days = today.AddDays(60);
                holidays = allHolidays
                    .Where(h => DateTime.TryParse(h.Date, out var date) &&
                                date >= today &&
                                date <= next60Days)
                    .OrderBy(h => DateTime.Parse(h.Date))
                    .ToList();

                upcomingHolidays = holidays.Count;
                Console.WriteLine($"Loaded {holidays.Count} upcoming holidays for location: {userLocation}");
                foreach (var holiday in holidays.Take(3))
                {
                    Console.WriteLine($"Holiday: {holiday.Description} on {holiday.Date}");
                }
            }
            else
            {
                Console.WriteLine($"Failed to load holidays: {httpResponse.StatusCode} - {httpResponse.ReasonPhrase}");
                holidays = new();
                upcomingHolidays = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading holiday data: {ex.Message}");
            holidays = new();
            upcomingHolidays = 0;
        }
    }

    private async Task<string> GetUserRoleFromSupabase()
    {
        try
        {
            var (role, error) = await AuthService.VerifyToken();
            if (!string.IsNullOrEmpty(error))
            {
                Console.WriteLine($"Auth error: {error}");
            }
            return !string.IsNullOrEmpty(role) ? role : "User";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting user role: {ex.Message}");
            return "User";
        }
    }

    private async Task LoadUserDetails()
    {
        try
        {
            userEmail = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "email");
            if (!string.IsNullOrWhiteSpace(userEmail))
            {
                var employee = await EmployeeService.GetEmployeeDetailsByEmail(userEmail);
                if (employee != null)
                {
                    userName = employee.FirstName ?? "User";
                    userEmployeeId = employee.EmployeeID;
                    userDesignation = employee.Designation;
                    if (!string.IsNullOrEmpty(employee.JoiningLocation))
                    {
                        userLocation = employee.JoiningLocation;
                    }
                    Console.WriteLine($"User loaded: {userName}, Role: {userRole}, Location: {userLocation}");
                }
                else
                {
                    userName = GetNameFromEmail(userEmail);
                    Console.WriteLine($"Employee not found, using name from email: {userName}");
                }
            }
            else
            {
                Console.WriteLine("No email found in session storage");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user details: {ex.Message}");
        }
    }

    private string GetNameFromEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return "User";
        try
        {
            var name = email.Split('@')[0];
            return char.ToUpper(name[0]) + name.Substring(1).ToLower();
        }
        catch
        {
            return "User";
        }
    }

    private Color GetStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => Color.Success,
            "pending" => Color.Warning,
            "rejected" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetHolidayTypeColor(string holidayType)
    {
        return holidayType?.ToLower() switch
        {
            "permanent" => Color.Primary,
            "optional" => Color.Secondary,
            "fixed" => Color.Info,
            _ => Color.Default
        };
    }

    private string GetRoleIcon(string role)
    {
        return role?.ToLower() switch
        {
            "admin" => Icons.Material.Filled.AdminPanelSettings,
            "manager" => Icons.Material.Filled.ManageAccounts,
            "lead" => Icons.Material.Filled.Group,
            "user" => Icons.Material.Filled.Person,
            _ => Icons.Material.Filled.Person
        };
    }

    private int GetDaysDifference(DateTime startDate, DateTime endDate)
    {
        return Math.Max(1, (endDate - startDate).Days + 1);
    }

    private string GetDaysUntilHoliday(DateTime holidayDate)
    {
        var days = (holidayDate - DateTime.Today).Days;
        return days switch
        {
            0 => "Today",
            1 => "Tomorrow",
            _ when days > 0 => $"in {days} days",
            _ => "Past"
        };
    }

    private void NavigateToEmployeeList()
    {
        Navigation.NavigateTo("/home/employeeList");
    }

    private void NavigateToLeaveManagement()
    {
        Navigation.NavigateTo("/leaves/admin");
    }

    private void NavigateToHolidays()
    {
        Navigation.NavigateTo("/Calendar/holiday");
    }

    private void NavigateToAddEmployee()
    {
        Navigation.NavigateTo("/home/employees");
    }

    private async Task ToggleClock()
    {
        try
        {
            var ipAddress = await JSRuntime.InvokeAsync<string>("getUserIP");
            var locationDetails = await GetLocationDetails(ipAddress);
            snackbarMessage = !string.IsNullOrEmpty(locationDetails) ? $"Successfully done! Your current location is: {locationDetails}" : "Unable to determine your location.";
            showSnackbar = true;

            await JSRuntime.InvokeVoidAsync("playSound");

            await Task.Delay(2000);
            showSnackbar = false;

            isClockedIn = !isClockedIn;
        }
        catch (Exception ex)
        {
            snackbarMessage = $"Error: {ex.Message}";
            showSnackbar = true;
            await Task.Delay(2000);
            showSnackbar = false;
        }
    }

    private async Task<string> GetLocationDetails(string ipAddress)
    {
        var url = $"http://ip-api.com/json/{ipAddress}";
        var response = await Http.GetAsync(url);

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            var locationData = JsonSerializer.Deserialize<IpLocationData>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (locationData != null && locationData.Status == "success")
            {
                return $"{locationData.City}, {locationData.RegionName}, {locationData.Country}";
            }
        }

        return "Unknown location";
    }

    public class IpLocationData
    {
        public string Status { get; set; }
        public string Country { get; set; }
        public string RegionName { get; set; }
        public string City { get; set; }
        public double Lat { get; set; }
        public double Lon { get; set; }
    }
    }
}