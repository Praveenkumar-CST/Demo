    }

    private async Task<TableData<AnalyticsResultDto>> ServerReload(TableState state, CancellationToken token)
    {
        await Task.Delay(1, token);
        _lastTableState = state;

        IEnumerable<AnalyticsResultDto> data = _filteredEmployees;
        if (!string.IsNullOrWhiteSpace(SearchString))
        {
            string lowerSearch = SearchString.ToLowerInvariant();
            data = data.Where(e =>
                (e.FirstName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.LastName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.MiddleName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.Designation?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeID?.ToLowerInvariant().Contains(lowerSearch) ?? false)
            );
        }

        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            switch (state.SortLabel)
            {
                case "name_sort": data = data.OrderByDirection(state.SortDirection, e => $"{e.FirstName} {e.LastName}"); break;
                case "designation_sort": data = data.OrderByDirection(state.SortDirection, e => e.Designation ?? ""); break;
                case "id_sort": data = data.OrderByDirection(state.SortDirection, e => e.EmployeeID); break;
            }
        }

        var totalItems = data.Count();
        var pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToList();
        return new TableData<AnalyticsResultDto>() { TotalItems = totalItems, Items = pagedData };
    }

