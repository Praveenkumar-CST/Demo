    private void CalculateStats()
    {
        if (!_filteredEmployees.Any())
        {
            _totalEmployees = 0;
            _uniqueDesignations = 0;
            _uniqueBloodGroups = 0;
            return;
        }
        _totalEmployees = _filteredEmployees.Count;
        _uniqueDesignations = _filteredEmployees.Select(e => e.Designation).Where(d => !string.IsNullOrEmpty(d)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _uniqueBloodGroups = _filteredEmployees.Select(e => e.BloodGroup).Where(b => !string.IsNullOrEmpty(b)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Length > 0 ? parts[0][0].ToString().ToUpper() : "?";
        return $"{parts[0][0]}{parts.Last()[0]}".ToUpper();
    }

    private async Task<IEnumerable<string>> SearchNationalities(string value, CancellationToken token)
    {
        if (!_nationalityLoaded)
        {
            try
            {
                var authToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
                var request = new HttpRequestMessage(HttpMethod.Get, "api/Lookup/nationalities");
                if (!string.IsNullOrEmpty(authToken))
                {
                    request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", authToken);
                }

                var response = await Http.SendAsync(request, token);
                if (response.IsSuccessStatusCode)
                {
                    var r = await response.Content.ReadFromJsonAsync<List<string>>(cancellationToken: token);
                    if (r != null)
                        _nationalitySuggestions = r.OrderBy(s => s).ToList();
                    _nationalityLoaded = true;
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync(cancellationToken: token);
                    Console.WriteLine($"Error loading nationalities ({response.StatusCode}): {errorContent}");
                    _nationalitySuggestions = new List<string>();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading nationalities: {ex.Message}");
                _nationalitySuggestions = new List<string>();
            }
        }

        if (string.IsNullOrEmpty(value))
            return _nationalitySuggestions.Take(10);

        return _nationalitySuggestions
            .Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(10);
    }

