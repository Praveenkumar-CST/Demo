    private async Task<TableData<EmployeeAnalyticsResponseDto>> ServerReload(TableState state, CancellationToken token)
    {
        await Task.Delay(1, token);
        _lastTableState = state;

        IEnumerable<EmployeeAnalyticsResponseDto> data = _filteredEmployees;
        if (!string.IsNullOrWhiteSpace(SearchString))
        {
            string lowerSearch = SearchString.ToLowerInvariant();
            data = data.Where(e =>
                (e.EmployeeDetails.FirstName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.LastName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.MiddleName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.Designation?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.EmployeeID?.ToLowerInvariant().Contains(lowerSearch) ?? false)||
                (e.EmployeeDetails.FatherName?.ToLowerInvariant().Contains(lowerSearch) ?? false)||
                (e.EmployeeDetails.MotherName?.ToLowerInvariant().Contains(lowerSearch) ?? false)||
                (e.EmployeeDetails.Level?.ToLowerInvariant().Contains(lowerSearch) ?? false)||
                (e.EmployeeDetails.CurrentMobile?.ToLowerInvariant().Contains(lowerSearch) ?? false)||
                (e.EmployeeDetails.PassportNo?.ToLowerInvariant().Contains(lowerSearch) ?? false)

            );
        }

        if (!string.IsNullOrEmpty(state.SortLabel))
        {
            switch (state.SortLabel)
            {
                case "name_sort": data = data.OrderByDirection(state.SortDirection, e => $"{e.EmployeeDetails.FirstName ?? string.Empty} {e.EmployeeDetails.LastName ?? string.Empty}"); break;
                case "designation_sort": data = data.OrderByDirection(state.SortDirection, e => e.EmployeeDetails.Designation ?? string.Empty); break;
                case "id_sort": data = data.OrderByDirection(state.SortDirection, e => e.EmployeeDetails.EmployeeID ?? string.Empty); break;
            }
        }

        var totalItems = data.Count();
        var pagedData = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToList();
        return new TableData<EmployeeAnalyticsResponseDto>() { TotalItems = totalItems, Items = pagedData };
    }

