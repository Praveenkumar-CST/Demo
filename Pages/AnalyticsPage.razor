    private string BuildFilterQueryString(AnalyticsFilterDto dto)
    {
        var parameters = new Dictionary<string, string>();
        void AddIfNotNullOrEmpty(string key, string? value) { if (!string.IsNullOrEmpty(value)) parameters.Add(key, System.Net.WebUtility.UrlEncode(value)); }
        void AddIfNotNull<T>(string key, T? value) where T : struct { if (value.HasValue) parameters.Add(key, System.Net.WebUtility.UrlEncode(value.Value.ToString())); }
        void AddIfDateNotNull(string key, DateTime? value) { if (value.HasValue) parameters.Add(key, System.Net.WebUtility.UrlEncode(value.Value.ToString("yyyy-MM-dd"))); }

        AddIfNotNullOrEmpty(nameof(dto.BloodGroup), dto.BloodGroup);
        AddIfNotNullOrEmpty(nameof(dto.BankName), dto.BankName);
        AddIfNotNullOrEmpty(nameof(dto.Designation), dto.Designation);
        AddIfNotNullOrEmpty(nameof(dto.JoiningLocation), dto.JoiningLocation);
        AddIfNotNullOrEmpty(nameof(dto.Gender), dto.Gender);
        AddIfNotNullOrEmpty(nameof(dto.MaritalStatus), dto.MaritalStatus);
        AddIfNotNullOrEmpty(nameof(dto.Nationality), dto.Nationality);
        AddIfNotNullOrEmpty(nameof(dto.TypeOfEmployment), dto.TypeOfEmployment);
        AddIfNotNullOrEmpty(nameof(dto.Level), dto.Level);
        AddIfNotNullOrEmpty(nameof(dto.CurrentCity), dto.CurrentCity);
        AddIfNotNullOrEmpty(nameof(dto.CurrentState), dto.CurrentState);
        AddIfNotNullOrEmpty(nameof(dto.PermanentCity), dto.PermanentCity);
        AddIfNotNullOrEmpty(nameof(dto.PermanentState), dto.PermanentState);
        AddIfDateNotNull(nameof(dto.DateOfJoiningStart), dto.DateOfJoiningStart);
        AddIfDateNotNull(nameof(dto.DateOfJoiningEnd), dto.DateOfJoiningEnd);
        AddIfDateNotNull(nameof(dto.DateOfBirthStart), dto.DateOfBirthStart);
        AddIfDateNotNull(nameof(dto.DateOfBirthEnd), dto.DateOfBirthEnd);
        AddIfNotNullOrEmpty(nameof(dto.PhysicallyChallenged), dto.PhysicallyChallenged);
        AddIfNotNullOrEmpty(nameof(dto.BankBranch), dto.BankBranch);
        AddIfNotNullOrEmpty(nameof(dto.BankState), dto.BankState);
        AddIfNotNullOrEmpty(nameof(dto.AccountType), dto.AccountType);
        AddIfNotNullOrEmpty(nameof(dto.PANNumber), dto.PANNumber);
        AddIfNotNullOrEmpty(nameof(dto.AadhaarNumber), dto.AadhaarNumber);
        AddIfNotNullOrEmpty("EducationUniversity", dto.College);
        AddIfNotNullOrEmpty(nameof(dto.Qualification), dto.Qualification);
        AddIfNotNull(nameof(dto.YearOfPassingStart), dto.YearOfPassingStart);
        AddIfNotNull(nameof(dto.YearOfPassingEnd), dto.YearOfPassingEnd);
        AddIfNotNull(nameof(dto.EducationPercentageMin), dto.EducationPercentageMin);
        AddIfNotNull(nameof(dto.EducationPercentageMax), dto.EducationPercentageMax);
        AddIfNotNullOrEmpty("WorkEmployer", dto.PreviousEmployer);
        AddIfNotNullOrEmpty("WorkDesignation", dto.PreviousDesignation);
        AddIfNotNullOrEmpty("WorkLocation", dto.PreviousLocation);
        AddIfDateNotNull("WorkDateOfJoiningStart", dto.PreviousJobStartDateStart);
        AddIfDateNotNull("WorkDateOfJoiningEnd", dto.PreviousJobStartDateEnd);
        AddIfDateNotNull("WorkDateOfLeavingStart", dto.PreviousJobEndDateStart);
        AddIfDateNotNull("WorkDateOfLeavingEnd", dto.PreviousJobEndDateEnd);
        AddIfNotNullOrEmpty(nameof(dto.PassportNationality), dto.PassportNationality);
        AddIfDateNotNull(nameof(dto.PassportIssueDateStart), dto.PassportIssueDateStart);
        AddIfDateNotNull(nameof(dto.PassportIssueDateEnd), dto.PassportIssueDateEnd);
        AddIfDateNotNull(nameof(dto.PassportExpiryDateStart), dto.PassportExpiryDateStart);
        AddIfDateNotNull(nameof(dto.PassportExpiryDateEnd), dto.PassportExpiryDateEnd);
        AddIfNotNullOrEmpty(nameof(dto.CurrentZip), dto.CurrentZip);
        AddIfNotNullOrEmpty(nameof(dto.PermanentZip), dto.PermanentZip);
        AddIfNotNull(nameof(dto.HasAllergies), dto.HasAllergies);
        AddIfNotNull(nameof(dto.HasMedications), dto.HasMedications);
        return parameters.Any() ? "?" + string.Join("&", parameters.Select(p => $"{p.Key}={p.Value}")) : string.Empty;
    }

    private async Task ApplyFilters()
    {
        _isLoading = true;
        _errorMessage = null;
        _filteredEmployees.Clear();
        StateHasChanged();
        try
        {
			var Token = await JSRuntime.InvokeAsync<string>("localStorage.getItem" , "authToken");

            string queryString = BuildFilterQueryString(_filterDto);
            
            string apiUrl = $"/api/Analytics/filter{queryString}";
            Console.WriteLine($"Applying filters with GET request to: {apiUrl}");
			var request = new HttpRequestMessage(HttpMethod.Get, apiUrl);
			request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", Token);
          

			
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                _filteredEmployees = await response.Content.ReadFromJsonAsync<List<AnalyticsResultDto>>() ?? new List<AnalyticsResultDto>();
                Console.WriteLine($"Analytics filter successful: Found {_filteredEmployees.Count} employees.");
                bool isUnfiltered = string.IsNullOrEmpty(queryString);
                if (isUnfiltered && !_initialLoadComplete)
                {
                    _systemTotalEmployees = _filteredEmployees.Count;
                    _systemTotalDesignations = _filteredEmployees.Select(e => e.Designation).Where(d => !string.IsNullOrEmpty(d)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                    _systemTotalBloodGroups = _filteredEmployees.Select(e => e.BloodGroup).Where(b => !string.IsNullOrEmpty(b)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                }
                CalculateStats();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _filteredEmployees.Clear();
                _errorMessage = await response.Content.ReadAsStringAsync();
                if (string.IsNullOrWhiteSpace(_errorMessage)) { _errorMessage = "No employees found matching the criteria."; }
                Console.WriteLine($"Analytics filter returned 404: {_errorMessage}");
                CalculateStats();
            }
            else
            {
                _filteredEmployees.Clear();
                var errorContent = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Error fetching analytics data ({response.StatusCode}): {response.ReasonPhrase}. {errorContent}";
                Console.WriteLine($"Analytics filter error: {response.StatusCode} - {_errorMessage}");
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            _filteredEmployees.Clear();
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
            Console.WriteLine($"Analytics filter exception: {ex}");
            CalculateStats();
        }
        finally
        {
            if (!_initialLoadComplete) _initialLoadComplete = true;
            _isLoading = false;
            StateHasChanged();
            await (_table?.ReloadServerData() ?? Task.CompletedTask);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
