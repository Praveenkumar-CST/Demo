    private List<AnalyticsResultDto> GetFilteredAndSortedEmployees()
    {
        IEnumerable<AnalyticsResultDto> data = _filteredEmployees;

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchString))
        {
            string lowerSearch = SearchString.ToLowerInvariant();
            data = data.Where(e =>
                (e.FirstName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.LastName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.MiddleName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.Designation?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeID?.ToLowerInvariant().Contains(lowerSearch) ?? false)
            );
        }

        // Apply sorting based on stored state
        if (_lastTableState != null && !string.IsNullOrEmpty(_lastTableState.SortLabel))
        {
            switch (_lastTableState.SortLabel)
            {
                case "name_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => $"{e.FirstName} {e.LastName}"); break;
                case "designation_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => e.Designation ?? ""); break;
                case "id_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => e.EmployeeID); break;
            }
        }
        else // Default sort if none applied
        {
            data = data.OrderBy(e => e.FirstName).ThenBy(e => e.LastName);
        }

        return data.ToList();
    }

    private async Task DownloadFilteredEmployees()
    {
        var employeesToDownload = GetFilteredAndSortedEmployees();
        if (!employeesToDownload.Any())
        {
            // Optionally show a message to the user
            return;
        }

        try
        {
            // Generate CSV content
            var csvContent = new System.Text.StringBuilder();
 
            // === START: Helper Functions ===
            Func<string?, string> escape = (val) =>
            {
                if (string.IsNullOrEmpty(val)) return "";
                string escaped = val.Replace("\"", "\"\""); // Replace one quote with two quotes
                if (escaped.Contains(',') || escaped.Contains('\"') || escaped.Contains('\n') || escaped.Contains('\r'))
                {
                    return $"\"{escaped}\""; // Wrap in quotes
                }
                return escaped;
            };
            Func<DateTime?, string> formatDate = (date) => date?.ToString("yyyy-MM-dd") ?? "";
            Func<bool?, string> formatBool = (b) => b.HasValue ? b.Value.ToString() : "";
            Func<double?, string> formatDouble = (d) => d.HasValue ? d.Value.ToString("F2") : "";
            Func<int?, string> formatInt = (i) => i.HasValue ? i.Value.ToString() : "";
            // === END: Helper Functions ===
 
            // Header Row - Dynamically create based on updated AnalyticsResultDto properties (excluding ProfilePicture)
            var header = string.Join(",", typeof(AnalyticsResultDto).GetProperties()
                                        .Where(p => p.Name != nameof(AnalyticsResultDto.ProfilePicture))
                                        .Select(p => escape(p.Name))); // Escape header names too
            csvContent.AppendLine(header);

            // Data rows
            foreach (var emp in employeesToDownload)
            {
                // Create CSV row using properties from the updated AnalyticsResultDto
                var values = typeof(AnalyticsResultDto).GetProperties()
                    .Where(p => p.Name != nameof(AnalyticsResultDto.ProfilePicture))
                    .Select(p =>
                    {
                        var value = p.GetValue(emp);
                        return value switch
                        {
                            DateTime dt => formatDate(dt),
                            DateTimeOffset dto => formatDate(dto.DateTime), // Handle DateTimeOffset if needed
                            bool b => formatBool(b),
                            int i => formatInt(i),
                            double d => formatDouble(d),
                            decimal dec => formatDouble((double?)dec), // Handle decimal if needed
                            _ => escape(value?.ToString()),
                        };
                    });
                csvContent.AppendLine(string.Join(",", values));
            }

            // Prepare for download
            var fileBytes = System.Text.Encoding.UTF8.GetBytes(csvContent.ToString());
            var base64Content = Convert.ToBase64String(fileBytes);
            var fileName = $"FilteredEmployees_{DateTime.Now:yyyyMMddHHmmss}.csv";
            var contentType = "text/csv";

            // Trigger download using JavaScript interop
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, base64Content);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error generating or downloading file: {ex.Message}";
            Console.WriteLine($"Download error: {ex}");
            StateHasChanged(); // Update UI to show error
        }
    }
