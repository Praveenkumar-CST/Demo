@page "/analytics"
@using Microsoft.AspNetCore.Components
@using WiseHR.Models
@using WiseHR.Dtos
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager NavigationManager
@layout WiseHR.Components.sidebar.HomeLayout
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4" Style="height: calc(100vh - 64px); display: flex; flex-direction: column;">
    <MudText Typo="Typo.h5" Class="mb-2">Employee Analytics</MudText>

    <MudGrid Spacing="2" Style="flex: 1; min-height: 0;">
        @* Filter Section *@
        <MudItem xs="12" md="3" Style="display: flex; flex-direction: column;">
            <MudPaper Class="pa-3" Elevation="1" Style="height: 100%; display: flex; flex-direction: column; overflow-y: auto;">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Filters</MudText>

                <MudExpansionPanels MultiExpansion="true">
                    <MudExpansionPanel Text="Personal" IsInitiallyExpanded="true">
                        <MudSelect T="string" @bind-Value="_filterDto.BloodGroup" Label="Blood Group" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            @foreach (var group in _bloodGroups)
                            {
                                <MudSelectItem Value="@group">@group</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_filterDto.Gender" Label="Gender" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            @foreach (var gender in _genders)
                            {
                                <MudSelectItem Value="@gender">@gender</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_filterDto.MaritalStatus" Label="Marital Status" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                             @foreach (var status in _maritalStatuses)
                            {
                                <MudSelectItem Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>
                        <MudAutocomplete T="string" @bind-Value="_filterDto.Nationality" Label="Nationality"
                                         SearchFunc="SearchNationalities"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudSelect T="string" @bind-Value="_filterDto.PhysicallyChallenged" Label="Physically Challenged" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            @foreach (var option in _physicallyChallengedOptions)
                            {
                                <MudSelectItem Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                        <MudDatePicker @bind-Date="_filterDto.DateOfBirthStart" Label="DOB From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.DateOfBirthEnd" Label="DOB To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.DateOfBirthStart" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Employment">
                         <MudAutocomplete T="string" @bind-Value="_filterDto.Designation" Label="Designation"
                                          SearchFunc="SearchDesignations"
                                          Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                          ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                         <MudAutocomplete T="string" @bind-Value="_filterDto.JoiningLocation" Label="Joining Location"
                                          SearchFunc="SearchJoiningLocations"
                                          Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                          ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                         <MudSelect T="string" @bind-Value="_filterDto.TypeOfEmployment" Label="Type of Employment" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            @foreach (var type in _employmentTypes)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                         </MudSelect>
                         <MudAutocomplete T="string" @bind-Value="_filterDto.Level" Label="Level"
                                          SearchFunc="SearchLevels"
                                          Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                          ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                         <MudDatePicker @bind-Date="_filterDto.DateOfJoiningStart" Label="Joined From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                         <MudDatePicker @bind-Date="_filterDto.DateOfJoiningEnd" Label="Joined To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.DateOfJoiningStart" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Experience">
                        <MudAutocomplete T="string" @bind-Value="_filterDto.College" Label="College / University"
                                         SearchFunc="SearchEducationUniversities"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.Qualification" Label="Qualification"
                                         SearchFunc="SearchQualifications"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudNumericField @bind-Value="_filterDto.YearOfPassingStart" Label="Passed From Year" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Min="1900" Max="DateTime.Now.Year" Class="mb-2" />
                        <MudNumericField @bind-Value="_filterDto.YearOfPassingEnd" Label="Passed To Year" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Min="_filterDto.YearOfPassingStart ?? 1900" Max="DateTime.Now.Year" Class="mb-2" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PreviousEmployer" Label="Previous Employer"
                                         SearchFunc="SearchWorkEmployers"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PreviousDesignation" Label="Previous Designation"
                                         SearchFunc="SearchWorkDesignations"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PreviousLocation" Label="Previous Location"
                                         SearchFunc="SearchWorkLocations"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudNumericField T="double?" @bind-Value="_filterDto.EducationPercentageMin" Label="Min Education %" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Min="0" Max="100" Step="0.01" Format="F2" Class="mb-2" />
                        <MudNumericField T="double?" @bind-Value="_filterDto.EducationPercentageMax" Label="Max Education %" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Min="_filterDto.EducationPercentageMin ?? 0" Max="100" Step="0.01" Format="F2" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.PreviousJobStartDateStart" Label="Prev. Job Start From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.PreviousJobStartDateEnd" Label="Prev. Job Start To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.PreviousJobStartDateStart" />
                        <MudDatePicker @bind-Date="_filterDto.PreviousJobEndDateStart" Label="Prev. Job End From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.PreviousJobEndDateEnd" Label="Prev. Job End To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.PreviousJobEndDateStart" />
                    </MudExpansionPanel>

                     <MudExpansionPanel Text="Address">
                        <MudAutocomplete T="string" @bind-Value="_filterDto.CurrentCity" Label="Current City"
                                         SearchFunc="SearchCurrentCities"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.CurrentState" Label="Current State"
                                         SearchFunc="SearchCurrentStates"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PermanentCity" Label="Permanent City"
                                         SearchFunc="SearchPermanentCities"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PermanentState" Label="Permanent State"
                                         SearchFunc="SearchPermanentStates"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudTextField @bind-Value="_filterDto.CurrentZip" Label="Current Zip Code" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudTextField @bind-Value="_filterDto.PermanentZip" Label="Permanent Zip Code" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                     </MudExpansionPanel>

                    <MudExpansionPanel Text="Passport">
                        <MudAutocomplete T="string" @bind-Value="_filterDto.PassportNationality" Label="Passport Nationality"
                                         SearchFunc="SearchPassportNationalities"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudDatePicker @bind-Date="_filterDto.PassportIssueDateStart" Label="Passport Issued From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.PassportIssueDateEnd" Label="Passport Issued To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.PassportIssueDateStart" />
                        <MudDatePicker @bind-Date="_filterDto.PassportExpiryDateStart" Label="Passport Expires From" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudDatePicker @bind-Date="_filterDto.PassportExpiryDateEnd" Label="Passport Expires To" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" MinDate="_filterDto.PassportExpiryDateStart" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Banking">
                        <MudAutocomplete T="string" @bind-Value="_filterDto.BankName" Label="Bank Name"
                                         SearchFunc="SearchBankNames"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.BankBranch" Label="Bank Branch"
                                         SearchFunc="SearchBankBranches"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudAutocomplete T="string" @bind-Value="_filterDto.BankState" Label="Bank State"
                                         SearchFunc="SearchBankStates"
                                         Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2"
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        <MudSelect T="string" @bind-Value="_filterDto.AccountType" Label="Account Type" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                             @foreach (var type in _accountTypes)
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_filterDto.PANNumber" Label="PAN Number" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                        <MudTextField @bind-Value="_filterDto.AadhaarNumber" Label="Aadhaar Number" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Misc">
                        <MudSelect T="bool?" @bind-Value="_filterDto.HasAllergies" Label="Has Allergies?" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@( (bool?)null )">Any</MudSelectItem>
                            <MudSelectItem Value="@( (bool?)true )">Yes</MudSelectItem>
                            <MudSelectItem Value="@( (bool?)false )">No</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="bool?" @bind-Value="_filterDto.HasMedications" Label="Has Medications?" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2">
                            <MudSelectItem Value="@( (bool?)null )">Any</MudSelectItem>
                            <MudSelectItem Value="@( (bool?)true )">Yes</MudSelectItem>
                            <MudSelectItem Value="@( (bool?)false )">No</MudSelectItem>
                        </MudSelect>
                    </MudExpansionPanel>

                </MudExpansionPanels>

                <div class="mt-auto pt-3 d-flex">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters" Disabled="_isLoading" Class="mr-1" Style="flex: 1;">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                            <span>Applying...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-1"/>
                            <span>Apply</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearFilters" Disabled="_isLoading" Style="flex: 1;">
                        <MudIcon Icon="@Icons.Material.Filled.Clear" Class="mr-1"/>
                        <span>Clear</span>
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        @* Results Section *@
        <MudItem xs="12" md="9" Style="display: flex; flex-direction: column; min-height: 0;">
            <MudPaper Class="pa-3" Elevation="1" Style="height: 100%; display: flex; flex-direction: column;">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Results</MudText>

                @if (_isLoading && !_initialLoadComplete)
                {
                    <div class="d-flex justify-center align-center" style="flex: 1;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                    </div>
                }
                else    
                {
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-2">@_errorMessage</MudAlert>
                    }

                    @if (!_filteredEmployees.Any() && _initialLoadComplete && string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="d-flex flex-column justify-center align-center mud-text-secondary" style="flex: 1;">
                            <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Size="Size.Large" Class="mb-2" />
                            <MudText Align="Align.Center">No employees found matching the current filters.</MudText>
                        </div>
                    }

                    @if (_filteredEmployees.Any() || (_isLoading && _initialLoadComplete))
                    {
                        <MudGrid Spacing="2" Class="mb-2">
                            <MudItem xs="12" sm="4">
                                <MudCard Elevation="2" Class="hover-lift">
                                    <MudCardHeader Style="background-color: rgb(100 203 146); padding: 8px 16px;">
                                        <CardHeaderContent><MudText Typo="Typo.subtitle2">Total Employees</MudText></CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent Class="d-flex align-center pa-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" Size="Size.Medium" Class="mr-3"/>
                                        <MudText Typo="Typo.h6">@_totalEmployees<span class="mud-text-secondary" style="font-size: 0.8em;"> / @_systemTotalEmployees</span></MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudCard Elevation="2" Class="hover-lift">
                                    <MudCardHeader Style="background-color: rgb(243 149 237); padding: 8px 16px;">
                                        <CardHeaderContent><MudText Typo="Typo.subtitle2">Unique Designations</MudText></CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent Class="d-flex align-center pa-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Secondary" Size="Size.Medium" Class="mr-3"/>
                                        <MudText Typo="Typo.h6">@_uniqueDesignations<span class="mud-text-secondary" style="font-size: 0.8em;"> / @_systemTotalDesignations</span></MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudCard Elevation="2" Class="hover-lift">
                                    <MudCardHeader Style="background-color:rgb(93 188 245);; padding: 8px 16px;">
                                        <CardHeaderContent><MudText Typo="Typo.subtitle2">Unique Blood Groups</MudText></CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent Class="d-flex align-center pa-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Bloodtype" Color="Color.Info" Size="Size.Medium" Class="mr-3"/>
                                        <MudText Typo="Typo.h6">@_uniqueBloodGroups<span class="mud-text-secondary" style="font-size: 0.8em;"> / @_systemTotalBloodGroups</span></MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>

                        <div style="flex: 1; min-height: 0; display: flex; flex-direction: column;">
                            <MudTable ServerData="ServerReload" @ref="_table"
                                    T="AnalyticsResultDto"
                                    Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true" Elevation="0"
                                    Loading="_isLoading" LoadingProgressColor="Color.Primary"
                                    Style="flex: 1; overflow: auto;">
                                <ToolBarContent>
                                    <MudText Typo="Typo.subtitle1">Filtered Employees</MudText>
                                    <MudSpacer />
                                    <div class="d-flex">
                                        <MudTextField @bind-Value="SearchString"
                                                      Placeholder="Search employees..."
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                                      IconSize="Size.Small"
                                                      Variant="Variant.Outlined"
                                                      Dense="true"
                                                      Immediate="true"
                                                      OnKeyDown="HandleKeyDown"
                                                      Class="mt-0"
                                                      Style="width: 300px;"></MudTextField>
                                        @if (!string.IsNullOrWhiteSpace(SearchString))
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                                          Color="Color.Default"
                                                          OnClick="ClearSearchText"
                                                          Size="Size.Small"
                                                          Class="ml-1 mt-0" Style="margin-top: 9px !important;"></MudIconButton>
                                        }
                                    </div>
                                </ToolBarContent>
                                <HeaderContent>
                                    <MudTh Style="width: 60px;"></MudTh>
                                    <MudTh><MudTableSortLabel SortLabel="name_sort" T="AnalyticsResultDto">Name</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortLabel="designation_sort" T="AnalyticsResultDto">Designation</MudTableSortLabel></MudTh>
                                    <MudTh><MudTableSortLabel SortLabel="id_sort" T="AnalyticsResultDto">Employee ID</MudTableSortLabel></MudTh>
                                </HeaderContent>
                                <RowTemplate Context="employeeContext">
                                    <MudTd DataLabel="Avatar">
                                        @if (!string.IsNullOrEmpty(employeeContext.ProfilePicture))
                                        {
                                            var imageSrc = $"data:image/png;base64,{employeeContext.ProfilePicture}";
                                            <MudAvatar Image="@imageSrc" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudAvatar Color="Color.Primary" Size="Size.Small">@GetInitials(employeeContext.FirstName )</MudAvatar>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Name">
                                        <a href="/employee/@employeeContext.EmployeeID" target="_blank" style="text-decoration: none; color: inherit;">
                                            @employeeContext.FirstName @employeeContext.MiddleName @employeeContext.LastName
                                        </a>
                                    </MudTd>
                                    <MudTd DataLabel="Designation">
                                        <a href="/employee/@employeeContext.EmployeeID" target="_blank" style="text-decoration: none; color: inherit;">
                                            @employeeContext.Designation
                                        </a>
                                    </MudTd>
                                    <MudTd DataLabel="EmployeeID">
                                        <a href="/employee/@employeeContext.EmployeeID" target="_blank" style="text-decoration: none; color: inherit;">
                                            @employeeContext.EmployeeID
                                        </a>
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText>No matching records found.</MudText>
                                </NoRecordsContent>
                                <LoadingContent>
                                    <MudText>Loading...</MudText>
                                </LoadingContent>
                                <PagerContent>
                                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                                </PagerContent>
                            </MudTable>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private MudTable<AnalyticsResultDto>? _table;
    private AnalyticsFilterDto _filterDto = new();
    private List<AnalyticsResultDto> _filteredEmployees = new();
    private bool _isLoading = false;
    private bool _initialLoadComplete = false;
    private string? _errorMessage;
    private string _searchStringBackingField = "";

    private string SearchString
    {
        get => _searchStringBackingField;
        set
        {
            if (_searchStringBackingField != value)
            {
                _searchStringBackingField = value;
                Console.WriteLine($"SearchString set to: '{value}'");
                if (string.IsNullOrEmpty(value))
                {
                    _ = HandleEmptySearchAsync();
                }
            }
        }
    }

    // Stats
    private int _totalEmployees = 0;
    private int _uniqueDesignations = 0;
    private int _uniqueBloodGroups = 0;
    
    // Total metrics (across all employees, regardless of filter)
    private int _systemTotalEmployees = 0;
    private int _systemTotalDesignations = 0;
    private int _systemTotalBloodGroups = 0;

    // --- Predefined lists for some MudSelect components ---
    private List<string> _bloodGroups = new List<string> { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" };
    private List<string> _genders = new List<string> { "Male", "Female", "Other" };
    private List<string> _maritalStatuses = new List<string> { "Single", "Married", "Divorced", "Widowed" };
    private List<string> _physicallyChallengedOptions = new List<string> { "Yes", "No" };
    private List<string> _employmentTypes = new List<string> { "Permanent", "Contract", "Intern" };
    private List<string> _accountTypes = new List<string> { "Savings", "Current" };

    // --- Suggestion Lists and Loaded Flags for Autocomplete ---
    private List<string> _nationalitySuggestions = new();
    private bool _nationalityLoaded = false;
    private List<string> _designationSuggestions = new();
    private bool _designationLoaded = false;
    private List<string> _joiningLocationSuggestions = new();
    private bool _joiningLocationLoaded = false;
    private List<string> _levelSuggestions = new();
    private bool _levelLoaded = false;
    private List<string> _educationUniversitySuggestions = new();
    private bool _educationUniversityLoaded = false;
    private List<string> _qualificationSuggestions = new();
    private bool _qualificationLoaded = false;
    private List<string> _workEmployerSuggestions = new();
    private bool _workEmployerLoaded = false;
    private List<string> _workDesignationSuggestions = new();
    private bool _workDesignationLoaded = false;
    private List<string> _workLocationSuggestions = new();
    private bool _workLocationLoaded = false;
    private List<string> _currentCitySuggestions = new();
    private bool _currentCityLoaded = false;
