    private List<EmployeeAnalyticsResponseDto> GetFilteredAndSortedEmployees()
    {
        IEnumerable<EmployeeAnalyticsResponseDto> data = _filteredEmployees;

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchString))
        {
            string lowerSearch = SearchString.ToLowerInvariant();
            data = data.Where(e =>
                (e.EmployeeDetails.FirstName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.LastName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.MiddleName?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.Designation?.ToLowerInvariant().Contains(lowerSearch) ?? false) ||
                (e.EmployeeDetails.EmployeeID?.ToLowerInvariant().Contains(lowerSearch) ?? false)
            );
        }

        // Apply sorting based on stored state
        if (_lastTableState != null && !string.IsNullOrEmpty(_lastTableState.SortLabel))
        {
            switch (_lastTableState.SortLabel)
            {
                case "name_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => $"{e.EmployeeDetails.FirstName ?? string.Empty} {e.EmployeeDetails.LastName ?? string.Empty}"); break;
                case "designation_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => e.EmployeeDetails.Designation ?? string.Empty); break;
                case "id_sort": data = data.OrderByDirection(_lastTableState.SortDirection, e => e.EmployeeDetails.EmployeeID ?? string.Empty); break;
            }
        }
        else // Default sort if none applied
        {
            data = data.OrderBy(e => e.EmployeeDetails.FirstName).ThenBy(e => e.EmployeeDetails.LastName);
        }

        return data.ToList();
    }

    private async Task DownloadFilteredEmployees()
    {
        var employeesToDownload = GetFilteredAndSortedEmployees();
        if (!employeesToDownload.Any())
        {
            return;
        }

        try
        {
            var csvContent = new System.Text.StringBuilder();
 
            // Helper Functions
            Func<string?, string> escape = (val) =>
            {
                if (string.IsNullOrEmpty(val)) return "";
                string escaped = val.Replace("\"", "\"\"");
                if (escaped.Contains(',') || escaped.Contains('\"') || escaped.Contains('\n') || escaped.Contains('\r'))
                {
                    return $"\"{escaped}\"";
                }
                return escaped;
            };
            Func<DateTime?, string> formatDate = (date) => date?.ToString("yyyy-MM-dd") ?? "";
            Func<bool?, string> formatBool = (b) => b.HasValue ? b.Value.ToString() : "";
            Func<double?, string> formatDouble = (d) => d.HasValue ? d.Value.ToString("F2") : "";
            Func<int?, string> formatInt = (i) => i.HasValue ? i.Value.ToString() : "";

            // Create headers for professional information only
            var headers = new List<string>
            {
                "EmployeeID",
                "Designation",
                "TypeOfEmployment",
                "Level",
                "JoiningLocation",
                "DateOfJoining",
                "Education_Qualification_1",
                "Education_University_1",
                "Education_YearOfPassing_1",
                "Education_Percentage_1",
                "Education_Qualification_2",
                "Education_University_2",
                "Education_YearOfPassing_2",
                "Education_Percentage_2",
                "Education_Qualification_3",
                "Education_University_3",
                "Education_YearOfPassing_3",
                "Education_Percentage_3",
                "Work_Employer_1",
                "Work_Location_1",
                "Work_Designation_1",
                "Work_DateOfJoining_1",
                "Work_DateOfLeaving_1",
                "Work_Employer_2",
                "Work_Location_2",
                "Work_Designation_2",
                "Work_DateOfJoining_2",
                "Work_DateOfLeaving_2",
                "Work_Employer_3",
                "Work_Location_3",
                "Work_Designation_3",
                "Work_DateOfJoining_3",
                "Work_DateOfLeaving_3"
            };

            csvContent.AppendLine(string.Join(",", headers.Select(h => escape(h))));

            // Data rows
            foreach (var emp in employeesToDownload)
            {
                var values = new List<string>();
                
                // Professional Information
                values.Add(escape(emp.EmployeeDetails.EmployeeID));
                values.Add(escape(emp.EmployeeDetails.Designation));
                values.Add(escape(emp.EmployeeDetails.TypeOfEmployment));
                values.Add(escape(emp.EmployeeDetails.Level));
                values.Add(escape(emp.EmployeeDetails.JoiningLocation));
                values.Add(formatDate(emp.EmployeeDetails.DateOfJoining));

                // Education (up to 3 entries)
                var educationEntries = emp.experience?.EducationQualifications?.Take(3).ToList() ?? new List<Education>();
                for (int i = 0; i < 3; i++)
                {
                    if (i < educationEntries.Count)
                    {
                        values.Add(escape(educationEntries[i].Qualification));
                        values.Add(escape(educationEntries[i].University));
                        values.Add(formatInt(educationEntries[i].YearOfPassing));
                        values.Add(formatDouble(educationEntries[i].Percentage));
                    }
                    else
                    {
                        values.AddRange(new[] { "", "", "", "" });
                    }
                }

                // Work Experience (up to 3 entries)
                var workEntries = emp.experience?.WorkExperiences?.Take(3).ToList() ?? new List<WorkExperience>();
                for (int i = 0; i < 3; i++)
                {
                    if (i < workEntries.Count)
                    {
                        values.Add(escape(workEntries[i].Employer));
                        values.Add(escape(workEntries[i].Location));
                        values.Add(escape(workEntries[i].Designation));
                        values.Add(formatDate(workEntries[i].DateOfJoining));
                        values.Add(formatDate(workEntries[i].DateOfLeaving));
                    }
                    else
                    {
                        values.AddRange(new[] { "", "", "", "", "" });
                    }
                }

                csvContent.AppendLine(string.Join(",", values));
            }

            // Prepare for download
            var fileBytes = System.Text.Encoding.UTF8.GetBytes(csvContent.ToString());
            var base64Content = Convert.ToBase64String(fileBytes);
            var fileName = $"EmployeeAnalytics_{DateTime.Now:yyyyMMddHHmmss}.csv";
            var contentType = "text/csv";

            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, base64Content);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error generating or downloading file: {ex.Message}";
            Console.WriteLine($"Download error: {ex}");
        }
    }

    private async Task SyncData()
    {
        if (_isLoading) return;

        _isLoading = true;
        _errorMessage = null;
        
        try
        {
            // Store current data as backup
            var previousData = _filteredEmployees.ToList();
            
            // Get new data
            var Token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, "/api/Analytics/all");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", Token);
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                var newData = await response.Content.ReadFromJsonAsync<List<EmployeeAnalyticsResponseDto>>() ?? new List<EmployeeAnalyticsResponseDto>();
                
                // Apply current filters to new data
                _filteredEmployees = newData.Where(emp =>
                {
                    var details = emp.EmployeeDetails;
                    var banking = emp.BankingInformation;
                    var experience = emp.experience;

                    // Basic filters
                    if (!string.IsNullOrEmpty(_filterDto.BloodGroup) && details.BloodGroup != _filterDto.BloodGroup) return false;
                    if (!string.IsNullOrEmpty(_filterDto.Designation) && details.Designation != _filterDto.Designation) return false;
                    if (!string.IsNullOrEmpty(_filterDto.JoiningLocation) && details.JoiningLocation != _filterDto.JoiningLocation) return false;
                    if (!string.IsNullOrEmpty(_filterDto.Gender) && details.Gender != _filterDto.Gender) return false;
                    if (!string.IsNullOrEmpty(_filterDto.MaritalStatus) && details.MaritalStatus != _filterDto.MaritalStatus) return false;
                    if (!string.IsNullOrEmpty(_filterDto.Nationality) && details.Nationality != _filterDto.Nationality) return false;
                    if (!string.IsNullOrEmpty(_filterDto.TypeOfEmployment) && details.TypeOfEmployment != _filterDto.TypeOfEmployment) return false;
                    if (!string.IsNullOrEmpty(_filterDto.Level) && details.Level != _filterDto.Level) return false;

                    // Date range filters
                    if (_filterDto.DateOfJoiningStart.HasValue && details.DateOfJoining < _filterDto.DateOfJoiningStart) return false;
                    if (_filterDto.DateOfJoiningEnd.HasValue && details.DateOfJoining > _filterDto.DateOfJoiningEnd) return false;
                    if (_filterDto.DateOfBirthStart.HasValue && details.DateOfBirth < _filterDto.DateOfBirthStart) return false;
                    if (_filterDto.DateOfBirthEnd.HasValue && details.DateOfBirth > _filterDto.DateOfBirthEnd) return false;

                    // Banking filters
                    if (banking != null)
                    {
                        if (!string.IsNullOrEmpty(_filterDto.BankName) && banking.BankName != _filterDto.BankName) return false;
                        if (!string.IsNullOrEmpty(_filterDto.BankBranch) && banking.Branch != _filterDto.BankBranch) return false;
                        if (!string.IsNullOrEmpty(_filterDto.BankState) && banking.State != _filterDto.BankState) return false;
                        if (!string.IsNullOrEmpty(_filterDto.AccountType) && banking.AccountType != _filterDto.AccountType) return false;
                    }

                    // Experience filters
                    if (experience != null)
                    {
                        // Education filters
                        if (!string.IsNullOrEmpty(_filterDto.College))
                        {
                            if (!experience.EducationQualifications.Any(e => e.University == _filterDto.College)) return false;
                        }
                        if (!string.IsNullOrEmpty(_filterDto.Qualification))
                        {
                            if (!experience.EducationQualifications.Any(e => e.Qualification == _filterDto.Qualification)) return false;
                        }
                        if (_filterDto.YearOfPassingStart.HasValue)
                        {
                            if (!experience.EducationQualifications.Any(e => e.YearOfPassing >= _filterDto.YearOfPassingStart)) return false;
                        }
                        if (_filterDto.YearOfPassingEnd.HasValue)
                        {
                            if (!experience.EducationQualifications.Any(e => e.YearOfPassing <= _filterDto.YearOfPassingEnd)) return false;
                        }
                        if (_filterDto.EducationPercentageMin.HasValue)
                        {
                            if (!experience.EducationQualifications.Any(e => e.Percentage >= _filterDto.EducationPercentageMin)) return false;
                        }
                        if (_filterDto.EducationPercentageMax.HasValue)
                        {
                            if (!experience.EducationQualifications.Any(e => e.Percentage <= _filterDto.EducationPercentageMax)) return false;
                        }

                        // Work experience filters
                        if (!string.IsNullOrEmpty(_filterDto.PreviousEmployer))
                        {
                            if (!experience.WorkExperiences.Any(w => w.Employer == _filterDto.PreviousEmployer)) return false;
                        }
                        if (!string.IsNullOrEmpty(_filterDto.PreviousDesignation))
                        {
                            if (!experience.WorkExperiences.Any(w => w.Designation == _filterDto.PreviousDesignation)) return false;
                        }
                        if (!string.IsNullOrEmpty(_filterDto.PreviousLocation))
                        {
                            if (!experience.WorkExperiences.Any(w => w.Location == _filterDto.PreviousLocation)) return false;
                        }
                        if (_filterDto.PreviousJobStartDateStart.HasValue)
                        {
                            if (!experience.WorkExperiences.Any(w => w.DateOfJoining >= _filterDto.PreviousJobStartDateStart)) return false;
                        }
                        if (_filterDto.PreviousJobStartDateEnd.HasValue)
                        {
                            if (!experience.WorkExperiences.Any(w => w.DateOfJoining <= _filterDto.PreviousJobStartDateEnd)) return false;
                        }
                        if (_filterDto.PreviousJobEndDateStart.HasValue)
                        {
                            if (!experience.WorkExperiences.Any(w => w.DateOfLeaving >= _filterDto.PreviousJobEndDateStart)) return false;
                        }
                        if (_filterDto.PreviousJobEndDateEnd.HasValue)
                        {
                            if (!experience.WorkExperiences.Any(w => w.DateOfLeaving <= _filterDto.PreviousJobEndDateEnd)) return false;
                        }
                    }

                    return true;
                }).ToList();

                // Update system totals if no filters are applied
                bool isUnfiltered = !_filterDto.GetType().GetProperties()
                    .Any(p => p.GetValue(_filterDto) != null && !string.IsNullOrEmpty(p.GetValue(_filterDto)?.ToString()));

                if (isUnfiltered)
                {
                    _systemTotalEmployees = newData.Count;
                    _systemTotalDesignations = newData.Select(e => e.EmployeeDetails.Designation).Where(d => !string.IsNullOrEmpty(d)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                    _systemTotalBloodGroups = newData.Select(e => e.EmployeeDetails.BloodGroup).Where(b => !string.IsNullOrEmpty(b)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                }
            }
            else
            {
                // If request fails, keep previous data
                _filteredEmployees = previousData;
                _errorMessage = "Failed to sync data. Keeping previous data.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error syncing data: {ex.Message}";
            Console.WriteLine($"Sync error: {ex}");
        }
        finally
        {
            _isLoading = false;
            CalculateStats();
            StateHasChanged();
            await (_table?.ReloadServerData() ?? Task.CompletedTask);
        }
    }

    private bool HasActiveFilters()
    {
        return _filterDto.GetType().GetProperties()
            .Any(p => p.GetValue(_filterDto) != null && !string.IsNullOrEmpty(p.GetValue(_filterDto)?.ToString()));
    }

    private Dictionary<string, string> GetActiveFilters()
    {
        var activeFilters = new Dictionary<string, string>();
        var properties = _filterDto.GetType().GetProperties();

        foreach (var prop in properties)
        {
            var value = prop.GetValue(_filterDto);
            if (value != null && !string.IsNullOrEmpty(value.ToString()))
            {
                string displayName = prop.Name switch
                {
                    "BloodGroup" => "Blood Group",
                    "MaritalStatus" => "Marital Status",
                    "TypeOfEmployment" => "Type of Employment",
                    "DateOfBirthStart" => "DOB From",
                    "DateOfBirthEnd" => "DOB To",
                    "DateOfJoiningStart" => "Joined From",
                    "DateOfJoiningEnd" => "Joined To",
                    "YearOfPassingStart" => "Passed From Year",
                    "YearOfPassingEnd" => "Passed To Year",
                    "EducationPercentageMin" => "Min Education %",
                    "EducationPercentageMax" => "Max Education %",
                    "PreviousJobStartDateStart" => "Prev. Job Start From",
                    "PreviousJobStartDateEnd" => "Prev. Job Start To",
                    "PreviousJobEndDateStart" => "Prev. Job End From",
                    "PreviousJobEndDateEnd" => "Prev. Job End To",
                    "PassportIssueDateStart" => "Passport Issued From",
                    "PassportIssueDateEnd" => "Passport Issued To",
                    "PassportExpiryDateStart" => "Passport Expires From",
                    "PassportExpiryDateEnd" => "Passport Expires To",
                    "CurrentZip" => "Current Zip Code",
                    "PermanentZip" => "Permanent Zip Code",
                    "PANNumber" => "PAN Number",
                    "AadhaarNumber" => "Aadhaar Number",
                    "HasAllergies" => "Has Allergies",
                    "HasMedications" => "Has Medications",
                    _ => prop.Name
                };

                string displayValue = value switch
                {
                    DateTime dt => dt.ToString("yyyy-MM-dd"),
                    bool b => b ? "Yes" : "No",
                    _ => value.ToString()
                };

                activeFilters[displayName] = displayValue;
            }
        }

        return activeFilters;
    }

    private async Task ClearFilter(string filterName)
    {
        var propertyName = filterName switch
        {
            "Blood Group" => "BloodGroup",
            "Marital Status" => "MaritalStatus",
            "Type of Employment" => "TypeOfEmployment",
            "DOB From" => "DateOfBirthStart",
            "DOB To" => "DateOfBirthEnd",
            "Joined From" => "DateOfJoiningStart",
            "Joined To" => "DateOfJoiningEnd",
            "Passed From Year" => "YearOfPassingStart",
            "Passed To Year" => "YearOfPassingEnd",
            "Min Education %" => "EducationPercentageMin",
            "Max Education %" => "EducationPercentageMax",
            "Prev. Job Start From" => "PreviousJobStartDateStart",
            "Prev. Job Start To" => "PreviousJobStartDateEnd",
            "Prev. Job End From" => "PreviousJobEndDateStart",
            "Prev. Job End To" => "PreviousJobEndDateEnd",
            "Passport Issued From" => "PassportIssueDateStart",
            "Passport Issued To" => "PassportIssueDateEnd",
            "Passport Expires From" => "PassportExpiryDateStart",
            "Passport Expires To" => "PassportExpiryDateEnd",
            "Current Zip Code" => "CurrentZip",
            "Permanent Zip Code" => "PermanentZip",
            "PAN Number" => "PANNumber",
            "Aadhaar Number" => "AadhaarNumber",
            "Has Allergies" => "HasAllergies",
            "Has Medications" => "HasMedications",
            _ => filterName
        };

        var property = _filterDto.GetType().GetProperty(propertyName);
        if (property != null)
        {
            property.SetValue(_filterDto, null);
            await ApplyFilters();
        }
    }
