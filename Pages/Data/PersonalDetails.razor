@page "/employeeDetails/{EmployeeId}"
@inject NavigationManager NavigationManager
@inject EmployeeService EmployeeService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<EmployeeDetails> Logger
@using MudBlazor.Services

<MudThemeProvider />
<MudSnackbarProvider />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="employee-container">
    @if (!string.IsNullOrEmpty(_searchError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4 mb-4" ShowCloseIcon="true" CloseIconClicked="() => _searchError = null">@_searchError</MudAlert>
    }

    @if (employee != null)
    {
        <MudCard Class="section-card employee-profile-card">
            <MudCardHeader Class="employee-header pa-6">
                <MudGrid>
                    <MudItem xs="12" sm="2" Class="d-flex align-center justify-center">
                        @if (!string.IsNullOrEmpty(employee.PhotoBase64Content) && !string.IsNullOrEmpty(employee.PhotoContentType))
                        {
                            <MudAvatar Class="employee-avatar" Style="width: 80px; height: 80px;">
                                <img src="data:@employee.PhotoContentType;base64,@employee.PhotoBase64Content" alt="@employee.FirstName @employee.LastName" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Class="employee-avatar" Color="Color.Transparent" Style="background: rgba(255, 255, 255, 0.2); font-size: 2rem; font-weight: bold; width: 80px; height: 80px;">
                                @GetInitials(employee.FirstName, employee.LastName)
                            </MudAvatar>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Class="mb-2 employee-name">@($"{employee.FirstName} {employee.LastName}")</MudText>
                        <MudText Typo="Typo.body1" Class="mb-3 employee-designation">@employee.Designation</MudText>
                        <MudChipSet T="string">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">ID: @employee.EmployeeID</MudChip>
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">Code: @employee.EmployeeCode</MudChip>
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">@employee.TypeOfEmployment</MudChip>
                        </MudChipSet>
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-center justify-center justify-sm-end gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Class="btn-edit" StartIcon="@Icons.Material.Filled.Edit" OnClick="NavigateToPersonalEditForm">Edit Profile</MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardHeader>
        </MudCard>

        <MudGrid Class="mt-4">
            <MudItem xs="12" lg="6" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />Personal Information</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Email</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.CurrentEmail</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Gender</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.Gender</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Date of Birth</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.DateOfBirth?.ToShortDateString()</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Marital Status</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.MaritalStatus</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Blood Group</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.BloodGroup) ? "Not specified" : employee.BloodGroup)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Nationality</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.Nationality</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="6" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Work" Class="mr-2" />Employment Details</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Employee ID</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.EmployeeID</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Employee Code</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.EmployeeCode</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Level</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.Level</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Joining Date</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.DateOfJoining?.ToShortDateString()</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Location</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@employee.JoiningLocation</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="6" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-2" />Family Information</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Father's Name</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.FatherName) ? "Not specified" : employee.FatherName)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Mother's Name</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.MotherName) ? "Not specified" : employee.MotherName)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Sons</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(employee.Sons?.ToString() ?? "0")</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Daughters</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(employee.Daughters?.ToString() ?? "0")</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="6" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Favorite" Class="mr-2" />Health Information</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Blood Group</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.BloodGroup) ? "Not specified" : employee.BloodGroup)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Allergies</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.Allergies) ? "None reported" : employee.Allergies)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Medications</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.Medications) ? "None reported" : employee.Medications)</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="info-row">
                                <MudGrid>
                                    <MudItem xs="4" Class="info-label"><MudText>Physically Challenged</MudText></MudItem>
                                    <MudItem xs="8" Class="info-value"><MudText>@(employee.PhysicallyChallenged?.ToString() ?? "No")</MudText></MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="mr-2" />Address Information</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Class="mb-3 address-subsection-title">Current Address</MudText> <br/>
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Address</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.CurrentAddress) ? "Not specified" : employee.CurrentAddress)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>City</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.CurrentCity</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>State</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.CurrentState</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>ZIP Code</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.CurrentZip</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="6" Class="border-md-start">
                                <MudText Typo="Typo.subtitle1" Class="mb-3 address-subsection-title">Permanent Address</MudText> <br />
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Address</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.PermanentAddress) ? "Not specified" : employee.PermanentAddress)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>City</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.PermanentCity</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>State</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.PermanentState</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>ZIP Code</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@employee.PermanentZip</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Book" Class="mr-2" />Passport Information</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Full Name</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.PassportFullName) ? "Not specified" : employee.PassportFullName)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Passport No</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.PassportNo) ? "Not specified" : employee.PassportNo)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Nationality</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.PassportNationality) ? "Not specified" : employee.PassportNationality)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Issue Date</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(employee.PassportIssueDate?.ToShortDateString() ?? "Not specified")</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Expiry Date</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(employee.PassportExpiryDate?.ToShortDateString() ?? "Not specified")</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Place of Issue</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.PassportPlaceOfIssue) ? "Not specified" : employee.PassportPlaceOfIssue)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="mb-4">
                <MudCard Class="section-card">
                    <MudCardHeader Class="section-header">
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Phone" Class="mr-2" />Emergency Contacts</MudText> <br />
                    </MudCardHeader>
                    <MudCardContent Class="card-content-padded">
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudText Typo="Typo.subtitle1" Class="mb-3 emergency-subsection-title">Primary Contact</MudText><br/>
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Name</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact1Name) ? "Not specified" : employee.EmergencyContact1Name)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Relationship</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact1Relationship) ? "Not specified" : employee.EmergencyContact1Relationship)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Mobile</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact1Mobile) ? "Not specified" : employee.EmergencyContact1Mobile)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Address</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact1Address) ? "Not specified" : employee.EmergencyContact1Address)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>City, State ZIP</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@($"{employee.EmergencyContact1City}, {employee.EmergencyContact1State} {employee.EmergencyContact1ZipCode}".Trim(new char[] { ',', ' ' }))</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="6" Class="border-md-start">
                                <MudText Typo="Typo.subtitle1" Class="mb-3 emergency-subsection-title">Secondary Contact</MudText> <br />
                                <MudGrid>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Name</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact2Name) ? "Not specified" : employee.EmergencyContact2Name)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Relationship</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact2Relationship) ? "Not specified" : employee.EmergencyContact2Relationship)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Mobile</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact2Mobile) ? "Not specified" : employee.EmergencyContact2Mobile)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>Address</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@(string.IsNullOrEmpty(employee.EmergencyContact2Address) ? "Not specified" : employee.EmergencyContact2Address)</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="info-row">
                                        <MudGrid>
                                            <MudItem xs="4" Class="info-label"><MudText>City, State ZIP</MudText></MudItem>
                                            <MudItem xs="8" Class="info-value"><MudText>@($"{employee.EmergencyContact2City}, {employee.EmergencyContact2State} {employee.EmergencyContact2ZipCode}".Trim(new char[] { ',', ' ' }))</MudText></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="loading-container" Style="min-height: 400px;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Color="Color.Default">Loading employee details...</MudText>
        </MudStack>
    }
</MudContainer>

<style>
    .employee-container {
        padding: 3rem 1.5rem;
    }

    .employee-profile-card {
        margin-bottom: 24px;
    }

    .employee-header {
