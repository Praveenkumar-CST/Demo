@code {
    [Parameter] public string EmployeeId { get; set; }

    private EmployeeDetails employee;
    private string _searchError;

    private async Task Logout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "email");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "empId");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "EmpId");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "recentEmployees");

            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "EmpId");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "email");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "role");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "userRole");

            Logger.LogInformation("User logged out successfully. LocalStorage and sessionStorage cleared.");

            Snackbar.Add("Logged out successfully!", Severity.Success);
            await Task.Delay(2000);

            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during logout");
            Snackbar.Add("Failed to log out. Please try again or clear your browser storage manually.", Severity.Error);
            _searchError = "Logout failed. Please try again.";
            StateHasChanged();
        }
    }

    private void NavigateToPersonalEditForm()
    {
        NavigationManager.NavigateTo($"personalEditForm/{employee.EmployeeID}");
    }

    private string GetInitials(string firstName, string lastName)
    {
        var first = !string.IsNullOrEmpty(firstName) ? firstName.Substring(0, 1).ToUpper() : "";
        var last = !string.IsNullOrEmpty(lastName) ? lastName.Substring(0, 1).ToUpper() : "";
        return first + last;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employee = await EmployeeService.GetEmployeeDetails(EmployeeId);
            if (employee == null)
            {
                _searchError = "Employee not found.";
                Logger.LogWarning($"Employee with ID {EmployeeId} not found.");
            }
            else if (!string.IsNullOrEmpty(employee.PhotoBase64Content))
            {
                try
                {
                    Convert.FromBase64String(employee.PhotoBase64Content);
                }
                catch (FormatException)
                {
                    Logger.LogWarning($"Invalid Base64 photo content for employee ID {EmployeeId}");
                    employee.PhotoBase64Content = null;
                    _searchError = "Invalid photo data. Displaying default avatar.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error loading employee details for ID {EmployeeId}");
            _searchError = "An error occurred while loading employee details.";
        }
        StateHasChanged();
    }
}