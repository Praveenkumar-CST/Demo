@page "/employeeDetailsData/{EmployeeID}"
@using WiseHRServer.Models
@inject EmployeeService EmployeeService
@inject BankingService BankingService
@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@using MudBlazor.Services
@layout HomeLayout

<MudThemeProvider />
<MudSnackbarProvider />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 px-4 employee-details-page">
    <div class="d-flex align-center justify-space-between mb-6">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="NavigateBackToEmployeeList" Class="back-button">
            Back to Employee List
        </MudButton>
        <MudText Typo="Typo.h4" Class="page-title flex-grow-1 text-center">Employee Details</MudText>
        <div style="width: 200px;"></div>
    </div>

    <MudPaper Class="pa-6 rounded-xl shadow-lg tab-container-card">
        <MudButtonGroup Class="custom-tab-group" Exclusive="true" Color="Color.Primary" Elevation="0">
            <MudButton OnClick="@(() => ShowSection(1))" Color="@(currentSection == 1 ? Color.Primary : Color.Default)" Variant="@(currentSection == 1 ? Variant.Text : Variant.Text)" Class="@GetButtonClass(1)">Personal Details</MudButton>
            <MudButton OnClick="@(() => ShowSection(2))" Color="@(currentSection == 2 ? Color.Primary : Color.Default)" Variant="@(currentSection == 2 ? Variant.Text : Variant.Text)" Class="@GetButtonClass(2)">Banking Details</MudButton>
            <MudButton OnClick="@(() => ShowSection(3))" Color="@(currentSection == 3 ? Color.Primary : Color.Default)" Variant="@(currentSection == 3 ? Variant.Text : Variant.Text)" Class="@GetButtonClass(3)">Experience</MudButton>
        </MudButtonGroup>

        <MudDivider Class="my-6 custom-divider" />

        <div class="tab-content">
            @if (currentSection == 1)
            {
                <PersonalDetails EmployeeID="@EmployeeID" />
            }
            else if (currentSection == 2)
            {
                <Bankdetails EmployeeID="@EmployeeID" />
            }
            else if (currentSection == 3)
            {
                <Experienceinfo EmployeeID="@EmployeeID" />
            }
        </div>
    </MudPaper>
</MudContainer>

<style>
    /* Page Container and Title */
    .employee-details-page {
        background-color: #f0f2f5; /* Light grey background for the whole page */
        min-height: 100vh; /* Ensure it covers full viewport height */
        padding-top: 40px;
        padding-bottom: 40px;
    }

    .page-title {
        color: #3f51b5; /* Primary blue for the main title */
        font-weight: 700;
        text-align: center;
        /* margin-bottom: 30px; Removed as it's now handled by parent flex container */
        letter-spacing: 0.05em;
    }

    /* Back Button Styling */
    .back-button {
        color: #3f51b5 !important; /* Ensure primary color */
        font-weight: 600;
        text-transform: capitalize;
        padding: 8px 16px;
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .back-button:hover {
            background-color: rgba(63, 81, 181, 0.08); /* Light hover background */
            transform: translateX(-3px); /* Subtle slide effect */
        }

        .back-button .mud-icon {
            margin-right: 8px;
        }

    /* Tab Container Card */
    .tab-container-card {
        background-color: #ffffff; /* White background for the card holding tabs and content */
        border-radius: 16px !important; /* Larger rounded corners */
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); /* More prominent shadow */
        padding: 30px; /* Increased padding inside the card */
    }

    /* Custom Tab Group Styling */
    .custom-tab-group {
        display: flex;
        justify-content: flex-start; /* Align tabs to the start */
        border-bottom: 2px solid #e0e0e0; /* Subtle line below the tabs */
        margin-bottom: -2px; /* Pull up to align with the border */
    }

        .custom-tab-group .mud-button-root {
            border-radius: 0; /* Remove individual button border-radius */
            padding: 12px 20px; /* Adjust padding for a better tab feel */
            font-weight: 500;
            transition: all 0.3s ease-in-out;
            min-width: 140px; /* Ensure a minimum width for tabs */
            position: relative; /* For the active indicator */
            overflow: hidden; /* Hide overflow for transition effect */
            color: #607d8b; /* Default tab text color */
            text-transform: capitalize; /* Keep first letter capitalized */
            font-size: 0.95rem;
        }

            .custom-tab-group .mud-button-root::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background-color: transparent;
                transition: background-color 0.3s ease-in-out, transform 0.3s ease-in-out;
                transform: scaleX(0); /* Start hidden */
                transform-origin: bottom center;
            }

            .custom-tab-group .mud-button-root.active-tab-button {
                color: #3f51b5 !important;
                font-weight: 700; /* Bolder active tab */
                background-color: transparent !important; /* No background for active tab */
            }

                .custom-tab-group .mud-button-root.active-tab-button::after {
                    background-color: #3f51b5; /* Primary color underline for active tab */
                    transform: scaleX(1); /* Show the underline */
                }

            .custom-tab-group .mud-button-root:hover:not(.active-tab-button) {
                color: #3f51b5; /* Highlight text on hover */
                background-color: #f5f5f5 !important; /* Subtle background on hover */
            }

            .custom-tab-group .mud-button-root:active {
                transform: translateY(1px); /* Slight press effect */
            }

    /* Divider beneath tabs */
    .custom-divider {
        margin-top: 20px !important; /* Adjust margin from tabs */
        margin-bottom: 20px !important; /* Adjust margin to content */
        background-color: #eceff1; /* Lighter divider */
    }

    /* Tab Content Area */
    .tab-content {
        min-height: 400px; /* Ensure sufficient height for content */
        padding-top: 10px; /* Space between divider and content */
    }

    /* Responsive Adjustments */
    @@media (max-width: 600px) {
        .d-flex.align-center.justify-space-between.mb-6

    {
        flex-direction: column;
        align-items: flex-start !important;
        margin-bottom: 20px !important;
    }

    .page-title {
        text-align: left;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    .back-button {
        margin-bottom: 10px;
    }

    .custom-tab-group {
        flex-direction: column; /* Stack buttons vertically on small screens */
        align-items: stretch; /* Make them full width */
    }

        .custom-tab-group .mud-button-root {
            min-width: unset; /* Remove min-width for full width */
            width: 100%; /* Full width */
            border-bottom: 1px solid #e0e0e0; /* Separator for stacked buttons */
        }

            .custom-tab-group .mud-button-root:last-child {
                border-bottom: none; /* No border on the last stacked button */
            }

    .tab-container-card {
        padding: 15px; /* Reduce padding on small screens */
    }

    .page-title {
        font-size: 1.8rem;
        margin-bottom: 20px;
    }

    }
</style>
@code {
    [Parameter] public string EmployeeID { get; set; }
    private int currentSection = 1;

    private void ShowSection(int section)
    {
        if (currentSection != section)
        {
            currentSection = section;
            StateHasChanged(); // Notify Blazor that the component state has changed
        }
    }

    private string GetButtonClass(int section) =>
        currentSection == section ? "active-tab-button" : "";
    private void NavigateBackToEmployeeList()
    {
        NavigationManager.NavigateTo("/home/employeeList");
    }
}