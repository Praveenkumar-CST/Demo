@page "/home/employeeList"
@using WiseHRServer.Models
@layout HomeLayout
@inject EmployeeService EmployeeService
@inject BankingService BankingService
@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (isLoading)
{
    <div style="display: flex; flex-direction: column; align-items: center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Align="Align.Center">Loading...</MudText>
    </div>
}
else if (isFiltering)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Filtering...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger custom-alert">Failed to load employee data.</div>
}
else if (pagedEmployees.Any())
{
    <!-- Search and Filter Row -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <input type="text"
               class="form-control w-50"
               placeholder="Search Employee"
               @bind="searchQuery"
               @oninput="HandleSearchInput" />

        <select class="form-select w-auto ms-2"
                @bind="SelectedDesignation">
            <option value="">All Designations</option>
            @foreach (var designation in designations)
            {
                <option value="@designation">@designation</option>
            }
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Designation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in pagedEmployees)
                {
                    <tr @onclick="() => ShowEmployeeDetails(emp.EmployeeID)">
                        <td>@emp.EmployeeID</td>

                        <td>
                            <span>
                                @if (!string.IsNullOrEmpty(emp.PhotoBase64Content) && !string.IsNullOrEmpty(emp.PhotoContentType))
                                {
                                    <img src="data:@emp.PhotoContentType;base64,@emp.PhotoBase64Content"
                                         class="rounded-circle"
                                         alt="Employee Photo"
                                         style="width: 30px; height: 30px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="/images/default-avatar.jpg"
                                         class="rounded-circle"
                                         alt="Loading..."
                                         style="width: 30px; height: 30px; object-fit: cover;"
                                         @onload="() => LoadPhotoAsync(emp)" />
                                }
                            </span>
                            @($" {emp.FirstName} {emp.LastName}")
                        </td>

                        <td>@emp.CurrentEmail</td>
                        <td>@emp.Designation</td>
                        <td>
                            <button class="btn btn-sm btn-primary"
                                    style="padding: 2px 6px; font-size: 0.75rem;"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ShowEmployeeDetails(emp.EmployeeID)">
                                View
                            </button>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           @onclick="() => ShowDeleteConfirmation(emp.EmployeeID)" />

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <nav aria-label="Employee pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNum = i;
                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info custom-alert">No employees found.</div>
}

@code {
    private List<EmployeeDetails> employees = new();
    private List<EmployeeDetails> pagedEmployees = new();
    private bool isLoading = true;
    private bool isFiltering = false;
    private bool hasError = false;
    private int currentPage = 1;
    private int itemsPerPage = 10;
    private string searchQuery = string.Empty;
    private string _selectedDesignation = string.Empty;
    private HashSet<string> designations = new();
    private CancellationTokenSource? debounceCts;

    private int totalPages => (int)Math.Ceiling((double)filteredEmployees.Count / itemsPerPage);
    private List<EmployeeDetails> filteredEmployees = new();
    private Dictionary<string, string> employeePhotos = new();
    private HashSet<string> loadingPhotos = new();

    private async Task LoadPhotoAsync(EmployeeDetails emp)
    {
        if (string.IsNullOrEmpty(emp.EmployeeID) || !string.IsNullOrEmpty(emp.PhotoBase64Content) || loadingPhotos.Contains(emp.EmployeeID))
            return;

        loadingPhotos.Add(emp.EmployeeID);
        try
        {
            var (photoBytes, contentType) = await EmployeeService.GetEmployeePhoto(emp.EmployeeID);
            emp.PhotoBase64Content = Convert.ToBase64String(photoBytes);
            emp.PhotoContentType = contentType;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading photo for {emp.EmployeeID}: {ex.Message}");
        }
        finally
        {
            loadingPhotos.Remove(emp.EmployeeID);
        }
    }


    private string SelectedDesignation
    {
        get => _selectedDesignation;
        set
        {
            if (_selectedDesignation != value)
            {
                _selectedDesignation = value;
                _ = UpdateFilteredEmployeesAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees = await EmployeeService.GetAllEmployees();
            if (employees == null || !employees.Any())
            {
                Console.WriteLine("No employees returned from EmployeeService.");
                hasError = true;
                return;
            }

            designations = employees
                .Select(e => e.Designation)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct()
                .ToHashSet();
            await UpdateFilteredEmployeesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateFilteredEmployeesAsync()
    {
        isFiltering = true;
        StateHasChanged();

        try
        {
            filteredEmployees = await Task.Run(() => employees
                .Where(emp => emp != null && // Ensure emp is not null
                    (string.IsNullOrWhiteSpace(searchQuery) ||
                     (emp.FirstName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true) ||
                     (emp.LastName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true) ||
                     (emp.CurrentEmail?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true) ||
                     (emp.EmployeeID?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true) ||
                     (emp.Designation?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true)) &&
                    (string.IsNullOrEmpty(_selectedDesignation) || emp.Designation == _selectedDesignation))
                .ToList());

            UpdatePagedEmployees();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering employees: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isFiltering = false;
            StateHasChanged();
        }
    }

    private void UpdatePagedEmployees()
    {
        var skip = (currentPage - 1) * itemsPerPage;
        pagedEmployees = filteredEmployees.Skip(skip).Take(itemsPerPage).ToList();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagedEmployees();
            StateHasChanged();
        }
    }

    private void ShowEmployeeDetails(string employeeId)
    {
        if (!string.IsNullOrEmpty(employeeId))
        {
            NavigationManager.NavigateTo($"employeeDetailsData/{employeeId}");
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;

        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounceCts.Token);
            currentPage = 1;
            await UpdateFilteredEmployeesAsync();
        }
        catch (TaskCanceledException)
        {
            // Debounce cancelled, no action needed
        }
    }

    protected override void OnParametersSet()
    {
        UpdatePagedEmployees();
    }

    private string ItemsPerPage
    {
        get => itemsPerPage.ToString();
        set
        {
            if (int.TryParse(value, out int newVal) && itemsPerPage != newVal)
            {
                itemsPerPage = newVal;
                currentPage = 1;
                UpdatePagedEmployees();
                StateHasChanged();
            }
        }
    }
    private async Task ShowDeleteConfirmation(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId))
            return;

        var employee = employees.FirstOrDefault(e => e.EmployeeID == employeeId);
        var employeeName = employee != null ? $"{employee.FirstName} {employee.LastName}" : employeeId;

        bool? confirmed = await DialogService.ShowMessageBox(
            title: "Confirm Delete",
            message: $"Are you sure you want to delete employee {employeeName} (ID: {employeeId})? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }
        );

        if (confirmed == true)
        {
            await DeleteEmployeeAsync(employeeId);
        }
    }

    private async Task DeleteEmployeeAsync(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId))
            return;

        try
        {
            // Execute all delete operations
            var deleteBankingTask = BankingService.DeleteBankingInfo(employeeId);
            var deleteEmployeeTask = EmployeeService.DeleteEmployee(employeeId);
            var deleteExperienceTask = ExperienceService.DeleteExperienceAsync(employeeId);

            var results = await Task.WhenAll(deleteBankingTask, deleteEmployeeTask, deleteExperienceTask);

            bool allSuccessful = results.All(r => r);

            if (allSuccessful)
            {
                // Log success to console
                Console.WriteLine($"Successfully deleted all data for EmployeeID: {employeeId}");

                // Show success snackbar
                var employee = employees.FirstOrDefault(e => e.EmployeeID == employeeId);
                var employeeName = employee != null ? $"{employee.FirstName} {employee.LastName}" : employeeId;
                Snackbar.Add($"Employee {employeeName} (ID: {employeeId}) and associated data deleted successfully", Severity.Success);

                // Remove from local lists
                employees.RemoveAll(e => e.EmployeeID == employeeId);
                filteredEmployees.RemoveAll(e => e.EmployeeID == employeeId);
                UpdatePagedEmployees();
                StateHasChanged();
            }
            else
            {
                // Log partial failure to console
                Console.WriteLine($"Partial failure deleting data for EmployeeID: {employeeId}");
                Snackbar.Add($"Failed to delete some data for Employee {employeeId}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting employee data for {employeeId}: {ex.Message}");
            Snackbar.Add($"Error deleting employee {employeeId}: {ex.Message}", Severity.Error);
        }
    }



    public void Dispose()
    {
        debounceCts?.Dispose();
    }
}