@page "/home/employeeList"
@using WiseHRServer.Models
@layout HomeLayout
@inject EmployeeService EmployeeService
@inject BankingService BankingService
@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Employee Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3">
    <!-- Header Section -->
    <MudPaper Class="pa-3 mb-3 dashboard-card" Elevation="3">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" md="6">
                <div class="card-title">
                    <MudIcon Icon="@Icons.Material.Filled.People" Class="title-icon" />
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="welcome-title">
                        Employee Management
                    </MudText>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="welcome-subtitle">
                    Manage your organization's workforce efficiently
                </MudText>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex justify-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick='() => NavigationManager.NavigateTo("/home/employees")'
                           Size="Size.Large"
                           Class="action-btn">
                    Add New Employee
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Class="pa-6 text-center dashboard-card" Elevation="3">
            <div class="loading-container">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Class="loading-text">Loading employee data...</MudText>
            </div>
        </MudPaper>
    }
    else if (hasError)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3 error-alert">
            <MudIcon Icon="@Icons.Material.Filled.Error" Class="alert-icon" />
            <MudText>Failed to load employee data. Please try refreshing the page.</MudText>
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="RefreshData" Class="mt-2">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-1" />
                Retry
            </MudButton>
        </MudAlert>
    }
    else
    {
        <!-- Statistics Cards -->
        <MudGrid Class="mb-3 metrics-grid">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="metric-card clickable" Elevation="3" @onclick="@(() => NavigationManager.NavigateTo("/home/employeeList"))">
                    <div class="metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Group" />
                    </div>
                    <div class="metric-content">
                        <MudText Typo="Typo.h4" Class="metric-value">@employees.Count</MudText>
                        <MudText Typo="Typo.body2" Class="metric-label">Total Employees</MudText>
                        <div class="metric-trend">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                            Active members
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="metric-card clickable" Elevation="3">
                    <div class="metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Business" />
                    </div>
                    <div class="metric-content">
                        <MudText Typo="Typo.h4" Class="metric-value">@designations.Count</MudText>
                        <MudText Typo="Typo.body2" Class="metric-label">Designations</MudText>
                        <div class="metric-trend">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                            Unique roles
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="metric-card clickable" Elevation="3">
                    <div class="metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.FilterList" />
                    </div>
                    <div class="metric-content">
                        <MudText Typo="Typo.h4" Class="metric-value">@filteredEmployees.Count</MudText>
                        <MudText Typo="Typo.body2" Class="metric-label">Filtered Results</MudText>
                        <div class="metric-trend">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                            Current view
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="metric-card clickable" Elevation="3">
                    <div class="metric-icon">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" />
                    </div>
                    <div class="metric-content">
                        <MudText Typo="Typo.h4" Class="metric-value">@totalPages</MudText>
                        <MudText Typo="Typo.body2" Class="metric-label">Total Pages</MudText>
                        <div class="metric-trend">
                            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" />
                            Paginated view
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Search and Filter Section -->
        <MudPaper Class="pa-3 mb-3 dashboard-card" Elevation="3">
            <MudGrid AlignItems="Center" Spacing="2" Justify="Justify.SpaceBetween">
                <MudItem xs="12" sm="12" md="4">
                    <MudTextField @bind-Value="searchQuery"
                                  @oninput="HandleSearchInput"
                                  Placeholder="Search"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  Immediate="true"
                                  Dense="true"
                                  Class="search-field" />
                </MudItem>
                <MudItem xs="12" sm="12" md="4">
                    <MudSelect T="string" @bind-Value="SelectedDesignation"
                               Label="Designation"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Clearable="true"
                               Dense="true">
                        @foreach (var designation in designations.OrderBy(d => d))
                        {
                            <MudSelectItem Value="@designation">@designation</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="4" Class="d-flex justify-center">
                    <MudTooltip Text="Export to Excel">
                        <MudIconButton Icon="@Icons.Material.Filled.FileDownload"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       OnClick="ExportToExcel"
                                       Class="action-btn" />
                    </MudTooltip>
                </MudItem>
            </MudGrid>
        </MudPaper>


        @if (isFiltering)
        {
            <MudPaper Class="pa-4 text-center dashboard-card" Elevation="3">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudText Class="mt-2 loading-text">Filtering employees...</MudText>
            </MudPaper>
        }
        else if (pagedEmployees.Any())
        {
            <!-- Employee Table -->
            <MudPaper Elevation="3" Class="mb-3 dashboard-card">
                <MudDataGrid T="EmployeeDetails" Items="@pagedEmployees"
                             ReadOnly="true"
                             Dense="true"
                             Hover="true"
                             Striped="true"
                             FixedHeader="true"
                             Height="600px"
                             Class="employee-grid">
                    <Columns>
                        <PropertyColumn Property="x => x.EmployeeID" Title="Employee ID">
                            <CellTemplate>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Class="chip-primary">
                                    @context.Item.EmployeeID
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn T="EmployeeDetails" Title="Employee" Sortable="false">
                            <CellTemplate>
                                <div class="d-flex align-center clickable" @onclick="@(() => ShowEmployeeDetails(context.Item.EmployeeID))">
                                    <MudAvatar Size="Size.Medium" Class="mr-3 activity-avatar">
                                        @if (!string.IsNullOrEmpty(context.Item.PhotoBase64Content))
                                        {
                                            <MudImage Src="@($"data:{context.Item.PhotoContentType};base64,{context.Item.PhotoBase64Content}")"
                                                      Alt="Employee Photo" />
                                        }
                                        else
                                        {
                                            @(context.Item.FirstName?.Length > 0 ? context.Item.FirstName[0].ToString().ToUpper() : "U")
                                        }
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.body1" Class="activity-text">
                                            @($"{context.Item.FirstName} {context.Item.LastName}")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="activity-meta">
                                            @context.Item.CurrentEmail
                                        </MudText>
                                    </div>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Designation" Title="Designation">
                            <CellTemplate>
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined" Class="chip-secondary">
                                    @context.Item.Designation
                                </MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        @if (currentUserRole != "Manager" && currentUserRole != "Employee")
                        {
                            <TemplateColumn T="EmployeeDetails" Title="Actions" Sortable="false">
                                <CellTemplate>
                                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Class="action-btn-group">
                                        <MudTooltip Text="View Details">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => ShowEmployeeDetails(context.Item.EmployeeID)"
                                                           Class="action-btn" />
                                        </MudTooltip>
                                        <MudTooltip Text="Edit Employee">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           OnClick="() => EditEmployee(context.Item.EmployeeID)"
                                                           Class="action-btn" />
                                        </MudTooltip>
                                        <MudTooltip Text="Delete Employee">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="() => ShowDeleteConfirmation(context.Item.EmployeeID)"
                                                           Class="action-btn error" />
                                        </MudTooltip>
                                    </MudButtonGroup>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                    </Columns>
                </MudDataGrid>
            </MudPaper>

            <!-- Pagination -->
            <MudGrid AlignItems="Center" Class="mt-3">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="welcome-subtitle">
                        Showing @((currentPage - 1) * itemsPerPage + 1) to @Math.Min(currentPage * itemsPerPage, filteredEmployees.Count)
                        of @filteredEmployees.Count employees
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex justify-end">
                    <MudPagination Count="totalPages"
                                   Selected="currentPage"
                                   SelectedChanged="OnPageChanged"
                                   ShowFirstButton="true"
                                   ShowLastButton="true"
                                   ShowPreviousButton="true"
                                   ShowNextButton="true"
                                   BoundaryCount="2"
                                   MiddleCount="2"
                                   Size="Size.Medium"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="pagination" />
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudPaper Class="pa-6 text-center dashboard-card" Elevation="3">
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="empty-icon" />
                    <MudText Typo="Typo.h6" Class="mt-2">No employees found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="welcome-subtitle">
                        Try adjusting your search criteria or filters
                    </MudText>
                </div>
            </MudPaper>
        }
    }
</MudContainer>

