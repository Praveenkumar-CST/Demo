@page "/home/employeeList"
@using WiseHRServer.Models
@layout HomeLayout
@inject EmployeeService EmployeeService
@inject NavigationManager NavigationManager

@if (isLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else if (isFiltering)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Filtering...</span>
    </div>
}
else if (hasError)
{
    <div class="alert alert-danger custom-alert">Failed to load employee data.</div>
}
else if (pagedEmployees.Any())
{
    <!-- Search and Filter Row -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group w-50">
            <input type="text"
                   class="form-control"
                   placeholder="Search Employee"
                   @bind="searchQuery" />
            <button class="btn btn-primary" @onclick="HandleSearch">Search</button>
        </div>

        <select class="form-select w-auto ms-2"
                @bind="SelectedDesignation">
            <option value="">All Designations</option>
            @foreach (var designation in designations)
            {
                <option value="@designation">@designation</option>
            }
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Designation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in pagedEmployees)
                {
                    <tr @onclick="() => ShowEmployeeDetails(emp.EmployeeID)">
                        <td>@emp.EmployeeID</td>
                        <td>
                            <span>
                                @if (!string.IsNullOrEmpty(emp.PhotoBase64Content))
                                {
                                    <img src="data:@emp.PhotoContentType;base64,@emp.PhotoBase64Content"
                                         class="rounded-circle"
                                         alt="Employee Photo"
                                         style="width: 30px; height: 30px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">No photo</span>
                                }
                            </span>
                            @($" {emp.FirstName} {emp.LastName}")
                        </td>
                        <td>@emp.CurrentEmail</td>
                        <td>@emp.Designation</td>
                        <td>
                            <button class="btn btn-sm btn-primary"
                                    style="padding: 2px 6px; font-size: 0.75rem;"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ShowEmployeeDetails(emp.EmployeeID)">
                                View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <nav aria-label="Employee pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNum = i;
                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info custom-alert">No employees found.</div>
}

@code {
    private List<EmployeeDetails> employees = new();
    private List<EmployeeDetails> pagedEmployees = new();
    private bool isLoading = true;
    private bool isFiltering = false;
    private bool hasError = false;
    private int currentPage = 1;
    private int itemsPerPage = 10;
    private string searchQuery = string.Empty;
    private string _selectedDesignation = string.Empty;
    private HashSet<string> designations = new();
    private List<EmployeeDetails> filteredEmployees = new();

    private int totalPages => (int)Math.Ceiling((double)filteredEmployees.Count / itemsPerPage);

    private string SelectedDesignation
    {
        get => _selectedDesignation;
        set
        {
            if (_selectedDesignation != value)
            {
                _selectedDesignation = value;
                _ = UpdateFilteredEmployeesAsync(); // Trigger filtering
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees = await EmployeeService.GetAllEmployees();
            designations = employees
                .Select(e => e.Designation)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct()
                .ToHashSet();
            await UpdateFilteredEmployeesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdateFilteredEmployeesAsync()
    {
        isFiltering = true;
        StateHasChanged();

        try
        {
            // Offload filtering to a background thread
            filteredEmployees = await Task.Run(() => employees
                .Where(emp =>
                    (string.IsNullOrWhiteSpace(searchQuery) ||
                     emp.FirstName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     emp.LastName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     emp.CurrentEmail.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     emp.EmployeeID.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     emp.Designation?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true) &&
                    (string.IsNullOrEmpty(_selectedDesignation) || emp.Designation == _selectedDesignation))
                .ToList());

            UpdatePagedEmployees();
        }
        finally
        {
            isFiltering = false;
            StateHasChanged();
        }
    }

    private void UpdatePagedEmployees()
    {
        var skip = (currentPage - 1) * itemsPerPage;
        pagedEmployees = filteredEmployees.Skip(skip).Take(itemsPerPage).ToList();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            UpdatePagedEmployees();
            StateHasChanged();
        }
    }

    private void ShowEmployeeDetails(string employeeId)
    {
        NavigationManager.NavigateTo($"employeeDetailsData/{employeeId}");
    }

    private async Task HandleSearch()
    {
        currentPage = 1;
        await UpdateFilteredEmployeesAsync();
    }

    protected override void OnParametersSet()
    {
        UpdatePagedEmployees();
    }

    private string ItemsPerPage
    {
        get => itemsPerPage.ToString();
        set
        {
            if (int.TryParse(value, out int newVal) && itemsPerPage != newVal)
            {
                itemsPerPage = newVal;
                currentPage = 1;
                UpdatePagedEmployees();
                StateHasChanged();
            }
        }
    }
}