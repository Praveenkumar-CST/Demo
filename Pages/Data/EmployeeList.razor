    private async Task ExportToExcel()
    {
        try
        {
            var exportData = filteredEmployees.Select(e => new
            {
                EmployeeID = e.EmployeeID,
                FirstName = e.FirstName,
                LastName = e.LastName,
                Email = e.CurrentEmail,
                Designation = e.Designation
            }).ToList();
            var fileName = $"Employees_{System.DateTime.UtcNow:yyyy-MM-dd}.xlsx";
            var result = await JSRuntime.InvokeAsync<bool>("exportToExcel", new object[] { exportData, fileName });
            Snackbar.Add(result ? "Success" : "Failed to export Excel", result ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowDeleteConfirmation(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId))
            return;

        var employee = employees.FirstOrDefault(e => e.EmployeeID == employeeId);
        var employeeName = employee != null ? $"{employee.FirstName} {employee.LastName}" : employeeId;

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete {employeeName} (ID: {employeeId})? This action cannot be undone and will remove all associated data.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MudDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await DeleteEmployeeAsync(employeeId);
        }
    }

    private async Task DeleteEmployeeAsync(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId))
            return;

        try
        {
            var employee = employees.FirstOrDefault(e => e.EmployeeID == employeeId);
            var employeeName = employee != null ? $"{employee.FirstName} {employee.LastName}" : employeeId;

            var deleteTasks = new[]
            {
                BankingService.DeleteBankingInfo(employeeId),
                EmployeeService.DeleteEmployee(employeeId),
                ExperienceService.DeleteExperienceAsync(employeeId)
            };

            await Task.WhenAll(deleteTasks);
            employees.RemoveAll(e => e.EmployeeID == employeeId);
            await UpdateFilteredEmployeesAsync();
            Snackbar.Add($"Employee {employeeName} deleted successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting employee data: {employeeId}: {ex.Message}");
            Snackbar.Add($"Error deleting employee: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
    }
}