@page "/forgot-password"
@using WiseHR.Services
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.False" Style="min-height: 100vh; width: 100vw; padding: 0; margin: 0; background: white;" Class="d-flex justify-center align-center">
    <MudPaper Width="450px" Elevation="25" Class="pa-8 transition-transform" Style="border-radius: 24px; background: linear-gradient(145deg, #ffffff, #f8f9fa); box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2); transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;" HoverStyle="transform: scale(1.02); box-shadow: 0px 15px 35px rgba(0, 0, 0, 0.25);">
        <MudGrid>
            <MudItem xs="12" Class="d-flex flex-column align-center mb-6">
                <div style="position: relative; margin-bottom: 24px;">
                    <MudImage Src="assets/wwlogo.png" Alt="Wise Work Logo" Width="160" Height="160" Class="mb-2" Style="border-radius: 16px; filter: drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.15));" />
                    <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 16px; background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 70%); pointer-events: none;"></div>
                </div>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2" Style="font-style: italic; color: #526480; font-weight: 500;">"Empowering Your Future – Wise Work."</MudText>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="font-weight-bold mb-4" Style="background: linear-gradient(90deg, #34adb8 0%, #8E54E9 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-top: 16px;">Forgot Password</MudText>
            </MudItem>
            <MudItem xs="12">
                @if (!string.IsNullOrEmpty(ForgotPasswordMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">@ForgotPasswordMessage</MudAlert>
                }
                @if (!string.IsNullOrEmpty(ForgotPasswordErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@ForgotPasswordErrorMessage</MudAlert>
                }
                <MudForm @ref="forgotPasswordForm" @onsubmit="HandleForgotPassword">
                    <MudTextField T="string" Label="Email" @bind-Value="ForgotPasswordEmail" Variant="Variant.Outlined"
                                  Class="mb-4" Required="true" For="@(() => ForgotPasswordEmail)"
                                  AdornmentIcon="@Icons.Material.Filled.Email" Adornment="Adornment.End" Disabled="IsLoading"
                                  Style="border-radius: 12px; background: rgba(255,255,255,0.6);" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4 mb-4" FullWidth="true"
                               ButtonType="ButtonType.Submit" Disabled="IsLoading"
                               Style="border-radius: 12px; background: linear-gradient(90deg, #34adb8 0%, #8E54E9 100%); height: 48px; text-transform: none; font-size: 16px; font-weight: 500; box-shadow: 0px 4px 12px rgba(142, 84, 233, 0.5);">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Sending Reset Link...</span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                        }
                    </MudButton>
                </MudForm>
                <MudItem xs="12" Class="d-flex justify-center">
                    <MudLink Underline="Underline.Hover" Color="Color.Primary" @onclick='() => NavigationManager.NavigateTo("/")'>Back to Login</MudLink>
                </MudItem>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? forgotPasswordForm;
    private bool IsLoading { get; set; } = false;
    private string ForgotPasswordEmail { get; set; } = "";
    private string ForgotPasswordMessage { get; set; } = "";
    private string ForgotPasswordErrorMessage { get; set; } = "";

    private async Task HandleForgotPassword()
    {
        if (forgotPasswordForm == null) return;
        IsLoading = true;
        ForgotPasswordMessage = "";
        ForgotPasswordErrorMessage = "";
        await forgotPasswordForm.Validate();
        if (!forgotPasswordForm.IsValid)
        {
            IsLoading = false;
            StateHasChanged();
            return;
        }
        try
        {
            var (success, error) = await AuthService.ForgotPassword(ForgotPasswordEmail);
            if (success)
            {
                ForgotPasswordMessage = "A password reset email has been sent. Please check your inbox and follow the link.";
                ForgotPasswordErrorMessage = "";
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ForgotPasswordErrorMessage = error ?? "Failed to send reset email.";
                ForgotPasswordMessage = "";
            }
        }
        catch (Exception ex)
        {
            ForgotPasswordErrorMessage = $"Forgot password error: {ex.Message}";
            await JSRuntime.InvokeVoidAsync("console.error", $"Forgot password error: {ex}");
            ForgotPasswordMessage = "";
        }
        IsLoading = false;
        StateHasChanged();
    }
}