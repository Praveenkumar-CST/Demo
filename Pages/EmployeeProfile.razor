@page "/employee/{id}"
@inject EmployeeService EmployeeService
@inject ExperienceService ExperienceService
@inject BankingService BankingService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using WiseHR.Models
@using WiseHRServer.Models
@using MudBlazor
@using WiseHR.Components.sidebar
@using System.Globalization
@layout WiseHR.Components.sidebar.HomeLayout

<MudThemeProvider />

<style>
    .profile-header {
        background: linear-gradient(90deg, #34adb8 0%, #8E54E9 100%);
        box-shadow: 0 8px 20px rgba(71, 118, 230, 0.2);
        transition: all 0.3s ease;
        color: white;
    }

    .profile-header:hover {
        box-shadow: 0 12px 25px rgba(71, 118, 230, 0.3);
        transform: translateY(-3px);
    }

    .profile-avatar {
        border: 4px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }
    
    /* Custom gradient styles for tabs */
    .gradient-tabs ::deep .mud-tabs-toolbar {
        background: linear-gradient(90deg, #34adb8 0%, #8E54E9 100%);
    }
    
    .gradient-tabs ::deep .mud-tab {
        color: rgba(255, 255, 255, 0.7);
    }
    
    .gradient-tabs ::deep .mud-tab.mud-tab-active {
        color: white;
        font-weight: 500;
    }
    
    .gradient-tabs ::deep .mud-tabs-toolbar-content .mud-tab:hover {
        color: white;
    }
    
    .gradient-tabs ::deep .mud-tabs-indicator {
        background: white;
        height: 3px;
    }
    .mud-tabs-tabbar{
            background: linear-gradient(90deg, #34adb8 0%, #8E54E9 100%);
    color: white;
    }
    .mud-tab.mud-tab-active{
        color: white;
    }
    .mud-tab-slider.mud-tab-slider-horizontal {
        height: 5px;
    }
    .mud-tab-slider {
        background: #fff;
    }

    .profile-section-title {
        color: #2c3e50;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .profile-field-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .profile-field-value {
        color: #1e293b;
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1.4;
        word-break: break-word;
        min-height: 1.4rem;
    }

        .profile-field-value.empty {
            color: #94a3b8;
            font-style: italic;
            font-weight: 400;
        }
</style>

    <MudMainContent Style="flex-grow: 1;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @if (isLoading)
            {
                <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center py-16">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.body1" Color="Color.Primary" Class="mt-4">Loading employee profile...</MudText>
                </MudPaper>
            }
            else if (errorMessage != null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
                    <MudText>@errorMessage</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Retry">Retry</MudButton>
                </MudAlert>
            }
            else if (Employee != null)
            {
                <MudGrid>
                    <!-- Employee Profile Header -->
                    <MudItem xs="12">
                        <MudPaper Elevation="3" Class="pa-4 rounded-lg profile-header">
                            <MudGrid AlignItems="AlignItems.Center">
                                <MudItem xs="12" sm="3" Class="d-flex justify-center">
                                    @if (!string.IsNullOrEmpty(Employee.PhotoBase64Content) && !string.IsNullOrEmpty(Employee.PhotoContentType))
                                    {
                                        <MudAvatar Style="height: 120px; width: 120px;" Class="mud-elevation-2 profile-avatar">
                                            <MudImage Src="@($"data:{Employee.PhotoContentType};base64,{Employee.PhotoBase64Content}")" Alt="@Employee.FirstName" ObjectFit="ObjectFit.Cover" />
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Style="height: 120px; width: 120px; font-size: 2.5rem;" Class="mud-elevation-2 profile-avatar">
                                            @(Employee.FirstName?.Length > 0 ? Employee.FirstName[0].ToString().ToUpper() : "?")
                                        </MudAvatar>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="9" Class="pl-sm-4">
                                    <MudText Typo="Typo.h4" GutterBottom="true" Style="color: white; font-weight: 500;">@Employee.FirstName @Employee.MiddleName @Employee.LastName</MudText>
                                    <MudText Typo="Typo.h6" GutterBottom="true" Style="color: rgba(255, 255, 255, 0.9);">@Employee.Designation</MudText>
                                    <MudDivider Class="my-2" Style="background-color: rgba(255, 255, 255, 0.2);" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.body1" Class="d-flex align-center" Style="color: white;">
                                                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" Style="color: rgba(255, 255, 255, 0.8);" />
                                                @Employee.CurrentEmail
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.body1" Class="d-flex align-center" Style="color: white;">
                                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" Style="color: rgba(255, 255, 255, 0.8);" />
                                                @Employee.CurrentMobile
                                            </MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <!-- Employee Tabs -->
                    <MudItem xs="12" Class="mt-4">
                        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="gradient-tabs">

                            @* --- Personal Information Tab --- *@
                            <MudTabPanel Text="Personal" Icon="@Icons.Material.Filled.Person">
                                <MudCard Elevation="2" Class="rounded-lg pa-4 mb-4" Style="background: #f8fafd;">
                                    <MudCardHeader>
                                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" /> Personal Details
                                        </MudText>
                                    </MudCardHeader>
                                    <MudDivider Class="mb-3" />
                                    <div  Style="profile-field-value profile-field-label profile-section-title">

                                    
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">First Name</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@Employee.FirstName</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Middle Name</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.MiddleName)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Last Name</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@Employee.LastName</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Date of Birth</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderDate(Employee.DateOfBirth)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Gender</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Gender)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Blood Group</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.BloodGroup)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Marital Status</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.MaritalStatus)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Nationality</MudText>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Nationality)</MudText>
                                        </MudItem>
                                    </MudGrid>
                                    </div>
                                </MudCard>

                                <!-- Family Information -->
                            <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                                <MudExpansionPanel  Text="Family Information" Icon="@Icons.Material.Filled.MoreHoriz" IconColor="Color.Error" IsInitiallyExpanded="false">
                                    <MudDivider Class="mb-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Father's Name</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.FatherName)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mother's Name</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.MotherName)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Sons</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Sons)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Daughters</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Daughters)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                      </MudExpansionPanel>
                                </MudExpansionPanels>
                              

                                <!-- Health Information -->
                                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                                    <MudExpansionPanel Text="Health Information" Icon="@Icons.Material.Filled.MoreHoriz" IconColor="Color.Error" IsInitiallyExpanded="false">
                                    <MudDivider Class="mb-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Physically Challenged</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.PhysicallyChallenged)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Allergies</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Allergies)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Medications</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.Medications)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                        </MudExpansionPanel>
                                </MudExpansionPanels>
                              
                                                     <!-- Primary Contact -->
                                    <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                                        <MudExpansionPanel Text="Official Contact" Icon="@Icons.Material.Filled.MoreHoriz" IconColor="Color.Error" IsInitiallyExpanded="false">

                                            <MudDivider Class="mb-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" />
                                                    @RenderString(Employee.CurrentEmail)
                                                </MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mobile</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" />
                                                    @RenderString(Employee.CurrentMobile)
                                                </MudText>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                         </MudExpansionPanel>
                                </MudExpansionPanels>
                              
                            <!-- Permanent Contact -->
                                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                                    <MudExpansionPanel Text="Personal Contact" Icon="@Icons.Material.Filled.MoreHoriz" IconColor="Color.Error" IsInitiallyExpanded="false">
                            
                                    <MudDivider Class="mb-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" />
                                                    @RenderString(Employee.PermanentEmail)
                                                </MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mobile</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" />
                                                    @RenderString(Employee.PermanentMobile)
                                                </MudText>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                               
                                </MudExpansionPanel>
                                </MudExpansionPanels>
                              

                                <!-- Emergency Contacts -->
                                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                                    <MudExpansionPanel Text="Emergency Contacts" Icon="@Icons.Material.Filled.MoreHoriz" IconColor="Color.Error" IsInitiallyExpanded="false">
                                        <MudGrid Spacing="3">
                                            <MudItem xs="12" md="6">
                                                <MudCard Elevation="2" Class="rounded-lg pa-3 mb-2" Style="background: #fcf8f8;">
                                                    <MudCardHeader>
                                                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="d-flex align-center">
                                                            <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Class="mr-2" /> Contact 1
                                                        </MudText>
                                                    </MudCardHeader>
                                                    <MudDivider Class="mb-3" />
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Name</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.EmergencyContact1Name)</MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Relationship</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.EmergencyContact1Relationship)</MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mobile</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                                    <MudIcon Icon="@Icons.Material.Filled.Call" Size="Size.Small" Class="mr-2" />
                                                                    @RenderString(Employee.EmergencyContact1Mobile)
                                                                </MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Address</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">
                                                                    @RenderString(Employee.EmergencyContact1Address),
                                                                    @RenderString(Employee.EmergencyContact1City),
                                                                    @RenderString(Employee.EmergencyContact1State) @RenderString(Employee.EmergencyContact1ZipCode)
                                                                </MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudCard>
                                            </MudItem>
                                            <MudItem xs="12" md="6">
                                                <MudCard Elevation="2" Class="rounded-lg pa-3 mb-2" Style="background: #fcf8f8;">
                                                    <MudCardHeader>
                                                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="d-flex align-center">
                                                            <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Class="mr-2" /> Contact 2
                                                        </MudText>
                                                    </MudCardHeader>
                                                    <MudDivider Class="mb-3" />
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Name</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.EmergencyContact2Name)</MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Relationship</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.EmergencyContact2Relationship)</MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mobile</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold d-flex align-center">
                                                                    <MudIcon Icon="@Icons.Material.Filled.Call" Size="Size.Small" Class="mr-2" />
                                                                    @RenderString(Employee.EmergencyContact2Mobile)
                                                                </MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(220, 53, 69, 0.05); border-radius: 8px;">
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Address</MudText>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">
                                                                    @RenderString(Employee.EmergencyContact2Address),
                                                                    @RenderString(Employee.EmergencyContact2City),
                                                                    @RenderString(Employee.EmergencyContact2State) @RenderString(Employee.EmergencyContact2ZipCode)
                                                                </MudText>
                                                            </MudPaper>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudCard>
                                            </MudItem>
                                        </MudGrid>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudTabPanel>

                            @* --- Address Tab --- *@
                            <MudTabPanel Text="Address" Icon="@Icons.Material.Filled.Home">
                                <!-- Current Address -->
                                  <!-- Employment Details -->
                                <MudCard Elevation="2" Class="rounded-lg pa-4 mb-4" Style="background: #f8fafd;">
                                    <MudCardHeader>
                                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="d-flex align-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Work" Class="mr-2" /> Residential Address
                                        </MudText>
                                    </MudCardHeader>
                                    <MudDivider Class="mb-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Address</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.CurrentAddress)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">City</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.CurrentCity)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(52, 173, 184, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">State</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.CurrentState)</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: rgba(142, 84, 233, 0.05); border-radius: 8px;">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Zip</MudText>
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@RenderString(Employee.CurrentZip)</MudText>
