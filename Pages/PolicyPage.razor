@page "/policies"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using WiseHR.Models
@using WiseHR.Components.Dialogs
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@layout WiseHR.Components.sidebar.HomeLayout

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-4" Elevation="3">
        <div class="d-flex align-center mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" Color="Color.Primary" />
            <MudText Typo="Typo.h5">Company Policies</MudText>
            <MudSpacer />
            @if (IsAdmin)
            {
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          StartIcon="@Icons.Material.Filled.Upload" 
                          OnClick="@(() => showUploadForm = !showUploadForm)">
                    @(showUploadForm ? "Cancel Upload" : "Upload Policy")
                </MudButton>
            }
        </div>

        @if (showUploadForm && IsAdmin)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudForm @ref="_form" @bind-IsValid="@_success">
                    <MudTextField @bind-Value="newPolicy.Title"
                                Label="Title"
                                Required="true"
                                RequiredError="Title is required!" />
                    <MudTextField @bind-Value="newPolicy.Version"
                                Label="Version"
                                Required="true"
                                RequiredError="Version is required!" />
                    <MudPaper Class="pa-4 mt-4" Elevation="0" Style="border: 2px dashed var(--mud-palette-primary);">
                        <div class="d-flex flex-column align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                            <MudText Class="mb-2">Drag and drop your PDF file here or</MudText>
                            <InputFile OnChange="OnFileSelected" 
                                     Accept=".pdf"
                                     class="d-none"
                                     id="fileInput" />
                            <MudButton Variant="Variant.Filled"
                                     Color="Color.Primary"
                                     OnClick="OpenFilePicker"
                                     StartIcon="@Icons.Material.Filled.Upload"
                                     Class="mt-2">
                                Choose PDF File
                            </MudButton>
                            @if (_selectedFile != null)
                            {
                                <MudChip T="string" Color="Color.Success" Class="mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                                    @_selectedFile.Name
                                </MudChip>
                            }
                        </div>
                    </MudPaper>
                    <div class="d-flex justify-end mt-4">
                        <MudButton OnClick="@(() => showUploadForm = false)" Class="mr-2">Cancel</MudButton>
                        <MudButton Color="Color.Primary" 
                                 OnClick="UploadPolicy"
                                 Disabled="@(!_success || _selectedFile == null)">
                            Upload
                        </MudButton>
                    </div>
                </MudForm>
            </MudPaper>
        }

        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_policies == null || !_policies.Any())
        {
            <MudAlert Severity="Severity.Info">No policies available.</MudAlert>
        }
        else
        {
            <MudTable Items="@_policies" Dense="true" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>Upload Date</MudTh>
                    <MudTh>Uploaded By</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">@context.Title</MudTd>
                    <MudTd DataLabel="Version">@context.Version</MudTd>
                    <MudTd DataLabel="Upload Date">@context.UploadDate.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Uploaded By">@context.UploadedBy</MudTd>
                    <MudTd>
                        <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                            <MudButton OnClick="@(() => ViewPolicy(context.PolicyId))"
                                     StartIcon="@Icons.Material.Filled.Visibility">
                                View
                            </MudButton>
                            <MudButton OnClick="@(() => DownloadPolicy(context.PolicyId))"
                                     StartIcon="@Icons.Material.Filled.Download">
                                Download
                            </MudButton>
                            @if (IsAdmin)
                            {
                                <MudButton OnClick="@(() => DeletePolicy(context.PolicyId))"
                                         StartIcon="@Icons.Material.Filled.Delete"
                                         Color="Color.Error">
                                    Delete
                                </MudButton>
                            }
                        </MudButtonGroup>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

<MudDialog @bind-IsVisible="_showViewDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@_currentPolicy?.Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingPolicy)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else if (_currentPolicy != null && !string.IsNullOrEmpty(_currentPolicyBase64Content))
        {
            <iframe src="@($"data:{_currentPolicy.ContentType};base64,{_currentPolicyBase64Content}")"
                    style="width: 100%; height: 80vh; border: none;"
                    title="@_currentPolicy.FileName">
            </iframe>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Failed to load policy content</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showViewDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PolicyDto> _policies;
    private bool _isLoading = true;
    private bool IsAdmin { get; set; }
    private bool showUploadForm = false;
    private bool _success;
    private MudForm _form;
    private PolicyUploadDto newPolicy = new();
    private IBrowserFile _selectedFile;
    private bool _showViewDialog;
    private PolicyResponseDto _currentPolicy;
    private string _currentPolicyBase64Content;
    private bool _isLoadingPolicy;

    protected override async Task OnInitializedAsync()
    {
        await CheckAdminStatus();
        await LoadPolicies();
    }

    private async Task CheckAdminStatus()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, "api/Auth/check-admin");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);
            IsAdmin = response.IsSuccessStatusCode;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking admin status: {ex.Message}");
            IsAdmin = false;
        }
    }

    private async Task OpenFilePicker()
    {
        await JSRuntime.InvokeVoidAsync("triggerFileInput", "fileInput");
    }

    private async Task LoadPolicies()
    {
        try
        {
            _isLoading = true;
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, "api/Policy");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _policies = await response.Content.ReadFromJsonAsync<List<PolicyDto>>();
            }
            else
            {
                Snackbar.Add("Failed to load policies", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading policies", Severity.Error);
            Console.WriteLine($"Error loading policies: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10485760) // 10MB
            {
                Snackbar.Add("File size exceeds 10MB limit", Severity.Error);
                return;
            }

            if (!file.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
            {
                Snackbar.Add("Only PDF files are allowed", Severity.Error);
                return;
            }

            _selectedFile = file;
            StateHasChanged();
        }
    }

    private async Task UploadPolicy()
    {
        try
        {
            await _form.Validate();
            if (!_success || _selectedFile == null) return;

            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(newPolicy.Title), "Title");
            content.Add(new StringContent(newPolicy.Version), "Version");

            // Create a stream content for the file
            var fileContent = new StreamContent(_selectedFile.OpenReadStream(maxAllowedSize: 10485760)); // 10MB
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_selectedFile.ContentType);
            content.Add(fileContent, "File", _selectedFile.Name);

            var request = new HttpRequestMessage(HttpMethod.Post, "api/Policy")
            {
                Content = content
            };
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Policy uploaded successfully", Severity.Success);
                showUploadForm = false;
                newPolicy = new PolicyUploadDto();
                _selectedFile = null;
                await LoadPolicies();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to upload policy: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error uploading policy", Severity.Error);
            Console.WriteLine($"Error uploading policy: {ex.Message}");
        }
    }

    private async Task ViewPolicy(int policyId)
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Policy/{policyId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PolicyResponseDto>();
                if (result != null)
                {
                    var base64Content = Convert.ToBase64String(result.Content);
                    var parameters = new DialogParameters
                    {
                        { "Policy", result },
                        { "Base64Content", base64Content },
                        { "IsLoading", false }
                    };

                    var dialog = await DialogService.ShowAsync<ViewPolicyDialog>("View Policy", parameters);
                    await dialog.Result;
                }
            }
            else
            {
                Snackbar.Add("Failed to load policy", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading policy", Severity.Error);
            Console.WriteLine($"Error loading policy: {ex.Message}");
        }
    }

    private async Task DownloadPolicy(int policyId)
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Policy/{policyId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PolicyResponseDto>();
                if (result != null)
                {
                    // Convert byte array to base64 string
                    var base64Content = Convert.ToBase64String(result.Content);
                    await JSRuntime.InvokeVoidAsync("downloadBase64File", result.ContentType, base64Content, result.FileName);
                }
            }
            else
            {
                Snackbar.Add("Failed to download policy", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error downloading policy", Severity.Error);
            Console.WriteLine($"Error downloading policy: {ex.Message}");
        }
    }

    private async Task DeletePolicy(int policyId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this policy?"))
            return;

        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Policy/{policyId}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Policy deleted successfully", Severity.Success);
                await LoadPolicies();
            }
            else
            {
                Snackbar.Add("Failed to delete policy", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error deleting policy", Severity.Error);
            Console.WriteLine($"Error deleting policy: {ex.Message}");
        }
    }
} 