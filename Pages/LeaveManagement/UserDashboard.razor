        max-width: 150px;
    }

    }

    /* Grid alignment */
    .mud-grid-item {
        display: flex;
        padding: 0 !important;
    }

        .mud-grid-item .leave-card {
            width: 100%;
            margin: 8px;
        }

        .mud-grid-item .expand-card {
            width: 100%;
            margin: 8px;
        }

        .mud-grid-item .request-status {
            width: 100%;
            margin: 8px;
        }

    /* Full width grid spacing */
    .mud-grid {
        margin: 0 !important;
        width: 100% !important;
    }
</style>

@code {
    private MudForm form;
    private LeaveRequestDto leaveRequest = new();
    private MyHistoryResponse historyResponse;
    private List<LeaveRequest> requestStatus;
    private bool isNameDisabled;
    private bool isEmailDisabled;
    private bool showLeavePopup = false;
    private bool showLogsPopup = false;
    private bool showAllLeaves = false;
    private string selectedLeaveType = "";
    private List<LeaveHistory> filteredLeaveHistory;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var (name, email, _) = await LeaveService.GetUserClaimsAsync();
            if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(email))
            {
                leaveRequest.Name = name;
                leaveRequest.Email = email;
                isNameDisabled = true;
                isEmailDisabled = true;
            }
            await LoadHistory();
            await LoadRequestStatus();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Initialization failed: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            historyResponse = await LeaveService.GetMyLeaveHistoryAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error loading history: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadRequestStatus()
    {
        try
        {
            requestStatus = await LeaveService.GetRequestStatusAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error loading request status: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private string GetLeaveTypeClass(string leaveType)
    {
        return leaveType?.ToLower() switch
        {
            "annual" => "annual-leave",
            "casual" => "casual-leave",
            "sick" => "sick-leave",
            "maternity" => "maternity-leave",
            "paternity" => "paternity-leave",
            "privilege" => "privilege-leave",
            _ => "casual-leave"
        };
    }

    private string GetDisplayValue(dynamic balance)
    {
        if (balance.LeaveType?.ToLower() == "sick")
        {
            return $"{balance.Available}d";
        }
        return $"{balance.Available}d";
    }

    private void ToggleShowAllLeaves()
    {
        showAllLeaves = !showAllLeaves;
    }

    private void OpenLeavePopup(string leaveType)
    {
        selectedLeaveType = leaveType;
        leaveRequest.LeaveType = leaveType;
        showLeavePopup = true;
    }

    private void CloseLeavePopup()
    {
        showLeavePopup = false;
        selectedLeaveType = "";
    }

    private void OpenLogsPopup(string leaveType)
    {
        selectedLeaveType = leaveType;
        if (historyResponse?.History != null)
        {
            filteredLeaveHistory = historyResponse.History
                .Where(h => h.LeaveType.Equals(leaveType, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        showLogsPopup = true;
    }

    private void CloseLogsPopup()
    {
        showLogsPopup = false;
        selectedLeaveType = "";
        filteredLeaveHistory = null;
    }

    private async Task SubmitLeaveRequest()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                var response = await LeaveService.SubmitLeaveRequestAsync(leaveRequest);
                Snackbar.Add(response.Message, MudBlazor.Severity.Success);
                leaveRequest = new LeaveRequestDto
                {
                    Name = leaveRequest.Name,
                    Email = leaveRequest.Email
                };
                await LoadHistory();
                await LoadRequestStatus();
                CloseLeavePopup();
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add($"Error submitting leave request: {ex.Message}", MudBlazor.Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Unexpected error: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    public class LeaveRequestDtoValidator : AbstractValidator<LeaveRequestDto>
    {
        public LeaveRequestDtoValidator()
        {
            RuleFor(x => x.Name).NotEmpty().WithMessage("Name is required");
            RuleFor(x => x.Email).NotEmpty().EmailAddress().WithMessage("Valid email is required");
            RuleFor(x => x.LeaveType).NotEmpty().WithMessage("Leave type is required");
            RuleFor(x => x.StartDate).NotNull().GreaterThanOrEqualTo(DateTime.Today).WithMessage("Start date must be today or later");
            RuleFor(x => x.EndDate).NotNull().GreaterThanOrEqualTo(x => x.StartDate ?? DateTime.Today).WithMessage("End date must be on or after start date");
            RuleFor(x => x.Reason).NotEmpty().WithMessage("Reason is required");
            RuleFor(x => x.MentorName).NotEmpty().WithMessage("Mentor name is required");
            RuleFor(x => x.MentorEmail).NotEmpty().EmailAddress().WithMessage("Valid mentor email is required");
        }
    }
}