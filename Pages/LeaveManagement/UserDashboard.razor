            background: #7CB342;
        }

    .logs-btn {
        background: #2196F3;
        color: white;
    }

        .logs-btn:hover {
            background: #1976D2;
        }

    .expand-card {
        background: white;
        border-radius: 12px;
        padding: 16px;
        margin: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        height: 320px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 100%;
        cursor: pointer;
