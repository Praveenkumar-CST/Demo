@page "/employee/leave"
@using WiseHR.Models
@using WiseHR.Services
@using FluentValidation
@inject LeaveManagementService LeaveService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@using Components.sidebar
@layout HomeLayout
@inject NavigationManager NavigationManager


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <!-- Leave Balance Cards and Actions -->
    <MudGrid>
        @if (historyResponse?.Balances != null)
        {
            var visibleBalances = showAllLeaves ? historyResponse.Balances : historyResponse.Balances.Where(b => b.LeaveType.ToLower() == "casual" || b.LeaveType.ToLower() == "sick" || b.LeaveType.ToLower() == "privilege").Take(3);

            @foreach (var balance in visibleBalances)
            {
                var progressAngle = balance.TotalQuota > 0 ? (360 * balance.Available / balance.TotalQuota) : 0;
                var cssClass = GetLeaveTypeClass(balance.LeaveType);

                <MudItem xs="12" sm="6" md="2">
                    <div class="leave-card @cssClass">
                        <div class="leave-title">@balance.LeaveType Leave</div>
                        <div class="circular-progress">
                            <div class="progress-circle" style="--progress-angle: @(progressAngle)deg;">
                                <div class="progress-inner">
                                    <div class="progress-value">@GetDisplayValue(balance)</div>
                                    <div class="progress-label">Available</div>
                                </div>
                            </div>
                        </div>
                        <div class="leave-details">
                            <div><span>Available</span><span>@balance.Available D</span></div>
                            <div><span>Consumed</span><span>@balance.Consumed D</span></div>
                            <div><span>Annual Quota</span><span>@balance.TotalQuota D</span></div>
                        </div>
                        <div class="leave-actions-buttons">
                            <button class="action-btn apply-btn" @onclick="() => OpenLeavePopup(balance.LeaveType)">
                                Apply
                            </button>
                            <button class="action-btn logs-btn" @onclick="() => OpenLogsPopup(balance.LeaveType)">
                                Logs
                            </button>
                        </div>
                    </div>
                </MudItem>
            }

            @if (!showAllLeaves && historyResponse.Balances.Count() > 3)
            {
                <MudItem xs="12" sm="6" md="2">
                    <div class="expand-card" @onclick="ToggleShowAllLeaves">
                        <div class="expand-content">
                            <div class="expand-icon">+</div>
                            <div class="expand-text">Show More</div>
                            <div class="expand-count">@(historyResponse.Balances.Count() - 3) more</div>
                        </div>
                    </div>
                </MudItem>
            }
            else if (showAllLeaves && historyResponse.Balances.Count() > 3)
            {
                <MudItem xs="12" sm="6" md="2">
                    <div class="expand-card" @onclick="ToggleShowAllLeaves">
                        <div class="expand-content">
                            <div class="expand-icon">−</div>
                            <div class="expand-text">Show Less</div>
                        </div>
                    </div>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12">
                <MudProgressCircular Indeterminate="true" />
            </MudItem>
        }
    </MudGrid>

    <!-- Request Status Section - Table Format -->
    <MudGrid>
        <MudItem xs="12">
            <div class="request-status">
                <h3>Request Status</h3>

                @if (requestStatus == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (requestStatus.Any())
                {
                    <table class="leaves-table">
                        <thead>
                            <tr>
                                <th>Date Range</th>
                                <th>Type</th>
                                <th>Reason</th>
                                <th>Applied Date</th>
                                <th>Status</th>
                                <th>Mentor Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in requestStatus.Take(5))
                            {
                                var leaveTypeClass = request.LeaveType.ToLower();
                                var statusClass = request.Status.ToLower();
                                <tr>
                                    <td>
                                        <div class="table-date">@request.StartDate.ToString("MMM dd, yyyy")</div>
                                        <div class="table-date-range">to @request.EndDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <span class="table-leave-type @leaveTypeClass">@request.LeaveType</span>
                                    </td>
                                    <td>
                                        <div class="table-reason" title="@request.Reason">@request.Reason</div>
                                    </td>
                                    <td>
                                        <div class="table-approver">@request.StartDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <span class="table-status @statusClass">@request.Status</span>
                                    </td>
                                    <td>
                                        <div class="table-approver">@request.MentorName</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: #666;">
                        <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
                        <div>No pending requests available</div>
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudContainer>

<!-- Leave Application Popup -->
@if (showLeavePopup)
{
    <div class="popup-overlay" @onclick="CloseLeavePopup">
        <div class="popup-content" @onclick:stopPropagation="true">
            <div class="popup-header">
                <div class="popup-title">Submit Leave Request - @selectedLeaveType</div>
                <button class="close-btn" @onclick="CloseLeavePopup">×</button>
            </div>

            <MudForm @ref="form" Model="leaveRequest" Validation="@(new LeaveRequestDtoValidator())">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect Label="Leave Type" @bind-Value="leaveRequest.LeaveType" Required="true" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Privilege")">Privilege</MudSelectItem>
                            <MudSelectItem Value="@("Sick")">Sick</MudSelectItem>
                            <MudSelectItem Value="@("Casual")">Casual</MudSelectItem>
                            <MudSelectItem Value="@("Maternity")">Maternity</MudSelectItem>
                            <MudSelectItem Value="@("Paternity")">Paternity</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Start Date" @bind-Date="leaveRequest.StartDate" Required="true" DateFormat="MMM dd, yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="End Date" @bind-Date="leaveRequest.EndDate" Required="true" DateFormat="MMM dd, yyyy" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Reason" @bind-Value="leaveRequest.Reason" Required="true" Lines="3" Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-4">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CloseLeavePopup">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitLeaveRequest">Submit</MudButton>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </div>
    </div>
}

<!-- Logs Popup -->
@if (showLogsPopup)
{
    <div class="popup-overlay" @onclick="CloseLogsPopup">
        <div class="popup-content logs-popup" @onclick:stopPropagation="true">
            <div class="popup-header">
                <div class="popup-title">@selectedLeaveType Leave History</div>
                <button class="close-btn" @onclick="CloseLogsPopup">×</button>
            </div>

            <div class="logs-content">
                @if (filteredLeaveHistory == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (filteredLeaveHistory.Any())
                {
                    <table class="leaves-table">
                        <thead>
                            <tr>
                                <th>Applied Date</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Mentor Name</th>
                                <th>Approver Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in filteredLeaveHistory)
                            {
                                var statusClass = leave.Status.ToLower();
                                <tr>
                                    <td>
                                        <div class="table-date">@leave.StartDate.ToString("MMM dd, yyyy")</div>
                                        <div class="table-date-range">to @leave.EndDate.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="table-reason" title="@leave.Reason">@leave.Reason</div>
                                    </td>
                                    <td>
                                        <span class="table-status @statusClass">@leave.Status</span>
                                    </td>
                                    <td>
                                        <div class="table-approver">@leave.MentorName</div>
                                    </td>
                                    <td>
                                        <div class="table-approver">@leave.ApproverName</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: #666;">
                        <div style="font-size: 48px; margin-bottom: 16px;">📅</div>
                        <div>No @selectedLeaveType leave history available</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
