            background: #fff3e0;
            color: #f57c00;
        }

        .table-leave-type.maternity {
            background: #fce4ec;
            color: #c2185b;
        }

        .table-leave-type.paternity {
            background: #f3e5f5;
            color: #7b1fa2;
        }

        .table-leave-type.privilege {
            background: #e3f2fd;
            color: #1976d2;
        }

    .table-status {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .table-status.approved {
            background: #4CAF50;
            color: white;
        }

        .table-status.pending {
            background: #FF9800;
