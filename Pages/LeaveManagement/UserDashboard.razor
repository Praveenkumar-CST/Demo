    }

    .progress-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--progress-color);
        line-height: 1;
    }

    .progress-label {
        font-size: 9px;
        color: var(--progress-color);
        text-transform: uppercase;
        margin-top: 2px;
        font-weight: 600;
    }

    .annual-leave {
        --progress-color: #2196F3;
    }

    .casual-leave {
        --progress-color: #FF9800;
    }

    .sick-leave {
        --progress-color: #4CAF50;
    }

    .maternity-leave {
        --progress-color: #E91E63;
    }

    .paternity-leave {
        --progress-color: #9C27B0;
    }

    .privilege-leave {
        --progress-color: #2196F3;
    }

    .leave-details {
