    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (!user.Identity.IsAuthenticated || !user.IsInRole("Admin") && !user.IsInRole("HR") && !user.IsInRole("Manager"))
            {
                NavigationManager.NavigateTo("/home");
                return;
            }

            await LoadPendingRequests();
            await LoadLeaveQuotas();
            await InitializeDefaultQuotaCache();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Initialization failed: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error during initialization: {ex.Message}", MudBlazor.Severity.Error);
        }
    }


    private async Task InitializeDefaultQuotaCache()
    {
        try
        {
            var leaveTypes = new[] { "Privilege", "Sick", "WorkFromHome", "Unpaid", "Paternity", "Maternity" };
            foreach (var leaveType in leaveTypes)
            {
                var request = new QuotaHistoryRequestDto { LeaveType = leaveType, PageNumber = 1, PageSize = 1 };
                var history = await LeaveService.GetQuotaHistoryAsync(request);
                if (history?.History?.Any() == true)
                {
                    defaultQuotaCache[leaveType] = history.History.First().NewQuota;
                }
                else
                {
                    defaultQuotaCache[leaveType] = 0;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing quota cache: {ex.Message}", MudBlazor.Severity.Error);
        }
    }


