    private IndividualLeaveQuotaDto individualLeaveQuota = new();
    private UserHistoryRequestDto historyRequest = new();
    private QuotaHistoryRequestDto quotaHistoryRequest = new();
    private List<LeaveRequest>? pendingRequests;
    private UserHistoryResponse? historyResponse;
    private QuotaHistoryResponse? defaultQuotaHistory;
    private QuotaHistoryResponse? individualQuotaHistory;
    private List<LeaveQuotaDto> leaveQuotas = new();
    private bool isLoading;
    private bool isLoadingQuotaHistory;
    private MudTable<LeaveHistory>? historyTable;
    private int currentSearchId;
    private int lastSearchId;
    private bool showAllLeaveTypes;
    private bool ShowDefaultQuotaHistory;
    private bool ShowIndividualQuotaHistory;
    private string selectedLeaveType = "Privilege";
    private Dictionary<string, int> defaultQuotaCache = new();
    private Dictionary<(string, string), int> individualQuotaCache = new();
    private string DefaultLeaveType
    {
        get => defaultLeaveQuota.LeaveType;
        set
        {
            defaultLeaveQuota.LeaveType = value;
            OnDefaultLeaveTypeChanged(value).GetAwaiter().GetResult(); 
        }
    }

    private string IndividualLeaveType
    {
        get => individualLeaveQuota.LeaveType;
        set
        {
            individualLeaveQuota.LeaveType = value;
            OnIndividualLeaveTypeChanged(value).GetAwaiter().GetResult(); 
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPendingRequests();
            await LoadLeaveQuotas();
            await InitializeDefaultQuotaCache();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Initialization failed: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error during initialization: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task InitializeDefaultQuotaCache()
    {
        try
        {
            var leaveTypes = new[] { "Privilege", "Sick", "Maternity", "Paternity", "Unpaid" };
            foreach (var leaveType in leaveTypes)
            {
                var request = new QuotaHistoryRequestDto { LeaveType = leaveType, PageNumber = 1, PageSize = 1 };
                var history = await LeaveService.GetQuotaHistoryAsync(request);
                if (history?.History?.Any() == true)
                {
                    defaultQuotaCache[leaveType] = history.History.First().NewQuota;
                }
                else
                {
                    defaultQuotaCache[leaveType] = 0;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing quota cache: {ex.Message}", MudBlazor.Severity.Error);
        }
    }


    private async Task LoadLeaveQuotas()
    {
        try
        {
            if (pendingRequests == null)
            {
                await LoadPendingRequests();
            }

            var leaveTypes = new[] { "Privilege", "Sick", "Maternity", "Paternity", "Unpaid" };

            leaveQuotas = leaveTypes.Select(type => new LeaveQuotaDto
            {
                LeaveType = type,
                RequestCount = pendingRequests?.Count(r => r.LeaveType == type) ?? 0
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading leave request counts: {ex.Message}", MudBlazor.Severity.Error);
            leaveQuotas = new List<LeaveQuotaDto>
            {
                new LeaveQuotaDto { LeaveType = "Privilege", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Sick", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Maternity", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Paternity", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Unpaid", RequestCount = 0 }
            };
        }
    }

    private async Task LoadPendingRequests()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            pendingRequests = await LeaveService.GetPendingRequestsAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error loading pending requests: {ex.Message}", MudBlazor.Severity.Error);
            pendingRequests = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error loading requests: {ex.Message}", MudBlazor.Severity.Error);
            pendingRequests = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDefaultQuotaHistory(string leaveType)
    {
        isLoadingQuotaHistory = true;
        StateHasChanged();
        try
        {
            var request = new QuotaHistoryRequestDto
            {
                LeaveType = leaveType,
                PageNumber = 1,
                PageSize = 10
            };
            defaultQuotaHistory = await LeaveService.GetQuotaHistoryAsync(request);
            if (defaultQuotaHistory == null || !defaultQuotaHistory.History.Any())
            {
                Snackbar.Add($"No history found for {leaveType} leave type.", MudBlazor.Severity.Info);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error loading default quota history: {ex.Message}", MudBlazor.Severity.Error);
            defaultQuotaHistory = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error loading default quota history: {ex.Message}", MudBlazor.Severity.Error);
            defaultQuotaHistory = null;
        }
        finally
        {
            isLoadingQuotaHistory = false;
            StateHasChanged();
        }
    }

    private async Task LoadIndividualQuotaHistory()
    {
        if (individualQuotaHistoryForm != null)
        {
            await individualQuotaHistoryForm.Validate();
            if (individualQuotaHistoryForm.IsValid)
            {
                isLoadingQuotaHistory = true;
                StateHasChanged();
                try
                {
                    var request = new QuotaHistoryRequestDto
                    {
                        EmployeeId = quotaHistoryRequest.EmployeeId,
                        PageNumber = 1,
                        PageSize = 10
                    };
                    individualQuotaHistory = await LeaveService.GetQuotaHistoryAsync(request);
                    if (individualQuotaHistory == null || !individualQuotaHistory.History.Any())
                    {
                        Snackbar.Add("No history found for the specified employee.", MudBlazor.Severity.Info);
                    }
                }
                catch (HttpRequestException ex)
                {
                    Snackbar.Add($"Error loading individual quota history: {ex.Message}", MudBlazor.Severity.Error);
                    individualQuotaHistory = null;
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Unexpected error loading individual quota history: {ex.Message}", MudBlazor.Severity.Error);
                    individualQuotaHistory = null;
                }
                finally
                {
                    isLoadingQuotaHistory = false;
                    StateHasChanged();
                }
            }
            else
            {
                Snackbar.Add("Please enter a valid Employee ID.", MudBlazor.Severity.Warning);
            }
        }
    }

    private async Task ToggleDefaultQuotaHistory()
    {
        ShowDefaultQuotaHistory = !ShowDefaultQuotaHistory;
        if (ShowDefaultQuotaHistory)
        {
            await LoadDefaultQuotaHistory(selectedLeaveType);
        }
    }

    private async Task OnDefaultLeaveTypeChanged(string leaveType)
    {
        defaultLeaveQuota.LeaveType = leaveType;
        if (defaultQuotaCache.ContainsKey(leaveType))
        {
            defaultLeaveQuota.Quota = defaultQuotaCache[leaveType];
        }
        else
        {
            defaultLeaveQuota.Quota = 0;
        }

        if (ShowDefaultQuotaHistory)
        {
            await LoadDefaultQuotaHistory(leaveType);
        }
        StateHasChanged();
    }

    private async Task OnIndividualLeaveTypeChanged(string leaveType)
    {
        individualLeaveQuota.LeaveType = leaveType;
        if (!string.IsNullOrEmpty(individualLeaveQuota.EmployeeID))
        {
            var key = (individualLeaveQuota.EmployeeID, leaveType);
            if (individualQuotaCache.ContainsKey(key))
            {
                individualLeaveQuota.Quota = individualQuotaCache[key];
            }
            else
            {
                try
                {
                    var request = new QuotaHistoryRequestDto
                    {
                        EmployeeId = individualLeaveQuota.EmployeeID,
                        LeaveType = leaveType,
                        PageNumber = 1,
                        PageSize = 1
                    };
                    var history = await LeaveService.GetQuotaHistoryAsync(request);
                    if (history?.History?.Any() == true)
                    {
                        individualLeaveQuota.Quota = history.History.First().NewQuota;
                        individualQuotaCache[key] = individualLeaveQuota.Quota;
                    }
                    else
                    {
                        individualLeaveQuota.Quota = 0;
                        individualQuotaCache[key] = 0;
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error loading individual quota: {ex.Message}", MudBlazor.Severity.Error);
                    individualLeaveQuota.Quota = 0;
                }
            }
        }
        else
        {
            individualLeaveQuota.Quota = 0;
        }

        if (ShowIndividualQuotaHistory)
        {
            await LoadIndividualQuotaHistory();
        }
        StateHasChanged();
    }

    private async Task RefreshPendingRequests()
    {
        await LoadPendingRequests();
        await LoadLeaveQuotas();
    }

    private async Task HandleApproveReject(int requestId, bool isApproved)
    {
        try
        {
            var request = new ApproveRejectDto { LeaveRequestId = requestId, IsApproved = isApproved };
            var response = await LeaveService.ApproveRejectRequestAsync(request);
            Snackbar.Add(response.Message, MudBlazor.Severity.Success);
            await LoadPendingRequests();
