@page "/admin/leave"
@using WiseHR.Models
@using WiseHR.Services
@using FluentValidation
@using Components.sidebar
@inject LeaveManagementService LeaveService
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager NavigationManager
@layout HomeLayout

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <AuthorizeView Roles="Admin,HR,Manager">
        <Authorized>
            <!-- Leave Request Overview -->
            <MudCard Class="mb-6" Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Leave Request Overview</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (isLoading)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-4" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="150px" />
                        </MudStack>
                    }
                    else
                    {
                        <MudGrid Class="@(showAllLeaveTypes ? "" : "justify-center")">
                            @foreach (var quota in leaveQuotas.Where(q => showAllLeaveTypes || new[] { "Privilege", "Sick", "Unpaid" }.Contains(q.LeaveType)))
                            {
                                <MudItem xs="12" sm="6" md="3">
                                    <MudPaper Class="pa-4 text-center" Style="@GetGradientStyle(quota.LeaveType)">
                                        <MudIcon Icon="@GetLeaveTypeIcon(quota.LeaveType)" Size="Size.Large" Color="@GetLeaveTypeColor(quota.LeaveType)" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="@($"color: {GetColorHex(GetLeaveTypeColor(quota.LeaveType))}")">@quota.RequestCount</MudText>
                                        <MudText Typo="Typo.body2" Style="@($"color: {GetColorHex(GetLeaveTypeColor(quota.LeaveType))}")">@quota.LeaveType Leave Requests</MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@(showAllLeaveTypes ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       OnClick="ToggleShowMore">
                                @(showAllLeaveTypes ? "Show Less" : "Show More")
                            </MudButton>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Pending Leave Requests -->
            <MudCard Class="mb-6" Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            <MudIcon Icon="Icons.Material.Filled.PendingActions" Class="mr-2" />
                            All Pending Leave Requests
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="RefreshPendingRequests"
                                   Disabled="@isLoading">
                            Refresh
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (isLoading)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="150px" Class="mt-2" />
                        </MudStack>
                    }
                    else
                    {
                        @if (pendingRequests == null || !pendingRequests.Any())
                        {
                            <MudPaper Class="pa-8 text-center" Style="background-color: #f5f5f5;">
                                <MudIcon Icon="Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                <MudText Typo="Typo.h6" Class="mt-2">No pending leave requests found</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">All requests have been processed</MudText>
                            </MudPaper>
                        }
                        else
                        {
                            <div style="overflow-x: auto; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                <MudTable Items="@pendingRequests"
                                          Hover="true"
                                          Breakpoint="Breakpoint.None"
                                          Dense="false"
                                          Elevation="0"
                                          Class="modern-table"
                                          Style="min-width: 1200px;">
                                    <HeaderContent>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 16px; min-width: 180px; position: sticky; left: 0; z-index: 10;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="Icons.Material.Filled.Person" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Employee</MudText>
                                            </MudStack>
                                        </MudTh>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 16px; min-width: 120px;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudIcon Icon="Icons.Material.Filled.Category" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Leave Type</MudText>
                                            </MudStack>
                                        </MudTh>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 16px; min-width: 160px;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudIcon Icon="Icons.Material.Filled.DateRange" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Duration</MudText>
                                            </MudStack>
                                        </MudTh>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 16px; min-width: 200px;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudIcon Icon="Icons.Material.Filled.Description" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Reason</MudText>
                                            </MudStack>
                                        </MudTh>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 16px; min-width: 180px;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudIcon Icon="Icons.Material.Filled.SupervisorAccount" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Mentor</MudText>
                                            </MudStack>
                                        </MudTh>
                                        <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 16px; min-width: 200px;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudIcon Icon="Icons.Material.Filled.Settings" Size="Size.Small" />
                                                <MudText Typo="Typo.subtitle2">Actions</MudText>
                                            </MudStack>
                                        </MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Employee" Style="text-align: left; padding: 16px; vertical-align: middle; background-color: white; position: sticky; left: 0; z-index: 5; box-shadow: 2px 0 5px rgba(0,0,0,0.1);">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                    @context.Name.Substring(0, 1).ToUpper()
                                                </MudAvatar>
                                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Name</MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="Leave Type" Style="text-align: center; padding: 16px; vertical-align: middle;">
                                            <MudStack AlignItems="AlignItems.Center">
                                                <MudChip T="string" Label="true"
                                                         Color="@GetLeaveTypeColor(context.LeaveType)"
                                                         Size="Size.Small"
                                                         Icon="@GetLeaveTypeIcon(context.LeaveType)">
                                                    @context.LeaveType
                                                </MudChip>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="Duration" Style="text-align: center; padding: 16px; vertical-align: middle;">
                                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                                    @context.StartDate.ToString("MMM dd") - @context.EndDate.ToString("MMM dd, yyyy")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">
                                                    @((context.EndDate - context.StartDate).Days + 1) Days
                                                </MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="Reason" Style="text-align: center; padding: 16px; vertical-align: middle;">
                                            <MudStack AlignItems="AlignItems.Center">
                                                <MudTooltip Text="@context.Reason">
                                                    <MudText Typo="Typo.body2"
                                                             Style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;">
                                                        @context.Reason
                                                    </MudText>
                                                </MudTooltip>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="Mentor" Style="text-align: center; padding: 16px; vertical-align: middle;">
                                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.MentorName</MudText>
                                                <MudText Typo="Typo.caption" Class="text-muted">@context.MentorEmail</MudText>
                                            </MudStack>
                                        </MudTd>
                                        <MudTd DataLabel="Actions" Style="text-align: center; padding: 16px; vertical-align: middle;">
                                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                                <MudTooltip Text="Approve this leave request">
                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Success"
                                                               Size="Size.Small"
                                                               OnClick="@(async () => await OnApprove(context.Id))"
                                                               Style="min-width: 80px; text-transform: none;">
                                                        Approve
                                                    </MudButton>
                                                </MudTooltip>
                                                <MudTooltip Text="Reject this leave request">
                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(async () => await OnReject(context.Id))"
                                                               Style="min-width: 80px; text-transform: none;">
                                                        Reject
                                                    </MudButton>
                                                </MudTooltip>
                                            </MudStack>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                    }
                </MudCardContent>
            </MudCard>

            <!-- Leave Quota Management Section -->
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
                <MudStack Spacing="6">
                    <MudGrid Spacing="4">
                        <!-- Manage Default Leave Quota Card -->
                        <MudItem xs="12" sm="6" md="6" lg="6">
                            <MudCard Class="quota-card" Elevation="3">
                                <MudCardHeader Class="header-centered">
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                                            <MudIcon Icon="Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
                                            Manage Default Leave Limit
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudTooltip Text="View default quota logs">
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       Class="logs-button"
                                                       OnClick="@(async () => await ToggleDefaultQuotaHistory())">
                                                Logs
                                            </MudButton>
                                        </MudTooltip>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (isLoading)
                                    {
                                        <MudStack Spacing="3">
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudForm @ref="defaultQuotaForm" Model="defaultLeaveQuota" Validation="@(new DefaultLeaveQuotaDtoValidator())">
                                            <MudStack Spacing="3">
                                                <MudSelect Label="Leave Type"
                                                           @bind-Value="DefaultLeaveType"
                                                           Required="true"
                                                           Variant="Variant.Outlined"
                                                           AnchorOrigin="Origin.BottomCenter"
                                                           Class="compact-input">
                                                    <MudSelectItem Value="@("Privilege")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                                                            <span>Privilege</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Sick")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.LocalHospital" Size="Size.Small" />
                                                            <span>Sick</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Maternity")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.FamilyRestroom" Size="Size.Small" />
                                                            <span>Maternity</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Paternity")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.Man" Size="Size.Small" />
                                                            <span>Paternity</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Unpaid")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                                                            <span>Unpaid</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                </MudSelect>

                                                <MudTextField Label="Quota (Number of Leaves)"
                                                              @bind-Value="defaultLeaveQuota.Quota"
                                                              Required="true"
                                                              InputType="InputType.Number"
                                                              Variant="Variant.Outlined"
                                                              Class="compact-input" />

                                                <MudTextField Label="Description"
                                                              @bind-Value="defaultLeaveQuota.Description"
                                                              Variant="Variant.Outlined"
                                                              Class="compact-input" />

                                                <MudStack Row Spacing="2" Class="mt-3">
                                                    <MudTooltip Text="Update the default leave quota for all employees">
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Primary"
                                                                   FullWidth="true"
                                                                   OnClick="ManageDefaultQuota">
                                                            Update Quota
                                                        </MudButton>
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudStack>
                                        </MudForm>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <!-- Manage Individual Leave Quota Card -->
                        <MudItem xs="12" sm="6" md="6" lg="6">
                            <MudCard Class="quota-card" Elevation="3">
                                <MudCardHeader Class="header-centered">
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                                            <MudIcon Icon="Icons.Material.Filled.Person" Class="mr-2" />
                                            Manage Individual Leave Limit
                                        </MudText>
                                    </CardHeaderContent>
                                    <CardHeaderActions>
                                        <MudTooltip Text="View individual quota logs">
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       Class="logs-button"
                                                       OnClick="@(() => ShowIndividualQuotaHistory = !ShowIndividualQuotaHistory)">
                                                Logs
                                            </MudButton>
                                        </MudTooltip>
                                    </CardHeaderActions>
                                </MudCardHeader>
                                <MudCardContent>
                                    @if (isLoading)
                                    {
                                        <MudStack Spacing="3">
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />

                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudForm @ref="individualQuotaForm" Model="individualLeaveQuota" Validation="@(new IndividualLeaveQuotaDtoValidator())">
                                            <MudStack Spacing="3">
                                                <MudTextField Label="Employee ID"
                                                              @bind-Value="individualLeaveQuota.EmployeeID"
                                                              Required="true"
                                                              Variant="Variant.Outlined"
                                                              Class ="compact-input" />

                                                <MudSelect Label="Leave Type"
                                                           @bind-Value="IndividualLeaveType"
                                                           Required="true"
                                                           Variant="Variant.Outlined"
                                                           AnchorOrigin="Origin.BottomCenter"
                                                           Class="compact-input">
                                                    <MudSelectItem Value="@("Privilege")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                                                            <span>Privilege</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Sick")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.LocalHospital" Size="Size.Small" />
                                                            <span>Sick</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Maternity")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.FamilyRestroom" Size="Size.Small" />
                                                            <span>Maternity</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Paternity")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.Man" Size="Size.Small" />
                                                            <span>Paternity</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                    <MudSelectItem Value="@("Unpaid")">
                                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                            <MudIcon Icon="Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                                                            <span>Unpaid</span>
                                                        </MudStack>
                                                    </MudSelectItem>
                                                </MudSelect>

                                                <MudTextField Label="Quota (Number of Leaves)"
                                                              @bind-Value="individualLeaveQuota.Quota"
                                                              Required="true"
                                                              InputType="InputType.Number"
                                                              Variant="Variant.Outlined"
                                                              Class="compact-input" />

                                                <MudTextField Label="Description"
                                                              @bind-Value="individualLeaveQuota.Description"
                                                              Variant="Variant.Outlined"
                                                              Class="compact-input" />

                                                <MudStack Row Spacing="2" Class="mt-3">
                                                    <MudTooltip Text="Update the individual leave quota for this employee">
                                                        <MudButton Variant="Variant.Filled"
                                                                   Color="Color.Primary"
                                                                   FullWidth="true"
                                                                   OnClick="ManageIndividualQuota">
                                                            Update Quota
                                                        </MudButton>
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudStack>
                                        </MudForm>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudContainer>

            <!-- Default Quota History Overlay -->
            <MudOverlay Visible="@ShowDefaultQuotaHistory"
                        DarkBackground="true"
                        ZIndex="1000"
                        AutoClose="false"
                        Class="fixed-overlay">
                <MudPaper Elevation="5" Class="centered-overlay">
                    <MudStack Spacing="4" Class="pa-6">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                <MudIcon Icon="Icons.Material.Filled.Assignment" Class="mr-2" />
                                Default Limit Logs
                            </MudText>
                            <MudIconButton Icon="Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowDefaultQuotaHistory = false)" />
                        </MudStack>

                        <MudSelect Label="Select Leave Type"
                                   @bind-Value="selectedLeaveType"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Class="compact-input"
                                   T="string">
                            <MudSelectItem Value="@("Privilege")">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                                    <span>Privilege</span>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="@("Sick")">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="Icons.Material.Filled.LocalHospital" Size="Size.Small" />
                                    <span>Sick</span>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="@("Maternity")">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="Icons.Material.Filled.FamilyRestroom" Size="Size.Small" />
                                    <span>Maternity</span>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="@("Paternity")">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="Icons.Material.Filled.Man" Size="Size.Small" />
                                    <span>Paternity</span>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="@("Unpaid")">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                                    <span>Unpaid</span>
                                </MudStack>
                            </MudSelectItem>
                        </MudSelect>

                        @if (isLoadingQuotaHistory)
                        {
                            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Class="mt-2" />
                            </MudStack>
                        }
                        else if (defaultQuotaHistory != null && defaultQuotaHistory.History.Any())
                        {
                            <MudTable Items="@defaultQuotaHistory.History"
                                      Hover="true"
                                      Breakpoint="Breakpoint.Sm"
                                      Dense="true"
                                      Elevation="0"
                                      Class="modern-table">
                                <HeaderContent>
                                    <MudTh Style="font-weight: 600;">Leave Type</MudTh>
                                    <MudTh Style="font-weight: 600;">Previous Quota</MudTh>
                                    <MudTh Style="font-weight: 600;">New Quota</MudTh>
                                    <MudTh Style="font-weight: 600;">Description</MudTh>
                                    <MudTh Style="font-weight: 600;">Updated By</MudTh>
                                    <MudTh Style="font-weight: 600;">Updated At</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Leave Type">@context.LeaveType</MudTd>
                                    <MudTd DataLabel="Previous Quota">@context.PreviousQuota</MudTd>
                                    <MudTd DataLabel="New Quota">@context.NewQuota</MudTd>
                                    <MudTd DataLabel="Description">@context.Description</MudTd>
                                    <MudTd DataLabel="Updated By">@context.UpdatedByName (@context.UpdatedByEmail)</MudTd>
                                    <MudTd DataLabel="Updated At">@context.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager />
                                </PagerContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudPaper Class="pa-4 text-center" Elevation="0">
                                <MudIcon Icon="Icons.Material.Filled.Info" Size="Size.Medium" Color="Color.Info" />
                                <MudText Typo="Typo.body2" Class="mt-2">No logs found for this leave type</MudText>
                            </MudPaper>
                        }

                        <MudStack Row Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="@(async () => await LoadDefaultQuotaHistory(selectedLeaveType))">
                                Search
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       OnClick="@(() => ShowDefaultQuotaHistory = false)">
                                Close
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudOverlay>

            <!-- Individual Quota History Overlay -->
            <MudOverlay Visible="@ShowIndividualQuotaHistory"
                        DarkBackground="true"
                        ZIndex="1000"
                        AutoClose="false"
                        Class="fixed-overlay">
                <MudPaper Elevation="5" Class="centered-overlay">
                    <MudStack Spacing="4" Class="pa-6">
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                <MudIcon Icon="Icons.Material.Filled.Assignment" Class="mr-2" />
                                Individual Limit Logs
                            </MudText>
                            <MudIconButton Icon="Icons.Material.Filled.Close"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowIndividualQuotaHistory = false)" />
                        </MudStack>

                        <MudForm @ref="individualQuotaHistoryForm" Model="quotaHistoryRequest" Validation="@(new QuotaHistoryRequestDtoValidator())">
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudTextField Label="Employee ID"
                                              @bind-Value="quotaHistoryRequest.EmployeeId"
                                              Variant="Variant.Outlined"
                                              Class="compact-input flex-grow-1"
                                              Immediate="true"
                                              OnKeyPress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await LoadIndividualQuotaHistory(); })" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="LoadIndividualQuotaHistory">
                                    Search
                                </MudButton>
                            </MudStack>
                        </MudForm>

                        @if (isLoadingQuotaHistory)
                        {
                            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="100px" Class="mt-2" />
                            </MudStack>
                        }
                        else if (individualQuotaHistory != null && individualQuotaHistory.History.Any())
                        {
                            <MudTable Items="@individualQuotaHistory.History"
                                      Hover="true"
                                      Breakpoint="Breakpoint.Sm"
                                      Dense="true"
                                      Elevation="0"
                                      Class="modern-table">
                                <HeaderContent>
                                    <MudTh Style="font-weight: 600;">Leave Type</MudTh>
                                    <MudTh Style="font-weight: 600;">Previous Quota</MudTh>
                                    <MudTh Style="font-weight: 600;">New Quota</MudTh>
                                    <MudTh Style="font-weight: 600;">Description</MudTh>
                                    <MudTh Style="font-weight: 600;">Updated By</MudTh>
                                    <MudTh Style="font-weight: 600;">Updated At</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Leave Type">@context.LeaveType</MudTd>
                                    <MudTd DataLabel="Previous Quota">@context.PreviousQuota</MudTd>
                                    <MudTd DataLabel="New Quota">@context.NewQuota</MudTd>
                                    <MudTd DataLabel="Description">@context.Description</MudTd>
                                    <MudTd DataLabel="Updated By">@context.UpdatedByName (@context.UpdatedByEmail)</MudTd>
                                    <MudTd DataLabel="Updated At">@context.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager />
                                </PagerContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudPaper Class="pa-4 text-center" Elevation="0">
                                <MudIcon Icon="Icons.Material.Filled.Info" Size="Size.Medium" Color="Color.Info" />
                                <MudText Typo="Typo.body2" Class="mt-2">No logs found for this employee</MudText>
                            </MudPaper>
                        }

                        <MudStack Row Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="LoadIndividualQuotaHistory">
                                Refresh
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       OnClick="@(() => ShowIndividualQuotaHistory = false)">
                                Close
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudOverlay>

            <!-- User Leave History Search -->
            <MudItem xs="12">
                <MudCard Class="mb-6" Elevation="4" Style="border-radius: 16px;">
                    <MudCardHeader Class="py-4">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                <MudIcon Icon="Icons.Material.Filled.History" Class="mr-2" Size="Size.Medium" />
                                Search User Leave History
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-6">
                        <MudForm @ref="historyForm" Model="historyRequest" Validation="@(new UserHistoryRequestDtoValidator())">
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="search-container mb-4">
                                <MudTextField Label="Employee ID or Email"
                                              @bind-Value="historyRequest.SearchTerm"
                                              Variant="Variant.Outlined"
                                              Class="compact-input flex-grow-1"
                                              Immediate="true"
                                              Margin="Margin.Dense"
                                              OnKeyPress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchHistory(); })" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="SearchHistory"
                                           Class="search-button px-6"
                                           Size="Size.Large">
                                    Search
                                </MudButton>
                            </MudStack>
                        </MudForm>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @if (historyResponse != null)
            {
                <MudGrid Class="px-4" Spacing="4">
                    <MudItem xs="12" sm="12" md="6" lg="8">
                        <MudCard Elevation="4" Class="mb-6" Style="border-radius: 16px;">
                            <MudCardHeader Class="py-4">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        <MudIcon Icon="Icons.Material.Filled.TableChart" Class="mr-2" Size="Size.Medium" />
                                        Leave History Results
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                @if (isLoading)
                                {
                                    <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" Class="mb-2" />
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                                    </MudStack>
                                }
                                else if (historyResponse.History != null && historyResponse.History.Any())
                                {
                                    <MudTable @ref="historyTable" Hover="true" Breakpoint="Breakpoint.None" Dense="false" Elevation="0" Class="enhanced-table" ServerData="@LoadServerData">
                                        <HeaderContent>
                                            <MudTh Class="table-header">Employee</MudTh>
                                            <MudTh Class="table-header">Email</MudTh>
                                            <MudTh Class="table-header">Leave Type</MudTh>
                                            <MudTh Class="table-header">Duration</MudTh>
                                            <MudTh Class="table-header">Reason</MudTh>
                                            <MudTh Class="table-header">Mentor</MudTh>
                                            <MudTh Class="table-header">Approver</MudTh>
                                            <MudTh Class="table-header">Status</MudTh>
                                            <MudTh Class="table-header">Approved At</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Employee" Class="table-cell">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                                        @(context.Name?.Substring(0, 1).ToUpper() ?? "U")
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.body1">@context.Name</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Email" Class="table-cell">
                                                <MudText Typo="Typo.body2">@context.Email</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Leave Type" Class="table-cell">
                                                <MudChip T="string" Label="true" Color="@GetLeaveTypeColor(context.LeaveType)" Size="Size.Medium" Icon="@GetLeaveTypeIcon(context.LeaveType)">
                                                    @context.LeaveType
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="Duration" Class="table-cell">
                                                <MudStack Spacing="4">
                                                    <MudText Typo="Typo.body2">
                                                        @context.StartDate.ToString("MMM dd") - @context.EndDate.ToString("MMM dd, yyyy")
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @((context.EndDate - context.StartDate).Days + 1) day(s)
                                                    </MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Reason" Class="table-cell">
                                                <MudText Typo="Typo.body2" Style="max-width: 400px; white-space: normal;">
                                                    @context.Reason
                                                </MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Mentor" Class="table-cell">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">@context.MentorName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MentorEmail</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Approver" Class="table-cell">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">@context.ApproverName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.ApproverEmail</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Status" Class="table-cell">
                                                <MudChip T="string" Label="true" Color="@GetStatusColor(context.Status)" Size="Size.Medium" Icon="@GetStatusIcon(context.Status)">
                                                    @context.Status
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="Approved At" Class="table-cell">
                                                <MudText Typo="Typo.body2">
                                                    @(context.ApprovedAt.HasValue ? context.ApprovedAt.Value.ToString("MMM dd, yyyy") : "N/A")
                                                </MudText>
                                            </MudTd>
                                        </RowTemplate>
                                        <PagerContent>
                                            <MudTablePager Class="px-4 py-3" />
                                        </PagerContent>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudPaper Class="pa-8 text-center" Elevation="0">
                                        <MudIcon Icon="Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.h6" Class="mt-4 mb-2">No leave history found</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Try searching with different criteria</MudText>
                                    </MudPaper>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" sm="12" md="6" lg="4">
                        <MudCard Elevation="3" Class="mb-4" Style="border-radius: 16px;">
                            <MudCardHeader Class="py-4">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        <MudIcon Icon="Icons.Material.Filled.Balance" Class="mr-2" Size="Size.Medium" />
                                        Leave Balances
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                @if (isLoading)
                                {
                                    <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" Class="mb-2" />
                                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px" />
                                    </MudStack>
                                }
                                else if (historyResponse.Balances != null && historyResponse.Balances.Any())
                                {
                                    <MudTable Items="@historyResponse.Balances"
                                              Hover="true"
                                              Breakpoint="Breakpoint.None"
                                              Dense="true"
                                              Elevation="0"
                                              Class="enhanced-table"
                                              Style="table-layout: fixed; width: 100%;">
                                        <HeaderContent>
                                            <MudTh Class="table-header" Style="width: 35%;">Leave Type</MudTh>
                                            <MudTh Class="table-header" Style="width: 20%; text-align: center;">Total</MudTh>
                                            <MudTh Class="table-header" Style="width: 20%; text-align: center;">Used</MudTh>
                                            <MudTh Class="table-header" Style="width: 25%; text-align: center;">Available</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Leave Type" Class="table-cell" Style="width: 35%; word-wrap: break-word;">
                                                <div style="display: flex; align-items: center; gap: 4px;">
                                                    <MudIcon Icon="@GetLeaveTypeIcon(context.LeaveType)"
                                                             Color="@GetLeaveTypeColor(context.LeaveType)"
                                                             Size="Size.Small" />
                                                    <span style="font-size: 0.875rem; font-weight: 500;">@context.LeaveType</span>
                                                </div>
                                            </MudTd>
                                            <MudTd DataLabel="Total" Class="table-cell" Style="width: 20%; text-align: center;">@context.TotalQuota</MudTd>
                                            <MudTd DataLabel="Used" Class="table-cell" Style="width: 20%; text-align: center;">@context.Consumed</MudTd>
                                            <MudTd DataLabel="Available" Class="table-cell" Style="width: 25%; text-align: center;">@context.Available</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudPaper Class="pa-8 text-center" Elevation="0">
                                        <MudIcon Icon="Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Info" />
                                        <MudText Typo="Typo.h6" Class="mt-4 mb-2">No leave balances available</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No quota information found for this employee</MudText>
                                    </MudPaper>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            }
        </Authorized>
    </AuthorizeView>
</MudContainer>

<style>
    .modern-table, .enhanced-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
    }

        .modern-table .mud-table-cell, .table-cell {
            border-bottom: 1px solid #e8ecef;
            padding: 16px 24px;
            vertical-align: middle;
            font-size: 1rem;
        }

        .modern-table .mud-table-row:hover, .enhanced-table .mud-table-row:hover {
            background-color: #f8fafc;
            transition: background-color 0.2s ease;
        }

    .table-header {
        font-weight: 600;
        background-color: #f5f6f8;
        padding: 16px 24px;
        text-align: left;
        border-bottom: 2px solid #e0e0e0;
        white-space: nowrap;
        font-size: 1.1rem;
    }

    .flex-grow-1 {
        flex-grow: 1;
    }

    .modern-table .mud-table-row:hover {
        background-color: #f8f9fa !important;
        transition: background-color 0.2s ease;
    }

    .modern-table .mud-table-cell {
        border-bottom: 1px solid #e9ecef;
    }

    .modern-table .mud-table-head .mud-table-cell {
        border-bottom: 2px solid #dee2e6;
    }

    div[style*="overflow-x: auto"]::-webkit-scrollbar {
        height: 8px;
    }

    div[style*="overflow-x: auto"]::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    div[style*="overflow-x: auto"]::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 4px;
    }

        div[style*="overflow-x: auto"]::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    .leave-quota-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 0;
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 24px;
        margin-bottom: 32px;
        border-radius: 0 0 24px 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

        .page-header .mud-text {
            color: white;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        .page-header .mud-icon {
            color: white;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
        }

    .quota-card {
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #ffffff;
        overflow: hidden;
        height: 100%;
        border: 1px solid #e3f2fd;
        position: relative;
    }

        .quota-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .quota-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15) !important;
            border-color: #bbdefb;
        }

            .quota-card:hover::before {
                opacity: 1;
            }

    .mud-card-header {
        background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
        border-bottom: 2px solid #e8eaf6;
        padding: 20px 24px;
        position: relative;
    }

    .header-centered {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

        .header-centered .mud-card-header-content {
            flex-grow: 1;
        }

        .header-centered .mud-text {
            color: #3f51b5;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .header-centered .mud-icon {
            color: #667eea;
        }

    .mud-card-content {
        padding: 28px 24px;
        background: #ffffff;
    }

    .uniform-input {
        width: 100%;
        max-width: 100%;
        margin-bottom: 4px;
    }

    .compact-input {
        width: 100%;
        max-width: 100%;
        margin-bottom: 4px;
    }

        .uniform-input .mud-input-root,
        .compact-input .mud-input-root {
            width: 100%;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

            .uniform-input .mud-input-root:hover,
            .compact-input .mud-input-root:hover {
                border-color: #667eea;
            }

            .uniform-input .mud-input-root.mud-input-outlined,
            .compact-input .mud-input-root.mud-input-outlined {
                border: 2px solid #e0e0e0;
            }

                .uniform-input .mud-input-root.mud-input-outlined:focus-within,
                .compact-input .mud-input-root.mud-input-outlined:focus-within {
                    border-color: #667eea;
                    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                }

        .compact-input .mud-input-root {
            font-size: 0.875rem;
            padding: 8px 12px;
        }

        .compact-input .mud-input-label {
            font-size: 0.75rem;
        }

    .mud-select .mud-input-root {
        border-radius: 12px;
    }

    .mud-select-item {
        padding: 12px 16px;
        transition: background-color 0.2s ease;
    }

        .mud-select-item:hover {
            background-color: #f3e5f5;
        }

        .mud-select-item .mud-stack {
            align-items: center;
        }

        .mud-select-item .mud-icon {
            color: #667eea;
        }

    .mud-button {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0.5px;
        min-height: 44px;
    }

        .mud-button.mud-button-filled.mud-button-color-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

            .mud-button.mud-button-filled.mud-button-color-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
                background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
            }

        .mud-button.mud-button-outlined {
            border: 2px solid #667eea;
            color: #667eea;
        }

            .mud-button.mud-button-outlined:hover {
                background-color: rgba(102, 126, 234, 0.04);
                border-color: #5a6fd8;
                transform: translateY(-1px);
            }

        .mud-button.mud-button-filled.mud-button-color-secondary {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
        }

    .logs-button {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 500;
        text-transform: none;
        font-size: 0.875rem;
        min-width: 70px;
        border: 2px solid #e3f2fd;
        background: #ffffff;
        color: #667eea;
        transition: all 0.2s ease;
    }

        .logs-button:hover {
            background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
            border-color: #667eea;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(102, 126, 234, 0.15);
        }

    .mud-grid.quota-grid {
        align-items: stretch;
        gap: 24px;
    }

        .mud-grid.quota-grid .mud-grid-item {
            display: flex;
            flex-direction: column;
        }

            .mud-grid.quota-grid .mud-grid-item > .quota-card {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

                .mud-grid.quota-grid .mud-grid-item > .quota-card .mud-card-content {
                    flex: 1;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                }

    .mud-grid.history-grid {
        align-items: stretch;
        gap: 24px;
    }

        .mud-grid.history-grid .mud-grid-item {
            display: flex;
            flex-direction: column;
        }

            .mud-grid.history-grid .mud-grid-item > .mud-card {
                flex: 1;
