    private async Task OnDefaultLeaveTypeChanged(string leaveType)
    {
        defaultLeaveQuota.LeaveType = leaveType;
        if (defaultQuotaCache.ContainsKey(leaveType))
        {
            defaultLeaveQuota.Quota = defaultQuotaCache[leaveType];
        }
        else
        {
            defaultLeaveQuota.Quota = 0;
        }

        if (ShowDefaultQuotaHistory)
        {
            await LoadDefaultQuotaHistory(leaveType);
        }
        StateHasChanged();
    }

    private async Task OnIndividualLeaveTypeChanged(string leaveType)
    {
        individualLeaveQuota.LeaveType = leaveType;
        if (!string.IsNullOrEmpty(individualLeaveQuota.EmployeeID))
        {
            var key = (individualLeaveQuota.EmployeeID, leaveType);
            if (individualQuotaCache.ContainsKey(key))
            {
                individualLeaveQuota.Quota = individualQuotaCache[key];
            }
            else
            {
                try
                {
                    var request = new QuotaHistoryRequestDto
                    {
                        EmployeeId = individualLeaveQuota.EmployeeID,
                        LeaveType = leaveType,
                        PageNumber = 1,
                        PageSize = 1
                    };
                    var history = await LeaveService.GetQuotaHistoryAsync(request);
                    if (history?.History?.Any() == true)
                    {
                        individualLeaveQuota.Quota = history.History.First().NewQuota;
                        individualQuotaCache[key] = individualLeaveQuota.Quota;
                    }
                    else
                    {
                        individualLeaveQuota.Quota = 0;
                        individualQuotaCache[key] = 0;
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error loading individual quota: {ex.Message}", MudBlazor.Severity.Error);
                    individualLeaveQuota.Quota = 0;
                }
            }
        }
        else
        {
            individualLeaveQuota.Quota = 0;
        }

        if (ShowIndividualQuotaHistory)
        {
            await LoadIndividualQuotaHistory();
        }
        StateHasChanged();
    }

