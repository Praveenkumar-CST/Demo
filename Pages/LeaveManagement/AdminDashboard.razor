@page "/admin/leave"
@using WiseHR.Models
@using WiseHR.Services
@using FluentValidation
@using Components.sidebar
@inject LeaveManagementService LeaveService
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager NavigationManager
@layout HomeLayout

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true" Class="mb-6">Admin Leave Management</MudText>

    <AuthorizeView Roles="Admin,HR,Manager">
        <Authorized>
            <!-- Leave Request Overview -->
            <MudCard Class="mb-6" Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Leave Request Overview</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (isLoading)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                            <MudText Typo="Typo.body1" Class="mt-2">Loading leave request counts...</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudGrid Class="@(showAllLeaveTypes ? "" : "justify-center")">
                            @foreach (var quota in leaveQuotas.Where(q => showAllLeaveTypes || new[] { "Privilege", "Sick", "Unpaid" }.Contains(q.LeaveType)))
                            {
                                <MudItem xs="12" sm="6" md="3">
                                    <MudPaper Class="pa-4 text-center" Style="@GetGradientStyle(quota.LeaveType)">
                                        <MudIcon Icon="@GetLeaveTypeIcon(quota.LeaveType)" Size="Size.Large" Color="@GetLeaveTypeColor(quota.LeaveType)" Class="mb-2" />
                                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="@($"color: {GetColorHex(GetLeaveTypeColor(quota.LeaveType))}")">@quota.RequestCount</MudText>
                                        <MudText Typo="Typo.body2" Style="@($"color: {GetColorHex(GetLeaveTypeColor(quota.LeaveType))}")">@quota.LeaveType Requests</MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@(showAllLeaveTypes ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       OnClick="ToggleShowMore">
                                @(showAllLeaveTypes ? "Show Less" : "Show More")
                            </MudButton>
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Pending Leave Requests -->
            <MudCard Class="mb-6" Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            <MudIcon Icon="Icons.Material.Filled.PendingActions" Class="mr-2" />
                            All Pending Leave Requests
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="Icons.Material.Filled.Refresh"
                                   OnClick="RefreshPendingRequests"
                                   Disabled="@isLoading">
                            Refresh
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (isLoading)
                    {
                        <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                            <MudText Typo="Typo.body1" Class="mt-2">Loading pending requests...</MudText>
                        </MudStack>
                    }
                    else
                    {
                        @if (pendingRequests == null || !pendingRequests.Any())
                        {
                            <MudPaper Class="pa-8 text-center" Style="background-color: #f5f5f5;">
                                <MudIcon Icon="Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                <MudText Typo="Typo.h6" Class="mt-2">No pending leave requests found</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">All requests have been processed</MudText>
                            </MudPaper>
                        }
                        else
                        {
                            <MudTable Items="@pendingRequests"
                                      Hover="true"
                                      Breakpoint="Breakpoint.Sm"
                                      Dense="false"
                                      Elevation="0"
                                      Class="modern-table">
                                <HeaderContent>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                        Employee
                                    </MudTh>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.Category" Size="Size.Small" Class="mr-1" />
                                        Leave Type
                                    </MudTh>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.DateRange" Size="Size.Small" Class="mr-1" />
                                        Duration
                                    </MudTh>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
                                        Reason
                                    </MudTh>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: left; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.SupervisorAccount" Size="Size.Small" Class="mr-1" />
                                        Mentor
                                    </MudTh>
                                    <MudTh Style="font-weight: 600; background-color: #f8f9fa; text-align: center; padding: 12px;">
                                        <MudIcon Icon="Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-1" />
                                        Actions
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Employee" Style="text-align: left; padding: 12px;">
                                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                @context.Name.Substring(0, 1).ToUpper()
                                            </MudAvatar>
                                            <MudText>@context.Name</MudText>
                                        </MudStack>
                                    </MudTd>
                                    <MudTd DataLabel="Leave Type" Style="text-align: left; padding: 12px;">
                                        <MudChip T="string" Label="true"
                                                 Color="@GetLeaveTypeColor(context.LeaveType)"
                                                 Size="Size.Small"
                                                 Icon="@GetLeaveTypeIcon(context.LeaveType)">
                                            @context.LeaveType
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Duration" Style="text-align: left; padding: 12px;">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.body2">
                                                @context.StartDate.ToString("MMM dd") - @context.EndDate.ToString("MMM dd, yyyy")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">
                                                @((context.EndDate - context.StartDate).Days + 1) Days
                                            </MudText>
                                        </MudStack>
                                    </MudTd>
                                    <MudTd DataLabel="Reason" Style="text-align: left; padding: 12px;">
                                        <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                            @context.Reason
                                        </MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Mentor" Style="text-align: left; padding: 12px;">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.body2">@context.MentorName</MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">@context.MentorEmail</MudText>
                                        </MudStack>
                                    </MudTd>
                                    <MudTd DataLabel="Actions" Style="text-align: center; padding: 12px; background: transparent;">
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="action-buttons">
                                            <MudButton Variant="Variant.Filled"
                                                       Style="background-color: #4caf50; color: white;"
                                                       Size="Size.Small"
                                                       StartIcon="Icons.Material.Filled.CheckCircle"
                                                       OnClick="@(async () => await OnApprove(context.Id))">
                                                Approve
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled"
                                                       Style="background-color: #f44336; color: white;"
                                                       Size="Size.Small"
                                                       StartIcon="Icons.Material.Filled.Cancel"
                                                       OnClick="@(async () => await OnReject(context.Id))">
                                                Reject
                                            </MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                </MudCardContent>
            </MudCard>

            <MudGrid>
                <!-- Manage Default Leave Quota -->
                <MudItem xs="12" md="6">
                    <MudCard Class="mb-4 quota-card" Elevation="3" Style="min-height: 400px;">
                        <MudCardHeader Class="header-centered">
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="font-weight-bold">
                                    <MudIcon Icon="Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
                                    Manage Default Leave Quota
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="d-flex flex-column h-100">
                            <MudForm @ref="defaultQuotaForm" Model="defaultLeaveQuota" Validation="@(new DefaultLeaveQuotaDtoValidator())" Class="flex-grow-1">
                                <MudStack Spacing="4">
                                    <MudSelect Label="Leave Type"
                                               @bind-Value="defaultLeaveQuota.LeaveType"
                                               Required="true"
                                               Variant="Variant.Outlined"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Class="uniform-input">
                                        <MudSelectItem Value="@("Privilege")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                                                <span>Privilege</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Sick")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.LocalHospital" Size="Size.Small" />
                                                <span>Sick</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Maternity")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.FamilyRestroom" Size="Size.Small" />
                                                <span>Maternity</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Paternity")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.Man" Size="Size.Small" />
                                                <span>Paternity</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Unpaid")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                                                <span>Unpaid</span>
                                            </MudStack>
                                        </MudSelectItem>
                                    </MudSelect>
                                    <MudTextField Label="Quota (Number of Leaves)"
                                                  @bind-Value="defaultLeaveQuota.Quota"
                                                  Required="true"
                                                  InputType="InputType.Number"
                                                  Variant="Variant.Outlined"
                                                  Class="uniform-input" />
                                    <MudTextField Label="Description"
                                                  @bind-Value="defaultLeaveQuota.Description"
                                                  Variant="Variant.Outlined"
                                                  Class="uniform-input" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               StartIcon="Icons.Material.Filled.Update"
                                               OnClick="ManageDefaultQuota">
                                        Update Default Quota
                                    </MudButton>
                                </MudStack>
                            </MudForm>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Manage Individual Leave Quota -->
                <MudItem xs="12" md="6">
                    <MudCard Class="mb-4 quota-card" Elevation="3" Style="min-height: 400px;">
                        <MudCardHeader Class="header-centered">
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Class="font-weight-bold">
                                    <MudIcon Icon="Icons.Material.Filled.Person" Class="mr-2" />
                                    Manage Individual Leave Quota
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="d-flex flex-column h-100">
                            <MudForm @ref="individualQuotaForm" Model="individualLeaveQuota" Validation="@(new IndividualLeaveQuotaDtoValidator())" Class="flex-grow-1">
                                <MudStack Spacing="4">
                                    <MudTextField Label="Employee ID"
                                                  @bind-Value="individualLeaveQuota.EmployeeID"
                                                  Required="true"
                                                  Variant="Variant.Outlined"
                                                  Class="uniform-input" />
                                    <MudSelect Label="Leave Type"
                                               @bind-Value="individualLeaveQuota.LeaveType"
                                               Required="true"
                                               Variant="Variant.Outlined"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Class="uniform-input">
                                        <MudSelectItem Value="@("Privilege")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.BeachAccess" Size="Size.Small" />
                                                <span>Privilege</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Sick")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.LocalHospital" Size="Size.Small" />
                                                <span>Sick</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Maternity")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.FamilyRestroom" Size="Size.Small" />
                                                <span>Maternity</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Paternity")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.Man" Size="Size.Small" />
                                                <span>Paternity</span>
                                            </MudStack>
                                        </MudSelectItem>
                                        <MudSelectItem Value="@("Unpaid")">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="Icons.Material.Filled.MoneyOff" Size="Size.Small" />
                                                <span>Unpaid</span>
                                            </MudStack>
                                        </MudSelectItem>
                                    </MudSelect>
                                    <MudTextField Label="Quota (Number of Leaves)"
                                                  @bind-Value="individualLeaveQuota.Quota"
                                                  Required="true"
                                                  InputType="InputType.Number"
                                                  Variant="Variant.Outlined"
                                                  Class="uniform-input" />
                                    <MudTextField Label="Description"
                                                  @bind-Value="individualLeaveQuota.Description"
                                                  Variant="Variant.Outlined"
                                                  Class="uniform-input" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               StartIcon="Icons.Material.Filled.Update"
                                               OnClick="ManageIndividualQuota">
                                        Update Individual Quota
                                    </MudButton>
                                </MudStack>
                            </MudForm>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- User Leave History Search -->
            <MudItem xs="12">
                <MudCard Class="mb-6" Elevation="4" Style="border-radius: 16px;">
                    <MudCardHeader Class="py-4">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                <MudIcon Icon="Icons.Material.Filled.History" Class="mr-2" Size="Size.Medium" />
                                Search User Leave History
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-6">
                        <MudForm @ref="historyForm" Model="historyRequest" Validation="@(new UserHistoryRequestDtoValidator())">
                            <MudStack Spacing="4" Class="search-container mb-4">
                                <MudTextField Label="Employee ID"
                                              @bind-Value="historyRequest.EmployeeId"
                                              Variant="Variant.Outlined"
                                              Class="uniform-input"
                                              Immediate="true"
                                              Margin="Margin.Dense"
                                              OnKeyPress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchHistory(); })" />
                                <MudTextField Label="Email"
                                              @bind-Value="historyRequest.Email"
                                              Variant="Variant.Outlined"
                                              Class="uniform-input"
                                              Immediate="true"
                                              Margin="Margin.Dense"
                                              OnKeyPress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await SearchHistory(); })" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="Icons.Material.Filled.Search"
                                           OnClick="SearchHistory"
                                           Class="search-button px-6"
                                           Size="Size.Large">
                                    Search
                                </MudButton>
                            </MudStack>
                        </MudForm>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            @if (historyResponse != null)
            {
                <MudGrid Class="px-4">
                    <MudItem xs="12" md="8">
                        <MudCard Elevation="4" Class="mb-6" Style="border-radius: 16px;">
                            <MudCardHeader Class="py-4">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">
                                        <MudIcon Icon="Icons.Material.Filled.TableChart" Class="mr-2" Size="Size.Medium" />
                                        Leave History Results
                                    </MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="pa-0">
                                @if (historyResponse.History != null && historyResponse.History.Any())
                                {
                                    <MudTable @ref="historyTable"
                                              Hover="true"
                                              Breakpoint="Breakpoint.None"
                                              Dense="false"
                                              Elevation="0"
                                              Class="enhanced-table"
                                              ServerData="@LoadServerData">
                                        <HeaderContent>
                                            <MudTh Class="table-header">Employee</MudTh>
                                            <MudTh Class="table-header">Email</MudTh>
                                            <MudTh Class="table-header">Leave Type</MudTh>
                                            <MudTh Class="table-header">Duration</MudTh>
                                            <MudTh Class="table-header">Reason</MudTh>
                                            <MudTh Class="table-header">Mentor</MudTh>
                                            <MudTh Class="table-header">Approver</MudTh>
                                            <MudTh Class="table-header">Status</MudTh>
                                            <MudTh Class="table-header">Approved At</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Employee" Class="table-cell">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                                        @(context.Name?.Substring(0, 1).ToUpper() ?? "U")
                                                    </MudAvatar>
                                                    <MudText Typo="Typo.body1">@context.Name</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Email" Class="table-cell">
                                                <MudText Typo="Typo.body2">@context.Email</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Leave Type" Class="table-cell">
                                                <MudChip T="string" Label="true"
                                                         Color="@GetLeaveTypeColor(context.LeaveType)"
                                                         Size="Size.Medium"
                                                         Icon="@GetLeaveTypeIcon(context.LeaveType)">
                                                    @context.LeaveType
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="Duration" Class="table-cell">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">
                                                        @context.StartDate.ToString("MMM dd") - @context.EndDate.ToString("MMM dd, yyyy")
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @((context.EndDate - context.StartDate).Days + 1) day(s)
                                                    </MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Reason" Class="table-cell">
                                                <MudText Typo="Typo.body2" Style="max-width: 250px; white-space: normal; word-break: break-word;">
                                                    @context.Reason
                                                </MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Mentor" Class="table-cell">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">@context.MentorName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MentorEmail</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Approver" Class="table-cell">
                                                <MudStack Spacing="1">
                                                    <MudText Typo="Typo.body2">@context.ApproverName</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.ApproverEmail</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Status" Class="table-cell">
                                                <MudChip T="string" Label="true"
                                                         Color="@GetStatusColor(context.Status)"
                                                         Size="Size.Medium"
                                                         Icon="@GetStatusIcon(context.Status)">
                                                    @context.Status
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="Approved At" Class="table-cell">
                                                <MudText Typo="Typo.body2">@(context.ApprovedAt.HasValue ? context.ApprovedAt.Value.ToString("MMM dd, yyyy") : "N/A")</MudText>
                                            </MudTd>
                                        </RowTemplate>
                                        <PagerContent>
                                            <MudTablePager Class="px-4 py-3" />
                                        </PagerContent>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudPaper Class="pa-8 text-center" Elevation="0">
                                        <MudIcon Icon="Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.h6" Class="mt-4 mb-2">No leave history found</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Try searching with different criteria</MudText>
                                    </MudPaper>
                                }
                            </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCard Elevation="4" Class="mb-6" Style="border-radius: 16px;">
                        <MudCardHeader Class="py-4">
                            <CardHeaderContent>
                                <MudText Typo="Typo.h5" Class="font-weight-bold">
                                    <MudIcon Icon="Icons.Material.Filled.Balance" Class="Size.Medium" />
                                    Leave Balances
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            @if (historyResponse.Balances != null && historyResponse.Balances.Any())
                            {
                                <MudTable Items="@historyResponse.Balances"
                                    Hover="true"
                                    Breakpoint="Breakpoint.None"
                                    Dense="true"
                                    Elevation="0"
                                    Class="enhanced-table">
                                    <HeaderContent>
                                    <MudTh Class="table-header">Leave Type</MudTh>
                                    <MudTh Class="table-header">Total</MudTh>
                                    <MudTh Class="table-header">Used</MudTh>
                                    <MudTh Class="table-header">Available</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Leave Type" Class="table-cell">
                                            <MudChip T="string" Label="true"
                                                     Color="@GetLeaveTypeColor(context.LeaveType)"
                                                     Size="Size.Medium"
                                                     Icon="@GetLeaveTypeIcon(context.LeaveType)">
                                                @context.LeaveType
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Total" Class="table-cell">@context.TotalQuota</MudTd>
                                        <MudTd DataLabel="Used" Class="table-cell">@context.Consumed</MudTd>
                                        <MudTd DataLabel="Available" Class="table-cell">@context.Available</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else
                            {
                                <MudPaper Class="pa-8 text-center" Elevation="0">
                                    <MudIcon Icon="Icons.Material.Filled.Info" Size="Size.Large" Color="Color.Info" />
                                    <MudText Typo="Typo.h6" Class="mt-4 mb-2">No leave balances available</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No quota information found for this employee</MudText>
                                </MudPaper>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }
    </Authorized>
</AuthorizeView>
</MudContainer>

