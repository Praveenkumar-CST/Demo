    private async Task SearchHistory()
{
    if (historyForm != null)
    {
        await historyForm.Validate();
        if (historyForm.IsValid)
        {
            try
            {
                currentSearchId++;

                if (!string.IsNullOrWhiteSpace(historyRequest.SearchTerm))
                {
                    if (historyRequest.SearchTerm.Contains("@"))
                    {
                        historyRequest.Email = historyRequest.SearchTerm.Trim();
                        historyRequest.EmployeeId = null; 
                    }
                    else
                    {
                        historyRequest.EmployeeId = historyRequest.SearchTerm.Trim();
                        historyRequest.Email = null; 
                    }
                }

                historyResponse = await LeaveService.GetUserHistoryAsync(historyRequest);
                if (historyTable != null)
                {
                    await historyTable.ReloadServerData();
                }
                if (historyResponse == null || !historyResponse.History.Any())
                {
                    Snackbar.Add("No results found for the search criteria.", MudBlazor.Severity.Info);
                }
                else
                {
                    Snackbar.Add("History and balances loaded successfully", MudBlazor.Severity.Success);
                }
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add($"Error loading history: {ex.Message}", MudBlazor.Severity.Error);
                historyResponse = null;
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Unexpected error loading history: {ex.Message}", MudBlazor.Severity.Error);
                historyResponse = null;
            }
            finally
            {
                StateHasChanged();
            }
        }
        else
        {
            Snackbar.Add("Please enter valid search criteria.", MudBlazor.Severity.Warning);
        }
    }
}
    private int CalculateWorkingDays(DateTime startDate, DateTime endDate)
    {
        int totalDays = 0;
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek != DayOfWeek.Saturday && date.DayOfWeek != DayOfWeek.Sunday)
            {
                totalDays++;
            }
        }
        return totalDays;
    }

