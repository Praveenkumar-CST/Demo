    private async Task<TableData<LeaveHistory>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var request = new UserHistoryRequestDto
            {
                EmployeeId = historyRequest.EmployeeId,
                Email = historyRequest.Email,
                PageNumber = state.Page + 1,
                PageSize = state.PageSize
            };

            if (currentSearchId != lastSearchId)
            {
                request.PageNumber = 1;
                lastSearchId = currentSearchId;
            }

            var response = await LeaveService.GetUserHistoryAsync(request);

            if (cancellationToken.IsCancellationRequested)
            {
                return new TableData<LeaveHistory>
                {
                    Items = new List<LeaveHistory>(),
                    TotalItems = 0
                };
            }

            var leaveHistoryItems = response?.History?.Select(h => new LeaveHistory
            {
                Id = 0,
                EmployeeID = h.EmployeeID,
                Name = h.Name,
                Email = h.Email,
                LeaveType = h.LeaveType,
                StartDate = h.StartDate,
                EndDate = h.EndDate,
                Reason = h.Reason,
                Status = h.Status,
                ApprovedAt = h.ApprovedAt,
                ApproverName = h.ApproverName,
                MentorName = h.MentorName,
                MentorEmail = string.Empty
            }).ToList() ?? new List<LeaveHistory>();

            return new TableData<LeaveHistory>
            {
                Items = leaveHistoryItems,
                TotalItems = response?.Pagination?.TotalRecords ?? 0
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading history: {ex.Message}", MudBlazor.Severity.Error);
            return new TableData<LeaveHistory>
            {
                Items = new List<LeaveHistory>(),
                TotalItems = 0
            };
        }
    }

