                {
                    if (historyRequest.SearchTerm.Contains("@"))
                    {
                        historyRequest.Email = historyRequest.SearchTerm.Trim();
                        historyRequest.EmployeeId = null; 
                    }
                    else
                    {
                        historyRequest.EmployeeId = historyRequest.SearchTerm.Trim();
                        historyRequest.Email = null; 
                    }
