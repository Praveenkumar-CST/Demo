@code {
    private MudForm? defaultQuotaForm;
    private MudForm? individualQuotaForm;
    private MudForm? historyForm;
    private DefaultLeaveQuotaDto defaultLeaveQuota = new();
    private IndividualLeaveQuotaDto individualLeaveQuota = new();
    private UserHistoryRequestDto historyRequest = new();
    private List<LeaveRequest>? pendingRequests;
    private MyHistoryResponse? historyResponse;
    private List<LeaveQuotaDto> leaveQuotas = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPendingRequests();
            await LoadLeaveQuotas();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Initialization failed: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error during initialization: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadLeaveQuotas()
    {
        try
        {
            // Ensure pending requests are loaded
            if (pendingRequests == null)
            {
                await LoadPendingRequests();
            }

            var leaveTypes = new[] { "Privilege", "Sick", "Casual", "Maternity", "Paternity", "Unpaid" };

            // Count pending requests by leave type
            leaveQuotas = leaveTypes.Select(type => new LeaveQuotaDto
            {
                LeaveType = type,
                RequestCount = pendingRequests?.Count(r => r.LeaveType == type) ?? 0
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading leave request counts: {ex.Message}", MudBlazor.Severity.Error);
            leaveQuotas = new List<LeaveQuotaDto>
            {
                new LeaveQuotaDto { LeaveType = "Privilege", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Sick", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Casual", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Maternity", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Paternity", RequestCount = 0 },
                new LeaveQuotaDto { LeaveType = "Unpaid", RequestCount = 0 }
            };
        }
    }

    private async Task LoadPendingRequests()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            pendingRequests = await LeaveService.GetPendingRequestsAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error loading pending requests: {ex.Message}", MudBlazor.Severity.Error);
            pendingRequests = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error loading requests: {ex.Message}", MudBlazor.Severity.Error);
            pendingRequests = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshPendingRequests()
    {
        await LoadPendingRequests();
        await LoadLeaveQuotas();
    }

    private async Task HandleApproveReject(int requestId, bool isApproved)
    {
        try
        {
            var request = new ApproveRejectDto { LeaveRequestId = requestId, IsApproved = isApproved };
            var response = await LeaveService.ApproveRejectRequestAsync(request);
            Snackbar.Add(response.Message, MudBlazor.Severity.Success);
            await LoadPendingRequests();
            await LoadLeaveQuotas();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Error processing request: {ex.Message}", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error processing request: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task OnApprove(int id) => await HandleApproveReject(id, true);
    private async Task OnReject(int id) => await HandleApproveReject(id, false);

    private async Task ManageDefaultQuota()
    {
        if (defaultQuotaForm != null)
        {
            await defaultQuotaForm.Validate();
            if (defaultQuotaForm.IsValid)
            {
                try
                {
                    var response = await LeaveService.ManageDefaultLeaveQuotaAsync(defaultLeaveQuota);
                    Snackbar.Add(response.Message, MudBlazor.Severity.Success);
                    defaultLeaveQuota = new();
                    await defaultQuotaForm.ResetAsync();
                    await LoadLeaveQuotas();
                }
                catch (HttpRequestException ex)
                {
                    Snackbar.Add($"Error updating default quota: {ex.Message}", MudBlazor.Severity.Error);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Unexpected error updating quota: {ex.Message}", MudBlazor.Severity.Error);
                }
            }
        }
    }

    private async Task ManageIndividualQuota()
    {
        if (individualQuotaForm != null)
        {
            await individualQuotaForm.Validate();
            if (individualQuotaForm.IsValid)
            {
                try
                {
                    var response = await LeaveService.ManageIndividualLeaveQuotaAsync(individualLeaveQuota);
                    Snackbar.Add(response.Message, MudBlazor.Severity.Success);
                    individualLeaveQuota = new();
                    await individualQuotaForm.ResetAsync();
                    await LoadLeaveQuotas();
                }
                catch (HttpRequestException ex)
                {
                    Snackbar.Add($"Error updating individual quota: {ex.Message}", MudBlazor.Severity.Error);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Unexpected error updating quota: {ex.Message}", MudBlazor.Severity.Error);
                }
            }
        }
    }

    private async Task SearchHistory()
    {
        if (historyForm != null)
        {
            await historyForm.Validate();
            if (historyForm.IsValid)
            {
                try
                {
                    historyResponse = await LeaveService.GetUserHistoryAsync(historyRequest);
                    Snackbar.Add("History and balances loaded successfully", MudBlazor.Severity.Success);
                }
                catch (HttpRequestException ex)
                {
                    Snackbar.Add($"Error loading history: {ex.Message}", MudBlazor.Severity.Error);
                    historyResponse = null;
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Unexpected error loading history: {ex.Message}", MudBlazor.Severity.Error);
                    historyResponse = null;
                }
            }
        }
    }

    private async Task<TableData<LeaveHistory>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            historyRequest.PageNumber = state.Page + 1;
            historyRequest.PageSize = state.PageSize;
            historyResponse = await LeaveService.GetUserHistoryAsync(historyRequest);

            if (cancellationToken.IsCancellationRequested)
            {
                return new TableData<LeaveHistory>
                {
                    Items = new List<LeaveHistory>(),
                    TotalItems = 0
                };
            }

            return new TableData<LeaveHistory>
            {
                Items = historyResponse.History ?? new List<LeaveHistory>(),
                TotalItems = historyResponse.Pagination?.TotalRecords ?? 0
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading history: {ex.Message}", MudBlazor.Severity.Error);
            return new TableData<LeaveHistory>
            {
                Items = new List<LeaveHistory>(),
                TotalItems = 0
            };
        }
    }

    private Color GetLeaveTypeColor(string leaveType) => leaveType switch
    {
        "Privilege" => Color.Success,
        "Sick" => Color.Warning,
        "Casual" => Color.Info,
        "Maternity" => Color.Secondary,
        "Paternity" => Color.Primary,
        "Unpaid" => Color.Error,
        _ => Color.Default
    };

    private string GetLeaveTypeIcon(string leaveType) => leaveType switch
    {
        "Privilege" => Icons.Material.Filled.BeachAccess,
        "Sick" => Icons.Material.Filled.LocalHospital,
        "Casual" => Icons.Material.Filled.Coffee,
        "Maternity" => Icons.Material.Filled.FamilyRestroom,
        "Paternity" => Icons.Material.Filled.Man,
        "Unpaid" => Icons.Material.Filled.MoneyOff,
        _ => Icons.Material.Filled.EventNote
    };

    private string GetGradientStyle(string leaveType) => leaveType switch
    {
        "Privilege" => "background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%); border-radius: 12px;",
        "Sick" => "background: linear-gradient(135deg, #fff3e0 0%, #ffcc80 100%); border-radius: 12px;",
        "Casual" => "background: linear-gradient(135deg, #e3f2fd 0%, #90caf9 100%); border-radius: 12px;",
        "Maternity" => "background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%); border-radius: 12px;",
        "Paternity" => "background: linear-gradient(135deg, #e0f7fa 0%, #80deea 100%); border-radius: 12px;",
        "Unpaid" => "background: linear-gradient(135deg, #ffebee 0%, #ef9a9a 100%); border-radius: 12px;",
        _ => "background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%); border-radius: 12px;"
    };

    private string GetColorHex(Color color) => color switch
    {
        Color.Success => "#4caf50",
        Color.Warning => "#ff9800",
        Color.Info => "#2196f3",
        Color.Secondary => "#f06292",
        Color.Primary => "#3f51b5",
        Color.Error => "#f44336",
        _ => "#000000"
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "Pending" => Color.Warning,
        _ => Color.Default
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Approved" => Icons.Material.Filled.CheckCircle,
        "Rejected" => Icons.Material.Filled.Cancel,
        "Pending" => Icons.Material.Filled.PendingActions,
        _ => Icons.Material.Filled.Help
    };

    public class LeaveQuotaDto
    {
        public string LeaveType { get; set; }
        public int RequestCount { get; set; }
    }

    public class DefaultLeaveQuotaDtoValidator : AbstractValidator<DefaultLeaveQuotaDto>
    {
        public DefaultLeaveQuotaDtoValidator()
        {
            RuleFor(x => x.LeaveType).NotEmpty().WithMessage("Leave type is required");
            RuleFor(x => x.Quota).GreaterThanOrEqualTo(0).WithMessage("Quota cannot be negative");
        }
    }

    public class IndividualLeaveQuotaDtoValidator : AbstractValidator<IndividualLeaveQuotaDto>
    {
        public IndividualLeaveQuotaDtoValidator()
        {
            RuleFor(x => x.EmployeeID).NotEmpty().WithMessage("Employee ID is required");
            RuleFor(x => x.LeaveType).NotEmpty().WithMessage("Leave type is required");
            RuleFor(x => x.Quota).GreaterThanOrEqualTo(0).WithMessage("Quota cannot be negative");
        }
    }

    public class UserHistoryRequestDtoValidator : AbstractValidator<UserHistoryRequestDto>
    {
        public UserHistoryRequestDtoValidator()
        {
            RuleFor(x => x).Must(x => !string.IsNullOrEmpty(x.Name) || !string.IsNullOrEmpty(x.EmployeeId) || !string.IsNullOrEmpty(x.Email))
                .WithMessage("At least one of Name, Employee ID, or Email is required");
        }
    }
}