        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error processing request: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task OnApprove(int id) => await HandleApproveReject(id, true);
    private async Task OnReject(int id) => await HandleApproveReject(id, false);

