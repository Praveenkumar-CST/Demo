    public class LeaveQuotaDto
    {
        public string LeaveType { get; set; }
        public int RequestCount { get; set; }
    }

    public class DefaultLeaveQuotaDtoValidator : AbstractValidator<DefaultLeaveQuotaDto>
    {
        public DefaultLeaveQuotaDtoValidator()
        {
            RuleFor(x => x.LeaveType).NotEmpty().WithMessage("Leave type is required");
            RuleFor(x => x.Quota).GreaterThanOrEqualTo(0).WithMessage("Quota cannot be negative");
            RuleFor(x => x.Description).NotEmpty().When(x => x.Quota > 0).WithMessage("Description is required for assigning extra leaves");
        }
    }

    public class IndividualLeaveQuotaDtoValidator : AbstractValidator<IndividualLeaveQuotaDto>
    {
        public IndividualLeaveQuotaDtoValidator()
        {
            RuleFor(x => x.EmployeeID).NotEmpty().WithMessage("Employee ID is required");
            RuleFor(x => x.LeaveType).NotEmpty().WithMessage("Leave type is required");
            RuleFor(x => x.Quota).GreaterThanOrEqualTo(0).WithMessage("Quota cannot be negative");
            RuleFor(x => x.Description).NotEmpty().When(x => x.Quota > 0).WithMessage("Description is required for assigning extra leaves");
        }
    }

    public class UserHistoryRequestDtoValidator : AbstractValidator<UserHistoryRequestDto>
    {
        public UserHistoryRequestDtoValidator()
        {
            RuleFor(x => x.SearchTerm)
                .NotEmpty()
                .WithMessage("Please enter an Employee ID or Email")
                .MinimumLength(3)
                .WithMessage("Search term must be at least 3 characters");
        }
    }

    public class QuotaHistoryRequestDtoValidator : AbstractValidator<QuotaHistoryRequestDto>
    {
        public QuotaHistoryRequestDtoValidator()
        {
            RuleFor(x => x.EmployeeId).NotEmpty().When(x => string.IsNullOrEmpty(x.LeaveType)).WithMessage("Employee ID is required when Leave Type is not specified");
        }
    }
}
