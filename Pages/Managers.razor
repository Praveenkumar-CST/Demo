@page "/managers"
@inject IUserService UserService
@inject EmployeeService EmployeeService
@inject MentorAssignmentService MentorAssignmentService
@layout WiseHR.Components.sidebar.HomeLayout
@using WiseHR.Models
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h4" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
            Mentor Hierarchy
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Manage mentor-mentee relationships in a hierarchical structure
        </MudText>
    </MudPaper>

    @if (isPageLoading)
    {
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4">Loading hierarchy...</MudText>
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            <MudText>@errorMessage</MudText>
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="0">
            @* Admin Section *@
            @if (GetAdminNodes().Any())
            {
                <MudText Typo="Typo.h6" Class="mb-3 text-primary">Administrators</MudText>
                <MudGrid Class="mb-6">
                    @foreach (var adminNode in GetAdminNodes())
                    {
                        <MudItem xs="12" md="6" lg="4">
                            @RenderMentorCard(adminNode.Value)
                        </MudItem>
                    }
                </MudGrid>
            }

            @* HR Section *@
            @if (GetHRNodes().Any())
            {
                <MudText Typo="Typo.h6" Class="mb-3 text-primary">Human Resources</MudText>
                <MudGrid Class="mb-6">
                    @foreach (var hrNode in GetHRNodes())
                    {
                        <MudItem xs="12" md="6" lg="4">
                            @RenderMentorCard(hrNode.Value)
                        </MudItem>
                    }
                </MudGrid>
            }

            @* Manager Section *@
            @if (GetManagerNodes().Any())
            {
                <MudText Typo="Typo.h6" Class="mb-3 text-primary">Managers</MudText>
                <MudGrid Class="mb-6">
                    @foreach (var managerNode in GetManagerNodes())
                    {
                        <MudItem xs="12" md="6" lg="4">
                            @RenderMentorCard(managerNode.Value)
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }

    @* Assignment Modal *@
    @if (showModal)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
            <MudPaper Class="modal-content" Elevation="8">
                <div class="modal-header">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
                        Assign Mentees to @selectedMentorEmail
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   OnClick="CloseModal"
                                   Size="Size.Small" />
                </div>

                <div class="modal-body">
                    @if (isLoadingEmployees)
                    {
                        <div class="text-center pa-8">
                            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Large" />
                            <MudText Class="mt-4">@loadingStatus</MudText>
                        </div>
                    }
                    else if (employees == null || !employees.Any())
                    {
                        <MudAlert Severity="Severity.Info" Class="ma-4">
                            No users available for assignment.
                        </MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle1" Class="mb-3">
                            Select employees to assign as mentees:
                        </MudText>
                        <div class="employee-list">
                            @for (int i = 0; i < employees.Count; i++)
                            {
                                var index = i; // Capture the loop variable
                                var emp = employees[index];
                                <div class="employee-item">
                                    <MudCheckBox T="bool"
                                                 Value="@emp.IsSelected"
                                                 ValueChanged="@((bool value) => HandleCheckboxChange(index, value))"
                                                 Label="@GetEmployeeDisplayText(emp)"
                                                 Color="Color.Primary" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <MudButton OnClick="CloseModal"
                               Variant="Variant.Text"
                               Class="mr-2">
                        Cancel
                    </MudButton>
                    <MudButton OnClick="AssignMenteesAsync"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(isAssigning || !employees.Any(e => e.IsSelected))">
                        @if (isAssigning)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
                            <span>Assigning...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="mr-1" />
                            <span>Assign Selected</span>
                        }
                    </MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }
</MudContainer>

@code {
    private RenderFragment RenderMentorCard(MentorNode mentor) => __builder =>
    {
        <MudCard Class="mentor-card" Elevation="1">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Default" Size="Size.Medium">
                        <MudIcon Icon="@GetRoleIcon(mentor.Role)" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Class="mentor-name">
                        @mentor.MentorEmail
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        ID: @mentor.MentorEmployeeID
                    </MudText>
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Text">
                        @mentor.Role
                    </MudChip>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.PersonAdd"
                                   Color="Color.Primary"
                                   OnClick="@(() => Assign(mentor.MentorId, mentor.IsManager))"
                                   Title="Assign Mentees" />
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent Class="pt-0">
                @if (mentor.Mentees.Any())
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Class="mr-1" />
                        Mentees (@mentor.Mentees.Count)
                    </MudText>
                    <div class="mentees-container">
                        @foreach (var mentee in mentor.Mentees)
                        {
                            <div class="mentee-item">
                                <div class="mentee-info">
                                    <MudText Typo="Typo.body2" Class="mentee-name">
                                        @mentee.MenteeEmail
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        ID: @mentee.MenteeEmployeeID
                                    </MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteMenteeAsync(mentor.MentorId, mentee.MenteeEmail))"
                                               Title="Remove Mentee" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="ma-0">
                        <MudText Typo="Typo.caption">No mentees assigned yet</MudText>
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>
    };

    private void HandleCheckboxChange(int index, bool value)
    {
        if (index >= 0 && index < employees.Count)
        {
            employees[index].IsSelected = value;
            StateHasChanged();
        }
    }

    private string GetEmployeeDisplayText(SelectableUser emp)
    {
        var roleText = "";
        if (managers?.Any(m => m.Email == emp.Email) == true) roleText = " (Manager)";
        else if (admins?.Any(a => a.Email == emp.Email) == true) roleText = " (Admin)";
        else if (hrs?.Any(h => h.Email == emp.Email) == true) roleText = " (HR)";
        else roleText = " (Employee)";

        return $"{emp.Email}{roleText}";
    }

    private List<CustomTreeItemData<MentorNode>> GetAdminNodes()
    {
        return mentorNodes.Where(n => n.Value.Role == "Admin").ToList();
    }

    private List<CustomTreeItemData<MentorNode>> GetHRNodes()
    {
        return mentorNodes.Where(n => n.Value.Role == "HR").ToList();
    }

    private List<CustomTreeItemData<MentorNode>> GetManagerNodes()
    {
        return mentorNodes.Where(n => n.Value.Role == "Manager").ToList();
    }

    private string GetRoleIcon(string role)
    {
        return role switch
        {
            "Admin" => Icons.Material.Filled.AdminPanelSettings,
            "HR" => Icons.Material.Filled.People,
            "Manager" => Icons.Material.Filled.SupervisorAccount,
            _ => Icons.Material.Filled.Person
        };
    }

    // All your existing C# code...
    private List<CustomTreeItemData<MentorNode>> mentorNodes = new();
    private List<User>? managers;
    private List<User>? admins;
    private List<SelectableUser> employees = new();
    private bool isPageLoading = true;
    private bool isLoadingEmployees = false;
    private string? errorMessage;
    private string? loadingStatus;
    private bool showModal = false;
    private string? selectedMentorId;
    private string? selectedMentorEmail;
    private bool isManagerAssignment = true;
    private bool isAssigning = false;
    private List<User>? hrs;

    protected override async Task OnInitializedAsync()
    {
        isPageLoading = true;
        try
        {
            var managersTask = UserService.GetUsersByRoleAsync("Manager");
            var adminsTask = UserService.GetUsersByRoleAsync("Admin");
            var hrsTask = UserService.GetUsersByRoleAsync("HR");
            await Task.WhenAll(managersTask, adminsTask, hrsTask);

            managers = managersTask.Result ?? new();
            admins = adminsTask.Result ?? new();
            hrs = hrsTask.Result ?? new();

            mentorNodes.Clear();
            var allUsers = admins.Concat(hrs).Concat(managers).ToList();

            foreach (var user in allUsers)
            {
                if (string.IsNullOrEmpty(user.Id) || string.IsNullOrEmpty(user.Email)) continue;

                var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email);
                if (mentorDetails == null) continue;

                var role = user.Role;
                var node = new MentorNode
                    {
                        MentorId = user.Id,
                        MentorEmail = user.Email,
                        MentorEmployeeID = mentorDetails.EmployeeID,
                        IsManager = user.Role == "Manager",
                        Role = role,
                        Mentees = new List<MenteeNode>()
                    };

                var assignments = await MentorAssignmentService.GetAllAssignmentsAsync();
                var myAssignments = assignments.Where(a => a.MentorEmployeeID == mentorDetails.EmployeeID).ToList();

                foreach (var assignment in myAssignments)
                {
                    var mentee = await EmployeeService.GetEmployeeDetails(assignment.MenteeEmployeeID);
                    if (mentee != null && !string.IsNullOrWhiteSpace(mentee.CurrentEmail))
                    {
                        node.Mentees.Add(new MenteeNode
                            {
                                MenteeEmployeeID = mentee.EmployeeID,
                                MenteeEmail = mentee.CurrentEmail
                            });
                    }
                }

                mentorNodes.Add(new CustomTreeItemData<MentorNode>(node));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading mentor hierarchy: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isPageLoading = false;
            StateHasChanged();
        }
    }

    private async Task Assign(string? mentorId, bool isManager)
    {
        if (string.IsNullOrEmpty(mentorId)) return;

        // Clear previous state
        employees.Clear();
        selectedMentorId = mentorId;
        selectedMentorEmail = null;
        isLoadingEmployees = true;
        showModal = true;
        StateHasChanged();

        var mentorNode = mentorNodes.FirstOrDefault(n => n.Value.MentorId == mentorId)?.Value;
        if (mentorNode == null)
        {
            errorMessage = "Mentor not found.";
            Snackbar.Add(errorMessage, Severity.Error);
            isLoadingEmployees = false;
            showModal = false;
            StateHasChanged();
            return;
        }

        var role = mentorNode.Role;
        User? user = null;
        if (role == "Manager")
        {
            user = managers?.FirstOrDefault(m => m.Id == mentorId);
        }
        else if (role == "Admin")
        {
            user = admins?.FirstOrDefault(a => a.Id == mentorId);
        }
        else if (role == "HR")
        {
            user = hrs?.FirstOrDefault(h => h.Id == mentorId);
        }

        if (user == null || string.IsNullOrWhiteSpace(user.Email))
        {
            errorMessage = $"{role} not found or email is missing.";
            Snackbar.Add(errorMessage, Severity.Error);
            isLoadingEmployees = false;
            showModal = false;
            StateHasChanged();
            return;
        }

        var userDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email);
        if (userDetails == null)
        {
            errorMessage = $"{role}'s employee details not found.";
            Snackbar.Add(errorMessage, Severity.Error);
            isLoadingEmployees = false;
            showModal = false;
            StateHasChanged();
            return;
        }

        selectedMentorEmail = userDetails.CurrentEmail ?? user.Email;
        await LoadEmployeesAsync();
        isLoadingEmployees = false;
        StateHasChanged();
    }

    private async Task LoadEmployeesAsync()
    {
        isLoadingEmployees = true;
        loadingStatus = "Loading users...";

        try
        {
            var allUsers = new List<User>();
            var employeesTask = UserService.GetUsersByRoleAsync("Employee");
            var managersTask = UserService.GetUsersByRoleAsync("Manager");
            var adminsTask = Task.FromResult(new List<User>());
            var hrsTask = Task.FromResult(new List<User>());

            var mentorNode = mentorNodes.FirstOrDefault(n => n.Value.MentorId == selectedMentorId)?.Value;
            var mentorRole = mentorNode?.Role;

            if (mentorRole == "HR")
            {
                hrsTask = UserService.GetUsersByRoleAsync("HR");
            }
            else if (mentorRole == "Admin")
            {
                adminsTask = UserService.GetUsersByRoleAsync("Admin");
                hrsTask = UserService.GetUsersByRoleAsync("HR");
            }

            await Task.WhenAll(employeesTask, managersTask, adminsTask, hrsTask);

            allUsers.AddRange(employeesTask.Result);
            allUsers.AddRange(managersTask.Result.Where(m => m.Email != selectedMentorEmail));
            if (mentorRole == "Admin")
            {
                allUsers.AddRange(adminsTask.Result.Where(a => a.Email != selectedMentorEmail));
                allUsers.AddRange(hrsTask.Result.Where(h => h.Email != selectedMentorEmail));
            }
            else if (mentorRole == "HR")
            {
                allUsers.AddRange(hrsTask.Result.Where(h => h.Email != selectedMentorEmail));
            }

            var allAssignments = await MentorAssignmentService.GetAllAssignmentsAsync();
            var assignedMenteeIds = new HashSet<string>(allAssignments.Select(a => a.MenteeEmployeeID), StringComparer.OrdinalIgnoreCase);
            var filtered = new List<SelectableUser>();

            foreach (var user in allUsers)
            {
                var empDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email!);
                if (empDetails != null && !assignedMenteeIds.Contains(empDetails.EmployeeID))
                {
                    filtered.Add(new SelectableUser
                        {
                            Id = user.Id!,
                            Email = user.Email!,
                            IsSelected = false
                        });
                }
            }

            employees = filtered;
            loadingStatus = $"{employees.Count} users available for assignment.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
            loadingStatus = errorMessage;
        }
        finally
        {
            isLoadingEmployees = false;
            StateHasChanged();
        }
    }

    private async Task AssignMenteesAsync()
    {
        if (isAssigning) return; // Prevent double-clicks

        isAssigning = true;
        errorMessage = null;

        try
        {
            if (string.IsNullOrEmpty(selectedMentorEmail))
            {
                errorMessage = "Invalid mentor email.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(selectedMentorEmail);
            if (mentorDetails == null)
            {
                var mentorRole = mentorNodes.FirstOrDefault(n => n.Value.MentorId == selectedMentorId)?.Value.Role ?? "Mentor";
                errorMessage = $"{mentorRole} employee details not found.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            var selectedMentees = employees.Where(e => e.IsSelected).ToList();
            if (!selectedMentees.Any())
            {
                errorMessage = "No mentees selected.";
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }

            bool allSuccess = true;

            foreach (var mentee in selectedMentees)
            {
                var details = await EmployeeService.GetEmployeeDetailsByEmail(mentee.Email);
                if (details != null)
                {
                    var assignment = new MentorAssignment
                        {
                            MentorEmployeeID = mentorDetails.EmployeeID,
                            MentorEmail = mentorDetails.CurrentEmail,
                            MentorDesignation = mentorDetails.Designation,
                            MenteeEmployeeID = details.EmployeeID,
                            MenteeEmail = details.CurrentEmail,
                            MenteeDesignation = details.Designation,
                            AssignedDate = DateTime.UtcNow
                        };

                    var success = await MentorAssignmentService.CreateAssignmentAsync(assignment);
                    if (!success)
                    {
                        allSuccess = false;
                        Snackbar.Add($"Failed to assign {details.CurrentEmail}", Severity.Error);
                    }
                }
            }

            if (allSuccess)
            {
                Snackbar.Add("Mentees assigned successfully!", Severity.Success);
                CloseModal();
                await ReloadMentorNodes();
            }
            else
            {
                errorMessage = "Some mentees could not be assigned.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error assigning mentees: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isAssigning = false;
            StateHasChanged();
        }
    }

    private async Task ReloadMentorNodes()
    {
        isPageLoading = true;
        StateHasChanged();

        try
        {
            // Clear existing data
            mentorNodes.Clear();

            var managersTask = UserService.GetUsersByRoleAsync("Manager");
            var adminsTask = UserService.GetUsersByRoleAsync("Admin");
            var hrsTask = UserService.GetUsersByRoleAsync("HR");
            await Task.WhenAll(managersTask, adminsTask, hrsTask);

            managers = managersTask.Result ?? new();
            admins = adminsTask.Result ?? new();
            hrs = hrsTask.Result ?? new();

            var allUsers = admins.Concat(hrs).Concat(managers).ToList();

            foreach (var user in allUsers)
            {
                if (string.IsNullOrEmpty(user.Id) || string.IsNullOrEmpty(user.Email)) continue;

                var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email);
                if (mentorDetails == null) continue;

                var role = user.Role;
                var node = new MentorNode
                    {
                        MentorId = user.Id,
                        MentorEmail = user.Email,
                        MentorEmployeeID = mentorDetails.EmployeeID,
                        IsManager = user.Role == "Manager",
                        Role = role,
                        Mentees = new List<MenteeNode>()
                    };

                var assignments = await MentorAssignmentService.GetAllAssignmentsAsync();
                var myAssignments = assignments.Where(a => a.MentorEmployeeID == mentorDetails.EmployeeID).ToList();

                foreach (var assignment in myAssignments)
                {
                    var mentee = await EmployeeService.GetEmployeeDetails(assignment.MenteeEmployeeID);
                    if (mentee != null && !string.IsNullOrWhiteSpace(mentee.CurrentEmail))
                    {
                        node.Mentees.Add(new MenteeNode
                            {
                                MenteeEmployeeID = mentee.EmployeeID,
                                MenteeEmail = mentee.CurrentEmail
                            });
                    }
                }

                mentorNodes.Add(new CustomTreeItemData<MentorNode>(node));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reloading mentor hierarchy: {ex.Message}", Severity.Error);
        }
        finally
        {
            isPageLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        selectedMentorId = null;
        selectedMentorEmail = null;
        employees.Clear();
        isManagerAssignment = true;
        isLoadingEmployees = false;
        isAssigning = false;
        StateHasChanged();
    }

    private async Task DeleteMenteeAsync(string mentorId, string menteeEmail)
    {
        try
        {
            bool? confirmed = await DialogService.ShowMessageBox(
                title: "Confirm Delete",
                message: $"Are you sure you want to remove {menteeEmail} from this mentor?",
                yesText: "Delete",
                cancelText: "Cancel",
                options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }
            );

            if (confirmed == true)
            {
                var success = await MentorAssignmentService.DeleteAssignmentByMenteeEmailAsync(menteeEmail);
                if (success)
                {
                    Snackbar.Add("Mentee assignment deleted successfully.", Severity.Success);
                    await ReloadMentorNodes();
                }
                else
                {
                    Snackbar.Add("Failed to delete mentee assignment.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting mentee: {ex.Message}", Severity.Error);
        }
    }

    // Your existing classes remain the same
    public class CustomTreeItemData<T> : TreeItemData<T>
    {
        public CustomTreeItemData(T value) : base(value) { }
        public List<CustomTreeItemData<T>> ChildItems { get; set; } = new();
    }

    public class MentorNode
    {
        public string MentorId { get; set; } = string.Empty;
        public string MentorEmail { get; set; } = string.Empty;
        public string MentorEmployeeID { get; set; } = string.Empty;
        public bool IsManager { get; set; }
        public List<MenteeNode> Mentees { get; set; } = new();
        public string Role { get; set; } = string.Empty;
    }

    public class MenteeNode
    {
        public string MenteeEmployeeID { get; set; } = string.Empty;
        public string MenteeEmail { get; set; } = string.Empty;
    }

    public class SelectableUser
    {
        public string Id { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool IsSelected { get; set; } = false;
    }
}

<style>
    /* Minimal, clean styling */
    .mentor-card {
        border: 1px solid #e0e0e0;
        background: #fafafa;
        transition: box-shadow 0.2s ease;
    }

        .mentor-card:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .mentor-name {
        font-weight: 600;
        color: #333;
    }

    .mentees-container {
        background: #f5f5f5;
        border-radius: 4px;
        padding: 8px;
        border: 1px solid #e0e0e0;
    }

    .mentee-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        margin-bottom: 4px;
    }

        .mentee-item:last-child {
            margin-bottom: 0;
        }

    .mentee-info {
        flex: 1;
    }

    .mentee-name {
        font-weight: 500;
        color: #333;
    }

    /* Modal using MudOverlay */
    .modal-content {
        background: white;
        border-radius: 8px;
        width: 90%;
        max-width: 600px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        margin: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid #e0e0e0;
    }

    .modal-body {
        padding: 16px 24px;
        flex: 1;
        overflow-y: auto;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding: 16px 24px;
        border-top: 1px solid #e0e0e0;
    }

    .employee-list {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
    }

    .employe-e-item {
        padding: 12px 16px;
        border-bottom: 1px solid #f0f0f0;
        background: white;
    }

    .employee-item:last-child {
        border-bottom: none;
