    private async Task ReloadManagersAndAdmins()
    {
        isPageLoading = true;

        try
        {
            managers = await UserService.GetUsersByRoleAsync("Manager");
            admins = await UserService.GetUsersByRoleAsync("Admin");

            menteeLists.Clear();
            menteeCounts.Clear();

            foreach (var user in managers.Concat(admins))
            {
                if (!string.IsNullOrEmpty(user.Id))
                {
                    menteeLists[user.Id] = new();
                    menteeCounts[user.Id] = 0;
                }
            }

            await LoadAllMenteeData();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error reloading data after assignment: " + ex.Message, Severity.Error);
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        selectedManagerId = null;
        selectedManagerEmail = null;
        employees.Clear();
        isManagerAssignment = true;
    }

    private async void ViewMentees(string? userId)
    {
        if (string.IsNullOrEmpty(userId)) return;

        var user = managers?.FirstOrDefault(m => m.Id == userId) ?? admins?.FirstOrDefault(a => a.Id == userId);
        if (user == null) return;

        viewManagerEmail = user.Email;
        showViewModal = true;
        isLoadingView = true;
        menteeEmails.Clear();

        try
        {
            var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email!);
            if (mentorDetails == null) return;

            var assignments = await MentorAssignmentService.GetAllAssignmentsAsync();
            var myAssignments = assignments.Where(a => a.MentorEmployeeID == mentorDetails.EmployeeID).ToList();

            foreach (var assignment in myAssignments)
            {
                var mentee = await EmployeeService.GetEmployeeDetails(assignment.MenteeEmployeeID);
                if (mentee != null && !string.IsNullOrWhiteSpace(mentee.CurrentEmail))
                {
                    menteeEmails.Add(mentee.CurrentEmail);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error viewing mentees: {ex.Message}");
        }
        finally
        {
            isLoadingView = false;
            StateHasChanged();
        }
    }
    private async Task DeleteMenteeAsync(string mentorId, string menteeEmail)
    {
        try
        {
            bool? confirmed = await DialogService.ShowMessageBox(
                title: "Confirm Delete",
                message: $"Are you sure you want to remove {menteeEmail} from this mentor?",
                yesText: "Delete",
                cancelText: "Cancel",
                options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }
            );

            if (confirmed == true)
            {
                var success = await MentorAssignmentService.DeleteAssignmentByMenteeEmailAsync(menteeEmail);

                if (success)
                {
                    Snackbar.Add("Mentee assignment deleted successfully.", Severity.Success);

                    // Remove from the list in UI
                    if (menteeLists.ContainsKey(mentorId))
                    {
                        menteeLists[mentorId].Remove(menteeEmail);
                        menteeCounts[mentorId] = menteeLists[mentorId].Count;
                    }

                    StateHasChanged(); // Refresh the UI
                }
                else
                {
                    Snackbar.Add("Failed to delete mentee assignment.", Severity.Error);
                }
                return;
            }

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting mentee: {ex.Message}", Severity.Error);
        }
    }


    public class SelectableUser
    {
        public string Id { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool IsSelected { get; set; } = false;
    }
}