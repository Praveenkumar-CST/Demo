@page "/managers"
@inject IUserService UserService
@inject EmployeeService EmployeeService
@inject MentorAssignmentService MentorAssignmentService
@layout WiseHR.Components.sidebar.HomeLayout
@using WiseHR.Models
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (isPageLoading)
    {
        <div class="d-flex justify-center mt-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else
    {


        if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }
        else if (managers == null || !managers.Any())
        {
            <MudAlert Severity="Severity.Info">No managers found.</MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var manager in managers)
                {
                    if (manager != null)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="6" Class="pa-2" Style="background-color:#E3F2FD">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">@manager.Email</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">ID: @manager.Id</MudText>
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@manager.Role</MudChip>
                                    </CardHeaderContent>
                                </MudCardHeader>

                                <MudCardContent>
                                    <MudText Typo="Typo.body1">Mentees Assigned: <strong>@(menteeCounts.TryGetValue(manager.Id, out var count) ? count : 0)</strong></MudText>

                                    <MudExpansionPanels>
                                        <MudExpansionPanel Text="View Mentees">
                                            @if (menteeLoadingStates.Contains(manager.Id))
                                            {
                                                <MudProgressLinear Indeterminate="true" Color="Color.Info" />
                                            }
                                            else if (!menteeLists.ContainsKey(manager.Id) || !menteeLists[manager.Id].Any())
                                            {
                                                <MudText>No mentees assigned.</MudText>
                                            }
                                            else
                                            {
                                                <MudList T="string" Dense="true">
                                                    @foreach (var mentee in menteeLists[manager.Id])
                                                    {
                                                        <MudListItem>
                                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                                <MudText>@mentee</MudText>
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                Color="Color.Error"
                                                                Size="Size.Small"
                                                                OnClick="() => DeleteMenteeAsync(manager.Id, mentee)" />
                                                            </MudStack>
                                                        </MudListItem>
                                                    }
                                                </MudList>
                                            }
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                </MudCardContent>

                                <MudCardActions>
                                    <button class="btn btn-primary me-2" @onclick="() => Assign(manager.Id, true)">Assign</button>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
        <br/>

        if (!string.IsNullOrEmpty(errorMessageAdmins))
        {
            <MudAlert Severity="Severity.Error">@errorMessageAdmins</MudAlert>
        }
        else if (admins == null || !admins.Any())
        {
            <MudAlert Severity="Severity.Info">No admins found.</MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var admin in admins)
                {
                    if (admin != null)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="6" Class="pa-2" Style="background-color:#F3E5F5">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">@admin.Email</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">ID: @admin.Id</MudText>
                                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@admin.Role</MudChip>
                                    </CardHeaderContent>
                                </MudCardHeader>

                                <MudCardContent>
                                    <MudText Typo="Typo.body1">Mentees Assigned: <strong>@(menteeCounts.TryGetValue(admin.Id, out var count) ? count : 0)</strong></MudText>

                                    <MudExpansionPanels>
                                        <MudExpansionPanel Text="View Mentees">
                                            @if (menteeLoadingStates.Contains(admin.Id))
                                            {
                                                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                                            }
                                            else if (!menteeLists.ContainsKey(admin.Id) || !menteeLists[admin.Id].Any())
                                            {
                                                <MudText>No mentees assigned.</MudText>
                                            }
                                            else
                                            {
                                                <MudList T="string" Dense="true">
                                                    @foreach (var mentee in menteeLists[admin.Id])
                                                    {
                                                        <MudListItem>
                                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                                <MudText>@mentee</MudText>
                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                Color="Color.Error"
                                                                Size="Size.Small"
                                                                OnClick="() => DeleteMenteeAsync(admin.Id, mentee)" />
                                                            </MudStack>
                                                        </MudListItem>
                                                    }
                                                </MudList>
                                            }
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="() => Assign(admin.Id, false)">Assign</MudButton>

                                </MudCardActions>

                            </MudCard>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
        @if (showModal)
        {
            <div class="modal show d-block mt-20" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Mentor: @selectedManagerEmail</h5>
                            <button type="button" class="btn-close" @onclick="CloseModal"></button>
                        </div>
                        <div class="modal-body">
                            @if (isLoadingEmployees)
                            {
                                <div class="d-flex justify-center mt-5">
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                                    <MudText Class="ml-3 mt-2">@loadingStatus</MudText>
                                </div>                        }
                            else if (employees == null || !employees.Any())
                            {
                                <p>No users available for assignment.</p>
                            }
                            else
                            {
                                <ul class="list-group">
                                    @foreach (var emp in employees)
                                    {
                                        <li class="list-group-item">
                                            <input type="checkbox" @bind="emp.IsSelected" />
                                            <span>
                                                @emp.Email
                                                @if (managers?.Any(m => m.Email == emp.Email) == true)
                                                {
                                                    <strong>(Manager)</strong>
                                                }
                                                else if (admins?.Any(a => a.Email == emp.Email) == true)
                                                {
                                                    <strong>(Admin)</strong>
                                                }
                                                else
                                                {
                                                    <strong>(Employee)</strong>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="CloseModal">Cancel</button>
                            <button class="btn btn-primary" @onclick="AssignMenteesAsync" disabled="@isAssigning">
                                @if (isAssigning)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }Assign Selected
                            </button>
                             
                        </div>
                    </div>
                </div>
            </div>
        }

    }

</MudContainer>



@code {
    private List<User>? managers;
    private List<User>? admins;
    private List<SelectableUser> employees = new();
    private List<string> menteeEmails = new();


    private bool isLoadingEmployees = false;
    private bool isLoadingView = false;

    private string? errorMessage;
    private string? errorMessageAdmins;
    private string? loadingStatus;

    private bool showModal = false;
    private bool showViewModal = false;

    private string? selectedManagerId;
    private string? selectedManagerEmail;
    private string? viewManagerEmail;
    private bool isManagerAssignment = true;

    private bool isPageLoading = true;

    private HashSet<string> menteeLoadingStates = new HashSet<string>();
    private Dictionary<string, List<string>> menteeLists = new Dictionary<string, List<string>>();
    private Dictionary<string, int> menteeCounts = new Dictionary<string, int>();
    private Dictionary<string, List<EmployeeDetails>> filteredMenteeDetails = new();

    protected override async Task OnInitializedAsync()
    {
        isPageLoading = true;

        Console.WriteLine("Initializing component...");

        try
        {
            Console.WriteLine("Fetching managers and admins...");

            var managersTask = UserService.GetUsersByRoleAsync("Manager");
            var adminsTask = UserService.GetUsersByRoleAsync("Admin");

            await Task.WhenAll(managersTask, adminsTask);

            managers = managersTask.Result;
            admins = adminsTask.Result;

            Console.WriteLine($"Managers fetched: {managers?.Count}");
            Console.WriteLine($"Admins fetched: {admins?.Count}");

            // Initialize dictionaries for all managers and admins
            foreach (var manager in managers ?? new List<User>())
            {
                menteeLists[manager.Id] = new List<string>();
                menteeCounts[manager.Id] = 0;
                Console.WriteLine($"Initialized manager: {manager.Email}");

            }
            foreach (var admin in admins ?? new List<User>())
            {
                menteeLists[admin.Id] = new List<string>();
                menteeCounts[admin.Id] = 0;
                Console.WriteLine($"Initialized admin: {admin.Email}");

            }

            // Load mentee data for all managers and admins
            await LoadAllMenteeData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading managers: {ex.Message}";
            errorMessageAdmins = $"Error loading admins: {ex.Message}";
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");

        }
        finally
        {

            isPageLoading = false;

        }
    }
    private async Task LoadAllMenteeData()
    {
        try
        {
            var allUsers = (managers ?? new List<User>()).Concat(admins ?? new List<User>()).ToList();
            var validUsers = new List<(User user, EmployeeDetails mentorDetails)>();

            foreach (var user in allUsers)
            {
                if (string.IsNullOrEmpty(user.Id) || string.IsNullOrEmpty(user.Email)) continue;

                var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email);
                if (mentorDetails != null)
                {
                    validUsers.Add((user, mentorDetails));
                }
            }

            var assignments = await MentorAssignmentService.GetAllAssignmentsAsync();
            var allEmployees = await EmployeeService.GetAllEmployees();

            foreach (var (user, mentorDetails) in validUsers)
            {
                menteeLoadingStates.Add(user.Id); // Show loading
                StateHasChanged();

                var myAssignments = assignments
                    .Where(a => a.MentorEmployeeID == mentorDetails.EmployeeID)
                    .ToList();

                var menteeEmails = new List<string>();
                foreach (var assignment in myAssignments)
                {
                    var mentee = await EmployeeService.GetEmployeeDetails(assignment.MenteeEmployeeID);
                    if (mentee != null && !string.IsNullOrWhiteSpace(mentee.CurrentEmail))
                    {
                        menteeEmails.Add(mentee.CurrentEmail);
                    }
                }

                var filteredMentees = allEmployees
                    .Where(emp => !string.IsNullOrWhiteSpace(emp.CurrentEmail) && menteeEmails.Contains(emp.CurrentEmail))
                    .ToList();

                menteeLists[user.Id] = menteeEmails;
                menteeCounts[user.Id] = menteeEmails.Count;
                filteredMenteeDetails[user.Id] = filteredMentees;

                menteeLoadingStates.Remove(user.Id); // Remove loading
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading mentee data: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async void Assign(string? userId, bool isManager)
    {
        isLoadingEmployees = true;
        showModal = true;
        if (string.IsNullOrEmpty(userId))
            return;

        var user = isManager ? managers?.FirstOrDefault(m => m.Id == userId) : admins?.FirstOrDefault(a => a.Id == userId);
        if (user == null || string.IsNullOrWhiteSpace(user.Email))
        {
            errorMessage = $"{(isManager ? "Manager" : "Admin")} not found or email is missing.";
            Snackbar.Add($"{(isManager ? "Manager" : "Admin")} not found or email is missing.", Severity.Error);

            return;
        }

        selectedManagerId = userId;
        isManagerAssignment = isManager;

        var userDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email);
        if (userDetails == null)
        {
            errorMessage = $"{(isManager ? "Manager's" : "Admin's")} employee details not found.";
            Snackbar.Add($"{(isManager ? "Manager's" : "Admin's")} employee details not found.", Severity.Error);

            return;
        }

        selectedManagerEmail = userDetails.CurrentEmail ?? user.Email;

        Console.WriteLine($"{(isManager ? "Manager" : "Admin")} Email: {selectedManagerEmail}");
        Console.WriteLine($"{(isManager ? "Manager" : "Admin")} Designation: {userDetails.Designation}");
        StateHasChanged();
        await LoadEmployeesAsync();
        StateHasChanged();
    }

    private async Task LoadEmployeesAsync()
    {
        isLoadingEmployees = true;
        loadingStatus = "Loading users...";

        try
        {
            var allUsers = new List<User>();
            var employeesTask = UserService.GetUsersByRoleAsync("Employee");
            var managersTask = UserService.GetUsersByRoleAsync("Manager");
            var adminsTask = isManagerAssignment ? Task.FromResult(new List<User>()) : UserService.GetUsersByRoleAsync("Admin");

            await Task.WhenAll(employeesTask, managersTask, adminsTask);

            allUsers.AddRange(employeesTask.Result);
            allUsers.AddRange(managersTask.Result.Where(m => m.Email != selectedManagerEmail)); 
            if (!isManagerAssignment)
            {
                allUsers.AddRange(adminsTask.Result.Where(a => a.Email != selectedManagerEmail)); 
            }

            var allAssignments = await MentorAssignmentService.GetAllAssignmentsAsync();
            var assignedMenteeIds = new HashSet<string>(allAssignments.Select(a => a.MenteeEmployeeID), StringComparer.OrdinalIgnoreCase);
            var filtered = new List<SelectableUser>();

            foreach (var user in allUsers)
            {
                var empDetails = await EmployeeService.GetEmployeeDetailsByEmail(user.Email!);
                if (empDetails != null && !assignedMenteeIds.Contains(empDetails.EmployeeID))
                {
                    filtered.Add(new SelectableUser
                        {
                            Id = user.Id!,
                            Email = user.Email!,
                            IsSelected = false
                        });
                }
            }

            employees = filtered;
            loadingStatus = $"{employees.Count} users available for assignment.";
            isLoadingEmployees = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
            loadingStatus = errorMessage;
        }
        finally
        {
            isLoadingEmployees = false;
        }
    }
    private bool isAssigning = false;

    private async Task AssignMenteesAsync()
    {
        isAssigning = true;
        errorMessage = null;

        try
        {
            if (string.IsNullOrEmpty(selectedManagerEmail))
            {
                errorMessage = "Invalid user email.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            var mentorDetails = await EmployeeService.GetEmployeeDetailsByEmail(selectedManagerEmail);
            if (mentorDetails == null)
            {
                errorMessage = $"{(isManagerAssignment ? "Manager" : "Admin")} employee details not found.";
                Snackbar.Add(errorMessage, Severity.Error);
                return;
            }

            var selectedMentees = employees.Where(e => e.IsSelected).ToList();
            if (!selectedMentees.Any())
            {
                errorMessage = "No mentees selected.";
                Snackbar.Add(errorMessage, Severity.Warning);
                return;
            }

            bool allSuccess = true;

            foreach (var mentee in selectedMentees)
            {
                var details = await EmployeeService.GetEmployeeDetailsByEmail(mentee.Email);
                if (details != null)
                {
                    var assignment = new MentorAssignment
                        {
                            MentorEmployeeID = mentorDetails.EmployeeID,
                            MentorEmail = mentorDetails.CurrentEmail,
                            MentorDesignation = mentorDetails.Designation,
                            MenteeEmployeeID = details.EmployeeID,
                            MenteeEmail = details.CurrentEmail,
                            MenteeDesignation = details.Designation,
                            AssignedDate = DateTime.UtcNow
                        };

                    var success = await MentorAssignmentService.CreateAssignmentAsync(assignment);
                    if (!success)
                    {
                        allSuccess = false;
                        Snackbar.Add($"Failed to assign {details.CurrentEmail}", Severity.Error);
                        Console.WriteLine($"Failed to assign mentee {details.EmployeeID}");
                    }
                }
            }

            if (allSuccess)
            {
                showModal = false;
                StateHasChanged();
                isAssigning = false;
                Snackbar.Add("Mentees assigned successfully!", Severity.Success);
                CloseModal();
                await ReloadManagersAndAdmins();
            }
            else
            {
                errorMessage = "Some mentees could not be assigned.";
            }
        }
        finally
        {
            isAssigning = false;
        }
    }

