@code {
    private static readonly string[] _daysOfWeek = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    private DateTime _currentDate = DateTime.Today;
    private List<List<CalendarDay>> _calendarWeeks = new();
    private Dictionary<(DateTime Date, string Location), Event> _events = new();
    private bool _isEventInputVisible;
    private DateTime _selectedDate;
    private string _eventDescription = "";
    private bool _hasExistingEvent;
    private bool _isPermanentHoliday;
    private bool _isOptionalHoliday;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _isLoading = true;
    private string _selectedLocation = "";
    private List<string> _locations = new();

    public class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsToday { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync();
        if (_locations.Any())
        {
            _selectedLocation = _locations[0];
        }
        else
        {
            _selectedLocation = "Bangalore,India";
            _errorMessage = "No locations available. Using default location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        await LoadEventsAsync();
        GenerateCalendar();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadLocationsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<string>>("/EmployeeDetails/GetAllJoiningLocations");
            if (response != null && response.Any())
            {
                _locations = response;
            }
            else
            {
                _locations = new List<string> { "Bangalore,India" };
                _errorMessage = "No locations found. Using default location.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _locations = new List<string> { "Bangalore,India" };
            _errorMessage = $"Failed to load locations: {ex.Message}. Using default location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
    }

    private async Task LoadEventsAsync()
    {
        if (string.IsNullOrEmpty(_selectedLocation))
        {
            _errorMessage = "No location selected. Please select a location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        try
        {
            _events.Clear();
            string url = $"/api/Events?location={Uri.EscapeDataString(_selectedLocation)}";
            var response = await Http.GetFromJsonAsync<List<Event>>(url);
            if (response != null)
            {
                _events = response
                    .Where(e => DateTime.TryParse(e.Date, out var parsedDate) && e.Location == _selectedLocation)
                    .ToDictionary(
                        e => (Date: DateTime.Parse(e.Date).Date, Location: e.Location!),
                        e => e
                    );
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Failed to load events for {_selectedLocation}: {ex.Message}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        GenerateCalendar();
        StateHasChanged();
    }

    private void GenerateCalendar()
    {
        _calendarWeeks.Clear();
        var firstOfMonth = new DateTime(_currentDate.Year, _currentDate.Month, 1);
        var firstDayOfWeek = (int)firstOfMonth.DayOfWeek;
        var currentDay = firstOfMonth.AddDays(-firstDayOfWeek);

        for (int week = 0; week < 6; week++)
        {
            _calendarWeeks.Add(Enumerable.Range(0, 7).Select(d => new CalendarDay
            {
                Date = currentDay.AddDays(d),
                IsCurrentMonth = currentDay.AddDays(d).Month == _currentDate.Month,
                IsToday = currentDay.AddDays(d).Date == DateTime.Today.Date
            }).ToList());
            currentDay = currentDay.AddDays(7);
        }
    }

    private void SelectDate(DateTime date)
    {
        if (string.IsNullOrEmpty(_selectedLocation))
        {
            _errorMessage = "Please select a location before selecting a date.";
            StateHasChanged();
            Task.Delay(3000).ContinueWith(_ => { _errorMessage = null; StateHasChanged(); });
            return;
        }

        _selectedDate = date.Date;
        _hasExistingEvent = _events.ContainsKey((date.Date, _selectedLocation));

        if (_hasExistingEvent)
        {
            _eventDescription = _events[(date.Date, _selectedLocation)]?.Description ?? "";
            _isPermanentHoliday = _events[(date.Date, _selectedLocation)]?.HolidayType == "Permanent";
            _isOptionalHoliday = _events[(date.Date, _selectedLocation)]?.HolidayType == "Optional";
        }
        else
        {
            _eventDescription = "";
            _isPermanentHoliday = false;
            _isOptionalHoliday = false;
        }

        _isEventInputVisible = true;
        _successMessage = null;
        _errorMessage = null;
        StateHasChanged();
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrEmpty(_selectedLocation))
        {
            _errorMessage = "No location selected. Please select a location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_eventDescription))
        {
            _errorMessage = "Please enter event details.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        if (!_isPermanentHoliday && !_isOptionalHoliday)
        {
            _errorMessage = "Please select a holiday type (Permanent or Optional).";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        try
        {
            var eventToSave = new Event
            {
                Date = _selectedDate.ToString("yyyy-MM-dd"),
                Description = _eventDescription,
                HolidayType = _isPermanentHoliday ? "Permanent" : "Optional",
                Location = _selectedLocation,
                Day = _selectedDate.ToString("ddd")
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/Events", eventToSave);

            if (response.IsSuccessStatusCode)
            {
                _events[(_selectedDate, _selectedLocation)] = eventToSave;
                _hasExistingEvent = true;
                _successMessage = $"Event saved successfully for {_selectedLocation}.";
                GenerateCalendar();
                StateHasChanged();
                await Task.Delay(3000);
                _successMessage = null;
            }
            else
            {
                _errorMessage = $"Failed to save event for {_selectedLocation}: {await response.Content.ReadAsStringAsync()}.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Error saving event for {_selectedLocation}: {ex.Message}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
    }

    private async Task UpdateEvent()
    {
        if (string.IsNullOrEmpty(_selectedLocation))
        {
            _errorMessage = "No location selected. Please select a location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_eventDescription))
        {
            _errorMessage = "Please enter event details.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        if (!_isPermanentHoliday && !_isOptionalHoliday)
        {
            _errorMessage = "Please select a holiday type (Permanent or Optional).";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        try
        {
            var eventToUpdate = new Event
            {
                Date = _selectedDate.ToString("yyyy-MM-dd"),
                Description = _eventDescription,
                HolidayType = _isPermanentHoliday ? "Permanent" : "Optional",
                Location = _selectedLocation,
                Day = _selectedDate.ToString("ddd")
            };

            string url = $"/api/Events/{_selectedDate:yyyy-MM-dd}?location={Uri.EscapeDataString(_selectedLocation)}";
            HttpResponseMessage response = await Http.PutAsJsonAsync(url, eventToUpdate);

            if (response.IsSuccessStatusCode)
            {
                _events[(_selectedDate, _selectedLocation)] = eventToUpdate;
                _successMessage = $"Event updated successfully for {_selectedLocation}.";
                GenerateCalendar();
                StateHasChanged();
                await Task.Delay(3000);
                _successMessage = null;
            }
            else
            {
                _errorMessage = $"Failed to update event for {_selectedLocation}: {await response.Content.ReadAsStringAsync()}.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Error updating event for {_selectedLocation}: {ex.Message}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
    }

    private async Task DeleteEvent()
    {
        if (string.IsNullOrEmpty(_selectedLocation))
        {
            _errorMessage = "No location selected. Please select a location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            return;
        }

        try
        {
            string url = $"/api/Events/{_selectedDate:yyyy-MM-dd}?location={Uri.EscapeDataString(_selectedLocation)}";
            HttpResponseMessage response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode)
            {
                _events.Remove((_selectedDate, _selectedLocation));
                _hasExistingEvent = false;
                _successMessage = $"Event deleted successfully for {_selectedLocation}.";
                GenerateCalendar();
                StateHasChanged();
                await Task.Delay(3000);
                _successMessage = null;
            }
            else
            {
                _errorMessage = $"Failed to delete event for {_selectedLocation}: {await response.Content.ReadAsStringAsync()}.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Error deleting event for {_selectedLocation}: {ex.Message}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
    }

    private void SetHolidayType(bool isPermanent)
    {
        _isPermanentHoliday = isPermanent;
        _isOptionalHoliday = !isPermanent;
        StateHasChanged();
    }

    private bool HasEvent(DateTime date)
    {
        return _events.ContainsKey((date.Date, _selectedLocation));
    }

    private bool IsHoliday(DateTime date)
    {
        return _events.ContainsKey((date.Date, _selectedLocation));
    }

    private string GetHolidayType(DateTime date)
    {
        return _events.TryGetValue((date.Date, _selectedLocation), out var evt) ? evt.HolidayType ?? "" : "";
    }

    private IEnumerable<KeyValuePair<(DateTime Date, string Location), Event>> GetHolidaysForMonth()
    {
        return _events
            .Where(e => e.Key.Location == _selectedLocation &&
                        e.Key.Date.Year == _currentDate.Year &&
                        e.Key.Date.Month == _currentDate.Month)
            .OrderBy(e => e.Key.Date);
    }

    private void CloseEventPanel()
    {
        _isEventInputVisible = false;
        _eventDescription = "";
        _isPermanentHoliday = false;
        _isOptionalHoliday = false;
        _successMessage = null;
        _errorMessage = null;
        _hasExistingEvent = false;
        StateHasChanged();
    }

    private void NavigateToNextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        GenerateCalendar();
        StateHasChanged();
    }

    private void NavigateToPreviousMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        GenerateCalendar();
        StateHasChanged();
    }

    private void NavigateToHolidaysPage()
    {
        NavigationManager.NavigateTo("/Calendar/holiday");
    }

    private async Task OnLocationChanged(ChangeEventArgs e)
    {
        _selectedLocation = e.Value?.ToString() ?? _locations.FirstOrDefault() ?? "Bangalore,India";
        if (!_locations.Contains(_selectedLocation))
        {
            _selectedLocation = _locations.FirstOrDefault() ?? "Bangalore,India";
            _errorMessage = $"Invalid location selected. Reverted to {_selectedLocation}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
            
        }
        _isLoading = true;
        CloseEventPanel();
        await LoadEventsAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private string TruncateEventName(string name, int maxLength)
    {
        if (string.IsNullOrEmpty(name) || name.Length <= maxLength)
            return name;
        return name.Substring(0, maxLength) + "...";
    }
}
