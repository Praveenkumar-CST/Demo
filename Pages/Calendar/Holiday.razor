@page "/Calendar/holiday"
@using list.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable
@layout HomeLayout

<h3 class="holiday-title">Holiday List @(_selectedYear)</h3>

<div class="back-container">
    <button class="back-button" @onclick="NavigateToCalendar">Back</button>
</div>

<div class="header-container">
    <div class="location-selection">
        <label for="location"><b>Select Location:</b></label>
        <select id="location" @bind-value="_selectedLocation" @bind-value:event="oninput" @onchange="OnLocationChanged" class="location-dropdown">
            @foreach (var location in _locations)
            {
                <option value="@location" selected="@(location == _selectedLocation)">@location</option>
            }
        </select>
    </div>
    <div class="year-selection">
        <label for="year"><b>Select Year:</b></label>
        <select id="year" @bind-value="_selectedYear" @bind-value:event="oninput" @onchange="OnYearChanged" class="year-dropdown">
            @foreach (var year in _years.OrderBy(y => y))
            {
                <option value="@year" selected="@(year == _selectedYear)">@year</option>
            }
        </select>
    </div>
</div>

<div class="holiday-boxes">
    <div class="permanent-holidays">
        <h4>Fixed Holidays</h4>
        <table class="holiday-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Event</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var holiday in _permanentHolidays.OrderByDescending(h => DateTime.Parse(h.Date)))
                {
                    <tr>
                        <td>@FormatDateString(holiday.Date)</td>
                        <td>@GetDayOfWeek(holiday.Date)</td>
                        <td class="event-description">
                            <div class="event-content">@holiday.Description</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="optional-holidays">
        <h4>Optional Holidays</h4>
        <table class="holiday-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Event</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var holiday in _optionalHolidays.OrderByDescending(h => DateTime.Parse(h.Date)))
                {
                    <tr>
                        <td>@FormatDateString(holiday.Date)</td>
                        <td>@GetDayOfWeek(holiday.Date)</td>
                        <td class="event-description">
                            <div class="event-content">@holiday.Description</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_isLoading)
{
    <div class="loading-container">
        <div class="spinner"></div>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error-message">@_errorMessage</div>
}

<style>
    body {
        background-color: #ffffff;
        color: #000000;
        font-family: Arial, sans-serif;
    }

    h3 {
        color: #1e90ff;
        text-align: center;
        margin-bottom: 15px;
    }

    h4 {
        color: #1e90ff;
        margin-bottom: 10px;
    }

    .header-container {
        top: 100px;
        bottom: 0px;
        left: 0px;
        right: 0px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 10px;
    }

    .holiday-boxes {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
    }

    .permanent-holidays,
    .optional-holidays {
        width: 45%;
        background-color: #d3d3d3;
        padding: 15px;
        border-radius: 10px;
        box-sizing: border-box;
    }

    .holiday-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #f5f5f5;
        table-layout: fixed;
    }

        .holiday-table th {
            background-color: #1e90ff;
            color: #ffffff;
            padding: 10px;
            text-align: left;
        }

        .holiday-table td {
            padding: 10px;
            border-bottom: 1px solid #000000;
            color: #000000;
            overflow-wrap: break-word;
            word-break: break-word;
        }

            .holiday-table td.event-description {
                height: auto;
            }

        .holiday-table tr:nth-child(even) {
            background-color: #ffffff;
        }

        .holiday-table tr:hover {
            background-color: #87cefa;
        }

    .error-message {
        color: #000000;
        background-color: rgb(66, 200, 100);
        padding: 10px;
        text-align: center;
        border-radius: 5px;
        margin: 10px auto;
        max-width: 600px;
    }

    .loading-container {
        border: 4px solid #3b82f6;
        border-top: 4px solid transparent;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 20px auto;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    p {
        text-align: center;
        color: #000000;
        font-family: Arial, sans-serif;
    }

    .back-button {
        padding: 8px 16px;
        background-color: #1e90ff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
    }

        .back-button:hover {
            background-color: #4682b4;
        }

    .location-selection, .year-selection {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .location-selection label, .year-selection label {
            color: #2c3e50;
            font-family: 'Segoe UI', sans-serif;
            font-weight: 500;
            font-size: 16px;
        }

    .location-dropdown, .year-dropdown {
        padding: 8px 16px;
        border: 1px solid #3498db;
        border-radius: 6px;
        font-family: 'Segoe UI', sans-serif;
        font-size: 14px;
        background-color: #e8f4f8;
        color: #2c3e50;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .location-dropdown:focus, .year-dropdown:focus {
            border-color: #3498db;
            outline: none;
        }

    .holiday-title {
        font-size: 27px;
    }
</style>

@code {
    private Events[] _holidays = Array.Empty<Events>();
    private Events[] _permanentHolidays = Array.Empty<Events>();
    private Events[] _optionalHolidays = Array.Empty<Events>();
    private string? _errorMessage;
    private bool _isLoading = true;
    private string _rawResponse = "No response yet.";
    private string _selectedLocation = "";
    private List<string> _locations = new();
    private int _selectedYear = DateTime.Now.Year;
    private List<int> _years = new();
    private System.Timers.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync();
        if (_locations.Any())
        {
            _selectedLocation = _locations[0];
        }
        else
        {
            _selectedLocation = "Bangalore,India";
            _errorMessage = "No locations available. Using default location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        await FetchHolidaysAsync();
        using var timer = new System.Timers.Timer(5000);
        _refreshTimer = timer;
        _refreshTimer.Elapsed += async (sender, e) => await RefreshHolidaysAsync();
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private async Task LoadLocationsAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<string>>("/EmployeeDetails/GetAllJoiningLocations");
            if (response != null && response.Any())
            {
                _locations = response;
            }
            else
            {
                _locations = new List<string> { "Bangalore,India" };
                _errorMessage = "No locations found. Using default location.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _locations = new List<string> { "Bangalore,India" };
            _errorMessage = $"Failed to load locations: {ex.Message}. Using default location.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
    }

    private void UpdateYearsList()
    {
        var years = _holidays
            .Select(h => DateTime.TryParse(h.Date, out var date) ? date.Year : (int?)null)
            .Where(y => y.HasValue)
            .Select(y => y.Value)
            .Distinct()
            .ToList();

        if (years.Any())
        {
            _years = years;
            if (!_years.Contains(_selectedYear))
            {
                _selectedYear = _years.Contains(DateTime.Now.Year) ? DateTime.Now.Year : _years.Max();
            }
        }
        else
        {
            _years = new List<int> { DateTime.Now.Year };
            _selectedYear = DateTime.Now.Year;
            _errorMessage = "No years found in holiday data. Using current year.";
            StateHasChanged();
            Task.Delay(3000).ContinueWith(_ => { _errorMessage = null; StateHasChanged(); });
        }
    }

    private async Task FetchHolidaysAsync()
    {
        try
        {
            _isLoading = true;
            string apiUrl = $"/api/Events?location={Uri.EscapeDataString(_selectedLocation)}&year={_selectedYear}";

            var httpResponse = await Http.GetAsync(apiUrl);
            _rawResponse = await httpResponse.Content.ReadAsStringAsync();

            if (httpResponse.IsSuccessStatusCode)
            {
                var holidays = await httpResponse.Content.ReadFromJsonAsync<Events[]>();
                _holidays = holidays ?? Array.Empty<Events>();
                UpdateYearsList(); // Update years based on fetched holidays
                _permanentHolidays = _holidays
                    .Where(h => h.HolidayType == "Permanent" && h.Location == _selectedLocation && DateTime.Parse(h.Date).Year == _selectedYear)
                    .ToArray();
                _optionalHolidays = _holidays
                    .Where(h => h.HolidayType == "Optional" && h.Location == _selectedLocation && DateTime.Parse(h.Date).Year == _selectedYear)
                    .ToArray();
                Console.WriteLine($"Fetched {_holidays.Length} holidays for {_selectedLocation} in {_selectedYear}. Permanent: {_permanentHolidays.Length}, Optional: {_optionalHolidays.Length}, Years: {string.Join(", ", _years)}");
            }
            else
            {
                _errorMessage = $"API request failed with status: {httpResponse.StatusCode}. Response: {_rawResponse}";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Error fetching holidays: {ex.Message}. Response: {_rawResponse}";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unexpected error: {ex.Message}. Response: {_rawResponse}";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshHolidaysAsync()
    {
        await FetchHolidaysAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnLocationChanged(ChangeEventArgs e)
    {
        _selectedLocation = e.Value?.ToString() ?? _locations.FirstOrDefault() ?? "Bangalore,India";
        if (!_locations.Contains(_selectedLocation))
        {
            _selectedLocation = _locations.FirstOrDefault() ?? "Bangalore,India";
            _errorMessage = $"Invalid location selected. Reverted to {_selectedLocation}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        _isLoading = true;
        await FetchHolidaysAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedYear))
        {
            _selectedYear = selectedYear;
            if (!_years.Contains(_selectedYear))
            {
                _selectedYear = _years.Contains(DateTime.Now.Year) ? DateTime.Now.Year : _years.Max();
                _errorMessage = $"Invalid year selected. Reverted to {_selectedYear}.";
                StateHasChanged();
                await Task.Delay(3000);
                _errorMessage = null;
            }
        }
        else
        {
            _selectedYear = _years.Contains(DateTime.Now.Year) ? DateTime.Now.Year : _years.Max();
            _errorMessage = $"Invalid year selected. Reverted to {_selectedYear}.";
            StateHasChanged();
            await Task.Delay(3000);
            _errorMessage = null;
        }
        _isLoading = true;
        await FetchHolidaysAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private string FormatDateString(string date)
    {
        if (DateTime.TryParse(date, out var parsedDate))
        {
            return $"{parsedDate.Day:D2}/{parsedDate.Month:D2}/{parsedDate.Year}";
        }
        return date;
    }

    private string GetDayOfWeek(string date)
    {
        if (DateTime.TryParse(date, out var parsedDate))
        {
            return parsedDate.ToString("dddd");
        }
        return "Invalid Date";
    }

    private void NavigateToCalendar()
    {
        Navigation.NavigateTo("/calendar");
    }

    public void Dispose()
    {
        if (_refreshTimer != null)
        {
            _refreshTimer.Stop();
            _refreshTimer.Dispose();
        }
    }
}