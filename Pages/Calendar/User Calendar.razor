@page "/user"
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable
@using System.Text
@using HolidayApp.Models
@using System.Text.Json
@using System.Net.Http.Headers
@using OfficeOpenXml
@using iTextSharp.text
@using iTextSharp.text.pdf
@layout HomeLayout

<h3 class="holiday-title">Holiday List @(_selectedYear)</h3>
<div class="header-container">
    <div class="location-selection">
        <label for="locationSelect" style="margin-right: 10px;"><b>View Location:</b></label>
        <select id="locationSelect" class="location-select location-dropdown"
                @bind="_selectedLocation"
                @bind:after="async () => await FetchHolidaysAsync()">
            @foreach (var location in _availableLocations)
            {
                <option value="@location">@location</option>
            }
        </select>
    </div>
    <div class="year-selection">
        <label for="yearSelect"><b>Select Year:</b></label>
        <select id="yearSelect" class="year-dropdown"
                @bind="_selectedYear"
                @bind:after="async () => await FetchHolidaysAsync()">
            @foreach (var year in _availableYears.OrderBy(y => y))
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>
    <div>
        <button class="download-button" @onclick="DownloadExcelAsync">Download Excel</button>
        <button class="download-button" @onclick="DownloadPdfAsync">Download PDF</button>
    </div>
</div>
<div class="holiday-boxes">
    <div class="permanent-holidays">
        <h4>Fixed Holidays</h4>
        <table class="holiday-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Event</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var holiday in _permanentHolidays.OrderByDescending(h => DateTime.Parse(h.Date)))
                {
                    <tr class="@(IsFutureDate(holiday.Date) ? "" : "past-holiday")">
                        <td>@FormatDateWithoutDay(holiday.Date)</td>
                        <td>@GetDayOfWeek(holiday.Date)</td>
                        <td>@holiday.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="optional-holidays" style="position: relative;">
        <h4>Optional Holidays</h4>
        @if (_isSaving)
        {
            <div class="saving-overlay">
                <div class="loading-spinner"></div>
            </div>
        }
        <table class="holiday-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Event</th>
                    @if (IsUserLocationSelected())
                    {
                        <th>Select<br>(Max 2 Days)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var holiday in _optionalHolidays)
                {
                    <tr class="@(IsFutureDate(holiday.Date) ? "" : "past-holiday")">
                        <td>@FormatDateWithoutDay(holiday.Date)</td>
                        <td>@GetDayOfWeek(holiday.Date)</td>
                        <td>@holiday.Description</td>
                        @if (IsUserLocationSelected())
                        {
                            <td>
                                <input type="checkbox"
                                       @bind="holiday.IsSelected"
                                       @bind:after="async () => await DebounceUpdateSelectionAsync()"
                                       disabled="@IsCheckboxDisabled(holiday)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (GetSelectedCount() > 0 && IsUserLocationSelected())
        {
            <div class="save-section">
                <button class="save-button"
                        @onclick="SaveSelectionAsync"
                        disabled="@(string.IsNullOrEmpty(_userEmail) || _isLoading || _isSaving)">
                    Save Selection (@GetSelectedCount() selected)
                </button>
            </div>
        }
    </div>
</div>
@if (_isSnackbarVisible)
{
    <div class="snackbar success">
        Successfully saved optional holidays!
    </div>
}
@if (_isLoading)
{
    <div style="text-align: center;">
        <div class="loading-spinner"></div>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <p class="error-message">@_errorMessage</p>
}
else if (string.IsNullOrEmpty(_joiningLocation))
{
    <p class="error-message">Employee location not assigned</p>
}
<style>
    .loading-spinner {
        border: 4px solid #3b82f6;
        border-top: 4px solid transparent;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 20px auto;
    }
    .saving-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }
    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }
    .location-selection, .year-selection {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .location-select, .location-dropdown, .year-dropdown {
        padding: 8px 16px;
        border: 1px solid #3498db;
        border-radius: 6px;
        font-family: 'Segoe UI', sans-serif;
        font-size: 14px;
        background-color: #e8f4f8;
        color: #2c3e50;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .location-dropdown:focus, .year-dropdown:focus {
        border-color: #3498db;
        outline: none;
    }
    body {
        background-color: #ffffff;
        color: #000000;
        font-family: Arial, sans-serif;
    }
    h3 {
        color: #1e90ff;
        text-align: center;
        margin-bottom: 20px;
    }
    h4 {
        color: #1e90ff;
        margin-bottom: 10px;
    }
    .holiday-boxes {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
    }
    .permanent-holidays,
    .optional-holidays {
        width: 45%;
        background-color: #d3d3d3;
        padding: 15px;
        border-radius: 10px;
        box-sizing: border singly: nowrap;
    }
    .optional-holidays .holiday-table td input[type="checkbox"] {
        margin-left: 1cm;
    }
    .holiday-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #f5f5f5;
        table-layout: fixed;
    }
    .holiday-table th {
        background-color: #1e90ff;
        color: #ffffff;
        padding: 10px;
        text-align: left;
    }
    .holiday-table td {
        padding: 10px;
        border-bottom: 1px solid #000000;
        color: #000000;
        overflow-wrap: break-word;
        word-break: break-word;
    }
    .holiday-table td.event-description {
        height: auto;
    }
    .holiday-table tr:nth-child(even) {
        background-color: #ffffff;
    }
    .holiday-table tr:hover {
        background-color: #87cefa;
    }
    .holiday-table tr.past-holiday {
        background-color: #bcc1c3;
        color: #ffffff;
    }
    .error-message {
        color: #000000;
        background-color: rgb(66, 200, 100);
        padding: 10px;
        text-align: center;
        border-radius: 5px;
    }
    p {
        text-align: center;
        color: #000000;
    }
    .save-section {
        margin-top: 15px;
        text-align: center;
    }
    .save-button, .download-button {
        padding: 8px 16px;
        background-color: #1e90ff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        margin-left: 10px;
    }
    .save-button:hover, .download-button:hover {
        background-color: #4682b4;
    }
    .snackbar {
        position: fixed;
        bottom: 20px;
        right: 20px;
        transform: none;
        padding: 12px 24px;
        border-radius: 12px;
        color: #000000;
        font-size: 14px;
        z-index: 1000;
        opacity: 1;
        transition: opacity 0.3s ease-in-out;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .snackbar.success {
        background-color: rgb(66, 200, 100);
    }
    .holiday-title {
        font-size: 27px;
    }
    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    private static readonly int MaxSelections = 2;
    private static readonly int SnackbarDurationMs = 2000;
    private static readonly int DebounceDelayMs = 300;
    private Event[] _allHolidays = Array.Empty<Event>();
    private Event[] _permanentHolidays = Array.Empty<Event>();
    private Event[] _optionalHolidays = Array.Empty<Event>();
    private Event[] _savedHolidays = Array.Empty<Event>();
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSnackbarVisible;
    private DateTime _currentDate = DateTime.Now.Date;
    private string? _userEmail;
    private string? _joiningLocation;
    private string? _selectedLocation;
    private int _selectedYear = DateTime.Now.Year;
    private int[] _availableYears = Array.Empty<int>();
    private string? _authToken;
    private string[] _availableLocations = Array.Empty<string>();
    private bool _hasSavedHolidays;
    private string _employeeId = string.Empty;
    private static readonly Dictionary<string, Event[]> _holidaysCache = new();
    private static readonly Dictionary<string, Event[]> _savedHolidaysCache = new();
    private static readonly Dictionary<string, string> _employeeLocationCache = new();
    private static readonly Dictionary<string, string> _employeeIdCache = new();
    private System.Timers.Timer? _debounceTimer;

    private int GetSelectedCount()
    {
        return _optionalHolidays.Count(h => h.IsSelected);
    }

    private bool IsUserLocationSelected()
    {
        return !string.IsNullOrEmpty(_joiningLocation) &&
               string.Equals(_selectedLocation?.Trim(), _joiningLocation?.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            _authToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(_authToken))
            {
                _errorMessage = "No authentication token found. Please log in.";
                return;
            }

            _userEmail = DecodeJwtPayload(_authToken);
            if (string.IsNullOrEmpty(_userEmail))
            {
                _errorMessage = "Unable to retrieve email from authentication token. Please log in again.";
                return;
            }

            await FetchEmployeeLocationAsync();
            await FetchEmployeeIdAsync();
            _selectedLocation = string.IsNullOrEmpty(_joiningLocation) ? null :
                string.Equals(_joiningLocation?.Trim(), "Bangalore", StringComparison.OrdinalIgnoreCase) ? "Bangalore" : _joiningLocation;
            await FetchHolidaysAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error initializing: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchEmployeeLocationAsync()
    {
        try
        {
            var cacheKey = $"location_{_userEmail}";
            if (_employeeLocationCache.TryGetValue(cacheKey, out var cachedLocation))
            {
                _joiningLocation = cachedLocation;
                return;
            }

            HttpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _authToken);
            var employeeDetailsUrl = $"/EmployeeDetails/GetJoiningLocationByEmail/{Uri.EscapeDataString(_userEmail ?? string.Empty)}";
            var response = await HttpClient.GetAsync(employeeDetailsUrl);

            if (response.IsSuccessStatusCode)
            {
                var employeeDetails = await response.Content.ReadFromJsonAsync<EmployeeDetails>();
                _joiningLocation = employeeDetails?.JoiningLocation?.Trim();
                if (!string.IsNullOrEmpty(_joiningLocation))
                {
                    _employeeLocationCache[cacheKey] = _joiningLocation;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _errorMessage = "Employee location not assigned";
                _joiningLocation = null;
            }
            else
            {
                _errorMessage = $"Failed to fetch employee details. Status: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error fetching employee location: {ex.Message}";
        }
        finally
        {
            HttpClient.DefaultRequestHeaders.Authorization = null;
        }
    }

    private async Task FetchEmployeeIdAsync()
    {
        try
        {
            var cacheKey = $"EmployeeByEmail_{_userEmail}";
            if (_employeeIdCache.TryGetValue(cacheKey, out var cachedEmployeeId))
            {
                _employeeId = cachedEmployeeId;
                return;
            }

            HttpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _authToken);
            var employeeIdUrl = $"/EmployeeDetails/GetEmployeeIdByEmail/{Uri.EscapeDataString(_userEmail ?? string.Empty)}";
            var response = await HttpClient.GetAsync(employeeIdUrl);

            if (response.IsSuccessStatusCode)
            {
                _employeeId = JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement.GetProperty("employeeID").GetString() ?? string.Empty;
                _employeeIdCache[cacheKey] = _employeeId;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _errorMessage = "Employee ID not found";
            }
            else
            {
                _errorMessage = $"Failed to fetch employee ID. Status: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error fetching employee ID: {ex.Message}";
        }
        finally
        {
            HttpClient.DefaultRequestHeaders.Authorization = null;
        }
    }

    private string? DecodeJwtPayload(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length != 3) return null;

            var payload = parts[1];
            var padding = payload.Length % 4;
            if (padding > 0)
            {
                payload += new string('=', 4 - padding);
            }

            var decodedPayloadBytes = Convert.FromBase64String(payload);
            var decodedPayload = Encoding.UTF8.GetString(decodedPayloadBytes);

            using var jsonDoc = JsonDocument.Parse(decodedPayload);
            return jsonDoc.RootElement.TryGetProperty("email", out var emailElement)
                && emailElement.ValueKind == JsonValueKind.String
                ? emailElement.GetString()
                : null;
        }
        catch
        {
            return null;
        }
    }

    private void UpdateYearsList()
    {
        var years = _allHolidays
            .Select(h => DateTime.TryParse(h.Date, out var date) ? date.Year : (int?)null)
            .Where(y => y.HasValue)
            .Select(y => y.Value)
            .Distinct()
            .ToArray();

        if (years.Any())
        {
            _availableYears = years;
            if (!_availableYears.Contains(_selectedYear))
            {
                _selectedYear = _availableYears.Contains(DateTime.Now.Year) ? DateTime.Now.Year : _availableYears.Max();
            }
        }
        else
        {
            _availableYears = new[] { DateTime.Now.Year };
            _selectedYear = DateTime.Now.Year;
            _errorMessage = "No years found in holiday data. Using current year.";
            StateHasChanged();
            Task.Delay(3000).ContinueWith(_ => { _errorMessage = null; StateHasChanged(); });
        }
    }

    private async Task FetchHolidaysAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            HttpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _authToken);

            if (!string.IsNullOrEmpty(_userEmail) && !string.IsNullOrEmpty(_joiningLocation))
            {
                var savedHolidaysCacheKey = $"saved_{_userEmail}_{_selectedYear}";
                _savedHolidaysCache.Remove(savedHolidaysCacheKey);
                var savedHolidaysUrl = $"/api/SavedHolidays/{Uri.EscapeDataString(_userEmail)}";
                var savedResponse = await HttpClient.GetAsync(savedHolidaysUrl);
                _savedHolidays = await savedResponse.Content.ReadFromJsonAsync<Event[]>() ?? Array.Empty<Event>();
                _savedHolidays = _savedHolidays
                    .Where(h => h.Date != null && h.Description != null && h.HolidayType != null && h.Location != null)
                    .Where(h => DateTime.TryParse(h.Date, out var date) && date.Year == _selectedYear)
                    .Take(MaxSelections)
                    .ToArray();
                _hasSavedHolidays = _savedHolidays.Any();
                _savedHolidaysCache[savedHolidaysCacheKey] = _savedHolidays;
            }
            else
            {
                _savedHolidays = Array.Empty<Event>();
                _hasSavedHolidays = false;
            }

            var holidaysCacheKey = $"holidays_{_selectedYear}";
            if (_holidaysCache.TryGetValue(holidaysCacheKey, out var cachedHolidays))
            {
                _allHolidays = cachedHolidays;
            }
            else
            {
                const string eventsUrl = "/api/Events";
                var httpResponse = await HttpClient.GetAsync(eventsUrl);
                if (httpResponse.IsSuccessStatusCode)
                {
                    var holidays = await httpResponse.Content.ReadFromJsonAsync<Event[]>() ?? Array.Empty<Event>();
                    _allHolidays = holidays
                        .Where(h => h.Date != null && h.Description != null && h.HolidayType != null && h.Location != null)
                        .ToArray();
                    _holidaysCache[holidaysCacheKey] = _allHolidays;
                }
                else
                {
                    _errorMessage = $"Failed to fetch holidays. Status: {httpResponse.StatusCode}";
                    return;
                }
            }

            UpdateYearsList();
            _availableLocations = _allHolidays
                .Where(h => !string.IsNullOrEmpty(h.Location))
                .Select(h => h.Location!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(l => l)
                .ToArray();

            var filteredHolidays = _allHolidays
                .Where(h => string.IsNullOrEmpty(_selectedLocation) ||
                    string.Equals(h.Location?.Trim(), _selectedLocation?.Trim(), StringComparison.OrdinalIgnoreCase))
                .Where(h => DateTime.TryParse(h.Date, out var date) && date.Year == _selectedYear)
                .ToArray();

            foreach (var holiday in filteredHolidays)
            {
                holiday.IsSelected = _savedHolidays.Any(s => s.Date == holiday.Date &&
                    string.Equals(s.Location?.Trim(), holiday.Location?.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            _permanentHolidays = filteredHolidays
                .Where(h => h.HolidayType == "Permanent")
                .OrderByDescending(h => DateTime.TryParse(h.Date, out var date) ? date : DateTime.MinValue)
                .ToArray();

            _optionalHolidays = filteredHolidays
                .Where(h => h.HolidayType == "Optional")
                .OrderByDescending(h => h.IsSelected)
                .ThenByDescending(h => DateTime.TryParse(h.Date, out var date) ? date : DateTime.MinValue)
                .ToArray();

            Console.WriteLine($"Fetched {_allHolidays.Length} holidays for {_selectedLocation ?? "All"} in {_selectedYear}. Permanent: {_permanentHolidays.Length}, Optional: {_optionalHolidays.Length}, Years: {string.Join(", ", _availableYears)}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error fetching holidays: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            HttpClient.DefaultRequestHeaders.Authorization = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveSelectionAsync()
    {
        if (string.IsNullOrEmpty(_userEmail))
        {
            _errorMessage = "No email found in authentication token. Please log in.";
            return;
        }

        if (string.IsNullOrEmpty(_joiningLocation))
        {
            _errorMessage = "Employee location not assigned. Cannot save selections.";
            return;
        }

        try
        {
            _isSaving = true;
            _errorMessage = null;
            await InvokeAsync(StateHasChanged);
            HttpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", _authToken);

            var selectedHolidays = _optionalHolidays
                .Where(h => h.IsSelected)
                .Take(MaxSelections)
                .Select(h => new SavedHoliday
                {
                    Date = h.Date,
                    EventName = h.Description,
                    UserEmail = _userEmail,
                    Location = h.Location,
                    EmployeeId = _employeeId
                })
                .ToArray();

            Console.WriteLine($"Saving holidays for Employee ID: {_employeeId}");

            foreach (var holiday in _savedHolidays.Where(s => !selectedHolidays.Any(o => o.Date == s.Date &&
                string.Equals(o.Location?.Trim(), s.Location?.Trim(), StringComparison.OrdinalIgnoreCase))))
            {
                var response = await HttpClient.DeleteAsync(
                    $"/api/SavedHolidays/{Uri.EscapeDataString(_userEmail)}/{Uri.EscapeDataString(holiday.Date)}");

                if (!response.IsSuccessStatusCode)
                {
                    _errorMessage = $"Failed to delete holiday for {holiday.Date} in {holiday.Location}. Status: {response.StatusCode}";
                    return;
                }
            }

            if (selectedHolidays.Any())
            {
                var postResponse = await HttpClient.PostAsJsonAsync("/api/SavedHolidays", selectedHolidays);
                if (!postResponse.IsSuccessStatusCode)
                {
                    _errorMessage = $"Failed to save holidays. Status: {postResponse.StatusCode}";
                    return;
                }
            }

            _savedHolidays = selectedHolidays
                .Select(h => new Event { Date = h.Date, Description = h.EventName, Location = h.Location, HolidayType = "Optional", IsSelected = true })
                .ToArray();

            _hasSavedHolidays = _savedHolidays.Any();

            var savedHolidaysCacheKey = $"saved_{_userEmail}_{_selectedYear}";
            _savedHolidaysCache.Remove(savedHolidaysCacheKey);

            _isSnackbarVisible = true;
            await FetchHolidaysAsync();
            await Task.Delay(SnackbarDurationMs);
            _isSnackbarVisible = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error updating selection: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            HttpClient.DefaultRequestHeaders.Authorization = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DebounceUpdateSelectionAsync()
    {
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
        }

        _debounceTimer = new System.Timers.Timer(DebounceDelayMs);
        _debounceTimer.Elapsed += async (sender, e) =>
        {
            if (GetSelectedCount() > MaxSelections)
            {
                var firstSelected = _optionalHolidays
                    .Where(h => h.IsSelected && IsFutureDate(h.Date))
                    .OrderBy(h => DateTime.Parse(h.Date!))
                    .FirstOrDefault();

                if (firstSelected != null)
                {
                    firstSelected.IsSelected = false;
                }
            }

            await InvokeAsync(StateHasChanged);
        };

        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private async Task DownloadExcelAsync()
    {
        try
        {
            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage();
            var worksheet = package.Workbook.Worksheets.Add("Holidays");

            worksheet.Cells[1, 1].Value = "Date";
            worksheet.Cells[1, 2].Value = "Day";
            worksheet.Cells[1, 3].Value = "Event";
            worksheet.Cells[1, 4].Value = "Type";

            var filteredHolidays = string.IsNullOrEmpty(_selectedLocation)
                ? _allHolidays
                : _allHolidays.Where(h => string.Equals(h.Location?.Trim(), _selectedLocation?.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

            var row = 2;
            foreach (var holiday in filteredHolidays.OrderByDescending(h => DateTime.Parse(h.Date)))
            {
                worksheet.Cells[row, 1].Value = FormatDateWithoutDay(holiday.Date);
                worksheet.Cells[row, 2].Value = GetDayOfWeek(holiday.Date);
                worksheet.Cells[row, 3].Value = holiday.Description ?? "";
                worksheet.Cells[row, 4].Value = holiday.HolidayType ?? "";
                row++;
            }

            worksheet.Cells.AutoFitColumns();

            using (var range = worksheet.Cells[1, 1, 1, 4])
            {
                range.Style.Font.Bold = true;
                range.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                range.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(30, 144, 255));
                range.Style.Font.Color.SetColor(System.Drawing.Color.White);
            }

            var fileBytes = package.GetAsByteArray();
            var fileName = $"Holidays_{_selectedLocation ?? "All"}_{_selectedYear}.xlsx";
            var base64String = Convert.ToBase64String(fileBytes);

            await JSRuntime.InvokeVoidAsync("eval", @"
                let link = document.createElement('a');
                link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64," + base64String + @"';
                link.download = '" + fileName + @"';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error downloading Excel: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadPdfAsync()
    {
        try
        {
            using var memoryStream = new MemoryStream();
            using var document = new Document(PageSize.A4, 25, 25, 30, 30);
            PdfWriter.GetInstance(document, memoryStream);
            document.Open();

            var title = new Paragraph($"Holiday List - {_selectedLocation ?? "All Locations"} {_selectedYear}", FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 16));
            title.Alignment = Element.ALIGN_CENTER;
            document.Add(title);
            document.Add(new Paragraph("\n"));

            var table = new PdfPTable(4);
            table.WidthPercentage = 100;
            table.SetWidths(new float[] { 1, 1, 2, 1 });

            var headerFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 10);
            var cellFont = FontFactory.GetFont(FontFactory.HELVETICA, 10);

            string[] headers = { "Date", "Day", "Event", "Type" };
            foreach (var header in headers)
            {
                var cell = new PdfPCell(new Phrase(header, headerFont));
                cell.Padding = 5;
                table.AddCell(cell);
            }

            var filteredHolidays = string.IsNullOrEmpty(_selectedLocation)
                ? _allHolidays
                : _allHolidays.Where(h => string.Equals(h.Location?.Trim(), _selectedLocation?.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

            foreach (var holiday in filteredHolidays.OrderByDescending(h => DateTime.Parse(h.Date)))
            {
                table.AddCell(new PdfPCell(new Phrase(FormatDateWithoutDay(holiday.Date), cellFont)) { Padding = 5 });
                table.AddCell(new PdfPCell(new Phrase(GetDayOfWeek(holiday.Date), cellFont)) { Padding = 5 });
                table.AddCell(new PdfPCell(new Phrase(holiday.Description ?? "", cellFont)) { Padding = 5 });
                table.AddCell(new PdfPCell(new Phrase(holiday.HolidayType ?? "", cellFont)) { Padding = 5 });
            }

            document.Add(table);
            document.Close();

            var fileBytes = memoryStream.ToArray();
            var fileName = $"Holidays_{_selectedLocation ?? "All"}_{_selectedYear}.pdf";
            var base64String = Convert.ToBase64String(fileBytes);

            await JSRuntime.InvokeVoidAsync("eval", @"
                let link = document.createElement('a');
                link.href = 'data:application/pdf;base64," + base64String + @"';
                link.download = '" + fileName + @"';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error downloading PDF: {ex.Message} {(ex.InnerException != null ? $"Inner: {ex.InnerException.Message}" : "")}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsFutureDate(string? date)
    {
        if (string.IsNullOrEmpty(date) || !DateTime.TryParse(date, out DateTime parsedDate))
        {
            return false;
        }

        return parsedDate.Date > _currentDate;
    }

    private bool IsCheckboxDisabled(Event holiday)
    {
        return !IsUserLocationSelected() ||
               !IsFutureDate(holiday.Date) ||
               (GetSelectedCount() >= MaxSelections && !holiday.IsSelected);
    }

    private string FormatDateWithoutDay(string? date)
    {
        if (string.IsNullOrEmpty(date) || !DateTime.TryParse(date, out DateTime parsedDate))
        {
            return string.Empty;
        }

        return $"{parsedDate.Day:D2}/{parsedDate.Month:D2}/{parsedDate.Year}";
    }

    private string GetDayOfWeek(string? date)
    {
        if (string.IsNullOrEmpty(date) || !DateTime.TryParse(date, out DateTime parsedDate))
        {
            return string.Empty;
        }

        return parsedDate.DayOfWeek.ToString();
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}