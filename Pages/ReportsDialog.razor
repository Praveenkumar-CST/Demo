@page "/reports"
@using WiseHR.Models
@using WiseHR.Pages.Form
@using Components.sidebar
@using WiseHRServer.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ReportService ReportService
@inject EmployeeService EmployeeService
@inject ExperienceService ExperienceService
@layout HomeLayout
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                <MudText Align="Align.Center" Class="mt-2" Typo="Typo.body2">Loading...</MudText>
            </div>
        }
        else
        {
            <MudGrid Spacing="2">
                <!-- Filter and Search Section -->
                <MudItem xs="12">
                    <MudPaper Elevation="1" Class="pa-3 mb-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4" md="3">
                                <MudSelect T="int?"
                                           Label="Year"
                                           Value="selectedYear"
                                           ValueChanged="OnYearChanged"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    <MudSelectItem T="int?" Value="@(null)">All Years</MudSelectItem>
                                    @foreach (var year in availableYears)
                                    {
                                        <MudSelectItem T="int?" Value="@year">@year</MudSelectItem>
                                    }
                                </MudSelect>

                            </MudItem>
                            <MudItem xs="12" sm="4" md="3">
                                <MudSelect T="int?"
                                           Label="Month"
                                           Value="selectedMonth"
                                           ValueChanged="OnMonthChanged"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    <MudSelectItem T="int?" Value="@(null)">All Months</MudSelectItem>
                                    @foreach (var month in Enumerable.Range(1, 12))
                                    {
                                        <MudSelectItem T="int?" Value="@month">
                                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="4" md="3">
                                <MudTextField @bind-Value="searchQuery"
                                Label="Search"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                Dense="true"
                                Placeholder="Search by project, mentee, or mentor..."
                                DebounceInterval="300"
                                OnDebounceIntervalElapsed="ApplyFilters" />
                            </MudItem>
                            <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled"
                                Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.Clear"
                                Size="Size.Small"
                                OnClick="ClearFilters"
                                Disabled="@(!selectedYear.HasValue && !selectedMonth.HasValue && string.IsNullOrEmpty(searchQuery))"
                                FullWidth="true">
                                    Clear
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Add Report Button -->
                @if (Role?.ToLower() != "employee")
                {
                    <MudItem xs="12" Class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Add"
                        Size="Size.Small"
                        OnClick="OpenReportDialog">
                            Add Report
                        </MudButton>
                    </MudItem>
                }

                <!-- Reports Table -->
                @if (filteredReports.Any())
                {
                    <MudItem xs="12">
                        <MudTable Items="filteredReports"
                        Dense="true"
                        Hover="true"
                        Bordered="true"
                        Striped="true"
                        Breakpoint="Breakpoint.Sm"
                        Elevation="0"
                        Class="excel-table">
                            <ToolBarContent>
                                <MudText Typo="Typo.subtitle1">Reports (@filteredReports.Count)</MudText>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh Class="excel-header">S.No</MudTh>
                                <MudTh Class="excel-header">Mentee</MudTh>
                                <MudTh Class="excel-header">Mentor</MudTh>
                                <MudTh Class="excel-header">Project</MudTh>
                                <MudTh Class="excel-header">Progress</MudTh>
                                <MudTh Class="excel-header">Fortnight 1</MudTh>
                                <MudTh Class="excel-header">Fortnight 2</MudTh>
                                @if (Role?.ToLower() != "employee")
                                {
                                    <MudTh Class="excel-header">Actions</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate Context="report">
                                <MudTd DataLabel="S.No" Style="width: 30px;">@((filteredReports.IndexOf(report) + 1))</MudTd>
                                <MudTd DataLabel="Mentee" Style="max-width: 120px;">
                                    <MudText Typo="Typo.body2" Class="truncate" title="@report.MenteeName">@report.MenteeName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="truncate" title="@report.MenteeEmail">@report.MenteeEmail</MudText>
                                </MudTd>
                                <MudTd DataLabel="Mentor" Style="max-width: 120px;">                                    
                                        <MudText Typo="Typo.body2" Class="truncate" title="@report.MentorName">@report.MentorName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="truncate" title="@report.MentorEmail">@report.MentorEmail</MudText>

                                </MudTd>
                                <MudTd DataLabel="Project & Stage" Style="max-width: 100px;">
                                    <div title="@report.ProjectsWorkedOn">
                                        <strong>Project:</strong> @report.ProjectsWorkedOn
                                    </div>
                                    <div class="mt-1">
                                        <strong>Stage:</strong>
                                        <MudChip T="string"
                                                 Color="@GetStageColor(report.ProgressStage)"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Small">
                                            @report.ProgressStage
                                        </MudChip>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Progress" Style="max-width: 100px;">
                                    <MudProgressLinear Value="@report.ProgressPercentage"
                                    Color="@GetProgressColor(report.ProgressPercentage)"
                                    Size="Size.Small"
                                    Class="progress-bar" />
                                    <MudText Typo="Typo.caption" Class="mt-1">@report.ProgressPercentage%</MudText>
                                </MudTd>
                                <MudTd DataLabel="Fortnight 1" Style="max-width: 120px;">
                                    @if (!string.IsNullOrEmpty(report.Performance1))
                                    {
                                        <MudText Typo="Typo.caption">Perf: <MudChip T="string" Color="@GetPerformanceColor(report.Performance1)" Size="Size.Small">@report.Performance1</MudChip></MudText>
                                        <MudText Typo="Typo.caption" Class="truncate" title="@report.Feedback1">FB: @(report.Feedback1?.Length > 20 ? report.Feedback1.Substring(0, 20) + "..." : report.Feedback1)</MudText>
                                        <MudText Typo="Typo.caption">SP: @report.CompletedStoryPoints1</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">N/A</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Fortnight 2" Style="max-width: 100px;">
                                    @if (!string.IsNullOrEmpty(report.Performance2))
                                    {
                                        <MudText Typo="Typo.caption">Perf: <MudChip T="string" Color="@GetPerformanceColor(report.Performance2)" Size="Size.Small">@report.Performance2</MudChip></MudText>
                                        <MudText Typo="Typo.caption" Class="truncate" title="@report.Feedback2">FB: @(report.Feedback2?.Length > 20 ? report.Feedback2.Substring(0, 20) + "..." : report.Feedback2)</MudText>
                                        <MudText Typo="Typo.caption">SP: @report.CompletedStoryPoints2</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">N/A</MudText>
                                    }
                                </MudTd>
                                @if (Role?.ToLower() != "employee")
                                {
                                    <MudTd DataLabel="Actions" Style="width: 80px;">
                                        <div style="display: flex; gap: 4px;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                            Color="Color.Primary"
                                            Size="Size.Small"
                                            OnClick="@(() => OpenEditReportDialog(report))"
                                            Title="Edit" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                            Color="Color.Error"
                                            Size="Size.Small"
                                            OnClick="@(() => DeleteReport(report.Id))"
                                            Title="Delete" />
                                        </div>
                                    </MudTd>
                                }
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager RowsPerPage="10" />
                            </PagerContent>
                        </MudTable>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mt-3 pa-2">No reports found.</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
        @if (isSubmitting)
        {
            <MudOverlay Visible="true" DarkBackground="true" Class="d-flex justify-center align-center" ZIndex="1300">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                <MudText Class="ml-2" Typo="Typo.body2" Color="Color.Primary">Submitting...</MudText>
            </MudOverlay>
        }
    </MudPaper>
</MudContainer>

<style>
    .excel-table {
    border-collapse: separate;
    border-spacing: 0;
    background-color: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    }

    .excel-header {
    background-color: #e8f0fe !important;
    font-weight: 600 !important;
    color: #1a3c6c !important;
    text-transform: uppercase;
    font-size: 11px !important;
    padding: 8px 10px !important;
    border-bottom: 1px solid #d3d3d3 !important;
    }

    .excel-table td {
    padding: 8px 10px !important;
    font-size: 12px !important;
    vertical-align: middle;
    border-bottom: 1px solid #e0e0e0 !important;
    }

    .excel-table tr:hover {
    background-color: #f5faff !important;
    }

    .truncate {
    max-width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    }

    .progress-bar {
    min-width: 60px;
    border-radius: 3px;
    }

    .mud-table-container {
    padding: 0 !important;
    }
</style>

@code {
    private List<ReportModel> reports = new();
    private List<ReportModel> filteredReports = new();
    private string? Role { get; set; }
    private string? Email { get; set; }
    private Dictionary<string, EmployeeDetails> _menteeDetailsCache = new();
    private Dictionary<string, Experience> _menteeExperienceCache = new();
    private Dictionary<string, (string ContentType, string Base64Content)> _mentorPhotos = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private int? selectedYear = null;
    private int? selectedMonth = null;
    private string searchQuery = string.Empty;
    private List<int> availableYears = Enumerable.Range(2020, DateTime.UtcNow.Year - 2019).ToList();

    private Color GetProgressColor(int percentage) => percentage switch
    {
        >= 80 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error
    };

    private Color GetStageColor(string? stage) => stage?.ToLower() switch
    {
        "completed" => Color.Success,
        "in progress" => Color.Warning,
        "planning" => Color.Info,
        _ => Color.Default
    };

    private Color GetPerformanceColor(string? performance) => performance?.ToLower() switch
    {
        "excellent" => Color.Success,
        "good" => Color.Success,
        "average" => Color.Info,
        "below average" => Color.Warning,
        "poor" => Color.Error,
        _ => Color.Default
    };

    private string GetInstitution(Experience? exp)
    {
        if (exp == null) return "N/A";
        if (exp.WorkExperiences?.Any() == true)
            return exp.WorkExperiences.First().Employer;
        if (exp.EducationQualifications?.Any() == true)
            return exp.EducationQualifications.OrderByDescending(e => e.YearOfPassing).First().University;
        return "N/A";
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var roleTask = JS.InvokeAsync<string>("sessionStorage.getItem", "userRole").AsTask();
            var emailTask = JS.InvokeAsync<string>("sessionStorage.getItem", "email").AsTask();
            await Task.WhenAll(roleTask, emailTask);

            Role = await roleTask;
            Email = await emailTask;

            if (string.IsNullOrEmpty(Role) || string.IsNullOrEmpty(Email))
            {
                Snackbar.Add("Role or Email is missing from session.", Severity.Error);
                return;
            }

            await LoadReportsBasedOnRole();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReportsBasedOnRole()
    {
        try
        {
            var empDetailsTask = EmployeeService.GetEmployeeDetailsByEmail(Email!);
            var reportsTask = Role!.ToLower() switch
            {
                "admin" => ReportService.GetReportsAsync(),
                "manager" => empDetailsTask.ContinueWith(t => t.Result != null ? ReportService.GetReportsByMentorIdAsync(t.Result.EmployeeID) : Task.FromResult<List<ReportModel>?>(null)).Unwrap(),
                "employee" => empDetailsTask.ContinueWith(t => t.Result != null ? ReportService.GetReportsByMenteeIdAsync(t.Result.EmployeeID) : Task.FromResult<List<ReportModel>?>(null)).Unwrap(),
                _ => throw new InvalidOperationException("Unknown role")
            };

            await Task.WhenAll(empDetailsTask, reportsTask);
            var empDetails = empDetailsTask.Result;
            reports = reportsTask.Result ?? new List<ReportModel>();

            if (empDetails == null)
            {
                Snackbar.Add("Employee details not found.", Severity.Error);
                return;
            }

            var uniqueMentorIds = reports.Select(r => r.MentorId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();
            var uniqueMenteeIds = reports.Select(r => r.MenteeId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();

            var missingMentorIds = uniqueMentorIds.Where(id => !_mentorPhotos.ContainsKey(id)).ToList();
            var missingMenteeIds = uniqueMenteeIds.Where(id => !_menteeDetailsCache.ContainsKey(id)).ToList();
            var missingExperienceIds = uniqueMenteeIds.Where(id => !_menteeExperienceCache.ContainsKey(id)).ToList();

            var mentorDetailsTasks = missingMentorIds.Select(id => EmployeeService.GetEmployeeDetails(id)).ToList();
            var menteeDetailsTasks = missingMenteeIds.Select(id => EmployeeService.GetEmployeeDetails(id)).ToList();
            var menteeExperienceTasks = missingExperienceIds.Select(id => ExperienceService.GetExperienceDetails(id)).ToList();

            await Task.WhenAll(mentorDetailsTasks);
            await Task.WhenAll(menteeDetailsTasks);
            await Task.WhenAll(menteeExperienceTasks);

            foreach (var (id, task) in missingMentorIds.Zip(mentorDetailsTasks))
            {
                var mentor = await task;
                if (mentor != null && !string.IsNullOrEmpty(mentor.PhotoBase64Content))
                {
                    _mentorPhotos[id] = (mentor.PhotoContentType, mentor.PhotoBase64Content);
                }
            }

            foreach (var (id, task) in missingMenteeIds.Zip(menteeDetailsTasks))
            {
                var mentee = await task;
                if (mentee != null)
                {
                    _menteeDetailsCache[id] = mentee;
                }
            }

            foreach (var (id, task) in missingExperienceIds.Zip(menteeExperienceTasks))
            {
                var exp = await task;
                if (exp != null)
                {
                    _menteeExperienceCache[id] = exp;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reports: {ex.Message}", Severity.Error);
        }
    }

    private void ApplyFilters()
    {
        var query = searchQuery?.Trim().ToLower();
        filteredReports = reports.Where(r =>
            (!selectedYear.HasValue || r.SubmittedOn.Year == selectedYear.Value) &&
            (!selectedMonth.HasValue || r.SubmittedOn.Month == selectedMonth.Value) &&
            (string.IsNullOrEmpty(query) ||
             r.ProjectsWorkedOn?.ToLower().Contains(query) == true ||
             r.MenteeName?.ToLower().Contains(query) == true ||
             r.MenteeEmail?.ToLower().Contains(query) == true ||
             r.MentorName?.ToLower().Contains(query) == true ||
             r.MentorEmail?.ToLower().Contains(query) == true)
        ).ToList();
        StateHasChanged();
    }

    private async Task OnYearChanged(int? year)
    {
        selectedYear = year;
        ApplyFilters();
    }

    private async Task OnMonthChanged(int? month)
    {
        selectedMonth = month;
        ApplyFilters();
    }

    private async Task ClearFilters()
    {
        selectedYear = null;
        selectedMonth = null;
        searchQuery = string.Empty;
        ApplyFilters();
    }

    private async Task OpenReportDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = false };
        isSubmitting = true;
        var dialog = await DialogService.ShowAsync<FortnightReportForm>("Submit Fortnight Report", options);
        var result = await dialog.Result;
        isSubmitting = false;

        if (!result.Canceled && result.Data is ReportModel newReport)
        {
            Snackbar.Add("Report added successfully.", Severity.Success);
            reports.Add(newReport);
            await UpdateCacheForReport(newReport);
            ApplyFilters();
            StateHasChanged();
        }
        else
        {
            await LoadReportsBasedOnRole();
            ApplyFilters();
            StateHasChanged();
        }
    }

    private async Task OpenEditReportDialog(ReportModel report)
    {
        var parameters = new DialogParameters { { nameof(FortnightReportForm.Report), report } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = false };
        isSubmitting = true;
        var dialog = await DialogService.ShowAsync<FortnightReportForm>("Edit Fortnight Report", parameters, options);
        var result = await dialog.Result;
        isSubmitting = false;

        if (!result.Canceled)
        {
            Snackbar.Add("Report updated successfully.", Severity.Success);
            var updatedReport = await ReportService.GetReportByIdAsync(report.Id);
            if (updatedReport != null)
            {
                var index = reports.FindIndex(r => r.Id == report.Id);
                if (index >= 0)
                {
                    reports[index] = updatedReport;
                }
                await UpdateCacheForReport(updatedReport);
            }
            else
            {
                await LoadReportsBasedOnRole();
            }
            ApplyFilters();
            StateHasChanged();
        }
    }

    private async Task DeleteReport(int id)
    {
        try
        {
            bool isDeleted = await ReportService.DeleteReportAsync(id);
            if (isDeleted)
            {
                Snackbar.Add("Report deleted successfully.", Severity.Success);
                reports.RemoveAll(r => r.Id == id);
                await CleanUpCache();
                ApplyFilters();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Failed to delete report.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting report: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateCacheForReport(ReportModel report)
    {
        try
        {
            var mentorId = report.MentorId;
            var menteeId = report.MenteeId;

            if (!string.IsNullOrEmpty(mentorId) && !_mentorPhotos.ContainsKey(mentorId))
            {
                var mentor = await EmployeeService.GetEmployeeDetails(mentorId);
                if (mentor != null && !string.IsNullOrEmpty(mentor.PhotoBase64Content))
                {
                    _mentorPhotos[mentorId] = (mentor.PhotoContentType, mentor.PhotoBase64Content);
                }
            }

            if (!string.IsNullOrEmpty(menteeId))
            {
                if (!_menteeDetailsCache.ContainsKey(menteeId))
                {
                    var mentee = await EmployeeService.GetEmployeeDetails(menteeId);
                    if (mentee != null)
                    {
                        _menteeDetailsCache[menteeId] = mentee;
                    }
                }

                if (!_menteeExperienceCache.ContainsKey(menteeId))
                {
                    var exp = await ExperienceService.GetExperienceDetails(menteeId);
                    if (exp != null)
                    {
                        _menteeExperienceCache[menteeId] = exp;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating cache: {ex.Message}", Severity.Error);
        }
    }

    private async Task CleanUpCache()
    {
        try
        {
            var activeMentorIds = reports.Select(r => r.MentorId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToHashSet();
            var activeMenteeIds = reports.Select(r => r.MenteeId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToHashSet();

            var mentorIdsToRemove = _mentorPhotos.Keys.Where(id => !activeMentorIds.Contains(id)).ToList();
            var menteeIdsToRemove = _menteeDetailsCache.Keys.Where(id => !activeMenteeIds.Contains(id)).ToList();
            var experienceIdsToRemove = _menteeExperienceCache.Keys.Where(id => !activeMenteeIds.Contains(id)).ToList();

            foreach (var id in mentorIdsToRemove)
            {
                _mentorPhotos.Remove(id);
            }

            foreach (var id in menteeIdsToRemove)
            {
                _menteeDetailsCache.Remove(id);
            }

            foreach (var id in experienceIdsToRemove)
            {
                _menteeExperienceCache.Remove(id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cleaning up cache: {ex.Message}", Severity.Error);
        }
    }
}