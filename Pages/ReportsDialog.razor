@page "/reports"
@using WiseHR.Models
@using WiseHR.Pages.Form
@using Components.sidebar
@using WiseHRServer.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ReportService ReportService
@inject EmployeeService EmployeeService
@inject ExperienceService ExperienceService
@layout HomeLayout
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="m-1.5">
    @if (isLoading)
    {
        <div style="display: flex; flex-direction: column; align-items: center;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Align="Align.Center">Loading...</MudText>
        </div>
    }
    else
    {
        @if (Role?.ToLower() != "employee")
        {
            <div class="d-flex mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenReportDialog">
                    Add Report
                </MudButton>
            </div>
        }
        @if (reports.Any())
        {
            <div style="max-width: 100%;" class="rounded-table-wrapper">
                <MudTable Class="small-table" Items="reports" Dense="true" Hover="true" Bordered="true" Striped="true" Style="width:max-content;">
                    <HeaderContent>
                        <MudTh>S.NO</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Phone</MudTh>
                        <MudTh>Institution</MudTh>
                        <MudTh>Mentor</MudTh>
                        <MudTh>Projects</MudTh>
                        <MudTh>Pro-Stage</MudTh>
                        <MudTh>Progress%</MudTh>
                        <MudTh>FortnightRemark1</MudTh>
                        <MudTh>FortnightRemark2</MudTh>
                        @if (Role?.ToLower() != "employee")
                        {
                            <MudTh>Actions</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="report">
                        <MudTd DataLabel="S.NO">@((reports.IndexOf(report) + 1))</MudTd>
                        <MudTd DataLabel="Mentee Name">@report.MenteeName</MudTd>
                        <MudTd DataLabel="Mentee Email">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                            @report.MenteeEmail
                        </MudTd>
                        <MudTd DataLabel="Phone">
                            <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                            @(_menteeDetailsCache.TryGetValue(report.MenteeId, out var mentee) ? mentee.CurrentMobile ?? "N/A" : "N/A")
                        </MudTd>
                        <MudTd DataLabel="Institution">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Color="Color.Info" Class="mr-1" />
                            @(_menteeExperienceCache.TryGetValue(report.MenteeId, out var exp) ? GetInstitution(exp) : "N/A")
                        </MudTd>
                        <MudTd DataLabel="Mentor">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                @if (_mentorPhotos.TryGetValue(report.MentorId, out var photo) && !string.IsNullOrEmpty(photo.Base64Content))
                                {
                                    <img src="data:@photo.ContentType;base64,@photo.Base64Content" alt="Mentor Photo" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                                <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Filled">@report.MentorName</MudChip>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Project">@report.ProjectsWorkedOn</MudTd>
                        <MudTd DataLabel="Pro-Stage">
                            <MudChip T="string" Color="@GetStageColor(report.ProgressStage)" Variant="Variant.Outlined">@report.ProgressStage</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Progress%">
                            <MudProgressLinear Value="@report.ProgressPercentage" Color="@GetProgressColor(report.ProgressPercentage)" Style="min-width:100px;" />
                            @if (report.ProgressPercentage == 100)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="ml-1" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Autorenew" Color="Color.Warning" Class="ml-1" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Remark1">@report.FortnightRemarks1</MudTd>
                        <MudTd DataLabel="Remark2">@report.FortnightRemarks2</MudTd>
                        @if (Role?.ToLower() != "employee")
                        {
                            <MudTd>
                                <div style="display: flex; gap: 2px;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => OpenEditReportDialog(report))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteReport(report.Id))" />
                                </div>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        }
        else
        {
            <MudText Color="Color.Secondary" Align="Align.Center" Class="mt-4">No reports found.</MudText>
        }
    }
    @if (isSubmitting)
    {
        <MudOverlay Visible="true" DarkBackground="true" Class="d-flex justify-center align-center" ZIndex="1300">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText Class="ml-2" Typo="Typo.h6" Color="Color.Primary">Submitting...</MudText>
        </MudOverlay>
    }
</MudContainer>

<style>
    .small-table td,
    .small-table th {
        font-size: 12px !important;
        padding: 4px 8px !important;
    }

    .small-table .mud-icon {
        font-size: 16px !important;
    }

    .rounded-table-wrapper {
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }
</style>

@code {
    private List<ReportModel> reports = new();
    private string? Role { get; set; }
    private string? Email { get; set; }
    private Dictionary<string, EmployeeDetails> _menteeDetailsCache = new();
    private Dictionary<string, Experience> _menteeExperienceCache = new();
    private Dictionary<string, (string ContentType, string Base64Content)> _mentorPhotos = new();
    private bool isLoading = true;
    private bool isSubmitting = false;

    private Color GetProgressColor(int percentage) => percentage switch
    {
        >= 80 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error
    };

    private Color GetStageColor(string? stage) => stage?.ToLower() switch
    {
        "completed" => Color.Success,
        "in-progress" => Color.Warning,
        "not started" => Color.Error,
        _ => Color.Default
    };

    private string GetInstitution(Experience? exp)
    {
        if (exp == null) return "N/A";
        if (exp.WorkExperiences?.Any() == true)
            return exp.WorkExperiences.First().Employer;
        if (exp.EducationQualifications?.Any() == true)
            return exp.EducationQualifications.OrderByDescending(e => e.YearOfPassing).First().University;
        return "N/A";
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            Console.WriteLine("[DEBUG] Initializing reports page...");
            var roleTask = JS.InvokeAsync<string>("sessionStorage.getItem", "userRole").AsTask();
            var emailTask = JS.InvokeAsync<string>("sessionStorage.getItem", "email").AsTask();
            await Task.WhenAll(roleTask, emailTask);

            Role = await roleTask;
            Email = await emailTask;
            Console.WriteLine($"[DEBUG] Role: {Role}, Email: {Email}");

            if (string.IsNullOrEmpty(Role) || string.IsNullOrEmpty(Email))
            {
                Snackbar.Add("Role or Email is missing from session.", Severity.Error);
                Console.WriteLine("[DEBUG] Missing role or email");
                return;
            }

            await LoadReportsBasedOnRole();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing: {ex.Message}", Severity.Error);
            Console.WriteLine($"[DEBUG] Error in OnInitializedAsync: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReportsBasedOnRole()
    {
        Console.WriteLine("[DEBUG] Loading reports based on role...");
        try
        {
            var empDetailsTask = EmployeeService.GetEmployeeDetailsByEmail(Email!);
            var reportsTask = Role!.ToLower() switch
            {
                "admin" => ReportService.GetReportsAsync(),
                "manager" => empDetailsTask.ContinueWith(t => t.Result != null ? ReportService.GetReportsByMentorIdAsync(t.Result.EmployeeID) : Task.FromResult<List<ReportModel>?>(null)).Unwrap(),
                "employee" => empDetailsTask.ContinueWith(t => t.Result != null ? ReportService.GetReportsByMenteeIdAsync(t.Result.EmployeeID) : Task.FromResult<List<ReportModel>?>(null)).Unwrap(),
                _ => throw new InvalidOperationException("Unknown role")
            };

            await Task.WhenAll(empDetailsTask, reportsTask);
            var empDetails = empDetailsTask.Result;
            reports = reportsTask.Result ?? new List<ReportModel>();
            Console.WriteLine($"[DEBUG] Reports loaded: {reports.Count}");

            if (empDetails == null)
            {
                Snackbar.Add("Employee details not found.", Severity.Error);
                Console.WriteLine("[DEBUG] No employee details found");
                return;
            }

            var uniqueMentorIds = reports.Select(r => r.MentorId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();
            var uniqueMenteeIds = reports.Select(r => r.MenteeId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();
            Console.WriteLine($"[DEBUG] Unique Mentor IDs: {uniqueMentorIds.Count}, Mentee IDs: {uniqueMenteeIds.Count}");

            var missingMentorIds = uniqueMentorIds.Where(id => !_mentorPhotos.ContainsKey(id)).ToList();
            var missingMenteeIds = uniqueMenteeIds.Where(id => !_menteeDetailsCache.ContainsKey(id)).ToList();
            var missingExperienceIds = uniqueMenteeIds.Where(id => !_menteeExperienceCache.ContainsKey(id)).ToList();

            var mentorDetailsTasks = missingMentorIds.Select(id => EmployeeService.GetEmployeeDetails(id)).ToList();
            var menteeDetailsTasks = missingMenteeIds.Select(id => EmployeeService.GetEmployeeDetails(id)).ToList();
            var menteeExperienceTasks = missingExperienceIds.Select(id => ExperienceService.GetExperienceDetails(id)).ToList();

            await Task.WhenAll(mentorDetailsTasks);
            await Task.WhenAll(menteeDetailsTasks);
            await Task.WhenAll(menteeExperienceTasks);

            foreach (var (id, task) in missingMentorIds.Zip(mentorDetailsTasks))
            {
                var mentor = await task;
                if (mentor != null && !string.IsNullOrEmpty(mentor.PhotoBase64Content))
                {
                    _mentorPhotos[id] = (mentor.PhotoContentType, mentor.PhotoBase64Content);
                    Console.WriteLine($"[DEBUG] Cached mentor photo for ID: {id}");
                }
            }

            foreach (var (id, task) in missingMenteeIds.Zip(menteeDetailsTasks))
            {
                var mentee = await task;
                if (mentee != null)
                {
                    _menteeDetailsCache[id] = mentee;
                    Console.WriteLine($"[DEBUG] Cached mentee details for ID: {id}");
                }
            }

            foreach (var (id, task) in missingExperienceIds.Zip(menteeExperienceTasks))
            {
                var exp = await task;
                if (exp != null)
                {
                    _menteeExperienceCache[id] = exp;
                    Console.WriteLine($"[DEBUG] Cached mentee experience for ID: {id}");
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reports: {ex.Message}", Severity.Error);
            Console.WriteLine($"[DEBUG] Error in LoadReportsBasedOnRole: {ex.Message}");
        }
    }

    private async Task OpenReportDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = false };
        isSubmitting = true;
        Console.WriteLine("[DEBUG] Opening add report dialog...");
        var dialog = await DialogService.ShowAsync<FortnightReportForm>("Submit Fortnight Report", options);
        var result = await dialog.Result;
        isSubmitting = false;

        if (!result.Canceled && result.Data is ReportModel newReport)
        {
            Snackbar.Add("Report added successfully.", Severity.Success);
            Console.WriteLine($"[DEBUG] Report added, ID: {newReport.Id}, Mentee: {newReport.MenteeName}");
            // Add the new report to the list instantly
            reports.Add(newReport);
            // Update cache for the new report
            await UpdateCacheForReport(newReport);
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("[DEBUG] Add report dialog canceled or no report data returned");
            // Fallback to full reload if dialog doesn't return the report
            await LoadReportsBasedOnRole();
            StateHasChanged();
        }
    }

    private async Task OpenEditReportDialog(ReportModel report)
    {
        var parameters = new DialogParameters { { nameof(FortnightReportForm.Report), report } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = false };
        isSubmitting = true;
        Console.WriteLine($"[DEBUG] Opening edit report dialog for report ID: {report.Id}");
        var dialog = await DialogService.ShowAsync<FortnightReportForm>("Edit Fortnight Report", parameters, options);
        var result = await dialog.Result;
        isSubmitting = false;

        if (!result.Canceled)
        {
            Snackbar.Add("Report updated successfully.", Severity.Success);
            Console.WriteLine("[DEBUG] Report updated, updating table...");
            var updatedReport = await ReportService.GetReportByIdAsync(report.Id);
            if (updatedReport != null)
            {
                var index = reports.FindIndex(r => r.Id == report.Id);
                if (index >= 0)
                {
                    reports[index] = updatedReport;
                }
                await UpdateCacheForReport(updatedReport);
            }
            else
            {
                await LoadReportsBasedOnRole();
            }
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("[DEBUG] Edit report dialog canceled");
        }
    }

    private async Task DeleteReport(int id)
    {
        Console.WriteLine($"[DEBUG] Deleting report ID: {id}");
        try
        {
            bool isDeleted = await ReportService.DeleteReportAsync(id);
            if (isDeleted)
            {
                Snackbar.Add("Report deleted successfully.", Severity.Success);
                Console.WriteLine("[DEBUG] Report deleted, removing from table...");
                reports.RemoveAll(r => r.Id == id);
                await CleanUpCache();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Failed to delete report.", Severity.Error);
                Console.WriteLine("[DEBUG] Failed to delete report");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting report: {ex.Message}", Severity.Error);
            Console.WriteLine($"[DEBUG] Error in DeleteReport: {ex.Message}");
        }
    }

    private async Task UpdateCacheForReport(ReportModel report)
    {
        Console.WriteLine($"[DEBUG] Updating cache for report ID: {report.Id}");
        try
        {
            var mentorId = report.MentorId;
            var menteeId = report.MenteeId;

            if (!string.IsNullOrEmpty(mentorId) && !_mentorPhotos.ContainsKey(mentorId))
            {
                var mentor = await EmployeeService.GetEmployeeDetails(mentorId);
                if (mentor != null && !string.IsNullOrEmpty(mentor.PhotoBase64Content))
                {
                    _mentorPhotos[mentorId] = (mentor.PhotoContentType, mentor.PhotoBase64Content);
                    Console.WriteLine($"[DEBUG] Cached mentor photo for ID: {mentorId}");
                }
            }

            if (!string.IsNullOrEmpty(menteeId))
            {
                if (!_menteeDetailsCache.ContainsKey(menteeId))
                {
                    var mentee = await EmployeeService.GetEmployeeDetails(menteeId);
                    if (mentee != null)
                    {
                        _menteeDetailsCache[menteeId] = mentee;
                        Console.WriteLine($"[DEBUG] Cached mentee details for ID: {menteeId}");
                    }
                }

                if (!_menteeExperienceCache.ContainsKey(menteeId))
                {
                    var exp = await ExperienceService.GetExperienceDetails(menteeId);
                    if (exp != null)
                    {
                        _menteeExperienceCache[menteeId] = exp;
                        Console.WriteLine($"[DEBUG] Cached mentee experience for ID: {menteeId}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Error updating cache: {ex.Message}");
        }
    }

    private async Task CleanUpCache()
    {
        Console.WriteLine("[DEBUG] Cleaning up cache...");
        try
        {
            var activeMentorIds = reports.Select(r => r.MentorId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToHashSet();
            var activeMenteeIds = reports.Select(r => r.MenteeId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToHashSet();

            var mentorIdsToRemove = _mentorPhotos.Keys.Where(id => !activeMentorIds.Contains(id)).ToList();
            var menteeIdsToRemove = _menteeDetailsCache.Keys.Where(id => !activeMenteeIds.Contains(id)).ToList();
            var experienceIdsToRemove = _menteeExperienceCache.Keys.Where(id => !activeMenteeIds.Contains(id)).ToList();

            foreach (var id in mentorIdsToRemove)
            {
                _mentorPhotos.Remove(id);
                Console.WriteLine($"[DEBUG] Removed mentor photo cache for ID: {id}");
            }

            foreach (var id in menteeIdsToRemove)
            {
                _menteeDetailsCache.Remove(id);
                Console.WriteLine($"[DEBUG] Removed mentee details cache for ID: {id}");
            }

            foreach (var id in experienceIdsToRemove)
            {
                _menteeExperienceCache.Remove(id);
                Console.WriteLine($"[DEBUG] Removed mentee experience cache for ID: {id}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Error cleaning up cache: {ex.Message}");
        }
    }

    private async Task DownloadFile(ReportModel report)
    {
        Console.WriteLine($"[DEBUG] Downloading file for report ID: {report.Id}");
        if (report.UploadedFile != null && !string.IsNullOrEmpty(report.FileName))
        {
            var base64 = Convert.ToBase64String(report.UploadedFile);
            await JS.InvokeVoidAsync("downloadBase64File", "application/octet-stream", base64, report.FileName);
            Console.WriteLine($"[DEBUG] File downloaded: {report.FileName}");
        }
        else
        {
            Console.WriteLine("[DEBUG] No file to download");
        }
    }

    public class Report
    {
        public string ReportName { get; set; } = string.Empty;
        public DateTime Date { get; set; }
    }
}