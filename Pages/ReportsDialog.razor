@page "/reports"
@using WiseHR.Models
@using WiseHR.Pages.Form
@using Components.sidebar
@using WiseHRServer.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ReportService ReportService
@inject EmployeeService EmployeeService
@inject ExperienceService ExperienceService
@layout HomeLayout
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="m-1.5">    @if (isLoading)
    {
        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Align="Align.Center">Loading...</MudText>
            </div>
        }

    }
    else
    {
        <!-- Button to open dialog -->
        @if (Role?.ToLower() != "employee")
        {
            <!-- Add Report Button -->
            <div class="d-flex  mb-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"  OnClick="OpenReportDialog">
                    Add Report
                </MudButton>
            </div>
        }
    @if (reports != null && reports.Count > 0)
    {

            <div style=" max-width: 100%;" class="rounded-table-wrapper">

            <MudTable  Class="small-table" Items="reports" Dense="true" Hover="true" Bordered="true" Striped="true" Style="width:max-content; ">
                <HeaderContent>             
                    <MudTh>S.NO</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Institution</MudTh>
                    <MudTh>Mentor</MudTh>
                    <MudTh>Projects</MudTh>
                    <MudTh>Pro-Stage</MudTh>
                    <MudTh>Progress%</MudTh>
                    <MudTh>FortnightRemark1</MudTh>
                    <MudTh>FortnightRemark2</MudTh>
                    @* <MudTh>File</MudTh> *@
                    @if (Role?.ToLower() != "employee")
                    {
                        <MudTh>Actions</MudTh>
                    }       
                </HeaderContent>
                <RowTemplate Context="report">
    <MudTd DataLabel="S.NO">@((reports.IndexOf(report) + 1).ToString())</MudTd>

    <MudTd DataLabel="Mentee Name">@report.MenteeName</MudTd>

    <MudTd DataLabel="Mentee Email">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color=" Color.Primary" Class="mr-1" />
        @report.MenteeEmail
    </MudTd>

    <MudTd DataLabel="Phone">
        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
        @(menteeMobiles.TryGetValue(report.MenteeId, out var phone) ? phone : "N/A")
    </MudTd>

    <MudTd DataLabel="Institution">
        <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" Color="Color.Info" Class="mr-1" />
        @(menteeInstitutions.TryGetValue(report.MenteeId, out var institution) ? institution : "N/A")
    </MudTd>

   <MudTd DataLabel="Mentor">
    <div style="display: flex; align-items: center; gap: 8px;">
        @if (mentorPhotos.TryGetValue(report.MentorId, out var photo) && !string.IsNullOrEmpty(photo.Base64Content))
        {
            <img src="data:@photo.ContentType;base64,@photo.Base64Content" alt="Mentor Photo" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
        }
        <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Filled">@report.MentorName</MudChip>
    </div>
</MudTd>

    <MudTd DataLabel="Project">@report.ProjectsWorkedOn</MudTd>

    <MudTd DataLabel="Pro-Stage">
        <MudChip  T="string" Color="@GetStageColor(report.ProgressStage)" Variant="Variant.Outlined">@report.ProgressStage</MudChip>
    </MudTd>

    <MudTd DataLabel="Progress%">
        <MudProgressLinear Value="@report.ProgressPercentage" Color="@GetProgressColor(report.ProgressPercentage)" Style="min-width:100px;" />
        @if (report.ProgressPercentage == 100)
        {
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="ml-1" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Color="Color.Warning" Class="ml-1" />
        }
    </MudTd>

    <MudTd DataLabel="Remark1">@report.FortnightRemarks1</MudTd>
    <MudTd DataLabel="Remark2">@report.FortnightRemarks2</MudTd>

    @* <MudTd> *@
    @*     @if (!string.IsNullOrEmpty(report.FileName)) *@
    @*     { *@
    @*         <MudTooltip Text="Download Report File"> *@
    @*             <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Primary" OnClick="() => DownloadFile(report)" /> *@
    @*         </MudTooltip> *@
    @*     } *@
    @*     else *@
    @*     { *@
    @*         <MudText Color="Color.Error">No File</MudText> *@
    @*     } *@
    @* </MudTd> *@

    @if (Role?.ToLower() != "employee")
    {
        <MudTd>
            <div style="display: flex; gap: 2px;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => OpenEditReportDialog(report)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteReport(report.Id)" />
            </div>
        </MudTd>
    }
</RowTemplate>

            </MudTable>
        </div>
        }
        else
        {
            <MudText Color="Color.Secondary" Align="Align.Center" Class="mt-4">No reports found.</MudText>
        }
    }@if (isSubmitting)
    {
        <MudOverlay Visible="true" DarkBackground="true" Class="d-flex justify-center align-center" ZIndex="1300">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"  />
            <MudText Class="ml-2" Typo="Typo.h6" Color="Color.Primary">Submitting...</MudText>
        </MudOverlay>
    }

</MudContainer>
<style>
    .small-table td,
    .small-table th {
        font-size: 12px !important;
        padding: 4px 8px !important;
    }

    .small-table .mud-icon {
        font-size: 16px !important;
    }
    .rounded-table-wrapper {
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }
</style>
@code {
    private List<ReportModel> reports = new();
    private string Role { get; set; }
    private string Email { get; set; }
    private Dictionary<string, string> menteeMobiles = new();
    private Dictionary<string, string> menteeInstitutions = new(); // New dictionary for institutions                                                            // }
    private bool isLoading = true;
    private bool isSubmitting = false;
    private Dictionary<string, (string ContentType, string Base64Content)> mentorPhotos = new();

    private Color GetProgressColor(int percentage)
    {
        return percentage switch
        {
            >= 80 => Color.Success,
            >= 50 => Color.Warning,
            _ => Color.Error
        };
    }

    private Color GetStageColor(string stage)
    {
        return stage?.ToLower() switch
        {
            "completed" => Color.Success,
            "in-progress" => Color.Warning,
            "not started" => Color.Error,
            _ => Color.Default
        };
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        //role to userRole
        try
        {


            Role = await JS.InvokeAsync<string>("sessionStorage.getItem", "userRole");
            Email = await JS.InvokeAsync<string>("sessionStorage.getItem", "email");
            Console.WriteLine($"role: {Role}");
            Console.WriteLine($"email: {Email}");
            await LoadReportsBasedOnRole();
            StateHasChanged();
        }
        finally
        {
            isLoading = false; // Set loading to false when done
            StateHasChanged(); // Ensure UI updates
        }
    }
    private async Task LoadReportsBasedOnRole()
    {
        try
        {
            if (string.IsNullOrEmpty(Role) || string.IsNullOrEmpty(Email))
            {
                Console.WriteLine("empty");
                Snackbar.Add("Role or Email is missing from session.", Severity.Error);
                return;
            }

            var empDetails = await EmployeeService.GetEmployeeDetailsByEmail(Email);
            Console.WriteLine($"empDetails : {empDetails}");

            if (empDetails == null)
            {
                Snackbar.Add("Employee details not found.", Severity.Error);
                return;
            }

            string empId = empDetails.EmployeeID;
            Console.WriteLine($"empId: {empId}");

            switch (Role.ToLower())
            {
                case "admin":
                    reports = await ReportService.GetReportsAsync() ?? new List<ReportModel>();
                    break;

                case "manager":
                    reports = await ReportService.GetReportsByMentorIdAsync(empId) ?? new List<ReportModel>();
                    break;

                case "employee":
                    reports = await ReportService.GetReportsByMenteeIdAsync(empId) ?? new List<ReportModel>();
                    break;

                default:
                    Snackbar.Add("Unknown role.", Severity.Warning);
                    return;
            }

            // Clear and populate menteeMobiles
            menteeMobiles.Clear();
            menteeInstitutions.Clear();
            var uniqueMentorIds = reports.Select(r => r.MentorId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();
            foreach (var mentorId in uniqueMentorIds)
            {
                try
                {
                    var mentor = await EmployeeService.GetEmployeeDetails(mentorId);
                    if (mentor != null && !string.IsNullOrEmpty(mentor.PhotoBase64Content))
                    {
                        mentorPhotos[mentorId] = (mentor.PhotoContentType, mentor.PhotoBase64Content);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error fetching mentor photo for {mentorId}: {ex.Message}");
                }
            }

            var uniqueMenteeIds = reports.Select(r => r.MenteeId).Distinct().Where(id => !string.IsNullOrEmpty(id)).ToList();
            Console.WriteLine($"Found {uniqueMenteeIds.Count} unique mentee IDs: {string.Join(", ", uniqueMenteeIds)}");
            foreach (var menteeId in uniqueMenteeIds)
            {
                try
                {
                    // Fetch employee details for phone number
                    var menteeDetail = await EmployeeService.GetEmployeeDetails(menteeId);
                    if (menteeDetail != null && !string.IsNullOrEmpty(menteeDetail.CurrentMobile))
                    {
                        menteeMobiles[menteeId] = menteeDetail.CurrentMobile;
                        Console.WriteLine($"Added phone for Mentee ID {menteeId}: {menteeDetail.CurrentMobile}");
                    }
                    else
                    {
                        menteeMobiles[menteeId] = "N/A";
                        Console.WriteLine($"No phone found for Mentee ID {menteeId}");
                    }

                    // Fetch experience details for institution
                    var experience = await ExperienceService.GetExperienceDetails(menteeId);
                    if (experience != null)
                    {
                        string institution = "N/A";
                        if (experience.WorkExperiences != null && experience.WorkExperiences.Any())
                        {
                            institution = experience.WorkExperiences.First().Employer;
                            Console.WriteLine($"Added institution (work) for Mentee ID {menteeId}: {institution}");
                        }
                        else if (experience.EducationQualifications != null && experience.EducationQualifications.Any())
                        {
                            var latestEducation = experience.EducationQualifications
                                .OrderByDescending(e => e.YearOfPassing)
                                .First();
                            institution = latestEducation.University; // Or use University if preferred
                            Console.WriteLine($"Added institution (education) for Mentee ID {menteeId}: {institution}");
                        }
                        menteeInstitutions[menteeId] = institution;
                    }
                    else
                    {
                        menteeInstitutions[menteeId] = "N/A";
                        Console.WriteLine($"No experience found for Mentee ID {menteeId}");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error fetching data for Mentee ID {menteeId}: {ex.Message}");
                    menteeMobiles[menteeId] = "N/A";
                    menteeInstitutions[menteeId] = "N/A";
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reports: {ex.Message}", Severity.Error);
            Console.WriteLine($"General error: {ex.Message}");
        }
    }
    private async Task OpenEditReportDialog(ReportModel report)
    {
        var parameters = new DialogParameters
        {
            { nameof(FortnightReportForm.Report), report } // Pass the report to the dialog
        };

        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = false
            };
        isSubmitting = true;
        var dialog = DialogService.Show<FortnightReportForm>("Edit Fortnight Report", parameters, options);
        var result = await dialog.Result;
        isSubmitting = false;

        if (!result.Canceled)
        {
            Snackbar.Add("Report updated successfully.", Severity.Success);
            await LoadReportsBasedOnRole(); // Refresh the list
            StateHasChanged();
        }
    }

    private async Task DeleteReport(int id)
    {
        bool isDeleted = await ReportService.DeleteReportAsync(id);
        if (isDeleted)
        {
            Snackbar.Add("Report deleted successfully.", Severity.Success);
            isLoading = true;
            await LoadReportsBasedOnRole();
            isLoading = false;// Refresh list
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Failed to delete report.", Severity.Error);
        }
    }

    private async Task OpenReportDialog()
    {
        var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = false
            };

        isSubmitting = true;
        var dialog = DialogService.Show<FortnightReportForm>("Submit Fortnight Report", options);
        var result = await dialog.Result;

        if (!result.Canceled) // ✅ correct spelling and property name
        {
            Snackbar.Add("Report added successfully.", Severity.Success);
            isLoading = true;

            await LoadReportsBasedOnRole();
            isLoading = false;

            StateHasChanged();
        }
        isSubmitting = false;
    }
    private async Task DownloadFile(ReportModel report)
    {
        if (report.UploadedFile != null && !string.IsNullOrEmpty(report.FileName))
        {
            var base64 = Convert.ToBase64String(report.UploadedFile);
            var fileType = "application/octet-stream"; // Optional: detect actual file type
            await JS.InvokeVoidAsync("downloadBase64File", fileType, base64, report.FileName);
        }
    }


    // Optional: Legacy placeholder model (not used if ReportModel is defined in Models)
    public class Report
    {
        public string ReportName { get; set; }
        public DateTime Date { get; set; }
    }
}