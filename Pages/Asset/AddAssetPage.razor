@page "/add-asset"
@inject NavigationManager Navigation
@inject AssetStateService AssetService
@layout HomeLayout
@using System.Text.Json
@using System.Linq
@using WiseHR.Models

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Add New Asset</h1>
        <button class="btn back-btn" @onclick="NavigateToHome">← Back to Dashboard</button>
    </div>

    <div class="form-container">
        <div class="form-section">
            <div class="form-group">
                <label>Category</label>
                <select class="form-control" @bind="category" @bind:after="ResetForm">
                    <option value="">Select Category</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Non-Electronics">Non-Electronics</option>
                </select>
            </div>

            @if (!string.IsNullOrEmpty(category))
                {
                <div class="form-group">
                    <label>Product</label>
                    <select class="form-control" @bind="product" @bind:after="ResetCustomAssetName">
                        <option value="">Select Product</option>
                        @foreach (var item in GetProductsByCategory(category))
                            {
                            <option value="@item">@item</option>
                            }
                    </select>
                </div>
                }

            @if (product == "Others")
                {
                <div class="form-group">
                    <label>Custom Asset Name</label>
                    <input type="text" class="form-control" @bind="customAssetName" placeholder="Enter custom asset name" />
                </div>
                }

            @if (!string.IsNullOrEmpty(product) && (product != "Others" || !string.IsNullOrEmpty(customAssetName)))
                {
                <div class="form-fields">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Product Brand</label>
                            <input type="text" class="form-control" @bind="productBrand" />
                        </div>
                        <div class="form-group addon-btn">
                            <button class="btn add-btn" @onclick="OpenSpecModal">+</button>
                        </div>
                    </div>

                    @foreach (var spec in productSpecs.ToList())
                        {
                        <div class="form-row" key="@spec.Key">
                            <div class="form-group">
                                <label>@spec.Key</label>
                                <input type="text" class="form-control" @bind="productSpecs[spec.Key]" />
                            </div>
                            <div class="form-group addon-btn">
                                <button class="btn add-btn remove-btn" @onclick="() => RemoveProductSpec(spec.Key)">-</button>
                            </div>
                        </div>
                        }

                    <div class="form-group">
                        <label>Number of Assets</label>
                        <input type="number" class="form-control" @bind="assetCount" min="1" />
                    </div>

                    <div class="action-buttons">
                        <button class="btn save-btn" @onclick="ShowConfirmSave">Save</button>
                    </div>
                </div>
                }
        </div>
    </div>
</div>

@if (showConfirmSave)
    {
    <div class="modal-backdrop" @onclick="CloseConfirmSave"></div>
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Confirm Save</h2>
                <button class="close-btn" @onclick="CloseConfirmSave">×</button>
            </div>
            <div class="modal-body">
                <p class="confirm-message">Are you sure you want to save <strong>@assetCount</strong> asset(s) for <strong>@GetDisplayProductName()</strong>?</p>
                <table class="preview-table">
                    <thead>
                        <tr>
                            <th>NO OF ASSET</th>
                            <th>ASSET TAG</th>
                            <th>BRAND</th>
                            <th>SPECIFICATIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 1; i <= assetCount; i++)
                            {
                            <tr>
                                <td>@i</td>
                                <td>@GenerateAssetTag(GetStoredProductName(), latestTagIndex + i)</td>
                                <td>@productBrand</td>
                                <td>
                                    @foreach (var spec in productSpecs)
                                        {
                                        <div>@spec.Key: @spec.Value</div>
                                        }
                                </td>
                            </tr>
                            }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn save-btn" @onclick="SaveAndClose">Confirm & Save</button>
                <button class="btn cancel-btn" @onclick="CloseConfirmSave">Cancel</button>
            </div>
        </div>
    </div>
    }

@if (showSpecModal)
    {
    <div class="modal-backdrop" @onclick="CloseSpecModal"></div>
    <div class="modal-dialog spec-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Add Specification</h2>
                <button class="close-btn" @onclick="CloseSpecModal">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Specification Name</label>
                    <input type="text" class="form-control" @bind="newSpecName" placeholder="e.g. RAM, CPU" />
                </div>
                <div class="form-group">
                    <label>Specification Value</label>
                    <input type="text" class="form-control" @bind="newSpecValue" placeholder="e.g. 8GB, Intel i5" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn save-btn" @onclick="AddProductSpec">Add</button>
                <button class="btn cancel-btn" @onclick="CloseSpecModal">Cancel</button>
            </div>
        </div>
    </div>
    }

