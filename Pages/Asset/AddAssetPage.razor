@code {
    private string category = string.Empty;
    private string product = string.Empty;
    private string customAssetName = string.Empty;
    private string productBrand = string.Empty;
    private int assetCount = 1;
    private Dictionary<string, string> productSpecs = new();
    private bool showConfirmSave = false;
    private bool showSpecModal = false;
    private string newSpecName = string.Empty;
    private string newSpecValue = string.Empty;
    private int latestTagIndex = 0;

    private Dictionary<string, List<string>> customProducts = new()
    {
        { "Electronics", new List<string>() },
        { "Non-Electronics", new List<string>() }
    };

    protected override async Task OnInitializedAsync()
        {
        await LoadCustomProducts();
        }

    private async Task LoadCustomProducts()
        {
        try
            {
            Console.WriteLine("Loading custom products...");
            var assets = await AssetService.GetAssetsAsync();
            Console.WriteLine($"Retrieved {assets?.Count ?? 0} assets.");
            customProducts["Electronics"].Clear();
            customProducts["Non-Electronics"].Clear();

            if (assets?.Any() == true)
                {
                var electronicsAssets = assets
                    .Where(a => a.Category.Equals("Electronics", StringComparison.OrdinalIgnoreCase))
                    .Select(a => a.Name)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Distinct(StringComparer.OrdinalIgnoreCase);

                var nonElectronicsAssets = assets
                    .Where(a => a.Category.Equals("Non-Electronics", StringComparison.OrdinalIgnoreCase))
                    .Select(a => a.Name)
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .Distinct(StringComparer.OrdinalIgnoreCase);

                var electronicsPredefined = GetPredefinedProducts("Electronics");
                var nonElectronicsPredefined = GetPredefinedProducts("Non-Electronics");

                customProducts["Electronics"].AddRange(electronicsAssets
                    .Where(name => !electronicsPredefined.Contains(name, StringComparer.OrdinalIgnoreCase)));
                customProducts["Non-Electronics"].AddRange(nonElectronicsAssets
                    .Where(name => !nonElectronicsPredefined.Contains(name, StringComparer.OrdinalIgnoreCase)));
                }
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error loading custom products: {ex.Message}");
            }
        }

    private void NavigateToHome()
        {
        Navigation.NavigateTo("/asset");
        }

    private void ResetForm()
        {
        if (!string.IsNullOrWhiteSpace(productBrand) || !string.IsNullOrWhiteSpace(customAssetName) || productSpecs.Any())
            {
            Console.WriteLine("Changing category will clear the form. Save your data first.");
            }
        product = string.Empty;
        customAssetName = string.Empty;
        productBrand = string.Empty;
        assetCount = 1;
        productSpecs.Clear();
        latestTagIndex = 0;
        StateHasChanged();
        }

    private void ResetCustomAssetName()
        {
        if (product != "Others")
            {
            customAssetName = string.Empty;
            }
        StateHasChanged();
        }

    private List<string> GetPredefinedProducts(string category)
        {
        if (category == "Electronics")
            {
            return new List<string> { "Laptop", "Desktop", "Monitor", "Phone", "Tablet", "Printer", "Router", "Keyboard", "Mouse", "Headset", "WebCam", "Docking Station", "Smart TV", "Others" };
            }
        else if (category == "Non-Electronics")
            {
            return new List<string> { "Office Chair", "Desk", "Conference Table", "Notebook", "Stationery Kit", "Books/Manuals", "Whiteboard", "Locker", "Packaging Boxes", "Plant", "Wall Clock", "Fan", "Others" };
            }
        return new List<string>();
        }

    private List<string> GetProductsByCategory(string category)
        {
        var products = GetPredefinedProducts(category);
        if (customProducts.ContainsKey(category))
            {
            products.AddRange(customProducts[category].Where(p => !p.Equals("Others", StringComparison.OrdinalIgnoreCase)));
            }
        var sortedProducts = products
            .Where(p => !p.Equals("Others", StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p)
            .ToList();
        if (products.Contains("Others", StringComparer.OrdinalIgnoreCase))
            {
            sortedProducts.Add("Others");
            }
        return sortedProducts;
        }

    private string GetDisplayProductName()
        {
        return product == "Others" ? customAssetName : product;
        }

    private string GetStoredProductName()
        {
        return product == "Others" ? customAssetName : product;
        }

    private void OpenSpecModal()
        {
        newSpecName = string.Empty;
        newSpecValue = string.Empty;
        showSpecModal = true;
        }

    private void CloseSpecModal()
        {
        showSpecModal = false;
        }

    private void AddProductSpec()
        {
        if (string.IsNullOrWhiteSpace(newSpecName))
            {
            Console.WriteLine("Specification name is required.");
            return;
            }
        if (productSpecs.ContainsKey(newSpecName))
            {
            Console.WriteLine("Specification name must be unique.");
            return;
            }

        productSpecs[newSpecName] = newSpecValue;
        CloseSpecModal();
        }

    private void RemoveProductSpec(string key)
        {
        productSpecs.Remove(key);
        }

    private async Task ShowConfirmSave()
        {
        Console.WriteLine($"productBrand: '{productBrand}', assetCount: {assetCount}, specsCount: {productSpecs.Count}");
        if (string.IsNullOrWhiteSpace(category))
            {
            Console.WriteLine("Category is required.");
            return;
            }
        if (string.IsNullOrWhiteSpace(product))
            {
            Console.WriteLine("Product is required.");
            return;
            }
        if (product == "Others" && string.IsNullOrWhiteSpace(customAssetName))
            {
            Console.WriteLine("Custom asset name is required when selecting 'Others'.");
            return;
            }
        if (string.IsNullOrWhiteSpace(productBrand))
            {
            Console.WriteLine("Brand is required.");
            return;
            }
        if (assetCount <= 0)
            {
            Console.WriteLine("Number of assets must be greater than 0.");
            return;
            }

        if (product == "Others")
            {
            var trimmedAssetName = customAssetName.Trim();
            var predefinedProducts = GetPredefinedProducts(category);
            if (predefinedProducts.Contains(trimmedAssetName, StringComparer.OrdinalIgnoreCase))
                {
                Console.WriteLine($"The asset '{trimmedAssetName}' is already a predefined product. Please select it from the product list.");
                return;
                }
            }

        await FetchLatestTagIndex();
        showConfirmSave = true;
        }

    private void CloseConfirmSave()
        {
        showConfirmSave = false;
        }

    private async Task FetchLatestTagIndex()
        {
        try
            {
            var productName = GetStoredProductName();
            var assets = await AssetService.GetAssetsAsync();
            latestTagIndex = 0;
            if (assets?.Any() == true)
                {
                var prefix = GenerateAssetTagPrefix(productName);
                var matchingInstances = assets
                    .Where(a => a.Name.Equals(productName, StringComparison.OrdinalIgnoreCase))
                    .SelectMany(a => a.Instances ?? new List<AssetInstance>())
                    .Where(i => !string.IsNullOrEmpty(i.AssetTag) && i.AssetTag.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                    .Select(i =>
                    {
                        var numericPart = i.AssetTag.Substring(prefix.Length);
                        return int.TryParse(numericPart, out var index) ? index : 0;
                    });

                latestTagIndex = matchingInstances.Any() ? matchingInstances.Max() : 0;
                }
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error fetching tag index: {ex.Message}");
            }
        }

    private string GenerateAssetTagPrefix(string name)
        {
        return "WW" + name.Substring(0, Math.Min(3, name.Length)).ToUpper();
        }

    private string GenerateAssetTag(string productName, int index)
        {
        var prefix = GenerateAssetTagPrefix(productName);
        return $"{prefix}{index:D3}";
        }

    private async Task SaveAndClose()
        {
        try
            {
            Console.WriteLine($"Saving asset with assetCount: {assetCount}, specsCount: {productSpecs.Count}");

            var assetDto = new CreateAssetDto
                    {
                    Name = GetStoredProductName().Trim(),
                    Category = category.Trim(),
                    Brand = productBrand.Trim(),
                    AssetTagPrefix = GenerateAssetTagPrefix(GetStoredProductName()),
                    InstanceCount = assetCount,
                    Specifications = productSpecs
                    };

            var assetJson = JsonSerializer.Serialize(assetDto);
            Console.WriteLine($"Sending CreateAssetDto: {assetJson}");

            Asset createdAsset = await AssetService.CreateAssetAsync(assetDto);
            Console.WriteLine($"Created asset response: ID={createdAsset?.Id}, Name={createdAsset?.Name}");

            if (createdAsset == null)
                {
                Console.WriteLine("Warning: Asset creation succeeded, but response body was empty.");
                }

            for (int i = 1; i <= assetCount; i++)
                {
                var instanceDto = new CreateInstanceDto
                        {
                        AssetTag = GenerateAssetTag(GetStoredProductName(), latestTagIndex + i),
                        Brand = productBrand.Trim(),
                        Status = "Available"
                        };

                var instanceJson = JsonSerializer.Serialize(instanceDto);
                Console.WriteLine($"Sending CreateInstanceDto {i}: {instanceJson}");

                var createdInstance = await AssetService.CreateInstanceAsync(createdAsset?.Id ?? 0, instanceDto);
                Console.WriteLine($"Created instance response: ID={createdInstance?.Id}, AssetTag={createdInstance?.AssetTag}");

                if (createdInstance == null)
                    {
                    Console.WriteLine($"Warning: Instance {i} creation succeeded, but response body was empty.");
                    }
                }

            if (product == "Others" && !string.IsNullOrWhiteSpace(customAssetName))
                {
                var trimmedAssetName = customAssetName.Trim();
                var predefinedProducts = GetPredefinedProducts(category);
                if (!predefinedProducts.Contains(trimmedAssetName, StringComparer.OrdinalIgnoreCase) &&
                    !customProducts[category].Contains(trimmedAssetName, StringComparer.OrdinalIgnoreCase))
                    {
                    customProducts[category].Add(trimmedAssetName);
                    }
                }

            CloseConfirmSave();
            Navigation.NavigateTo("/asset");
            }
        catch (Exception ex)
            {
            Console.WriteLine($"Error saving asset: {ex.Message}");
            CloseConfirmSave();
            Navigation.NavigateTo("/asset");
            }
        }
}