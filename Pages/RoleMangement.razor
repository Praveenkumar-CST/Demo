            background: #ffffff;
        }

        .modern-table.compact-table .mud-table-head th {
            background: #f5f7fa;
            color: #1e88e5;
            font-size: 0.85rem;
            padding: 4px 6px;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .modern-table.compact-table .mud-table-row {
            transition: background-color 0.2s ease;
        }

            .modern-table.compact-table .mud-table-row:hover {
