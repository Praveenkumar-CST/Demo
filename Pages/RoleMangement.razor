@page "/home/rolemanagement"
@using WiseHR.Models
@using System.Threading.Tasks
@using Components.sidebar
@using MudBlazor
@layout HomeLayout
@inject IUserService UserService
@inject EmployeeService EmployeeService
@inject BankingService BankingService
@inject ExperienceService ExperienceService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2">
    <MudGrid Spacing="2" Class="mb-4">
        @* Commented out Add New Employee button *@
        <MudItem xs="12" sm="6" md="4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick='() => NavigationManager.NavigateTo("/home/employees")'
                       >
                Add New Employee
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (users == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-flex align-center justify-center" />
    }
    else
    {
        <MudTable Items="@FilteredUsers"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true"
                  Elevation="2"
                  Class="mud-elevation-1">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Current Role</MudTh>
                <MudTh>New Role</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Current Role">@context.Role</MudTd>
                <MudTd DataLabel="New Role">
                    <MudSelect T="string"
                               Value="@context.Role"
                               ValueChanged="@(newRole => UpdateRole(context, newRole))"
                               Variant="Variant.Outlined"
                               Dense="true">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Manager")">Manager</MudSelectItem>
                        <MudSelectItem Value="@("HR")">HR</MudSelectItem>
                        <MudSelectItem Value="@("Employee")">Employee</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="() => ShowDeleteConfirmation(context.Id, context.Email)">
                        Delete
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<User>? users;
    private string searchQuery = "";

    private IEnumerable<User> FilteredUsers => users?
        .Where(u => string.IsNullOrEmpty(searchQuery) ||
                    u.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<User>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await UserService.GetUsersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading users: {ex.Message}", Severity.Error);
        }
    }

    [CascadingParameter]
    private HomeLayout? Layout { get; set; }

    protected override void OnParametersSet()
    {
        if (Layout != null)
        {
            Layout.OnSearchQueryChanged = EventCallback.Factory.Create<string>(this, HandleSearchQuery);
        }
    }

    private async Task HandleSearchQuery(string query)
    {
        Console.WriteLine($"Search Query Updated: {query}");
        searchQuery = query;
        StateHasChanged();
    }

    private async Task UpdateRole(User user, string? newRole)
    {
        if (user == null || string.IsNullOrEmpty(newRole)) return;

        var oldRole = user.Role;
        user.Role = newRole;
        try
        {
            await UserService.UpdateUserRoleAsync(user.Id, user.Role);
            Snackbar.Add($"Role updated for {user.Email} from {oldRole} to {newRole}", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating role: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowDeleteConfirmation(string? id, string email)
    {
        if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(email))
            return;

        bool? confirmed = await DialogService.ShowMessageBox(
            title: "Confirm Delete",
            message: $"Are you sure you want to delete user {email}? This action will also delete associated employee data (if any) and cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }
        );

        if (confirmed == true)
        {
            await DeleteUser(id, email);
        }
    }

    private async Task DeleteUser(string? id, string email)
    {
        if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(email))
            return;

        try
        {
            bool allSuccessful = true;

            // Check if the user has an associated employee record
            var employee = await EmployeeService.GetEmployeeDetailsByEmail(email);

            if (employee != null && !string.IsNullOrEmpty(employee.EmployeeID))
            {
                // Employee exists, delete all associated data
                var deleteBankingTask = BankingService.DeleteBankingInfo(employee.EmployeeID);
                var deleteEmployeeTask = EmployeeService.DeleteEmployee(employee.EmployeeID);
                var deleteExperienceTask = ExperienceService.DeleteExperienceAsync(employee.EmployeeID);

                var results = await Task.WhenAll(deleteBankingTask, deleteEmployeeTask, deleteExperienceTask);
                allSuccessful = results.All(r => r);

                if (allSuccessful)
                {
                    Console.WriteLine($"Successfully deleted employee data (banking, employee, experience) for EmployeeID: {employee.EmployeeID}");
                }
                else
                {
                    Console.WriteLine($"Partial failure deleting employee data for EmployeeID: {employee.EmployeeID}");
                    allSuccessful = false;
                }
            }

            // Delete user credentials from Supabase
            try
            {
                await UserService.DeleteUserAsync(id);
                Console.WriteLine($"Successfully deleted user credentials for ID: {id}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to delete user credentials for ID: {id}: {ex.Message}");
                allSuccessful = false;
            }

            if (allSuccessful)
            {
                // Remove from local users list
                if (users != null)
                {
                    users.RemoveAll(u => u.Id == id);
                }
                Console.WriteLine($"Successfully deleted user {email} (ID: {id}) and associated data");
                Snackbar.Add($"User {email} and associated data deleted successfully", Severity.Success);
            }
            else
            {
                Console.WriteLine($"Partial failure deleting user {email} (ID: {id})");
                Snackbar.Add($"Failed to delete some data for user {email}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting user {email} (ID: {id}): {ex.Message}");
            Snackbar.Add($"Error deleting user {email}: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }
}