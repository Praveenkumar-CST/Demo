    private List<Country> countries = new();
    private int? contactIndexBeingFetched = null;
    private string zipErrorMessage = null;
    private System.Timers.Timer debounceTimer = new System.Timers.Timer(500);
    private string lastZipProcessed = string.Empty;
    public class PinResponse
    {
        public List<PostOffice> PostOffice { get; set; }
    }
    public class PostOffice
    {
        public string State { get; set; }
        public string District { get; set; }
    }
    private async Task GetCityStateFromPin(string pinCode, Action<string> setCity, Action<string> setState)
    {
        Console.WriteLine($"[DEBUG] Fetching city/state for pin: {pinCode}");

        zipErrorMessage = null;
        if (!string.IsNullOrWhiteSpace(pinCode) && pinCode.Length == 6)
        {
            try
            {
                using var http = new HttpClient();
                var response = await http.GetFromJsonAsync<List<PinResponse>>($"https://api.postalpincode.in/pincode/{pinCode}");

                if (response?.Any() == true && response.First().PostOffice?.Any() == true)
                {
                    var post = response.First().PostOffice.FirstOrDefault();
                    Console.WriteLine($"[DEBUG] Found city: {post?.District}, state: {post?.State}");

                    if (post != null)
                    {
                        setCity(post.District);
                        setState(post.State);
                    }
                    else
                    {
                        setCity(string.Empty);
                        setState(string.Empty);
                        zipErrorMessage = $"No data found for PIN code: {pinCode}";
                    }
                }
                else
                {
                    Console.WriteLine($"[DEBUG] No data found for pin: {pinCode}");
                    setCity(string.Empty);
                    setState(string.Empty);
                    zipErrorMessage = $"Invalid PIN code: {pinCode}";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] Error fetching pin data: {ex.Message}");
                setCity(string.Empty);
                setState(string.Empty);
                zipErrorMessage = $"Error fetching city/state: {ex.Message}";
            }
        }
        else
        {
            Console.WriteLine($"[DEBUG] Invalid pin format: {pinCode}");
            setCity(string.Empty);
            setState(string.Empty);
            zipErrorMessage = "PIN code must be 6 digits.";
        }
    }
    private bool IsFetchingLocation = false;
    private async Task HandleZipCodeChange(string zip, int contactIndex)
    {
        if (string.IsNullOrWhiteSpace(zip) || zip.Length != 6 || zip == lastZipProcessed)
        {
            Console.WriteLine($"[DEBUG] Skipping fetch for invalid or unchanged pin: {zip}");
            return;
        }

        // Cancel any existing timer
        debounceTimer.Stop();

        // Start a new debounce timer
        await Task.Run(() =>
        {
            debounceTimer.Elapsed += async (s, e) =>
            {
                debounceTimer.Stop(); // Stop the timer after firing
                await InvokeAsync(async () =>
                {
                    IsFetchingLocation = true;
                    contactIndexBeingFetched = contactIndex;
                    StateHasChanged();

                    lastZipProcessed = zip; // Track the last processed ZIP to avoid duplicates

                    if (contactIndex == 1)
                    {
                        employeeDetails.EmergencyContact1ZipCode = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.EmergencyContact1City = city,
                            state => employeeDetails.EmergencyContact1State = state
                        );
                    }
                    else if (contactIndex == 2)
                    {
                        employeeDetails.EmergencyContact2ZipCode = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.EmergencyContact2City = city,
                            state => employeeDetails.EmergencyContact2State = state
                        );
                    }
                    else if (contactIndex == 3)
                    {
                        employeeDetails.CurrentZip = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.CurrentCity = city,
                            state => employeeDetails.CurrentState = state
                        );
                    }
                    else if (contactIndex == 4)
                    {
                        employeeDetails.PermanentZip = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.PermanentCity = city,
                            state => employeeDetails.PermanentState = state
                        );
                    }

                    IsFetchingLocation = false;
                    contactIndexBeingFetched = null;
                    StateHasChanged();
                });
            };
            debounceTimer.AutoReset = false; // Run only once
            debounceTimer.Start();
        });
    }
    protected async override void OnInitialized()
    {
        countries = await CountryService.GetCountriesAsync();

        await LoadFromLocalStorage();
        await LoadEmployeeInfo();
        if (InitialData != null)
        {
            employeeDetails = InitialData;
        }

    }
    private async Task LoadFromLocalStorage()
    {
        // Load EmpId and Email from localStorage (set during signup/login)
        var empId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "empId");
        var email = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "email");

        if (!string.IsNullOrEmpty(empId))
        {
            employeeDetails.EmployeeID = empId;
            Console.WriteLine($"Loaded EmployeeID from localStorage: {empId}");
        }
        if (!string.IsNullOrEmpty(email))
        {
            employeeDetails.CurrentEmail = email;
            Console.WriteLine($"Loaded Email from sessionStorage: {email}");
        }
        StateHasChanged();
    }
    private async Task LoadEmployeeInfo()
    {
        // Load existing employee details from sessionStorage, preserving EmpId and Email
        var employeeJson = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "employeeDetails");
        if (!string.IsNullOrEmpty(employeeJson))
        {
            var storedDetails = JsonSerializer.Deserialize<EmployeeDetails>(employeeJson);
            if (storedDetails != null)
            {
                // Merge stored data, but keep EmployeeID and CurrentEmail from localStorage
                employeeDetails = storedDetails;
                var empId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "empId");
                var email = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "email");
                if (!string.IsNullOrEmpty(empId)) employeeDetails.EmployeeID = empId;
                if (!string.IsNullOrEmpty(email)) employeeDetails.CurrentEmail = email;
            }
            StateHasChanged();
        }
    }


    private bool IsSameAsCurrentAddress { get; set; }

    private void CopyAddress(bool value)
    {
        IsSameAsCurrentAddress = value;
        if (IsSameAsCurrentAddress)
        {
            employeeDetails.PermanentAddress = employeeDetails.CurrentAddress;
            employeeDetails.PermanentCity = employeeDetails.CurrentCity;
            employeeDetails.PermanentState = employeeDetails.CurrentState;
            employeeDetails.PermanentZip = employeeDetails.CurrentZip;
            employeeDetails.PermanentMobile = employeeDetails.CurrentMobile;
            employeeDetails.PermanentEmail = employeeDetails.CurrentEmail;
        }
    }
   
