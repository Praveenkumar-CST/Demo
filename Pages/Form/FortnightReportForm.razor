@page "/fortnight-report"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject EmployeeService EmployeeService
@inject ReportService ReportService
@layout HomeLayout
@inject IUserService UserService
@inject MentorAssignmentService MentorAssignmentService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="2">
        @if (isLoading)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Align="Align.Center" Class="mt-2">Loading...</MudText>
            </div>
        }
        else if (hasError)
        {
            <MudAlert Severity="Severity.Error" Class="ma-4">Failed to load employee data.</MudAlert>
        }
        else
        {
            <EditForm Model="@report" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <MudGrid Spacing="4" Class="mud-grid-spacing-xs-4">
                    <!-- Mentor Information Section -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-4">Mentor Information</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="report.MentorName" 
                                    Label="Mentor Name" 
                                    Variant="Variant.Outlined" 
                                    Disabled="true" 
                                    Margin="Margin.Dense" />
                    </MudItem>
                    @* <MudItem xs="12" sm="6" md="4"> *@
                    @*     <MudTextField @bind-Value="report.MentorDesignation"  *@
                    @*                 Label="Mentor Designation"  *@
                    @*                 Variant="Variant.Outlined"  *@
                    @*                 Disabled="true"  *@
                    @*                 Margin="Margin.Dense" /> *@
                    @* </MudItem> *@

                    <!-- Mentee Information Section -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-6 mb-4">Mentee Information</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                 Label="Select Mentee Email"
                                 Value="selectedMenteeEmail"
                                 ValueChanged="OnMenteeEmailChanged"
                                 Required="true"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 For="@(() => report.MenteeEmail)">
                            @foreach (var emp in employees)
                            {
                                <MudSelectItem Value="@emp.CurrentEmail">@emp.CurrentEmail</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>                 
                    @* <MudItem xs="12" sm="6"> *@
                    @*     <MudTextField @bind-Value="report.MenteeEmail"  *@
                    @*                 Label="Mentee Email"  *@
                    @*                 Variant="Variant.Outlined"  *@
                    @*                 Disabled="true"  *@
                    @*                 Margin="Margin.Dense" /> *@
                    @* </MudItem> *@

                    <!-- Project Information Section -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-6 mb-4">Project Information</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="string" Label="Projects Worked On" @bind-Value="report.ProjectsWorkedOn"
                                   Variant="Variant.Outlined" Required="true" Margin="Margin.Dense">
                            <MudSelectItem Value=@("WiseONE")>WiseONE</MudSelectItem>
                            <MudSelectItem Value=@("WiseULTIMA")>WiseULTIMA</MudSelectItem>
                            <MudSelectItem Value=@("WiseMASTRO")>WiseMASTRO</MudSelectItem>
                            <MudSelectItem Value=@("WeatherAPP")>WeatherAPP</MudSelectItem>
                            <MudSelectItem Value=@("BlogAPP")>BlogAPP</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- Fortnight 1 Section -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-6 mb-4">First fortnight (1st - 15th)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" 
                                 @bind-Value="report.Performance1" 
                                 For="@(() => report.Performance1)" 
                                 Label="Performance 1" 
                                 Required="true" 
                                 Disabled="@IsFirstFortnightDisabled"
                                 Variant="Variant.Outlined" 
                                 Margin="Margin.Dense">
                            <MudSelectItem Value=@("Excellent")>Excellent</MudSelectItem>
                            <MudSelectItem Value=@("Good")>Good</MudSelectItem>
                            <MudSelectItem Value=@("Average")>Average</MudSelectItem>
                            <MudSelectItem Value=@("Below Average")>Below Average</MudSelectItem>
                            <MudSelectItem Value=@("Poor")>Poor</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="report.CompletedStoryPoints1" 
                                    For="@(() => report.CompletedStoryPoints1)" 
                                    Label="Completed Story Points 1" 
                                    InputType="InputType.Number" 
                                    Required="true" 
                                    Disabled="@IsFirstFortnightDisabled"
                                    Variant="Variant.Outlined" 
                                    Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="report.Feedback1" 
                                    For="@(() => report.Feedback1)" 
                                    Label="Feedback 1" 
                                    Lines="3" 
                                    Required="true" 
                                    Disabled="@IsFirstFortnightDisabled"
                                    Variant="Variant.Outlined" 
                                    Margin="Margin.Dense" />
                    </MudItem>

                    <!-- Fortnight 2 Section -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mt-6 mb-4">Second Fortnight (16th - 31st)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" 
                                 @bind-Value="report.Performance2" 
                                 For="@(() => report.Performance2)" 
                                 Label="Performance 2" 
                                 Required="true" 
                                 Disabled="@IsSecondFortnightDisabled"
                                 Variant="Variant.Outlined" 
                                 Margin="Margin.Dense">
                            <MudSelectItem Value=@("Excellent")>Excellent</MudSelectItem>
                            <MudSelectItem Value=@("Good")>Good</MudSelectItem>
                            <MudSelectItem Value=@("Average")>Average</MudSelectItem>
                            <MudSelectItem Value=@("Below Average")>Below Average</MudSelectItem>
                            <MudSelectItem Value=@("Poor")>Poor</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="report.CompletedStoryPoints2" 
                                    For="@(() => report.CompletedStoryPoints2)" 
                                    Label="Completed Story Points 2" 
                                    InputType="InputType.Number" 
                                    Required="true" 
                                    Disabled="@IsSecondFortnightDisabled"
                                    Variant="Variant.Outlined" 
                                    Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="report.Feedback2" 
                                    For="@(() => report.Feedback2)" 
                                    Label="Feedback 2" 
                                    Lines="3" 
                                    Required="true" 
                                    Disabled="@IsSecondFortnightDisabled"
                                    Variant="Variant.Outlined" 
                                    Margin="Margin.Dense" />
                    </MudItem>

                    <!-- Submit Button -->
                    <MudItem xs="12" Class="mt-6">
                        <MudButton ButtonType="ButtonType.Submit" 
                                 Variant="Variant.Filled" 
                                 Color="Color.Primary" 
                                 Size="Size.Large" 
                                 FullWidth="true">
                            @(isEditMode ? "Update Report" : "Submit Report")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public ReportModel Report { get; set; }
    private ReportModel report = new();
    private List<EmployeeDetails> employees = new();
    private string selectedMenteeEmail;
    private bool isLoading = true;
    private bool hasError = false;
    private bool isEditMode = false;

    private bool IsFirstFortnightDisabled => DateTime.Now.Day >= 16 && DateTime.Now.Day <= 31;
    private bool IsSecondFortnightDisabled => DateTime.Now.Day >= 1 && DateTime.Now.Day <= 15;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var email = await JS.InvokeAsync<string>("localStorage.getItem", "email");
            if (!string.IsNullOrWhiteSpace(email))
            {
                var mentor = await EmployeeService.GetEmployeeDetailsByEmail(email);
                if (mentor != null)
                {
                    report.MentorName = $"{mentor.FirstName} {mentor.LastName}";
                    report.MentorEmail = mentor.CurrentEmail;
                    report.MentorDesignation = mentor.Designation;
                    report.MentorId = mentor.EmployeeID;
                }
            }

            var assignments = await MentorAssignmentService.GetAllAssignmentsAsync();
            var assignedMenteeIds = assignments
                .Where(a => a.MentorEmployeeID == report.MentorId)
                .Select(a => a.MenteeEmployeeID)
                .Distinct()
                .ToList();

            employees = new List<EmployeeDetails>();

            foreach (var menteeId in assignedMenteeIds)
            {
                var mentee = await EmployeeService.GetEmployeeDetails(menteeId);
                if (mentee != null)
                {
                    employees.Add(mentee);
                }
            }

            if (Report != null)
            {
                isEditMode = true;
                report = Report;
                selectedMenteeEmail = report.MenteeEmail;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnMenteeEmailChanged(string email)
    {
        selectedMenteeEmail = email;

        if (!string.IsNullOrWhiteSpace(selectedMenteeEmail))
        {
            var mentee = await EmployeeService.GetEmployeeDetailsByEmail(selectedMenteeEmail);
            if (mentee != null)
            {
                report.MenteeName = $"{mentee.FirstName} {mentee.LastName}";
                report.MenteeEmail = mentee.CurrentEmail;
                report.MenteeId = mentee.EmployeeID;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        report.SubmittedOn = DateTime.Now;

        try
        {
            bool response;
            if (isEditMode)
            {
                response = await ReportService.UpdateReportAsync(report.Id, report);
                Snackbar.Add(response ? "Report updated successfully!" : "Failed to update the report.", response ? Severity.Success : Severity.Error);
            }
            else
            {
                response = await ReportService.SubmitReportAsync(report);
                Snackbar.Add(response ? "Report submitted successfully!" : "Failed to submit the report.", response ? Severity.Success : Severity.Error);
            }

            if (response)
            {
                Navigation.NavigateTo("/reports");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during submission: {ex.Message}");
            Snackbar.Add("An error occurred while submitting.", Severity.Error);
        }
    }
}