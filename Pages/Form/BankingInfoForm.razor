    private void CloseAadhaarPdfModal() => showPdfModal = false;
    private void ClosePanPdfModal() => showPanPdfModal = false;
    private void ClosePassbookPdfModal() => showPassbookPdfModal = false;

    private void DeleteAadhaarFile()
    {
        bankingInfo.AadhaarBase64Content = null;
        bankingInfo.AadhaarContentType = null;
        bankingInfo.AadhaarFileName = null;
        showInfo = false;
        StateHasChanged();
        Snackbar.Add("Aadhaar file deleted.", Severity.Info);
