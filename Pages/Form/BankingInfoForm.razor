@code {
    [Parameter] public EventCallback<BankingInformation> OnSubmit { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    public BankingInformation bankingInfo { get; set; } = new();

    [Parameter] public BankingInformation InitialData { get; set; }

    private EditContext EditContext;
    private Dictionary<string, List<string>> validationErrors = new();
    private bool showInfo = false;
    private bool showPanInfo = false;
    private bool showPassbookInfo = false;
    private string AadhaarUploadError;
    private string PanUploadError;
    private string PassbookUploadError;
    private bool showPdfModal = false;
    private bool showPanPdfModal = false;
    private bool showPassbookPdfModal = false;

    protected async override void OnInitialized()
    {
        var employeeDetailsJson = await JSRuntime.InvokeAsync<string>("sessionStorageHelper.getItem", "employeeDetails");
        if (!string.IsNullOrEmpty(employeeDetailsJson))
        {
            var employeeDetails = JsonSerializer.Deserialize<EmployeeDetails>(employeeDetailsJson);
            if (employeeDetails != null)
            {
                string employeeId = employeeDetails.EmployeeID;
                bankingInfo.EmployeeID = employeeId;
            }
        }

        EditContext = new EditContext(bankingInfo);
        await LoadBankingInfo();

        if (InitialData != null)
        {
            bankingInfo = InitialData;
        }
    }

    private async Task FetchBankDetails()
    {
        var result = await bankIFSCService.GetBankDetailsByIFSCAsync(bankingInfo.IFSCode);
        if (result != null)
        {
            bankingInfo.BankName = result.BANK;
            bankingInfo.Branch = result.BRANCH;
            bankingInfo.State = result.STATE;
        }
        else
        {
            Snackbar.Add("Invalid IFSC code or unable to fetch bank details.", Severity.Error);
        }
    }

    private void ValidateField(string propertyName)
    {
        var validationContext = new ValidationContext(bankingInfo) { MemberName = propertyName };
        var validationResults = new List<ValidationResult>();
        var property = bankingInfo.GetType().GetProperty(propertyName);
        var value = property?.GetValue(bankingInfo);

        validationErrors.Remove(propertyName);

        var isValid = Validator.TryValidateProperty(value, validationContext, validationResults);
        if (!isValid)
        {
            validationErrors[propertyName] = validationResults.Select(r => r.ErrorMessage).ToList();
        }
        StateHasChanged();
    }

    private bool HasValidationError(string propertyName)
    {
        return validationErrors.ContainsKey(propertyName) && validationErrors[propertyName].Any();
    }

    private string GetValidationError(string propertyName)
    {
        if (validationErrors.ContainsKey(propertyName) && validationErrors[propertyName].Any())
        {
            return validationErrors[propertyName].First();
        }
        return string.Empty;
    }

    private async Task GoToNextPage()
    {
        if (bankingInfo == null)
            return;
        ValidateAllFields();
        if (!validationErrors.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("sessionStorageHelper.setItem", "bankingInfo", JsonSerializer.Serialize(bankingInfo));
                await OnSubmit.InvokeAsync(bankingInfo);
                NavigationManager.NavigateTo("/workExperience");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error saving to session storage: {ex.Message}");
            }
        }
        else
        {
            Snackbar.Add("Please fix all validation errors before proceeding", Severity.Error);
        }
    }

    private void ValidateAllFields()
    {
        validationErrors.Clear();
        var validationContext = new ValidationContext(bankingInfo);
        var validationResults = new List<ValidationResult>();

        Validator.TryValidateObject(bankingInfo, validationContext, validationResults, true);

        foreach (var result in validationResults)
        {
            foreach (var memberName in result.MemberNames)
            {
                if (!validationErrors.ContainsKey(memberName))
                {
                    validationErrors[memberName] = new List<string>();
                }
                validationErrors[memberName].Add(result.ErrorMessage);
            }
        }
        StateHasChanged();
    }

    private async Task LoadBankingInfo()
    {
        var bankingInfoJson = await JSRuntime.InvokeAsync<string>("sessionStorageHelper.getItem", "bankingInfo");
        if (!string.IsNullOrEmpty(bankingInfoJson))
        {
            var deserialized = JsonSerializer.Deserialize<BankingInformation>(bankingInfoJson);
            bankingInfo = deserialized;
        }
        StateHasChanged();
    }

    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("sessionStorageHelper.setItem", "bankingInfo", JsonSerializer.Serialize(bankingInfo));
        await OnBack.InvokeAsync();
        NavigationManager.NavigateTo("/employee-form");
    }

    public void Reset()
    {
        bankingInfo = new BankingInformation();
        validationErrors.Clear();
        StateHasChanged();
    }

    // New MudFileUpload handlers
    private async Task HandleAadharMudUpload(IBrowserFile file)
        => await HandleFileSelectedMud(file, "aadhar");
    private async Task HandlePanMudUpload(IBrowserFile file)
        => await HandleFileSelectedMud(file, "pan");
    private async Task HandlePassbookMudUpload(IBrowserFile file)
        => await HandleFileSelectedMud(file, "passbook");

    private async Task HandleFileSelectedMud(IBrowserFile file, string fileType)
    {
        var fileName = file?.Name;
        if (file != null)
        {
            try
            {
                if (file.Size > 20 * 1024 * 1024)
                {
                    Snackbar.Add("File is too large! Please upload a file smaller than 20 MB.", Severity.Error);
                    return;
                }
                var buffer = new byte[file.Size];
                await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).ReadAsync(buffer);
                var base64String = Convert.ToBase64String(buffer);

                switch (fileType.ToLower())
                {
                    case "aadhar":
                        bankingInfo.AadhaarBase64Content = base64String;
                        bankingInfo.AadhaarContentType = file.ContentType;
                        bankingInfo.AadhaarFileName = fileName;
                        validationErrors.Remove(nameof(bankingInfo.AadhaarBase64Content));
                        break;
                    case "pan":
                        bankingInfo.PanBase64Content = base64String;
                        bankingInfo.PanContentType = file.ContentType;
                        bankingInfo.PanFileName = fileName;
                        validationErrors.Remove(nameof(bankingInfo.PanBase64Content));
                        break;
                    case "passbook":
                        bankingInfo.PassbookBase64Content = base64String;
                        bankingInfo.PassbookContentType = file.ContentType;
                        bankingInfo.PassbookFileName = fileName;
                        validationErrors.Remove(nameof(bankingInfo.PassbookBase64Content));
                        break;
                }

                await JSRuntime.InvokeVoidAsync("sessionStorageHelper.setItem", "bankingInfo", JsonSerializer.Serialize(bankingInfo));
                Snackbar.Add($"{fileType.ToUpper()} file uploaded successfully!", Severity.Success);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error reading file: {ex.Message}");
            }
        }
        else
        {
            SetUploadError(fileType, "File is required.");
        }
    }

    private void SetUploadError(string fileType, string message)
    {
        switch (fileType.ToLower())
        {
            case "aadhar":
                AadhaarUploadError = message;
                break;
            case "pan":
                PanUploadError = message;
                break;
            case "passbook":
                PassbookUploadError = message;
                break;
        }
        Snackbar.Add(message, Severity.Error);
    }

    private void ShowInfo()
    {
        if (!string.IsNullOrEmpty(bankingInfo.AadhaarBase64Content))
            showInfo = true;
    }
    private void ShowPanInfo()
    {
        if (!string.IsNullOrEmpty(bankingInfo.PanBase64Content))
            showPanInfo = true;
    }
    private void ShowPassbookInfo()
    {
        if (!string.IsNullOrEmpty(bankingInfo.PassbookBase64Content))
            showPassbookInfo = true;
    }

    private async Task DownloadFile()
    {
        if (!string.IsNullOrEmpty(bankingInfo.AadhaarBase64Content))
        {
            var fileName = bankingInfo.AadhaarFileName ?? "document";
            await JSRuntime.InvokeVoidAsync("blazorDownloadFile", fileName, bankingInfo.AadhaarContentType ?? "application/octet-stream", bankingInfo.AadhaarBase64Content);
        }
    }

