@page "/bankingForm"
@using System.Text.Json
@using Components.sidebar
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject BankingService bankingService
@inject BankIFSCService bankIFSCService

@layout HomeLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="main-form-compact">
    <MudCard Elevation="2" Class="p-3">
        <MudCardHeader>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">
                BANK DETAILS
                <MudText Typo="Typo.body2" Color="Color.Info">As per passbook.</MudText>
            </MudText>
        </MudCardHeader>
        <MudCardContent>
            <EditForm Model="@bankingInfo" OnValidSubmit="GoToNextPage">
                <DataAnnotationsValidator />

                <MudGrid Gutter="2">

                    <!-- Account Holder Name -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.Name"
                                      Label="Account Holder Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      style="text-transform:capitalize"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.Name)))"
                                      Error="@HasValidationError(nameof(bankingInfo.Name))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.Name))" />
                    </MudItem>

                    <!-- Account Number -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.AccountNumber"
                                      Label="Account Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.AccountNumber)))"
                                      Error="@HasValidationError(nameof(bankingInfo.AccountNumber))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.AccountNumber))" />
                    </MudItem>

                    <!-- IFSC -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.IFSCode"
                                      Label="IFSCode"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      @onblur="FetchBankDetails"
                                      Error="@HasValidationError(nameof(bankingInfo.IFSCode))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.IFSCode))" />
                    </MudItem>

                    <!-- Bank Name -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.BankName"
                                      Label="Bank Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      Disabled="true"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.BankName)))"
                                      Error="@HasValidationError(nameof(bankingInfo.BankName))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.BankName))" />
                    </MudItem>

                    <!-- Branch -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.Branch"
                                      Label="Branch"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      style="text-transform:capitalize"
                                      Margin="Margin.Dense"
                                      Disabled="true"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.Branch)))"
                                      Error="@HasValidationError(nameof(bankingInfo.Branch))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.Branch))" />
                    </MudItem>

                    <!-- Branch State -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.State"
                                      Label="Branch State"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Disabled="true"
                                      style="text-transform:capitalize"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.State)))"
                                      Error="@HasValidationError(nameof(bankingInfo.State))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.State))" />
                    </MudItem>

                    <!-- Mobile Number -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.Phone"
                                      Label="Mobile Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.Phone)))"
                                      Error="@HasValidationError(nameof(bankingInfo.Phone))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.Phone))" />
                    </MudItem>

                    <!-- Account Type -->
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="bankingInfo.AccountType"
                                   Label="Account Type"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Margin="Margin.Dense"
                                   Error="@HasValidationError(nameof(bankingInfo.AccountType))"
                                   ErrorText="@GetValidationError(nameof(bankingInfo.AccountType))"
                                   @onblur="@(() => ValidateField(nameof(bankingInfo.AccountType)))">
                            <MudSelectItem Value="@("Savings")">Savings</MudSelectItem>
                            <MudSelectItem Value="@("Current")">Current</MudSelectItem>
                        </MudSelect>
                        <ValidationMessage For="@(() => bankingInfo.AccountType)" />
                    </MudItem>

                    <!-- PAN Number -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.PANNumber"
                                      Label="PAN Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.PANNumber)))"
                                      Error="@HasValidationError(nameof(bankingInfo.PANNumber))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.PANNumber))" />
                    </MudItem>

                    <!-- Aadhaar Number -->
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="bankingInfo.AadhaarNumber"
                                      Label="Aadhaar Number"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Margin="Margin.Dense"
                                      @onblur="@(() => ValidateField(nameof(bankingInfo.AadhaarNumber)))"
                                      Error="@HasValidationError(nameof(bankingInfo.AadhaarNumber))"
                                      ErrorText="@GetValidationError(nameof(bankingInfo.AadhaarNumber))" />
                    </MudItem>

                    <!-- Aadhaar File Upload UI (MudFileUpload) -->
                    <MudItem xs="12">
                        <div class="aadhaar-rectangle-upload align-center-rectangle">
                            <div class="aadhaar-rectangle-content">
                                <div class="aadhaar-rectangle-title">
                                    <MudText Typo="Typo.subtitle1" Class="aadhaar-heading-highlight">
                                        <b>Aadhaar Document <span class="aadhaar-required">*</span></b>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">(PDF/JPG/PNG, max 20MB)</MudText>
                                </div>
                                <MudFileUpload T="IBrowserFile" FilesChanged="HandleAadharMudUpload">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload Aadhaar
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    @(string.IsNullOrEmpty(bankingInfo.AadhaarBase64Content)
                                        ? "No file selected"
                                        : $"File: {bankingInfo.AadhaarFileName}")
                                </MudText>
                                @if (!string.IsNullOrEmpty(bankingInfo.AadhaarBase64Content))
                                {
                                    <div class="aadhaar-rectangle-actions-row align-actions-row">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenAadhaarPdfModal" StartIcon="@Icons.Material.Filled.Visibility">
                                            Preview
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ShowInfo" StartIcon="@Icons.Material.Filled.Info">
                                            Info
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteAadhaarFile">
                                            Delete
                                        </MudButton>
                                    </div>
                                }
                                @if (showInfo && !string.IsNullOrEmpty(bankingInfo.AadhaarBase64Content))
                                {
                                    <MudPaper Elevation="0" Class="mt-2 pa-2 aadhaar-info-paper" Style="background: #f7f7f7; border-left:3px solid #1976d2;">
                                        <MudText Typo="Typo.caption">File Name: <b>@bankingInfo.AadhaarFileName</b></MudText>
                                        <MudText Typo="Typo.caption">File Size: <b>@(Convert.FromBase64String(bankingInfo.AadhaarBase64Content).Length / 1024) KB</b></MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-1" OnClick="() => showInfo=false">
                                            <MudIcon Icon="@Icons.Material.Filled.Close" /> Close
                                        </MudButton>
                                    </MudPaper>
                                }
                                @if (!string.IsNullOrEmpty(AadhaarUploadError))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@AadhaarUploadError</MudText>
                                }
                                @if (HasValidationError(nameof(bankingInfo.AadhaarBase64Content)))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@GetValidationError(nameof(bankingInfo.AadhaarBase64Content))</MudText>
                                }
                                <ValidationMessage For="@(() => bankingInfo.AadhaarBase64Content)" />
                            </div>
                        </div>
                    </MudItem>

                    <!-- PAN File Upload UI (MudFileUpload) -->
                    <MudItem xs="12">
                        <div class="aadhaar-rectangle-upload align-center-rectangle">
                            <div class="aadhaar-rectangle-content">
                                <div class="aadhaar-rectangle-title">
                                    <MudText Typo="Typo.subtitle1" Class="aadhaar-heading-highlight">
                                        <b>PAN Document <span class="aadhaar-required">*</span></b>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">(PDF/JPG/PNG, max 20MB)</MudText>
                                </div>
                                <MudFileUpload T="IBrowserFile" FilesChanged="HandlePanMudUpload">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload PAN
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    @(string.IsNullOrEmpty(bankingInfo.PanBase64Content)
                                        ? "No file selected"
                                        : $"File: {bankingInfo.PanFileName}")
                                </MudText>
                                @if (!string.IsNullOrEmpty(bankingInfo.PanBase64Content))
                                {
                                    <div class="aadhaar-rectangle-actions-row align-actions-row">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenPanPdfModal" StartIcon="@Icons.Material.Filled.Visibility">
                                            Preview
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ShowPanInfo" StartIcon="@Icons.Material.Filled.Info">
                                            Info
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeletePanFile">
                                            Delete
                                        </MudButton>
                                    </div>
                                }
                                @if (showPanInfo && !string.IsNullOrEmpty(bankingInfo.PanBase64Content))
                                {
                                    <MudPaper Elevation="0" Class="mt-2 pa-2 aadhaar-info-paper" Style="background: #f7f7f7; border-left:3px solid #1976d2;">
                                        <MudText Typo="Typo.caption">File Name: <b>@bankingInfo.PanFileName</b></MudText>
                                        <MudText Typo="Typo.caption">File Size: <b>@(Convert.FromBase64String(bankingInfo.PanBase64Content).Length / 1024) KB</b></MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-1" OnClick="() => showPanInfo=false">
                                            <MudIcon Icon="@Icons.Material.Filled.Close" /> Close
                                        </MudButton>
                                    </MudPaper>
                                }
                                @if (!string.IsNullOrEmpty(PanUploadError))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@PanUploadError</MudText>
                                }
                                @if (HasValidationError(nameof(bankingInfo.PanBase64Content)))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@GetValidationError(nameof(bankingInfo.PanBase64Content))</MudText>
                                }
                                <ValidationMessage For="@(() => bankingInfo.PanBase64Content)" />
                            </div>
                        </div>
                    </MudItem>

                    <!-- Passbook File Upload UI (MudFileUpload) -->
                    <MudItem xs="12">
                        <div class="aadhaar-rectangle-upload align-center-rectangle">
                            <div class="aadhaar-rectangle-content">
                                <div class="aadhaar-rectangle-title">
                                    <MudText Typo="Typo.subtitle1" Class="aadhaar-heading-highlight">
                                        <b>Passbook Document <span class="aadhaar-required">*</span></b>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">(PDF/JPG/PNG, max 20MB)</MudText>
                                </div>
                                <MudFileUpload T="IBrowserFile" FilesChanged="HandlePassbookMudUpload">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload Passbook
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudText Typo="Typo.caption" Class="mt-1">
                                    @(string.IsNullOrEmpty(bankingInfo.PassbookBase64Content)
                                        ? "No file selected"
                                        : $"File: {bankingInfo.PassbookFileName}")
                                </MudText>
                                @if (!string.IsNullOrEmpty(bankingInfo.PassbookBase64Content))
                                {
                                    <div class="aadhaar-rectangle-actions-row align-actions-row">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenPassbookPdfModal" StartIcon="@Icons.Material.Filled.Visibility">
                                            Preview
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ShowPassbookInfo" StartIcon="@Icons.Material.Filled.Info">
                                            Info
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeletePassbookFile">
                                            Delete
                                        </MudButton>
                                    </div>
                                }
                                @if (showPassbookInfo && !string.IsNullOrEmpty(bankingInfo.PassbookBase64Content))
                                {
                                    <MudPaper Elevation="0" Class="mt-2 pa-2 aadhaar-info-paper" Style="background: #f7f7f7; border-left:3px solid #1976d2;">
                                        <MudText Typo="Typo.caption">File Name: <b>@bankingInfo.PassbookFileName</b></MudText>
                                        <MudText Typo="Typo.caption">File Size: <b>@(Convert.FromBase64String(bankingInfo.PassbookBase64Content).Length / 1024) KB</b></MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-1" OnClick="() => showPassbookInfo=false">
                                            <MudIcon Icon="@Icons.Material.Filled.Close" /> Close
                                        </MudButton>
                                    </MudPaper>
                                }
                                @if (!string.IsNullOrEmpty(PassbookUploadError))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@PassbookUploadError</MudText>
                                }
                                @if (HasValidationError(nameof(bankingInfo.PassbookBase64Content)))
                                {
                                    <MudText Color="Color.Error" Typo="Typo.caption">@GetValidationError(nameof(bankingInfo.PassbookBase64Content))</MudText>
                                }
                                <ValidationMessage For="@(() => bankingInfo.PassbookBase64Content)" />
                            </div>
                        </div>
                    </MudItem>

                    <!-- Action Buttons -->
                    <MudItem xs="12" Class="d-flex justify-end mt-3 gap-3">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="GoBack">
                            Back
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">
                            Next
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- PDF Modal Overlay for Aadhaar -->
@if (showPdfModal)
{
    <div class="pdf-overlay" @onclick="CloseAadhaarPdfModal">
        <div class="pdf-modal" @onclick:stopPropagation>
            <MudPaper Elevation="3" Class="pa-2" Style="max-width:98vw;max-height:98vh;overflow:auto;position:relative;background:white;">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Aadhaar Document - Fullscreen Preview</MudText>
                <div style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Primary" OnClick="CloseAadhaarPdfModal" />
                </div>
                @if (!string.IsNullOrEmpty(bankingInfo.AadhaarFileName) &&
                     bankingInfo.AadhaarFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    <iframe src="@($"data:application/pdf;base64,{bankingInfo.AadhaarBase64Content}")"
                            style="width: 90vw; height: 85vh; border: none; background:white;"></iframe>
                }
                else
                {
                    <img src="@($"data:image/jpeg;base64,{bankingInfo.AadhaarBase64Content}")"
                         alt="Aadhaar Document Preview"
                         style="max-width: 90vw; max-height: 85vh; display: block; background:white;" />
                }
            </MudPaper>
        </div>
    </div>
}
