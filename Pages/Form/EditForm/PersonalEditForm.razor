@code {
    [Parameter]
    public string EmployeeId { get; set; }
    private bool isSubmitting = false;

    private List<Country> countries = new();
    [Parameter]
    public EventCallback<EmployeeDetails> OnSubmit { get; set; }
    private string? PhotoUploadError;
    public EmployeeDetails employeeDetails { get; set; } = new EmployeeDetails();
    [Parameter]
    public EmployeeDetails InitialData { get; set; }
    private bool isLoading = true;

    private bool IsSameAsCurrentAddress { get; set; }

    private void CopyAddress(bool value)
    {
        IsSameAsCurrentAddress = value;
        if (IsSameAsCurrentAddress)
        {
            employeeDetails.PermanentAddress = employeeDetails.CurrentAddress;
            employeeDetails.PermanentCity = employeeDetails.CurrentCity;
            employeeDetails.PermanentState = employeeDetails.CurrentState;
            employeeDetails.PermanentZip = employeeDetails.CurrentZip;
            employeeDetails.PermanentMobile = employeeDetails.CurrentMobile;
            employeeDetails.PermanentEmail = employeeDetails.CurrentEmail;
        }
    }
    private EditContext EditContext;
    private Dictionary<string, List<string>> validationErrors = new Dictionary<string, List<string>>();


    private int? contactIndexBeingFetched = null;
    private string zipErrorMessage = null;
    private System.Timers.Timer debounceTimer = new System.Timers.Timer(500);
    private string lastZipProcessed = string.Empty;
    public class PinResponse
    {
        public List<PostOffice> PostOffice { get; set; }
    }
    public class PostOffice
    {
        public string State { get; set; }
        public string District { get; set; }
    }
    private async Task GetCityStateFromPin(string pinCode, Action<string> setCity, Action<string> setState)
    {
        Console.WriteLine($"[DEBUG] Fetching city/state for PIN: {pinCode}");

        zipErrorMessage = null;
        if (!string.IsNullOrWhiteSpace(pinCode) && pinCode.Length == 6)
        {
            try
            {
                using var http = new HttpClient();
                var response = await http.GetFromJsonAsync<List<PinResponse>>($"https://api.postalpincode.in/pincode/{pinCode}");

                if (response?.Any() == true && response.First().PostOffice?.Any() == true)
                {
                    var post = response.First().PostOffice.FirstOrDefault();
                    Console.WriteLine($"[DEBUG] Found city: {post?.District}, state: {post?.State}");

                    if (post != null)
                    {
                        setCity(post.District);
                        setState(post.State);
                    }
                    else
                    {
                        setCity(string.Empty);
                        setState(string.Empty);
                        zipErrorMessage = $"No data found for PIN code: {pinCode}";
                    }
                }
                else
                {
                    Console.WriteLine($"[DEBUG] No data found for pin: {pinCode}");
                    setCity(string.Empty);
                    setState(string.Empty);
                    zipErrorMessage = $"Invalid PIN code: {pinCode}";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG] Error fetching pin data: {ex.Message}");
                setCity(string.Empty);
                setState(string.Empty);
                zipErrorMessage = $"Error fetching city/state: {ex.Message}";
            }
        }
        else
        {
            Console.WriteLine($"[DEBUG] Invalid pin format: {pinCode}");
            setCity(string.Empty);
            setState(string.Empty);
            zipErrorMessage = "PIN code must be 6 digits.";
        }
    }
    private bool IsFetchingLocation = false;
    private async Task HandleZipCodeChange(string zip, int contactIndex)
    {
        if (string.IsNullOrWhiteSpace(zip) || zip.Length != 6 || zip == lastZipProcessed)
        {
            Console.WriteLine($"[DEBUG] Skipping fetch for invalid or unchanged pin: {zip}");
            return;
        }

        // Cancel any existing timer
        debounceTimer.Stop();

        // Start a new debounce timer
        await Task.Run(() =>
        {
            debounceTimer.Elapsed += async (s, e) =>
            {
                debounceTimer.Stop(); // Stop the timer after firing
                await InvokeAsync(async () =>
                {
                    IsFetchingLocation = true;
                    contactIndexBeingFetched = contactIndex;
                    StateHasChanged();

                    lastZipProcessed = zip; // Track the last processed ZIP to avoid duplicates

                    if (contactIndex == 1)
                    {
                        employeeDetails.EmergencyContact1ZipCode = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.EmergencyContact1City = city,
                            state => employeeDetails.EmergencyContact1State = state
                        );
                    }
                    else if (contactIndex == 2)
                    {
                        employeeDetails.EmergencyContact2ZipCode = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.EmergencyContact2City = city,
                            state => employeeDetails.EmergencyContact2State = state
                        );
                    }
                    else if (contactIndex == 3)
                    {
                        employeeDetails.CurrentZip = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.CurrentCity = city,
                            state => employeeDetails.CurrentState = state
                        );
                    }
                    else if (contactIndex == 4)
                    {
                        employeeDetails.PermanentZip = zip;
                        await GetCityStateFromPin(
                            zip,
                            city => employeeDetails.PermanentCity = city,
                            state => employeeDetails.PermanentState = state
                        );
                    }

                    IsFetchingLocation = false;
                    contactIndexBeingFetched = null;
                    StateHasChanged();
                });
            };
            debounceTimer.AutoReset = false; // Run only once
            debounceTimer.Start();
        });
    }
    private void ValidateField(string propertyName)
    {
        var validationContext = new ValidationContext(employeeDetails) { MemberName = propertyName };
        var validationResults = new List<ValidationResult>();
        var property = employeeDetails.GetType().GetProperty(propertyName);
        var value = property?.GetValue(employeeDetails);

        // Clear previous errors for this field
        validationErrors.Remove(propertyName);

        // Validate the specific property
        var isValid = Validator.TryValidateProperty(value, validationContext, validationResults);

        if (!isValid)
        {
            validationErrors[propertyName] = validationResults.Select(r => r.ErrorMessage).ToList();
        }

        StateHasChanged();
    }

    private bool HasValidationError(string propertyName)
    {
        return validationErrors.ContainsKey(propertyName) && validationErrors[propertyName].Any();
    }

    private string GetValidationError(string propertyName)
    {
        if (validationErrors.ContainsKey(propertyName) && validationErrors[propertyName].Any())
        {
            return validationErrors[propertyName].First();
        }
        return string.Empty;
    }
    private void ValidateAllFields()
    {
        validationErrors.Clear();
        var validationContext = new ValidationContext(employeeDetails);
        var validationResults = new List<ValidationResult>();

        Validator.TryValidateObject(employeeDetails, validationContext, validationResults, true);

        foreach (var result in validationResults)
        {
            foreach (var memberName in result.MemberNames)
            {
                if (!validationErrors.ContainsKey(memberName))
                {
                    validationErrors[memberName] = new List<string>();
                }
                validationErrors[memberName].Add(result.ErrorMessage);
            }
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

         countries = await CountryService.GetCountriesAsync();

        if (!string.IsNullOrEmpty(EmployeeId))
        {
            employeeDetails = await EmployeeService.GetEmployeeDetails(EmployeeId);
        }
        isLoading = false;
    }
    private async Task HandlePhotoFileChange(InputFileChangeEventArgs e)
    {
        PhotoUploadError = null;

        var file = e.File;
        if (file == null)
        {
            PhotoUploadError = "No file selected.";
            return;
        }

        // Size check: max 20 MB
        if (file.Size > 20 * 1024 * 1024)
        {
            PhotoUploadError = "File size exceeds 20MB limit.";
            return;
        }

        // Acceptable formats
        var allowedTypes = new[] { "image/jpeg", "image/png", "application/pdf" };
        if (!allowedTypes.Contains(file.ContentType))
        {
            PhotoUploadError = "Invalid file format. Please upload JPG, PNG, or PDF.";
            return;
        }

        // Read file content
        var buffer = new byte[file.Size];
        await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).ReadAsync(buffer);

        // Assign to model
        employeeDetails.PhotoFileName = file.Name;
        employeeDetails.PhotoContentType = file.ContentType;
        employeeDetails.PhotoBase64Content = Convert.ToBase64String(buffer);
    }
    private string? SuccessMessage;

    private bool IsImageFile(string? contentType)
    {
        return contentType != null &&
               (contentType.StartsWith("image/jpeg") || contentType.StartsWith("image/png"));
    }
    private void CloseForm()
    {
        if (!string.IsNullOrEmpty(EmployeeId))
        {
            NavigationManager.NavigateTo($"/employeeDetailsData/{EmployeeId}");
        }
        else
        {
            NavigationManager.NavigateTo("home/employeeList");
        }
    }

    private async Task HandleUpdateEmployee()
    {
        ValidateAllFields();
        if (!validationErrors.Any())
        {
            Console.WriteLine("Form is valid, submitting...");
         
        }
        else
        {
            Console.WriteLine("Form has validation errors");
            Snackbar.Add("Please fix all validation errors before proceeding", Severity.Error);
        }
        
            isSubmitting = true;
            StateHasChanged(); 

        bool result = await EmployeeService.UpdateEmployee(employeeDetails);

            isSubmitting = false;
            StateHasChanged(); 
        if (result)
        {

            SuccessMessage = "Employee details updated successfully!";

            var parameters = new DialogParameters
        {
            { "Message", SuccessMessage },
            { "OnClose", EventCallback.Factory.Create(this, NavigateToList) }
        };

            DialogService.Show<SubmitSuccessDialog>("Success", parameters);
            // Navigate or show a success message
            Snackbar.Add("Updated successfully!", Severity.Success); // ✅ Success message

        }
        else
        {
            Snackbar.Add("Update failed. Please try again.", Severity.Error); // ❌ Failure message

            // Show an error message
            Console.WriteLine("Update failed");
        }
    }
    private void NavigateToList()
    {
        if (!string.IsNullOrEmpty(EmployeeId))
        {
            NavigationManager.NavigateTo($"/employeeDetailsData/{EmployeeId}");
        }
        else
        {
            NavigationManager.NavigateTo("home/employeeList");
        }   
    }

}