@page "/personalEditForm/{EmployeeId}"
@inject NavigationManager NavigationManager
@using Components.sidebar
@layout HomeLayout
@inject EmployeeService EmployeeService
@inject IDialogService DialogService
@inject CountryService CountryService
@inject ISnackbar Snackbar
@using System.ComponentModel.DataAnnotations;

<h3>Edit Personal Details</h3>

@if (isLoading)
{
    <div style="display: flex; flex-direction: column; align-items: center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Color="Color.Primary" Align="Align.Center">Loading...</MudText>
    </div>
}
else if (employeeDetails == null)
{
    <MudText Color="Color.Error">Failed to load employee data.</MudText>
}
else
{   <MudCard Elevation="2" Class="p-3">
             <MudCardHeader>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">
                    PERSONAL DETAILS
                </MudText>
            </MudCardHeader>
    <EditForm Model="@employeeDetails" OnValidSubmit="HandleUpdateEmployee">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@

        <!-- Personal Information -->
        <!-- Personal Information -->
        <MudExpansionPanel Typo="Typo.h5" Text="Personal Information*"
                           Icon="@Icons.Material.Filled.Person"
                           Class="section-tab"
                               Style=" padding: 10px;">
            <ChildContent>
                <div class="section-content">
                    <MudGrid Margin="Margin.Dense">
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Employee ID" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmployeeID"
                                          Required="true" Margin="Margin.Dense" Disabled="true" />
                        </MudItem>
                           <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Employee Code" Variant="Variant.Outlined" @bind-Value="employeeDetails.EmployeeCode"
                                          Required="true" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="First Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.FirstName" Required="true" Margin="Margin.Dense"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.FirstName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.FirstName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.FirstName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.FirstName)" /> *@
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Middle Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.MiddleName" Margin="Margin.Dense"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.MiddleName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.MiddleName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.MiddleName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.MiddleName)"/> *@


                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Last Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.LastName" Required="true" Margin="Margin.Dense"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.LastName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.LastName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.LastName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.LastName)" /> *@


                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Father's Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.FatherName" Required="true" Margin="Margin.Dense"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.FatherName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.FatherName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.FatherName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.FatherName)" /> *@

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Mother's Name" Variant="Variant.Outlined" @bind-Value="employeeDetails.MotherName" Required="true" Margin="Margin.Dense"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.MotherName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.MotherName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.MotherName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.MotherName)" /> *@
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudDatePicker Label="Date of Birth" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="employeeDetails.DateOfBirth" Required="true" MaxDate="DateTime.Now" For="@(() => employeeDetails.DateOfBirth)"
                                           @onblur="@(() => ValidateField(nameof(employeeDetails.DateOfBirth)))"
                                           Error="@HasValidationError(nameof(employeeDetails.DateOfBirth))"
                                           ErrorText="@GetValidationError(nameof(employeeDetails.DateOfBirth))" />
                            @* <ValidationMessage For="@(() => employeeDetails.DateOfBirth)" /> *@

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Gender" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Gender" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.Gender)))"
                                       Error="@HasValidationError(nameof(employeeDetails.Gender))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.Gender))">
                                <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                                <MudSelectItem Value="@("Pefer not to mention")">Perfer not to mention</MudSelectItem>
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.Gender)" />

                        </MudItem>
                    </MudGrid>
                    @* break *@
                    <strong> <b><hr style="color:black" ; /></b></strong>

                    <MudGrid>

                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Physically Challenged" Margin="Margin.Dense" Variant="Variant.Outlined" @bind-Value="employeeDetails.PhysicallyChallenged" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.PhysicallyChallenged)))"
                                       Error="@HasValidationError(nameof(employeeDetails.PhysicallyChallenged))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.PhysicallyChallenged))">
                                <MudSelectItem Value="@("Yes")">Yes</MudSelectItem>
                                <MudSelectItem Value="@("No")">No</MudSelectItem>

                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.PhysicallyChallenged)" />

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Allergies" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Allergies" />
                            <ValidationMessage For="@(() => employeeDetails.Allergies)" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Medications" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Medications" />
                            <ValidationMessage For="@(() => employeeDetails.Medications)" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Marital Status" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.MaritalStatus" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.MaritalStatus)))"
                                       Error="@HasValidationError(nameof(employeeDetails.MaritalStatus))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.MaritalStatus))">
                                <MudSelectItem Value="@("Married")">Married</MudSelectItem>
                                <MudSelectItem Value="@("Unmarried")">Unmarried</MudSelectItem>
                                <MudSelectItem Value="@("Divorced")">Divorced</MudSelectItem>
                                <MudSelectItem Value="@("Widowed")">Widowed</MudSelectItem>
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.MaritalStatus)" />

                        </MudItem>
                        @if (employeeDetails.MaritalStatus != "Unmarried")
                        {
                            <MudItem xs="12" sm="4" md="3">
                                <MudTextField Label="No of Sons" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Sons"
                                              @onblur="@(() => ValidateField(nameof(employeeDetails.Sons)))"
                                              Error="@HasValidationError(nameof(employeeDetails.Sons))"
                                              ErrorText="@GetValidationError(nameof(employeeDetails.Sons))" />
                                @* <ValidationMessage For="@(() => employeeDetails.Sons)" /> *@
                            </MudItem>
                            <MudItem xs="12" sm="4" md="3">
                                <MudTextField Label="No of Daughters" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Daughters"
                                              @onblur="@(() => ValidateField(nameof(employeeDetails.Daughters)))"
                                              Error="@HasValidationError(nameof(employeeDetails.Daughters))"
                                              ErrorText="@GetValidationError(nameof(employeeDetails.Daughters))" />
                                @* <ValidationMessage For="@(() => employeeDetails.Daughters)" /> *@
                            </MudItem>
                        }
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Blood Group" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.BloodGroup" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.BloodGroup)))"
                                       Error="@HasValidationError(nameof(employeeDetails.BloodGroup))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.BloodGroup))">
                                <MudSelectItem Value="@("A+")">A+</MudSelectItem>
                                <MudSelectItem Value="@("A-")">A-</MudSelectItem>
                                <MudSelectItem Value="@("B+")">B+</MudSelectItem>
                                <MudSelectItem Value="@("B-")">B-</MudSelectItem>
                                <MudSelectItem Value="@("O+")">O+</MudSelectItem>
                                <MudSelectItem Value="@("O-")">O-</MudSelectItem>
                                <MudSelectItem Value="@("AB+")">AB+</MudSelectItem>
                                <MudSelectItem Value="@("AB-")">AB-</MudSelectItem>
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.BloodGroup)" />

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Nationality" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Nationality" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.Nationality)))"
                                       Error="@HasValidationError(nameof(employeeDetails.Nationality))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.Nationality))">
                                @if (countries != null)
                                {
                                    @foreach (var country in countries)
                                    {
                                        <MudSelectItem Value="@country.Name">@country.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.Nationality)" />

                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.body1">Upload Image </MudText>

                            <InputFile OnChange="HandlePhotoFileChange" accept=".jpg,.jpeg,.png" @onblur="@(() => ValidateField(nameof(employeeDetails.PhotoBase64Content)))"
                                       Error="@HasValidationError(nameof(employeeDetails.PhotoBase64Content))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.PhotoBase64Content))" />

                            <MudText Typo="Typo.body2" Color="Color.Primary">
                                Max 20MB. Ensure clarity.
                            </MudText>

                            <MudText Typo="Typo.caption" Class="mt-1">
                                @(string.IsNullOrEmpty(employeeDetails.PhotoBase64Content)
                                    ? "No file selected"
                                    : $"File selected: {employeeDetails.PhotoFileName}")
                            </MudText>

                            @if (!string.IsNullOrEmpty(PhotoUploadError))
                            {
                                <MudText Color="Color.Error">@PhotoUploadError</MudText>
                            }

                            <ValidationMessage For="@(() => employeeDetails.PhotoBase64Content)" />
                        </MudItem>
                    </MudGrid>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        <MudExpansionPanel Typo="Typo.h5" Text="Work Information*"
                           Icon="@Icons.Material.Filled.Work"
                           Class="section-tab"
                               Style=" padding: 10px;">
            <ChildContent>
                <div class="section-content">
                    <!-- Work Information -->
                    @* <MudText Typo="Typo.h6" Class="mb-4 mt-6">Work Information</MudText> *@
                    <MudGrid>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Type of Employment" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.TypeOfEmployment"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.TypeOfEmployment)))"
                                       Error="@HasValidationError(nameof(employeeDetails.TypeOfEmployment))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.TypeOfEmployment))">
                                <MudSelectItem Value="@("Full-Time")">Full-Time</MudSelectItem>
                                <MudSelectItem Value="@("Part-Time")">Part-Time</MudSelectItem>
                                <MudSelectItem Value="@("Contract")">Contract</MudSelectItem>
                                <MudSelectItem Value="@("Internship")">Internship</MudSelectItem>
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.TypeOfEmployment)" />

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField T="string"
                                          Label="Level"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          @bind-Value="employeeDetails.Level"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.Level)))"
                                          Error="@HasValidationError(nameof(employeeDetails.Level))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.Level))" />

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Designation" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.Designation"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.Designation)))"
                                       Error="@HasValidationError(nameof(employeeDetails.Designation))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.Designation))">
                                <MudSelectItem Value="@("Software Engineer Intern")">Software Engineer Intern</MudSelectItem>
                                <MudSelectItem Value="@("Software Engineer trainee")">Software Engineer trainee</MudSelectItem>
                                <MudSelectItem Value="@("Associate Software Engineer")">Associate Software Engineer</MudSelectItem>
                                <MudSelectItem Value="@("Software Engineer Product Manager")">Software Engineer Product Manager</MudSelectItem>
                                <MudSelectItem Value="@("Senior Software Engineer")"> Senior Software Engineer  </MudSelectItem>
                                <MudSelectItem Value="@("Vice President")">Vice President  </MudSelectItem>
                                <MudSelectItem Value="@("President")">President  </MudSelectItem>
                                <MudSelectItem Value="@("People Senior Analyst")">People Senior Analyst</MudSelectItem>
                                <MudSelectItem Value="@("People Analyst Lead")">People Analyst Lead </MudSelectItem>
                                <MudSelectItem Value="@("Executive Assistant ")"> Executive Assistant </MudSelectItem>
                                <MudSelectItem Value="@("Business Development Lead ")"> Business Development Lead </MudSelectItem>
                                <MudSelectItem Value="@("Business Development  Intern ")"> Business Development  Intern </MudSelectItem>
                                <MudSelectItem Value="@("Content Writing Intern")"> Content Writing Intern</MudSelectItem>
                                <MudSelectItem Value="@("Social Media Intern")">
                                    Social Media Intern
                                </MudSelectItem>
                                <MudSelectItem Value="@("Video Creation Intern")">
                                    Video Creation Intern
                                </MudSelectItem>
                                <MudSelectItem Value="@("AI Content Creator")">
                                    AI Content Creator
                                </MudSelectItem>
                                <MudSelectItem Value="@("Content Creator Lead")">Content Creator Lead </MudSelectItem>
                                <MudSelectItem Value="@("Software Tester")">Software Tester </MudSelectItem>


                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.Designation)" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string" Label="Joining Location" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       @bind-Value="employeeDetails.JoiningLocation" Required="true"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.JoiningLocation)))"
                                       Error="@HasValidationError(nameof(employeeDetails.JoiningLocation))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.JoiningLocation))">
                                <MudSelectItem Value=@("Bangalore, India")>Bangalore, India</MudSelectItem>
                                <MudSelectItem Value=@("Riyadh, Saudi Arabia")>Riyadh, Saudi Arabia</MudSelectItem>
                                <MudSelectItem Value=@("Delawer, USA")>Delawer, USA</MudSelectItem>
                            </MudSelect>
                            <ValidationMessage For="@(() => employeeDetails.JoiningLocation)" />
                        </MudItem>

                        <MudItem xs="12" sm="4" md="3">
                            <MudDatePicker Label="Date of Joining" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="employeeDetails.DateOfJoining" Required="true" MaxDate="DateTime.Now" For="@(() => employeeDetails.DateOfJoining)"
                                           @onblur="@(() => ValidateField(nameof(employeeDetails.DateOfJoining)))"
                                           Error="@HasValidationError(nameof(employeeDetails.DateOfJoining))"
                                           ErrorText="@GetValidationError(nameof(employeeDetails.DateOfJoining))" />
                        </MudItem>

                    </MudGrid>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        @* break *@

        <!-- passport Information -->
        <MudExpansionPanel Typo="Typo.h5" Text="Passport Information"
                           Icon="@Icons.Material.Filled.PersonOutline"
                           Class="section-tab"  Style=" padding: 10px;">
            <ChildContent>
                <div class="section-content">
                    @* <MudText Typo="Typo.h6" Class="mb-4 mt-6">Passport  Information</MudText> *@

                    <MudGrid>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Passport Full Name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.PassportFullName" Required="false"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.PassportFullName)))"
                                          Error="@HasValidationError(nameof(employeeDetails.PassportFullName))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.PassportFullName))" />
                            @* <ValidationMessage For="@(() => employeeDetails.PassportFullName)" /> *@
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Passport No" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.PassportNo" Required="false"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.PassportNo)))"
                                          Error="@HasValidationError(nameof(employeeDetails.PassportNo))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.PassportNo))" />
                            @* <ValidationMessage For="@(() => employeeDetails.PassportNo)" /> *@
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect T="string"
                                       Label="Passport Nationality"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       @bind-Value="employeeDetails.PassportNationality"
                                       Required="false"
                                       @onblur="@(() => ValidateField(nameof(employeeDetails.PassportNationality)))"
                                       Error="@HasValidationError(nameof(employeeDetails.PassportNationality))"
                                       ErrorText="@GetValidationError(nameof(employeeDetails.PassportNationality))">
                                @if (countries != null)
                                {
                                    @foreach (var country in countries)
                                    {
                                        <MudSelectItem Value="@country.Name">@country.Name</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                            @* <ValidationMessage For="@(() => employeeDetails.PassportNationality)" /> *@
                        </MudItem>

                        <MudItem xs="12" sm="4" md="3">
                            <MudDatePicker Label="Date of Issue" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="employeeDetails.PassportIssueDate" Required="false" MaxDate="DateTime.Now" For="@(() => employeeDetails.PassportIssueDate)"
                                           @onblur="@(() => ValidateField(nameof(employeeDetails.PassportIssueDate)))"
                                           Error="@HasValidationError(nameof(employeeDetails.PassportIssueDate))"
                                           ErrorText="@GetValidationError(nameof(employeeDetails.PassportIssueDate))" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudDatePicker Label="Date of Expiry" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="employeeDetails.PassportExpiryDate" Required="false" MinDate="@employeeDetails.PassportIssueDate" For="@(() => employeeDetails.PassportExpiryDate)"
                                           @onblur="@(() => ValidateField(nameof(employeeDetails.PassportExpiryDate)))"
                                           Error="@HasValidationError(nameof(employeeDetails.PassportExpiryDate))"
                                           ErrorText="@GetValidationError(nameof(employeeDetails.PassportExpiryDate))" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Passport Place of Issue" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.PassportPlaceOfIssue" Required="false"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.PassportPlaceOfIssue)))"
                                          Error="@HasValidationError(nameof(employeeDetails.PassportPlaceOfIssue))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.PassportPlaceOfIssue))" />
                            @* <ValidationMessage For="@(() => employeeDetails.PassportPlaceOfIssue)" /> *@
                        </MudItem>
                    </MudGrid>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        @* break *@
        <MudExpansionPanel Typo="Typo.h5" Text="Address*"
                           Icon="@Icons.Material.Filled.LocationOn"
                           Class="section-tab"  Style=" padding: 10px;">
            <ChildContent>
                <div class="section-content">
                    <!-- Current Address -->
                    <MudText Typo="Typo.h6" Class="mb-4 mt-6">Current Address</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.CurrentAddress" Required="true" Lines="2"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentAddress)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentAddress))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentAddress))" />
                            @* <ValidationMessage For="@(() => employeeDetails.CurrentAddress)" /> *@

                        </MudItem>

                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="PIN Code"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          @bind-Value="employeeDetails.CurrentZip"
                                          @bind-Value:after="@(async () => await HandleZipCodeChange(employeeDetails.CurrentZip, 3))"
                                          Required="true"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentZip)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentZip))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentZip))" />
                            @* <ValidationMessage For="@(() => employeeDetails.CurrentZip)" /> *@
                            @if (IsFetchingLocation && contactIndexBeingFetched == 3)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info">Fetching location details...</MudText>
                            }
                            @if (!string.IsNullOrEmpty(zipErrorMessage) && contactIndexBeingFetched == 3)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@zipErrorMessage</MudText>
                            }
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.CurrentCity" Required="true" Disabled="true"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentCity)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentCity))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentCity))" />
                            @* <ValidationMessage For="@(() => employeeDetails.CurrentCity)" /> *@

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="State" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.CurrentState" Required="true" Disabled="true"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentState)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentState))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentState))" />
                            <ValidationMessage For="@(() => employeeDetails.CurrentState)" />

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Mobile No" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="employeeDetails.CurrentMobile" Required="true"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentMobile)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentMobile))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentMobile))" />
                            @* <ValidationMessage For="@(() => employeeDetails.CurrentMobile)" /> *@

                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          @bind-Value="employeeDetails.CurrentEmail" Required="true" Disabled="true"
                                          @onblur="@(() => ValidateField(nameof(employeeDetails.CurrentEmail)))"
                                          Error="@HasValidationError(nameof(employeeDetails.CurrentEmail))"
                                          ErrorText="@GetValidationError(nameof(employeeDetails.CurrentEmail))" />
                            @* <ValidationMessage For="@(() => employeeDetails.CurrentEmail)" /> *@
                        </MudItem>

                        <MudItem xs="12" sm="4" md="3">
